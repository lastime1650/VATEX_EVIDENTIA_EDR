{
    "id": "T1091-ReplicationThroughRemovableMedia",
    "name": "Replication Through Removable Media",
    "description": "Detects attempts by adversaries to move malware onto systems, including those on disconnected or air-gapped networks, by copying malicious files to removable media and leveraging Autorun features or tricking users into execution. This technique can also be used for lateral movement by modifying executables on removable media.",
    "severity": "high",
    "mitre_attack": {
        "tactic": "TA0001",
        "technique_id": "T1091",
        "subtechnique_id": "",
        "data_sources": [
            "Enterprise:Collection:Data from Local System",
            "Enterprise:Execution:Command and Scripting Interpreter:Windows Command Shell",
            "Enterprise:Discovery:Peripheral Device Discovery"
        ]
    },
    "platform": [
        "windows"
    ],
    "detection": {
        "selections": {
            "s1_process_create_action": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.action",
                        "operator": "equals",
                        "value": "create"
                    }
                ]
            },
            "s2_process_from_removable_drive_path": {
                "event_type": "process",
