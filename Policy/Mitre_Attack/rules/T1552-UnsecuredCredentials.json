{
    "id": "T1552-UnsecuredCredentials",
    "name": "Unsecured Credentials",
    "description": "Detects attempts by adversaries to find and obtain insecurely stored credentials on compromised systems, including plaintext files, operating system or application-specific repositories, or other specialized files/artifacts.",
    "severity": "high",
    "mitre_attack": {
        "tactic": "TA0006",
        "technique_id": "T1552",
        "subtechnique_id": "",
        "data_sources": [
            "Enterprise:Discovery:Query Registry",
            "Enterprise:Execution:Command and Scripting Interpreter:Windows Command Shell",
            "Enterprise:Discovery:File and Directory Discovery",
            "Enterprise:Execution:Native API"
        ]
    },
    "platform": [
        "windows"
    ],
    "detection": {
        "selections": {
            "s_proc_create": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.action",
                        "operator": "equals",
                        "value": "create"
                    }
                ]
            },
            "s_cmdline_credential_search_keywords": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "password"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "credential"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "key"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "secret"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "pwd"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "login"
                    }
                ]
            },
            "s_cmdline_mimikatz_keywords": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "mimikatz"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "sekurlsa"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "lsadump"
                    }
                ]
            },
            "s_cmdline_reg_query_sam_security_keywords": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "reg query"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "hklm\\sam"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "hklm\\security"
                    }
                ]
            },
            "s_cmdline_certutil_decode_keywords": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "certutil"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "decode"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "base64"
                    }
                ]
            },
            "s_cmdline_powershell_credential_commands": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "powershell"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "Get-Credential"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "Export-CliXml"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "ConvertFrom-SecureString"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "Invoke-Mimikatz"
                    }
                ]
            },
            "s_fs_read_action": {
                "event_type": "filesystem",
                "conditions": [
                    {
                        "field": "body.filesystem.action",
                        "operator": "equals",
                        "value": "read"
                    },
                    {
                        "field": "body.filesystem.action",
                        "operator": "equals",
                        "value": "open"
                    }
                ]
            },
            "s_fs_filepath_sensitive_extensions": {
                "event_type": "filesystem",
                "conditions": [
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "endswith",
                        "value": ".kdbx"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "endswith",
                        "value": ".key"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "endswith",
                        "value": ".pfx"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "endswith",
                        "value": ".pem"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "endswith",
                        "value": ".cer"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "endswith",
                        "value": ".p12"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "endswith",
                        "value": ".crt"
                    }
                ]
            },
            "s_fs_filepath_credential_keywords_in_name": {
                "event_type": "filesystem",
                "conditions": [
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "contains",
                        "value": "password"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "contains",
                        "value": "credential"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "contains",
                        "value": "secret"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "contains",
                        "value": "token"
                    }
                ]
            },
            "s_fs_filepath_browser_credential_db": {
                "event_type": "filesystem",
                "conditions": [
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "contains",
                        "value": "\\AppData\\Local\\Google\\Chrome\\User Data\\Default\\Login Data"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "contains",
                        "value": "\\AppData\\Local\\Microsoft\\Edge\\User Data\\Default\\Login Data"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "contains",
                        "value": "\\AppData\\Roaming\\Mozilla\\Firefox\\Profiles\\"
                    }
                ]
            },
            "s_fs_filepath_ssh_keys_locations": {
                "event_type": "filesystem",
                "conditions": [
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "contains",
                        "value": "\\.ssh\\id_rsa"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "contains",
                        "value": "\\.ssh\\id_dsa"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "contains",
                        "value": "\\.ssh\\config"
                    }
                ]
            },
            "s_fs_filepath_sam_security_hives_locations": {
                "event_type": "filesystem",
                "conditions": [
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "contains",
                        "value": "\\Windows\\System32\\config\\SAM"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "contains",
                        "value": "\\Windows\\System32\\config\\SECURITY"
                    }
                ]
            },
            "s_reg_access_action": {
                "event_type": "registry",
                "conditions": [
                    {
                        "field": "body.registry.keyclass",
                        "operator": "contains",
                        "value": "Query"
                    },
                    {
                        "field": "body.registry.keyclass",
                        "operator": "contains",
                        "value": "OpenKey"
                    },
                    {
                        "field": "body.registry.keyclass",
                        "operator": "contains",
                        "value": "Enumerate"
                    }
                ]
            },
            "s_reg_credential_store_keys": {
                "event_type": "registry",
                "conditions": [
                    {
                        "field": "body.registry.name",
                        "operator": "startswith",
                        "value": "HKEY_LOCAL_MACHINE\\SECURITY"
                    },
                    {
                        "field": "body.registry.name",
                        "operator": "startswith",
                        "value": "HKEY_LOCAL_MACHINE\\SAM"
                    },
                    {
                        "field": "body.registry.name",
                        "operator": "startswith",
                        "value": "HKEY_CURRENT_USER\\Software\\Microsoft\\Protected Storage System Provider"
                    },
                    {
                        "field": "body.registry.name",
                        "operator": "startswith",
                        "value": "HKEY_LOCAL_MACHINE\\SYSTEM\\CurrentControlSet\\Control\\Lsa"
                    }
                ]
            },
            "s_apicall_credential_retrieval": {
                "event_type": "apicall",
                "conditions": [
                    {
                        "field": "body.apicall.function",
                        "operator": "equals",
                        "value": "LsaRetrievePrivateData"
                    },
                    {
                        "field": "body.apicall.function",
                        "operator": "equals",
                        "value": "CredRead"
                    },
                    {
                        "field": "body.apicall.function",
                        "operator": "equals",
                        "value": "CredEnumerate"
                    },
                    {
                        "field": "body.apicall.function",
                        "operator": "equals",
                        "value": "CryptUnprotectData"
                    },
                    {
                        "field": "body.apicall.function",
                        "operator": "equals",
                        "value": "VaultEnumerateItems"
                    }
                ]
            }
        },
        "condition": "(s_proc_create and (s_cmdline_credential_search_keywords or s_cmdline_mimikatz_keywords or s_cmdline_reg_query_sam_security_keywords or s_cmdline_certutil_decode_keywords or s_cmdline_powershell_credential_commands)) or (s_fs_read_action and (s_fs_filepath_sensitive_extensions or s_fs_filepath_credential_keywords_in_name or s_fs_filepath_browser_credential_db or s_fs_filepath_ssh_keys_locations or s_fs_filepath_sam_security_hives_locations)) or (s_reg_access_action and s_reg_credential_store_keys) or s_apicall_credential_retrieval"
    },
    "operational_usage": "SOC 팀은 이 규칙을 활용하여 시스템 내에 안전하지 않게 저장된 자격 증명(패스워드, 키 파일 등)을 검색하거나 탈취하려는 시도를 탐지할 수 있습니다. 특히, 프로세스 명령줄에서 자격 증명 관련 키워드와 시스템 유틸리티(powershell, certutil, reg 등)의 조합, 민감한 파일 확장자 또는 이름이 포함된 파일에 대한 읽기/열기 접근, 알려진 자격 증명 저장 레지스트리 키에 대한 조회/열거 활동, 그리고 자격 증명 관련 API 호출 등을 모니터링합니다. 탐지된 이벤트는 높은 심각도로 분류되어 즉각적인 알람을 트리거하고, 관련 프로세스 및 접근 대상에 대한 추가적인 포렌식 조사를 시작하는 데 사용될 수 있습니다. 이는 초기 침투 후 권한 상승 또는 횡적 이동을 위한 중요한 전술이므로, 다른 침해 지표와 결합하여 분석할 때 더욱 효과적입니다.",
    "false_positive": "정상적인 시스템 관리 도구, 개발자 환경 설정, 백업 솔루션, 또는 합법적인 애플리케이션이 시스템 내 파일을 스캔하거나 레지스트리, API를 통해 정보를 조회하는 과정에서 오탐이 발생할 수 있습니다. 예를 들어, 보안 소프트웨어의 자격 증명 저장소 검사, 개발자가 자신의 SSH 키 파일을 접근하는 경우, 또는 특정 애플리케이션이 설정 파일을 읽는 경우 등이 있습니다. 알려진 정상 프로세스, 특정 파일 경로, 또는 명령줄 패턴을 화이트리스트에 추가하여 오탐을 줄일 수 있습니다."
}