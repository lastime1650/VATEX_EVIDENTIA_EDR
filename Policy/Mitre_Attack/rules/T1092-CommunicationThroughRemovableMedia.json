{
    "id": "T1092-CommunicationThroughRemovableMedia",
    "name": "Communication Through Removable Media",
    "description": "Detects attempts by adversaries to use removable media (e.g., USB drives) for command and control, transferring commands or data between compromised systems, especially those in disconnected networks. This involves monitoring file operations on such media that could indicate command receipt or data exfiltration.",
    "severity": "high",
    "mitre_attack": {
        "tactic": "TA0011",
        "technique_id": "T1092",
        "subtechnique_id": "",
        "data_sources": [
            "Enterprise:Command and Control:Communication Through Removable Media"
        ]
    },
    "platform": [
        "windows"
    ],
    "detection": {
        "selections": {
            "s1_action_is_write_or_create": {
                "event_type": "filesystem",
                "conditions": [
                    {
                        "field": "body.filesystem.action",
                        "operator": "equals",
                        "value": "write"
                    },
                    {
                        "field": "body.filesystem.action",
                        "operator": "equals",
                        "value": "create"
                    }
                ]
            },
            "s2_action_is_read_or_open": {
                "event_type": "filesystem",
                "conditions": [
                    {
                        "field": "body.filesystem.action",
                        "operator": "equals",
                        "value": "read"
                    },
                    {
                        "field": "body.filesystem.action",
                        "operator": "equals",
                        "value": "open"
                    }
                ]
            },
            "s3_filepath_on_removable_drive": {
                "event_type": "filesystem",
                "conditions": [
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "startswith",
                        "value": "D:\\"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "startswith",
                        "value": "E:\\"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "startswith",
                        "value": "F:\\"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "startswith",
                        "value": "G:\\"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "startswith",
                        "value": "H:\\"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "startswith",
                        "value": "I:\\"
                    }
                ]
            },
            "s4_filepath_suspicious_executable_extension": {
                "event_type": "filesystem",
                "conditions": [
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "endswith",
                        "value": ".exe"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "endswith",
                        "value": ".dll"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "endswith",
                        "value": ".ps1"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "endswith",
                        "value": ".bat"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "endswith",
                        "value": ".cmd"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "endswith",
                        "value": ".vbs"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "endswith",
                        "value": ".js"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "endswith",
                        "value": ".hta"
                    }
                ]
            },
            "s5_filepath_suspicious_command_or_data_file": {
                "event_type": "filesystem",
                "conditions": [
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "contains",
                        "value": "commands.txt"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "contains",
                        "value": "payload.dat"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "contains",
                        "value": "config.bin"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "contains",
                        "value": "output.log"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "contains",
                        "value": ".c2"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "contains",
                        "value": "secret.key"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "contains",
                        "value": "temp.enc"
                    }
                ]
            }
        },
        "condition": "(s1_action_is_write_or_create or s2_action_is_read_or_open) and s3_filepath_on_removable_drive and (s4_filepath_suspicious_executable_extension or s5_filepath_suspicious_command_or_data_file)"
    },
    "operational_usage": "SOC 팀은 이 규칙을 활용하여 USB 드라이브와 같은 이동식 미디어를 통한 명령 및 제어(C2) 시도를 탐지할 수 있습니다. 특히, 이동식 드라이브로 추정되는 경로에서 실행 파일, 스크립트, 또는 의심스러운 명령/데이터 파일에 대한 쓰기, 생성, 읽기, 열기 활동을 모니터링합니다. 탐지된 이벤트는 높은 심각도로 분류되어 즉각적인 알람을 트리거하고, 해당 파일의 내용 및 관련 프로세스에 대한 포렌식 조사를 시작하는 데 사용될 수 있습니다. 이는 특히 에어갭(air-gapped) 네트워크나 격리된 환경에서 C2 통신이 발생할 때 중요합니다.",
    "false_positive": "정상적인 소프트웨어 설치, 업데이트, 데이터 백업, 또는 사용자가 개인 파일(문서, 사진, 비디오 등)을 이동식 미디어에 저장하거나 읽는 과정에서 오탐이 발생할 수 있습니다. 특히, 일반적인 문서 파일(.txt, .log)의 경우 오탐 가능성이 높습니다. 알려진 정상 프로세스나 특정 파일 경로를 화이트리스트에 추가하여 오탐을 줄일 수 있습니다."
}