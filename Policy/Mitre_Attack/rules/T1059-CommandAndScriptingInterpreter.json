{
    "id": "T1059-CommandAndScriptingInterpreter",
    "name": "Command and Scripting Interpreter Abuse",
    "description": "Detects the abuse of command and script interpreters such as cmd.exe, PowerShell, and various scripting engines (e.g., WScript, CScript, MSHTA, Python) to execute commands, scripts, or binaries. Adversaries commonly leverage these native interfaces and languages for various malicious activities, including obfuscated command execution, system interaction, and payload delivery, often as part of initial access, execution, or persistence tactics.",
    "severity": "high",
    "mitre_attack": {
        "tactic": "TA0002",
        "technique_id": "T1059",
        "subtechnique_id": "",
        "data_sources": [
            "Enterprise:Execution:Command and Scripting Interpreter:Windows Command Shell",
            "Enterprise:Execution:Command and Scripting Interpreter:PowerShell",
            "Enterprise:Execution:Command and Scripting Interpreter:Visual Basic",
            "Enterprise:Execution:Command and Scripting Interpreter:Python",
            "Enterprise:Execution:Command and Scripting Interpreter:JavaScript",
            "Enterprise:Execution:Shared Modules"
        ]
    },
    "platform": [
        "windows"
    ],
    "detection": {
        "selections": {
            "s_process_creation": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.action",
                        "operator": "equals",
                        "value": "create"
                    }
                ]
            },
            "s_exe_cmd": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.exe_path",
                        "operator": "endswith",
                        "value": "cmd.exe"
                    }
                ]
            },
            "s_exe_powershell": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.exe_path",
                        "operator": "endswith",
                        "value": "powershell.exe"
                    }
                ]
            },
            "s_exe_pwsh": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.exe_path",
                        "operator": "endswith",
                        "value": "pwsh.exe"
                    }
                ]
            },
            "s_exe_wscript_cscript": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.exe_path",
                        "operator": "endswith",
                        "value": "wscript.exe"
                    },
                    {
                        "field": "body.process.exe_path",
                        "operator": "endswith",
                        "value": "cscript.exe"
                    }
                ]
            },
            "s_exe_mshta": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.exe_path",
                        "operator": "endswith",
                        "value": "mshta.exe"
                    }
                ]
            },
            "s_exe_python": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.exe_path",
                        "operator": "endswith",
                        "value": "python.exe"
                    }
                ]
            },
            "s_cmdline_cmd_abuse_patterns": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "^"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "&&"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "||"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "for /f"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "certutil.exe -urlcache"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "bitsadmin /transfer"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "start \"\" powershell.exe"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "schtasks /create"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "wmic process call create"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "net user"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "net localgroup"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "tasklist"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "query user"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "whoami"
                    }
                ]
            },
            "s_cmdline_ps_abuse_patterns": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "-EncodedCommand"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "IEX"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "Invoke-Expression"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "DownloadString"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "WebClient"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "Base64"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "System.Reflection.Assembly"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "[System.Text.Encoding]::UTF8.GetString"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "($env:comspec)"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "Invoke-Obfuscation"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "Get-WmiObject"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "Get-ItemProperty"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "Get-ADUser"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "Get-LocalGroup"
                    }
                ]
            },
            "s_cmdline_script_file_extensions": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "endswith",
                        "value": ".vbs"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "endswith",
                        "value": ".js"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "endswith",
                        "value": ".hta"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "endswith",
                        "value": ".bat"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "endswith",
                        "value": ".cmd"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "endswith",
                        "value": ".ps1"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "endswith",
                        "value": ".py"
                    }
                ]
            },
            "s_cmdline_script_specific_abuse": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "javascript:"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "ActiveXObject"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "WScript.Shell"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "CreateObject"
                    }
                ]
            }
        },
        "condition": "s_process_creation and ((s_exe_cmd and s_cmdline_cmd_abuse_patterns) or (s_exe_powershell and s_cmdline_ps_abuse_patterns) or (s_exe_pwsh and s_cmdline_ps_abuse_patterns) or (s_exe_wscript_cscript and (s_cmdline_script_file_extensions or s_cmdline_script_specific_abuse)) or (s_exe_mshta and s_cmdline_script_specific_abuse) or (s_exe_python and s_cmdline_script_file_extensions))"
    },
    "operational_usage": "SOC 팀은 이 규칙을 활용하여 cmd.exe, PowerShell, WScript, CScript, MSHTA, Python 등 다양한 명령 및 스크립트 인터프리터를 통한 악성 코드 실행 시도를 탐지할 수 있습니다. 특히 난독화된 명령줄 인자, 파일 다운로드 시도, 시스템 정보 수집 명령, 또는 스크립트 기반의 시스템 조작 패턴을 모니터링합니다. 탐지된 이벤트는 높은 심각도로 분류되어 즉각적인 알람을 트리거하고, 관련 프로세스 및 명령줄 인자에 대한 추가적인 포렌식 조사를 시작하는 데 사용될 수 있습니다. 이는 초기 접근, 실행, 방어 회피 및 지속성 전술에서 중요한 지표가 됩니다.",
    "false_positive": "정상적인 시스템 관리 스크립트, 소프트웨어 설치 프로그램, 개발 도구, 또는 합법적인 애플리케이션이 명령 및 스크립트 인터프리터를 사용하여 시스템 기능을 호출하는 경우 오탐이 발생할 수 있습니다. 특정 환경 변수, 사용자, 프로세스, 또는 명령줄 패턴을 화이트리스트에 추가하여 오탐을 줄일 수 있습니다."
}