{
    "id": "T1052.001-ExfiltrationOverUSB",
    "name": "Exfiltration over USB",
    "description": "Detects attempts by adversaries to exfiltrate data from a system by copying files to a USB-connected physical device. This includes monitoring for command-line utilities used for file transfer or direct filesystem write operations to removable media.",
    "severity": "high",
    "mitre_attack": {
        "tactic": "TA0010",
        "technique_id": "T1052",
        "subtechnique_id": "T1052.001",
        "data_sources": [
            "Enterprise:Exfiltration:Exfiltration Over Physical Medium:Exfiltration over USB",
            "Enterprise:Execution:Command and Scripting Interpreter:Windows Command Shell",
            "Enterprise:Collection:Data from Local System"
        ]
    },
    "platform": [
        "windows"
    ],
    "detection": {
        "selections": {
            "s1_process_create_action": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.action",
                        "operator": "equals",
                        "value": "create"
                    }
                ]
            },
            "s2_cmdline_copy_utility": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "copy "
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "xcopy "
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "robocopy "
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "powershell.exe -command \"Copy-Item"
                    }
                ]
            },
            "s3_cmdline_target_removable_drive": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": " D:\\"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": " E:\\"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": " F:\\"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": " G:\\"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": " H:\\"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": " I:\\"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": " J:\\"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": " K:\\"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": " L:\\"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": " M:\\"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": " N:\\"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": " O:\\"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": " P:\\"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": " Q:\\"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": " R:\\"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": " S:\\"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": " T:\\"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": " U:\\"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": " V:\\"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": " W:\\"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": " X:\\"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": " Y:\\"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": " Z:\\"
                    }
                ]
            },
            "s4_filesystem_write_action": {
                "event_type": "filesystem",
                "conditions": [
                    {
                        "field": "body.filesystem.action",
                        "operator": "equals",
                        "value": "write"
                    }
                ]
            },
            "s5_filesystem_removable_drive_path": {
                "event_type": "filesystem",
                "conditions": [
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "startswith",
                        "value": "D:\\"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "startswith",
                        "value": "E:\\"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "startswith",
                        "value": "F:\\"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "startswith",
                        "value": "G:\\"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "startswith",
                        "value": "H:\\"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "startswith",
                        "value": "I:\\"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "startswith",
                        "value": "J:\\"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "startswith",
                        "value": "K:\\"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "startswith",
                        "value": "L:\\"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "startswith",
                        "value": "M:\\"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "startswith",
                        "value": "N:\\"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "startswith",
                        "value": "O:\\"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "startswith",
                        "value": "P:\\"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "startswith",
                        "value": "Q:\\"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "startswith",
                        "value": "R:\\"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "startswith",
                        "value": "S:\\"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "startswith",
                        "value": "T:\\"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "startswith",
                        "value": "U:\\"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "startswith",
                        "value": "V:\\"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "startswith",
                        "value": "W:\\"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "startswith",
                        "value": "X:\\"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "startswith",
                        "value": "Y:\\"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "startswith",
                        "value": "Z:\\"
                    }
                ]
            }
        },
        "condition": "(s1_process_create_action and s2_cmdline_copy_utility and s3_cmdline_target_removable_drive) or (s4_filesystem_write_action and s5_filesystem_removable_drive_path)"
    },
    "operational_usage": "SOC 팀은 이 규칙을 활용하여 USB 장치를 통한 데이터 유출 시도를 탐지할 수 있습니다. 파일 복사 명령(copy, xcopy, robocopy, PowerShell Copy-Item)이 이동식 드라이브를 대상으로 실행되거나, 이동식 드라이브 경로에 직접 파일 쓰기 작업이 발생하는 이벤트를 모니터링합니다. 탐지된 이벤트는 높은 심각도로 분류되어 즉각적인 알람을 트리거하고, 데이터 유출의 잠재적 소스와 대상을 식별하기 위한 추가적인 포렌식 조사를 시작하는 데 사용될 수 있습니다.",
    "false_positive": "정상적인 사용자 또는 시스템 프로세스가 합법적으로 USB 드라이브에 파일을 복사하거나 쓰는 경우 오탐이 발생할 수 있습니다. 예를 들어, 개인 백업, 소프트웨어 설치 미디어 준비, 또는 특정 업무용 파일 전송 등이 이에 해당합니다. 알려진 정상적인 프로세스나 특정 파일 경로에 대해 화이트리스트를 적용하여 오탐을 줄일 수 있습니다."
}