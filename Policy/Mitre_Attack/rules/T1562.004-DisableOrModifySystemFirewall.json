{
    "id": "T1562.004-DisableOrModifySystemFirewall",
    "name": "Disable or Modify System Firewall",
    "description": "Detects attempts to disable or modify system firewalls using command-line utilities (e.g., netsh, PowerShell) or by directly manipulating firewall-related registry keys. This action can bypass network controls, enabling adversary command and control, lateral movement, or data exfiltration.",
    "severity": "high",
    "mitre_attack": {
        "tactic": "TA0005",
        "technique_id": "T1562",
        "subtechnique_id": "T1562.004",
        "data_sources": [
            "Firewall:FirewallRuleModification",
            "WindowsRegistry:WindowsRegistryKeyModification",
            "Command:CommandExecution",
            "Firewall:FirewallDisable"
        ]
    },
    "platform": [
        "windows"
    ],
    "detection": {
        "selections": {
            "process_create_action": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.action",
                        "operator": "equals",
                        "value": "create"
                    }
                ]
            },
            "netsh_exe_path": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.exe_path",
                        "operator": "endswith",
                        "value": "netsh.exe"
                    }
                ]
            },
            "netsh_advfirewall_cmd": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "advfirewall"
                    }
                ]
            },
            "netsh_modify_keywords": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "set"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "delete"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "add"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "disable"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "enable"
                    }
                ]
            },
            "netsh_target_keywords": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "rule"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "profile"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "firewall"
                    }
                ]
            },
            "powershell_exe_path": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.exe_path",
                        "operator": "endswith",
                        "value": "powershell.exe"
                    },
                    {
                        "field": "body.process.exe_path",
                        "operator": "endswith",
                        "value": "pwsh.exe"
                    }
                ]
            },
            "powershell_firewall_cmdlets": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "Set-NetFirewallProfile"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "Disable-NetFirewallRule"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "Enable-NetFirewallRule"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "Remove-NetFirewallRule"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "New-NetFirewallRule"
                    }
                ]
            },
            "registry_modification_action": {
                "event_type": "registry",
                "conditions": [
                    {
                        "field": "body.registry.keyclass",
                        "operator": "contains",
                        "value": "Set"
                    },
                    {
                        "field": "body.registry.keyclass",
                        "operator": "contains",
                        "value": "Delete"
                    },
                    {
                        "field": "body.registry.keyclass",
                        "operator": "contains",
                        "value": "Rename"
                    },
                    {
                        "field": "body.registry.keyclass",
                        "operator": "contains",
                        "value": "Create"
                    },
                    {
                        "field": "body.registry.keyclass",
                        "operator": "contains",
                        "value": "Open"
                    }
                ]
            },
            "registry_firewall_policy_path": {
                "event_type": "registry",
                "conditions": [
                    {
                        "field": "body.registry.name",
                        "operator": "startswith",
                        "value": "HKEY_LOCAL_MACHINE\\SOFTWARE\\Policies\\Microsoft\\WindowsFirewall"
                    }
                ]
            },
            "registry_sharedaccess_path": {
                "event_type": "registry",
                "conditions": [
                    {
                        "field": "body.registry.name",
                        "operator": "startswith",
                        "value": "HKEY_LOCAL_MACHINE\\SYSTEM\\CurrentControlSet\\Services\\SharedAccess\\Parameters\\FirewallPolicy"
                    }
                ]
            },
            "registry_bfe_service_path": {
                "event_type": "registry",
                "conditions": [
                    {
                        "field": "body.registry.name",
                        "operator": "startswith",
                        "value": "HKEY_LOCAL_MACHINE\\SYSTEM\\CurrentControlSet\\Services\\BFE"
                    }
                ]
            }
        },
        "condition": "(process_create_action and netsh_exe_path and netsh_advfirewall_cmd and netsh_modify_keywords and netsh_target_keywords) or (process_create_action and powershell_exe_path and powershell_firewall_cmdlets) or (registry_modification_action and (registry_firewall_policy_path or registry_sharedaccess_path or registry_bfe_service_path))"
    },
    "operational_usage": "SOC 팀은 이 규칙을 활용하여 시스템 방화벽 비활성화 또는 수정 시도를 탐지할 수 있습니다. 'netsh' 또는 PowerShell을 사용하여 방화벽 규칙을 추가, 삭제, 수정하거나 프로필을 변경하는 명령줄 실행을 모니터링합니다. 또한, 방화벽 관련 레지스트리 키(예: HKEY_LOCAL_MACHINE\\SYSTEM\\CurrentControlSet\\Services\\SharedAccess\\Parameters\\FirewallPolicy 또는 HKEY_LOCAL_MACHINE\\SOFTWARE\\Policies\\Microsoft\\WindowsFirewall)에 대한 쓰기 또는 삭제와 같은 변경 이벤트를 감지합니다. 탐지된 이벤트는 높은 심각도로 분류되어 즉각적인 알람을 트리거하고, 네트워크 연결, 프로세스 활동 및 추가적인 시스템 변경 사항에 대한 심층 조사를 시작하는 데 사용될 수 있습니다. 이는 공격자의 C2 통신 설정, 내부망 이동, 또는 데이터 유출 시도와 연관될 수 있으므로 침해사고 대응의 최우선 순위로 처리됩니다.",
    "false_positive": "정상적인 시스템 관리 작업, 소프트웨어 설치 또는 업데이트 프로세스, VPN 클라이언트 설치, 또는 합법적인 네트워크 구성 변경 도구가 방화벽 설정을 수정하는 경우 오탐이 발생할 수 있습니다. 이러한 경우, 특정 프로세스나 명령줄 인자를 화이트리스트에 추가하거나, 알려진 정상적인 레지스트리 변경 패턴을 제외하여 오탐을 줄일 수 있습니다."
}