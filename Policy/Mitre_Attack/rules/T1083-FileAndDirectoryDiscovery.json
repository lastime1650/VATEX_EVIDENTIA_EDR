{
    "id": "T1083-FileAndDirectoryDiscovery",
    "name": "File and Directory Discovery",
    "description": "Detects attempts to enumerate files and directories on a host or network share using command-line utilities (e.g., dir, tree, find, where, PowerShell cmdlets) or through Native API calls. This technique is often used by adversaries to gather information for follow-on actions.",
    "severity": "medium",
    "mitre_attack": {
        "tactic": "TA0007",
        "technique_id": "T1083",
        "subtechnique_id": "",
        "data_sources": [
            "Command:CommandExecution",
            "Process:ProcessCreation",
            "Process:OSAPIExecution",
            "WindowsRegistry:WindowsRegistryKeyAccess"
        ]
    },
    "platform": [
        "windows"
    ],
    "detection": {
        "selections": {
            "s1_process_create": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.action",
                        "operator": "equals",
                        "value": "create"
                    }
                ]
            },
            "s2_cmd_exe_path": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.exe_path",
                        "operator": "endswith",
                        "value": "cmd.exe"
                    }
                ]
            },
            "s3_powershell_exe_path": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.exe_path",
                        "operator": "endswith",
                        "value": "powershell.exe"
                    },
                    {
                        "field": "body.process.exe_path",
                        "operator": "endswith",
                        "value": "pwsh.exe"
                    }
                ]
            },
            "s4_cmd_file_discovery_commands": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "dir"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "tree"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "find"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "where"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "attrib"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "comp"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "fc"
                    }
                ]
            },
            "s5_powershell_file_discovery_cmdlets": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "Get-ChildItem"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "Get-Item"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "gci"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "ls"
                    }
                ]
            },
            "s6_apicall_findfile_functions": {
                "event_type": "apicall",
                "conditions": [
                    {
                        "field": "body.apicall.function",
                        "operator": "equals",
                        "value": "FindFirstFileW"
                    },
                    {
                        "field": "body.apicall.function",
                        "operator": "equals",
                        "value": "FindFirstFileA"
                    },
                    {
                        "field": "body.apicall.function",
                        "operator": "equals",
                        "value": "FindNextFileW"
                    },
                    {
                        "field": "body.apicall.function",
                        "operator": "equals",
                        "value": "FindNextFileA"
                    },
                    {
                        "field": "body.apicall.function",
                        "operator": "equals",
                        "value": "GetFileAttributesW"
                    },
                    {
                        "field": "body.apicall.function",
                        "operator": "equals",
                        "value": "GetFileAttributesA"
                    }
                ]
            },
            "s7_apicall_ntquery_functions": {
                "event_type": "apicall",
                "conditions": [
                    {
                        "field": "body.apicall.function",
                        "operator": "equals",
                        "value": "NtQueryDirectoryFile"
                    }
                ]
            },
            "s8_registry_query_enum_action": {
                "event_type": "registry",
                "conditions": [
                    {
                        "field": "body.registry.keyclass",
                        "operator": "contains",
                        "value": "QueryKey"
                    },
                    {
                        "field": "body.registry.keyclass",
                        "operator": "contains",
                        "value": "EnumerateKey"
                    },
                    {
                        "field": "body.registry.keyclass",
                        "operator": "contains",
                        "value": "OpenKey"
                    }
                ]
            },
            "s9_registry_known_paths": {
                "event_type": "registry",
                "conditions": [
                    {
                        "field": "body.registry.name",
                        "operator": "startswith",
                        "value": "HKEY_LOCAL_MACHINE\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Explorer\\Shell Folders"
                    },
                    {
                        "field": "body.registry.name",
                        "operator": "startswith",
                        "value": "HKEY_CURRENT_USER\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Explorer\\User Shell Folders"
                    },
                    {
                        "field": "body.registry.name",
                        "operator": "startswith",
                        "value": "HKEY_LOCAL_MACHINE\\SYSTEM\\CurrentControlSet\\Control\\Session Manager\\KnownDLLs"
                    },
                    {
                        "field": "body.registry.name",
                        "operator": "startswith",
                        "value": "HKEY_LOCAL_MACHINE\\SOFTWARE\\Microsoft\\Windows NT\\CurrentVersion\\Drivers32"
                    },
                    {
                        "field": "body.registry.name",
                        "operator": "contains",
                        "value": "Software\\Classes"
                    }
                ]
            }
        },
        "condition": "(s1_process_create and s2_cmd_exe_path and s4_cmd_file_discovery_commands) or (s1_process_create and s3_powershell_exe_path and s5_powershell_file_discovery_cmdlets) or (s6_apicall_findfile_functions or s7_apicall_ntquery_functions) or (s8_registry_query_enum_action and s9_registry_known_paths)"
    },
    "operational_usage": "SOC 팀은 이 규칙을 활용하여 시스템 내 파일 및 디렉터리 정보 수집 시도를 탐지할 수 있습니다. 'dir', 'tree', 'find', 'where'와 같은 명령 실행, PowerShell을 통한 파일 시스템 열거 시도, 파일 및 디렉터리 정보 조회 API 호출, 또는 시스템 파일 경로와 관련된 레지스트리 키 접근 등을 모니터링합니다. 탐지된 이벤트는 자동 알람을 트리거하고, 추가적인 조사 및 침해사고 대응의 우선순위를 지정하는 데 사용될 수 있습니다. 특히 다른 Discovery 또는 Collection 활동과 결합될 때 중요도가 높아집니다.",
    "false_positive": "정상적인 시스템 관리 도구, 백신 소프트웨어, 사용자 환경 설정 스크립트, 또는 합법적인 애플리케이션이 파일 시스템 정보를 조회하는 과정에서 탐지될 수 있습니다. 알려진 정상 프로세스나 특정 명령줄 패턴을 화이트리스트에 추가하여 오탐을 줄일 수 있습니다."
}