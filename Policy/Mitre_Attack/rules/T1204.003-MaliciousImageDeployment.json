{
    "id": "T1204.003-MaliciousImageDeployment",
    "name": "Malicious Image Deployment/Execution",
    "description": "Detects attempts to deploy or execute instances or containers from potentially malicious images. This includes monitoring command-line tools for container runtimes (e.g., Docker, Kubernetes) and virtualization platforms (e.g., Hyper-V, cloud CLIs) that create or run new instances/containers.",
    "severity": "high",
    "mitre_attack": {
        "tactic": "TA0002",
        "technique_id": "T1204",
        "subtechnique_id": "T1204.003",
        "data_sources": [
            "Enterprise:Execution:Command and Scripting Interpreter:Windows Command Shell",
            "Enterprise:Execution:Container Administration Command:Deploy Container",
            "Enterprise:Execution:System Services:Service Execution"
        ]
    },
    "platform": [
        "windows"
    ],
    "detection": {
        "selections": {
            "s1_process_create_action": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.action",
                        "operator": "equals",
                        "value": "create"
                    }
                ]
            },
            "s2_docker_cli_run_create": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "docker"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "run"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "create"
                    }
                ]
            },
            "s3_kubectl_cli_apply_create": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "kubectl"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "apply"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "create"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "deploy"
                    }
                ]
            },
            "s4_az_cli_vm_container_create": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "az.exe"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "vm create"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "container create"
                    }
                ]
            },
            "s5_aws_cli_ec2_run_instances": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "aws.exe"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "ec2 run-instances"
                    }
                ]
            },
            "s6_gcloud_cli_compute_instances_create": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "gcloud.exe"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "compute instances create"
                    }
                ]
            },
            "s7_hyperv_powershell_vm_creation": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.exe_path",
                        "operator": "endswith",
                        "value": "powershell.exe"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "New-VM"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "Import-VM"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "Start-VM"
                    }
                ]
            }
        },
        "condition": "s1_process_create_action and (s2_docker_cli_run_create or s3_kubectl_cli_apply_create or s4_az_cli_vm_container_create or s5_aws_cli_ec2_run_instances or s6_gcloud_cli_compute_instances_create or s7_hyperv_powershell_vm_creation)"
    },
    "operational_usage": "SOC 팀은 이 규칙을 활용하여 시스템에서 악성 이미지를 배포하거나 실행하려는 시도를 탐지할 수 있습니다. Docker, Kubernetes, Azure CLI, AWS CLI, GCP CLI, Hyper-V PowerShell cmdlet과 같은 컨테이너 및 가상화 관리 도구의 프로세스 생성 이벤트를 모니터링하여 새로운 인스턴스 또는 컨테이너 배포 명령을 식별합니다. 탐지된 이벤트는 잠재적인 악성 이미지 실행으로 분류되어 즉각적인 알람을 트리거하고, 관련된 프로세스 활동 및 네트워크 통신에 대한 추가적인 조사를 시작하는 데 사용될 수 있습니다. 특히, 알려지지 않은 이미지 소스나 비정상적인 배포 패턴과 결합될 때 중요도가 더욱 높아집니다.",
    "false_positive": "정상적인 개발 및 운영 활동, 시스템 관리 작업, 또는 합법적인 애플리케이션이 컨테이너나 가상 머신을 생성하고 관리하는 과정에서 오탐이 발생할 수 있습니다. 알려진 정상적인 배포 스크립트, 관리 도구의 명령줄 패턴, 또는 특정 사용자 계정에 대해 화이트리스트를 적용하여 오탐을 줄일 수 있습니다."
}