{
    "id": "T1648-ServerlessExecution",
    "name": "Serverless Execution",
    "description": "Detects attempts to abuse serverless computing, integration, and automation services to execute arbitrary code in cloud environments. This includes using CLI tools or scripts to create, update, or deploy malicious serverless functions, potentially leading to resource hijacking, privilege escalation, persistence, or data exfiltration within the cloud infrastructure.",
    "severity": "high",
    "mitre_attack": {
        "tactic": "TA0002",
        "technique_id": "T1648",
        "subtechnique_id": "",
        "data_sources": [
            "Command:CommandExecution",
            "Process:ProcessCreation"
        ]
    },
    "platform": [
        "windows"
    ],
    "detection": {
        "selections": {
            "s1_process_create_action": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.action",
                        "operator": "equals",
                        "value": "create"
                    }
                ]
            },
            "s2_aws_cli_path": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.exe_path",
                        "operator": "endswith",
                        "value": "aws.exe"
                    }
                ]
            },
            "s3_aws_lambda_cmd": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "lambda create-function"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "lambda update-function"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "lambda invoke"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "lambda delete-function"
                    }
                ]
            },
            "s4_az_cli_path": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.exe_path",
                        "operator": "endswith",
                        "value": "az.exe"
                    }
                ]
            },
            "s5_az_function_cmd": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "functionapp create"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "functionapp update"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "functionapp deploy"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "functionapp delete"
                    }
                ]
            },
            "s6_gcloud_cli_path": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.exe_path",
                        "operator": "endswith",
                        "value": "gcloud.exe"
                    }
                ]
            },
            "s7_gcloud_function_cmd": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "functions deploy"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "functions call"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "functions delete"
                    }
                ]
            },
            "s8_powershell_path": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.exe_path",
                        "operator": "endswith",
                        "value": "powershell.exe"
                    },
                    {
                        "field": "body.process.exe_path",
                        "operator": "endswith",
                        "value": "pwsh.exe"
                    }
                ]
            },
            "s9_powershell_aws_lambda_cmdlets": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "New-AWSPowerShellFunction"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "Update-AWSPowerShellFunction"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "Invoke-AWSPowerShellFunction"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "Remove-AWSPowerShellFunction"
                    }
                ]
            },
            "s10_powershell_az_function_cmdlets": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "New-AzFunctionApp"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "Set-AzFunctionApp"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "Publish-AzWebApp"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "Remove-AzFunctionApp"
                    }
                ]
            },
            "s11_powershell_gcloud_function_cmd": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "gcloud functions deploy"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "gcloud functions call"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "gcloud functions delete"
                    }
                ]
            }
        },
        "condition": "s1_process_create_action and ( (s2_aws_cli_path and s3_aws_lambda_cmd) or (s4_az_cli_path and s5_az_function_cmd) or (s6_gcloud_cli_path and s7_gcloud_function_cmd) or (s8_powershell_path and (s9_powershell_aws_lambda_cmdlets or s10_powershell_az_function_cmdlets or s11_powershell_gcloud_function_cmd)) )"
    },
    "operational_usage": "SOC 팀은 이 규칙을 활용하여 Windows 엔드포인트에서 클라우드 서버리스 기능(AWS Lambda, Azure Functions, GCP Cloud Functions 등)을 생성, 업데이트, 배포 또는 호출하려는 시도를 탐지할 수 있습니다. AWS CLI, Azure CLI, gcloud CLI, 또는 PowerShell을 사용한 관련 명령줄 실행을 모니터링합니다. 탐지된 이벤트는 높은 심각도로 분류되어 즉각적인 알람을 트리거하고, 관련된 프로세스 및 클라우드 환경에서의 추가적인 포렌식 조사를 시작하는 데 사용될 수 있습니다. 특히, 클라우드 환경 침해사고 대응 및 리소스 하이재킹, 권한 에스컬레이션, 데이터 탈취와 같은 공격 전술과 결합될 때 중요도가 더욱 높아집니다.",
    "false_positive": "정상적인 개발 및 배포 워크플로우, CI/CD 파이프라인, 클라우드 관리 도구, 또는 합법적인 자동화 스크립트가 서버리스 기능을 관리하는 과정에서 오탐이 발생할 수 있습니다. 알려진 정상적인 CLI 명령 패턴, 스크립트, 또는 특정 프로세스에 대해 화이트리스트를 적용하거나, 특정 사용자 계정의 활동을 제외하여 오탐을 줄일 수 있습니다."
}