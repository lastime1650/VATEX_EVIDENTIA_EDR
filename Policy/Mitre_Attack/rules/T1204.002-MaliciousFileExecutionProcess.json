{
    "id": "T1204.002-MaliciousFileExecutionProcess",
    "name": "User Execution: Malicious File (Process Creation)",
    "description": "Detects attempts by adversaries to gain execution by relying on a user opening a malicious file. This rule focuses on suspicious process creation events, including direct execution of malicious file types, document readers spawning suspicious child processes, and processes with highly suspicious command-line arguments. Common malicious file types include .exe, .scr, .hta, .js, .vbs, .bat, .cmd, .ps1, .lnk, .pif, .cpl, .msi, often delivered via social engineering.",
    "severity": "high",
    "mitre_attack": {
        "tactic": "TA0002",
        "technique_id": "T1204",
        "subtechnique_id": "T1204.002",
        "data_sources": [
            "Process:ProcessCreation"
        ]
    },
    "platform": [
        "windows"
    ],
    "detection": {
        "selections": {
            "s_process_create_action": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.action",
                        "operator": "equals",
                        "value": "create"
                    }
                ]
            },
            "s_malicious_file_extensions_exe_path": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.exe_path",
                        "operator": "endswith",
                        "value": "\\.exe"
                    },
                    {
                        "field": "body.process.exe_path",
                        "operator": "endswith",
                        "value": "\\.scr"
                    },
                    {
                        "field": "body.process.exe_path",
                        "operator": "endswith",
                        "value": "\\.hta"
                    },
                    {
                        "field": "body.process.exe_path",
                        "operator": "endswith",
                        "value": "\\.cpl"
                    },
                    {
                        "field": "body.process.exe_path",
                        "operator": "endswith",
                        "value": "\\.msi"
                    },
                    {
                        "field": "body.process.exe_path",
                        "operator": "endswith",
                        "value": "\\.js"
                    },
                    {
                        "field": "body.process.exe_path",
                        "operator": "endswith",
                        "value": "\\.jse"
                    },
                    {
                        "field": "body.process.exe_path",
                        "operator": "endswith",
                        "value": "\\.vbs"
                    },
                    {
                        "field": "body.process.exe_path",
                        "operator": "endswith",
                        "value": "\\.vbe"
                    },
                    {
                        "field": "body.process.exe_path",
                        "operator": "endswith",
                        "value": "\\.wsf"
                    },
                    {
                        "field": "body.process.exe_path",
                        "operator": "endswith",
                        "value": "\\.wsh"
                    },
                    {
                        "field": "body.process.exe_path",
                        "operator": "endswith",
                        "value": "\\.bat"
                    },
                    {
                        "field": "body.process.exe_path",
                        "operator": "endswith",
                        "value": "\\.cmd"
                    },
                    {
                        "field": "body.process.exe_path",
                        "operator": "endswith",
                        "value": "\\.ps1"
                    },
                    {
                        "field": "body.process.exe_path",
                        "operator": "endswith",
                        "value": "\\.lnk"
                    },
                    {
                        "field": "body.process.exe_path",
                        "operator": "endswith",
                        "value": "\\.pif"
                    }
                ]
            },
            "s_parent_doc_reader": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.parent_exe_path",
                        "operator": "endswith",
                        "value": "winword.exe"
                    },
                    {
                        "field": "body.process.parent_exe_path",
                        "operator": "endswith",
                        "value": "excel.exe"
                    },
                    {
                        "field": "body.process.parent_exe_path",
                        "operator": "endswith",
                        "value": "powerpnt.exe"
                    },
                    {
                        "field": "body.process.parent_exe_path",
                        "operator": "endswith",
                        "value": "acrord32.exe"
                    },
                    {
                        "field": "body.process.parent_exe_path",
                        "operator": "endswith",
                        "value": "outlook.exe"
                    }
                ]
            },
            "s_child_suspicious_executables": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.exe_path",
                        "operator": "endswith",
                        "value": "powershell.exe"
                    },
                    {
                        "field": "body.process.exe_path",
                        "operator": "endswith",
                        "value": "cmd.exe"
                    },
                    {
                        "field": "body.process.exe_path",
                        "operator": "endswith",
                        "value": "mshta.exe"
                    },
                    {
                        "field": "body.process.exe_path",
                        "operator": "endswith",
                        "value": "wscript.exe"
                    },
                    {
                        "field": "body.process.exe_path",
                        "operator": "endswith",
                        "value": "cscript.exe"
                    },
                    {
                        "field": "body.process.exe_path",
                        "operator": "endswith",
                        "value": "rundll32.exe"
                    },
                    {
                        "field": "body.process.exe_path",
                        "operator": "endswith",
                        "value": "regsvr32.exe"
                    }
                ]
            },
            "s_cmdline_suspicious_patterns": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "powershell -enc"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "powershell -e"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "mshta javascript:"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "cmd.exe /c"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "bitsadmin /transfer"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "certutil -urlcache -f"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "iex (new-object net.webclient).downloadstring"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "Invoke-Expression"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "regedit.exe /s"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "regsvr32.exe /s /i"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "rundll32.exe javascript:"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "for /l %x in"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "powershell -w hidden"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "powershell -nop -w hidden"
                    }
                ]
            }
        },
        "condition": "s_process_create_action and (s_malicious_file_extensions_exe_path or (s_parent_doc_reader and s_child_suspicious_executables) or s_cmdline_suspicious_patterns)"
    },
    "operational_usage": "SOC 팀은 이 규칙을 활용하여 사용자가 악성 파일을 실행하려는 시도를 탐지할 수 있습니다. 특히, 문서 파일이 비정상적인 자식 프로세스를 생성하거나, 직접적으로 의심스러운 확장자를 가진 파일이 실행될 때, 그리고 명령줄에 악성 활동과 관련된 패턴이 포함될 때를 모니터링합니다. 탐지된 이벤트는 높은 심각도로 분류되어 즉각적인 알람을 트리거하고, 추가적인 포렌식 조사를 시작하여 침해사고 대응의 우선순위를 지정하는 데 사용될 수 있습니다.",
    "false_positive": "정상적인 소프트웨어 설치 프로그램, 업데이트 스크립트, 또는 합법적인 애플리케이션이 유사한 명령줄 패턴을 사용하거나 특정 문서에서 스크립트를 실행하는 경우 오탐이 발생할 수 있습니다. 알려진 정상 프로세스, 부모 프로세스, 또는 특정 명령줄 패턴을 화이트리스트에 추가하여 오탐을 줄일 수 있습니다."
}