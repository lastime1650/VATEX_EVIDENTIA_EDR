{
    "id": "T1499-EndpointDenialOfService",
    "name": "Endpoint Denial of Service",
    "description": "Detects attempts by adversaries to degrade or block the availability of services on an endpoint by exhausting system resources or causing system instability/crashes. This includes executing commands or making API calls that lead to system shutdown, critical process termination, or critical registry/file modifications.",
    "severity": "high",
    "mitre_attack": {
        "tactic": "TA0040",
        "technique_id": "T1499",
        "subtechnique_id": "",
        "data_sources": [
            "Process:ProcessCreation",
            "Command:CommandExecution",
            "Process:OSAPIExecution",
            "WindowsRegistry:RegistryKeyModification",
            "File:FileDeletion"
        ]
    },
    "platform": [
        "windows"
    ],
    "detection": {
        "selections": {
            "s1_process_create_action": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.action",
                        "operator": "equals",
                        "value": "create"
                    }
                ]
            },
            "s2_shutdown_utility_path": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.exe_path",
                        "operator": "endswith",
                        "value": "shutdown.exe"
                    },
                    {
                        "field": "body.process.exe_path",
                        "operator": "endswith",
                        "value": "taskkill.exe"
                    }
                ]
            },
            "s3_shutdown_command_arguments": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": " /s"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": " /r"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": " -s"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": " -r"
                    }
                ]
            },
            "s4_taskkill_critical_process_arguments": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": " /f /im explorer.exe"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": " /f /im csrss.exe"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": " /f /im lsass.exe"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": " /f /im services.exe"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": " /f /im wininit.exe"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": " /f /im smss.exe"
                    }
                ]
            },
            "s5_apicall_system_impact": {
                "event_type": "apicall",
                "conditions": [
                    {
                        "field": "body.apicall.function",
                        "operator": "equals",
                        "value": "ExitWindowsEx"
                    },
                    {
                        "field": "body.apicall.function",
                        "operator": "equals",
                        "value": "NtShutdownSystem"
                    },
                    {
                        "field": "body.apicall.function",
                        "operator": "equals",
                        "value": "SetSystemPowerState"
                    }
                ]
            },
            "s6_registry_critical_modification_action": {
                "event_type": "registry",
                "conditions": [
                    {
                        "field": "body.registry.keyclass",
                        "operator": "equals",
                        "value": "RegNtSetValueKey"
                    },
                    {
                        "field": "body.registry.keyclass",
                        "operator": "equals",
                        "value": "RegNtDeleteKey"
                    },
                    {
                        "field": "body.registry.keyclass",
                        "operator": "equals",
                        "value": "RegNtPreDeleteKey"
                    },
                    {
                        "field": "body.registry.keyclass",
                        "operator": "equals",
                        "value": "RegNtPreSetValueKey"
                    }
                ]
            },
            "s7_registry_system_critical_paths": {
                "event_type": "registry",
                "conditions": [
                    {
                        "field": "body.registry.name",
                        "operator": "startswith",
                        "value": "HKEY_LOCAL_MACHINE\\SYSTEM\\CurrentControlSet\\Control\\CrashControl"
                    },
                    {
                        "field": "body.registry.name",
                        "operator": "startswith",
                        "value": "HKEY_LOCAL_MACHINE\\SYSTEM\\CurrentControlSet\\Services\\"
                    },
                    {
                        "field": "body.registry.name",
                        "operator": "startswith",
                        "value": "HKEY_LOCAL_MACHINE\\SOFTWARE\\Microsoft\\Windows NT\\CurrentVersion\\Winlogon"
                    },
                    {
                        "field": "body.registry.name",
                        "operator": "contains",
                        "value": "\\Start"
                    },
                    {
                        "field": "body.registry.name",
                        "operator": "contains",
                        "value": "\\ErrorControl"
                    },
                    {
                        "field": "body.registry.name",
                        "operator": "contains",
                        "value": "\\CriticalProcess"
                    }
                ]
            },
            "s8_filesystem_delete_action": {
                "event_type": "filesystem",
                "conditions": [
                    {
                        "field": "body.filesystem.action",
                        "operator": "equals",
                        "value": "remove"
                    }
                ]
            },
            "s9_filesystem_critical_system_files": {
                "event_type": "filesystem",
                "conditions": [
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "contains",
                        "value": "C:\\Windows\\System32\\kernel32.dll"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "contains",
                        "value": "C:\\Windows\\System32\\ntdll.dll"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "contains",
                        "value": "C:\\Windows\\System32\\hal.dll"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "contains",
                        "value": "C:\\Windows\\explorer.exe"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "contains",
                        "value": "C:\\Windows\\System32\\winlogon.exe"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "contains",
                        "value": "C:\\Windows\\System32\\smss.exe"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "contains",
                        "value": "C:\\Windows\\System32\\csrss.exe"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "contains",
                        "value": "C:\\Windows\\System32\\lsass.exe"
                    }
                ]
            }
        },
        "condition": "(s1_process_create_action and s2_shutdown_utility_path and s3_shutdown_command_arguments) or (s1_process_create_action and s2_shutdown_utility_path and s4_taskkill_critical_process_arguments) or s5_apicall_system_impact or (s6_registry_critical_modification_action and s7_registry_system_critical_paths) or (s8_filesystem_delete_action and s9_filesystem_critical_system_files)"
    },
    "operational_usage": "SOC 팀은 이 규칙을 활용하여 엔드포인트 서비스 가용성을 저해하려는 시도를 탐지할 수 있습니다. 시스템 종료/재부팅 명령 실행, explorer.exe, lsass.exe 등과 같은 중요 프로세스 강제 종료 시도, 시스템 종료 관련 API 호출, 또는 시스템 부팅 및 서비스 설정과 관련된 중요 레지스트리 키 변경, 그리고 핵심 시스템 파일 삭제 시도를 모니터링합니다. 탐지된 이벤트는 높은 심각도로 분류되어 즉각적인 알람을 트리거하고, 해당 프로세스 및 관련 활동에 대한 심층적인 포렌식 조사를 시작하는 데 사용됩니다. 이는 서비스 가용성 침해에 대한 신속한 대응을 가능하게 합니다.",
    "false_positive": "정상적인 시스템 관리 작업, 소프트웨어 설치/제거, 업데이트 프로세스, 또는 합법적인 진단 도구가 시스템 재부팅, 서비스 조정, 또는 파일 시스템 변경을 수행하는 과정에서 오탐이 발생할 수 있습니다. 알려진 정상적인 프로세스나 특정 명령줄 패턴을 화이트리스트에 추가하여 오탐을 줄일 수 있습니다."
}