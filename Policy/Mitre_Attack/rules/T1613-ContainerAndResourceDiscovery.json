{
    "id": "T1613-ContainerAndResourceDiscovery",
    "name": "Container and Resource Discovery",
    "description": "Adversaries may attempt to discover containers, images, deployments, pods, nodes, and other resources within a container environment. This rule detects common command-line utilities used for this purpose, such as 'docker' and 'kubectl', when invoked with discovery-related subcommands, as well as PowerShell commands for container enumeration.",
    "severity": "high",
    "mitre_attack": {
        "tactic": "TA0007",
        "technique_id": "T1613",
        "subtechnique_id": "",
        "data_sources": [
            "Process:ProcessCreation",
            "Enterprise:Execution:Command and Scripting Interpreter:Windows Command Shell",
            "Enterprise:Execution:Command and Scripting Interpreter:PowerShell",
            "Enterprise:Execution:Command and Scripting Interpreter:Unix Shell"
        ]
    },
    "platform": [
        "windows"
    ],
    "detection": {
        "selections": {
            "docker_process_creation": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.action",
                        "operator": "equals",
                        "value": "create"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "docker"
                    }
                ]
            },
            "docker_discovery_subcommand": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": " ps"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": " images"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": " info"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": " inspect"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": " network ls"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": " volume ls"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": " container ls"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": " system info"
                    }
                ]
            },
            "kubectl_process_creation": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.action",
                        "operator": "equals",
                        "value": "create"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "kubectl"
                    }
                ]
            },
            "kubectl_discovery_subcommand": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": " get pods"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": " get nodes"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": " describe"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": " cluster-info"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": " get deployments"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": " get services"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": " get namespaces"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": " get componentstatuses"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": " get events"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": " config view"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": " api-resources"
                    }
                ]
            },
            "powershell_execution": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.action",
                        "operator": "equals",
                        "value": "create"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "powershell.exe"
                    }
                ]
            },
            "powershell_container_discovery_subcommand": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "Get-Container"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "Get-VM"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "Get-Service -Name docker"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "Invoke-WebRequest -Uri http://localhost:2375/info"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "kubectl "
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "docker "
                    }
                ]
            }
        },
        "condition": "(docker_process_creation and docker_discovery_subcommand) or (kubectl_process_creation and kubectl_discovery_subcommand) or (powershell_execution and powershell_container_discovery_subcommand)"
    },
    "operational_usage": "SOC 팀은 이 규칙을 활용하여 컨테이너 환경 내에서 잠재적인 위협 행위자가 컨테이너, 이미지, 파드, 노드 등 리소스 정보를 수집하려는 시도를 탐지할 수 있습니다. 'docker' 또는 'kubectl'과 같은 CLI 도구의 실행과 함께 특정 탐색 명령어가 사용되는 경우를 모니터링하며, PowerShell을 통한 컨테이너 정보 조회 시도도 포함합니다. 탐지된 이벤트는 자동 알람을 트리거하고, 추가적인 조사 및 침해사고 대응의 우선순위를 지정하는 데 사용될 수 있습니다. 특히 다른 Discovery 또는 Lateral Movement 활동과 결합될 때 중요도가 높아집니다.",
    "false_positive": "정상적인 컨테이너 관리 작업, 개발 환경 설정 스크립트, CI/CD 파이프라인, 또는 모니터링 도구가 컨테이너 및 리소스 정보를 조회하는 과정에서 탐지될 수 있습니다. 알려진 정상 프로세스나 특정 명령줄 패턴을 화이트리스트에 추가하거나, 특정 사용자 계정에 대한 예외 처리를 통해 오탐을 줄일 수 있습니다."
}