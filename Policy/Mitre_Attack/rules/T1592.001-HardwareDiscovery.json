{
    "id": "T1592.001-HardwareDiscovery",
    "name": "Hardware Discovery",
    "description": "Detects attempts to gather information about the victim's host hardware using built-in utilities (e.g., systeminfo, wmic, dxdiag, msinfo32), PowerShell cmdlets, or by accessing specific registry keys and API calls related to hardware components. This reconnaissance activity helps adversaries understand the target environment for further exploitation.",
    "severity": "medium",
    "mitre_attack": {
        "tactic": "TA0007",
        "technique_id": "T1592",
        "subtechnique_id": "T1592.001",
        "data_sources": [
            "Enterprise:Reconnaissance:Gather Victim Host Information:Hardware",
            "Enterprise:Execution:Command and Scripting Interpreter:Windows Command Shell",
            "Enterprise:Execution:Native API",
            "Enterprise:Discovery:Query Registry"
        ]
    },
    "platform": [
        "windows"
    ],
    "detection": {
        "selections": {
            "s1_process_create": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.action",
                        "operator": "equals",
                        "value": "create"
                    }
                ]
            },
            "s2_cmd_systeminfo": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "systeminfo"
                    }
                ]
            },
            "s3_cmd_wmic_base": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "wmic"
                    }
                ]
            },
            "s4_cmd_wmic_hardware_targets": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "csproduct"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "baseboard"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "cpu"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "memorychip"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "diskdrive"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "nic"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "bios"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "physicalmedia"
                    }
                ]
            },
            "s5_exe_dxdiag_msinfo32": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.exe_path",
                        "operator": "endswith",
                        "value": "dxdiag.exe"
                    },
                    {
                        "field": "body.process.exe_path",
                        "operator": "endswith",
                        "value": "msinfo32.exe"
                    }
                ]
            },
            "s6_powershell_exe_path": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.exe_path",
                        "operator": "endswith",
                        "value": "powershell.exe"
                    }
                ]
            },
            "s7_powershell_hardware_cmdlets": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "Get-WmiObject -Class Win32_ComputerSystem"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "Get-CimInstance -ClassName Win32_ComputerSystem"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "Get-PnpDevice"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "Get-PhysicalDisk"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "Get-NetAdapter"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "Get-WmiObject -Class Win32_Processor"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "Get-WmiObject -Class Win32_BIOS"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "Get-WmiObject -Class Win32_BaseBoard"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "Get-WmiObject -Class Win32_PhysicalMemory"
                    }
                ]
            },
            "s8_registry_access_action": {
                "event_type": "registry",
                "conditions": [
                    {
                        "field": "body.registry.keyclass",
                        "operator": "contains",
                        "value": "Query"
                    },
                    {
                        "field": "body.registry.keyclass",
                        "operator": "contains",
                        "value": "OpenKey"
                    },
                    {
                        "field": "body.registry.keyclass",
                        "operator": "contains",
                        "value": "Enumerate"
                    }
                ]
            },
            "s9_registry_hardware_paths": {
                "event_type": "registry",
                "conditions": [
                    {
                        "field": "body.registry.name",
                        "operator": "startswith",
                        "value": "HKEY_LOCAL_MACHINE\\\\HARDWARE"
                    },
                    {
                        "field": "body.registry.name",
                        "operator": "startswith",
                        "value": "HKEY_LOCAL_MACHINE\\\\SYSTEM\\\\CurrentControlSet\\\\Control\\\\Class"
                    },
                    {
                        "field": "body.registry.name",
                        "operator": "startswith",
                        "value": "HKEY_LOCAL_MACHINE\\\\SYSTEM\\\\CurrentControlSet\\\\Services"
                    },
                    {
                        "field": "body.registry.name",
                        "operator": "startswith",
                        "value": "HKEY_LOCAL_MACHINE\\\\SOFTWARE\\\\Microsoft\\\\Windows\\\\CurrentVersion\\\\Component Based Servicing"
                    },
                    {
                        "field": "body.registry.name",
                        "operator": "startswith",
                        "value": "HKEY_LOCAL_MACHINE\\\\SOFTWARE\\\\Microsoft\\\\Windows\\\\CurrentVersion\\\\Setup\\\\Pnp"
                    }
                ]
            },
            "s10_apicall_hardware_discovery_functions": {
                "event_type": "apicall",
                "conditions": [
                    {
                        "field": "body.apicall.function",
                        "operator": "equals",
                        "value": "GetSystemInfo"
                    },
                    {
                        "field": "body.apicall.function",
                        "operator": "equals",
                        "value": "GetNativeSystemInfo"
                    },
                    {
                        "field": "body.apicall.function",
                        "operator": "equals",
                        "value": "EnumSystemFirmwareTables"
                    },
                    {
                        "field": "body.apicall.function",
                        "operator": "equals",
                        "value": "SetupDiEnumDeviceInfo"
                    },
                    {
                        "field": "body.apicall.function",
                        "operator": "equals",
                        "value": "CM_Get_DevNode_Property"
                    },
                    {
                        "field": "body.apicall.function",
                        "operator": "equals",
                        "value": "GetDiskFreeSpaceExW"
                    },
                    {
                        "field": "body.apicall.function",
                        "operator": "equals",
                        "value": "GetLogicalDrives"
                    },
                    {
                        "field": "body.apicall.function",
                        "operator": "equals",
                        "value": "GetAdaptersInfo"
                    },
                    {
                        "field": "body.apicall.function",
                        "operator": "equals",
                        "value": "GetAdaptersAddresses"
                    }
                ]
            }
        },
        "condition": "(s1_process_create and s2_cmd_systeminfo) or (s1_process_create and s3_cmd_wmic_base and s4_cmd_wmic_hardware_targets) or (s1_process_create and s5_exe_dxdiag_msinfo32) or (s1_process_create and s6_powershell_exe_path and s7_powershell_hardware_cmdlets) or (s8_registry_access_action and s9_registry_hardware_paths) or s10_apicall_hardware_discovery_functions"
    },
    "operational_usage": "SOC 팀은 이 규칙을 통해 시스템 하드웨어 정보 수집 시도를 탐지할 수 있습니다. 'systeminfo', 'wmic'와 같은 명령 실행, 'dxdiag.exe', 'msinfo32.exe' 실행, PowerShell을 통한 하드웨어 관련 정보 조회, 또는 하드웨어 관련 레지스트리 키 접근 및 특정 API 호출 등을 모니터링합니다. 탐지된 이벤트는 정찰(Reconnaissance) 활동으로 분류되며, 자동 알람을 트리거하고 추가적인 조사 및 침해사고 대응의 우선순위를 지정하는 데 활용될 수 있습니다. 특히 다른 정찰 또는 초기 접근 활동과 결합될 때 중요도가 높아집니다.",
    "false_positive": "정상적인 시스템 관리 도구, 진단 유틸리티, 백신 소프트웨어, 하드웨어 드라이버 설치/업데이트 프로그램, 또는 합법적인 애플리케이션이 시스템 하드웨어 정보를 조회하는 과정에서 오탐이 발생할 수 있습니다. 알려진 정상 프로세스나 특정 명령줄 패턴을 화이트리스트에 추가하여 오탐을 줄일 수 있습니다."
}