{
    "id": "T1665-HideInfrastructure",
    "name": "Hide Infrastructure",
    "description": "Detects attempts by adversaries to manipulate network traffic to hide and evade detection of their Command and Control (C2) infrastructure. This includes the use of proxies, VPNs, or direct modification of system network/proxy settings to obscure the true destination of malicious communications.",
    "severity": "high",
    "mitre_attack": {
        "tactic": "TA0011",
        "technique_id": "T1665",
        "subtechnique_id": "",
        "data_sources": [
            "Process:ProcessCreation",
            "Network:NetworkConnection",
            "WindowsRegistry:WindowsRegistryKeyModification",
            "Process:OSAPIExecution"
        ]
    },
    "platform": [
        "windows",
        "linux",
        "macos"
    ],
    "detection": {
        "selections": {
            "s1_process_create_action": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.action",
                        "operator": "equals",
                        "value": "create"
                    }
                ]
            },
            "s2_netsh_exe_path": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.exe_path",
                        "operator": "endswith",
                        "value": "netsh.exe"
                    }
                ]
            },
            "s3_netsh_winhttp_context": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "winhttp"
                    }
                ]
            },
            "s4_netsh_proxy_command": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "proxy"
                    }
                ]
            },
            "s5_netsh_set_command": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "set"
                    }
                ]
            },
            "s6_vpn_tool_exe_path": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.exe_path",
                        "operator": "contains",
                        "value": "openvpn.exe"
                    },
                    {
                        "field": "body.process.exe_path",
                        "operator": "contains",
                        "value": "wireguard.exe"
                    },
                    {
                        "field": "body.process.exe_path",
                        "operator": "contains",
                        "value": "sstpclient.exe"
                    },
                    {
                        "field": "body.process.exe_path",
                        "operator": "contains",
                        "value": "l2tpd.exe"
                    },
                    {
                        "field": "body.process.exe_path",
                        "operator": "contains",
                        "value": "pptp.exe"
                    }
                ]
            },
            "s7_registry_proxy_modify_action": {
                "event_type": "registry",
                "conditions": [
                    {
                        "field": "body.registry.keyclass",
                        "operator": "contains",
                        "value": "SetValueKey"
                    },
                    {
                        "field": "body.registry.keyclass",
                        "operator": "contains",
                        "value": "CreateKey"
                    }
                ]
            },
            "s8_registry_internet_settings_path": {
                "event_type": "registry",
                "conditions": [
                    {
                        "field": "body.registry.name",
                        "operator": "contains",
                        "value": "HKEY_CURRENT_USER\\Software\\Microsoft\\Windows\\CurrentVersion\\Internet Settings\\ProxyEnable"
                    },
                    {
                        "field": "body.registry.name",
                        "operator": "contains",
                        "value": "HKEY_CURRENT_USER\\Software\\Microsoft\\Windows\\CurrentVersion\\Internet Settings\\ProxyServer"
                    },
                    {
                        "field": "body.registry.name",
                        "operator": "contains",
                        "value": "HKEY_LOCAL_MACHINE\\SOFTWARE\\Policies\\Microsoft\\Windows\\CurrentVersion\\Internet Settings\\ProxySettingsPerUser"
                    }
                ]
            },
            "s9_network_common_proxy_port_dest": {
                "event_type": "network",
                "conditions": [
                    {
                        "field": "body.network.destinationport",
                        "operator": "equals",
                        "value": 8080
                    },
                    {
                        "field": "body.network.destinationport",
                        "operator": "equals",
                        "value": 3128
                    },
                    {
                        "field": "body.network.destinationport",
                        "operator": "equals",
                        "value": 8888
                    },
                    {
                        "field": "body.network.destinationport",
                        "operator": "equals",
                        "value": 1080
                    },
                    {
                        "field": "body.network.destinationport",
                        "operator": "equals",
                        "value": 443
                    }
                ]
            },
            "s10_network_common_proxy_port_src": {
                "event_type": "network",
                "conditions": [
                    {
                        "field": "body.network.sourceport",
                        "operator": "equals",
                        "value": 8080
                    },
                    {
                        "field": "body.network.sourceport",
                        "operator": "equals",
                        "value": 3128
                    },
                    {
                        "field": "body.network.sourceport",
                        "operator": "equals",
                        "value": 8888
                    },
                    {
                        "field": "body.network.sourceport",
                        "operator": "equals",
                        "value": 1080
                    },
                    {
                        "field": "body.network.sourceport",
                        "operator": "equals",
                        "value": 443
                    }
                ]
            },
            "s11_network_protocol_tcp": {
                "event_type": "network",
                "conditions": [
                    {
                        "field": "body.network.protocol",
                        "operator": "equals",
                        "value": "TCP"
                    }
                ]
            },
            "s12_apicall_proxy_set_function": {
                "event_type": "apicall",
                "conditions": [
                    {
                        "field": "body.apicall.function",
                        "operator": "equals",
                        "value": "WinHttpSetDefaultProxy"
                    },
                    {
                        "field": "body.apicall.function",
                        "operator": "equals",
                        "value": "WinHttpSetProxy"
                    },
                    {
                        "field": "body.apicall.function",
                        "operator": "equals",
                        "value": "InternetSetOption"
                    },
                    {
                        "field": "body.apicall.function",
                        "operator": "equals",
                        "value": "SetProxyInfo"
                    }
                ]
            }
        },
        "condition": "(s1_process_create_action and s2_netsh_exe_path and s3_netsh_winhttp_context and s4_netsh_proxy_command and s5_netsh_set_command) or (s1_process_create_action and s6_vpn_tool_exe_path) or (s7_registry_proxy_modify_action and s8_registry_internet_settings_path) or ((s9_network_common_proxy_port_dest or s10_network_common_proxy_port_src) and s11_network_protocol_tcp) or s12_apicall_proxy_set_function"
    },
    "operational_usage": "SOC 팀은 이 규칙을 활용하여 공격자가 C2 통신을 숨기기 위해 인프라를 위장하는 시도를 탐지할 수 있습니다. 'netsh' 명령을 이용한 시스템 프록시 설정 변경, OpenVPN/WireGuard와 같은 VPN 클라이언트 실행, 인터넷 설정 레지스트리 키 수정, 또는 프록시 설정 관련 API 호출 등을 모니터링합니다. 탐지된 이벤트는 높은 심각도로 분류되어 즉각적인 알람을 트리거하고, 관련 프로세스 및 네트워크 연결에 대한 추가적인 포렌식 조사를 시작하는 데 사용될 수 있습니다. 특히, 다른 C2 또는 방어 회피 전술과 결합될 때 중요도가 더욱 높아집니다.",
    "false_positive": "정상적인 시스템 관리 도구, 합법적인 VPN 소프트웨어, 기업 네트워크 정책에 따른 프록시 설정 변경, 또는 개발/테스트 환경에서 프록시를 사용하는 경우 오탐이 발생할 수 있습니다. 알려진 정상적인 프로세스나 특정 네트워크 연결 패턴을 화이트리스트에 추가하여 오탐을 줄일 수 있습니다."
}