{
    "id": "T1110.004-CredentialStuffing",
    "name": "Credential Stuffing",
    "description": "Adversaries may use credentials obtained from breach dumps of unrelated accounts to gain access to target accounts through credential overlap. This technique involves attempting to log into various services (SSH, Telnet, FTP, SMB, LDAP, Kerberos, RDP, HTTP/S, MSSQL, Oracle, MySQL, VNC) using leaked username and password pairs. While risky due to potential account lockouts, it exploits common user behavior of reusing passwords.",
    "severity": "high",
    "mitre_attack": {
        "tactic": "TA0006",
        "technique_id": "T1110",
        "subtechnique_id": "T1110.004",
        "data_sources": [
            "Network:NetworkConnection",
            "Process:ProcessCreation"
        ]
    },
    "platform": [
        "windows",
        "saas",
        "iaas",
        "linux",
        "macos",
        "containers",
        "network devices",
        "office suite",
        "identity provider",
        "esxi"
    ],
    "detection": {
        "selections": {
            "s1_common_auth_ports_network_connection": {
                "event_type": "network",
                "conditions": [
                    {
                        "field": "body.network.destinationport",
                        "operator": "equals",
                        "value": 22
                    },
                    {
                        "field": "body.network.destinationport",
                        "operator": "equals",
                        "value": 23
                    },
                    {
