{
    "id": "T1599-NetworkBoundaryBridging",
    "name": "Network Boundary Bridging",
    "description": "Detects attempts by a compromised host to manipulate network configurations or establish unusual connections to network device management ports, potentially bypassing network segmentation. This includes execution of command-line utilities (netsh, route) and PowerShell cmdlets to modify network settings, or outbound connections to common network device management ports.",
    "severity": "high",
    "mitre_attack": {
        "tactic": "TA0005",
        "technique_id": "T1599",
        "subtechnique_id": "",
        "data_sources": [
            "Enterprise:Execution:Command and Scripting Interpreter:Windows Command Shell",
            "Enterprise:Execution:Command and Scripting Interpreter:PowerShell",
            "Enterprise:Command and Control:Application Layer Protocol:Web Protocols",
            "Enterprise:Command and Control:Application Layer Protocol:File Transfer Protocols"
        ]
    },
    "platform": [
        "windows"
    ],
    "detection": {
        "selections": {
            "s1_process_create_action": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.action",
                        "operator": "equals",
                        "value": "create"
                    }
                ]
            },
            "s2_netsh_exe_path": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.exe_path",
                        "operator": "endswith",
                        "value": "netsh.exe"
                    }
                ]
            },
            "s3_netsh_network_keywords": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "firewall"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "advfirewall"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "interface"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "route"
                    }
                ]
            },
            "s4_netsh_modification_actions": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "set"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "add"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "delete"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "reset"
                    }
                ]
            },
            "s5_route_exe_path": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.exe_path",
                        "operator": "endswith",
                        "value": "route.exe"
                    }
                ]
            },
            "s6_route_modification_actions": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "add"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "change"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "delete"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "-p"
                    }
                ]
            },
            "s7_powershell_exe_path": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.exe_path",
                        "operator": "contains",
                        "value": "powershell.exe"
                    }
                ]
            },
            "s8_powershell_net_cmdlets": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "Set-NetFirewallRule"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "New-NetRoute"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "Set-NetIPInterface"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "Set-NetAdapter"
                    }
                ]
            },
            "s9_outbound_network_event": {
                "event_type": "network",
                "conditions": [
                    {
                        "field": "body.network.direction",
                        "operator": "equals",
                        "value": "out"
                    }
                ]
            },
            "s10_network_mgmt_ports": {
                "event_type": "network",
                "conditions": [
                    {
                        "field": "body.network.destinationport",
                        "operator": "equals",
                        "value": 22
                    },
                    {
                        "field": "body.network.destinationport",
                        "operator": "equals",
                        "value": 23
                    },
                    {
                        "field": "body.network.destinationport",
                        "operator": "equals",
                        "value": 80
                    },
                    {
                        "field": "body.network.destinationport",
                        "operator": "equals",
                        "value": 443
                    },
                    {
                        "field": "body.network.destinationport",
                        "operator": "equals",
                        "value": 161
                    },
                    {
                        "field": "body.network.destinationport",
                        "operator": "equals",
                        "value": 162
                    }
                ]
            }
        },
        "condition": "(s1_process_create_action and s2_netsh_exe_path and s3_netsh_network_keywords and s4_netsh_modification_actions) or (s1_process_create_action and s5_route_exe_path and s6_route_modification_actions) or (s1_process_create_action and s7_powershell_exe_path and s8_powershell_net_cmdlets) or (s9_outbound_network_event and s10_network_mgmt_ports)"
    },
    "operational_usage": "SOC 팀은 이 규칙을 활용하여 시스템에서 네트워크 경계 브리징 시도를 탐지할 수 있습니다. 'netsh', 'route'와 같은 명령줄 유틸리티나 PowerShell 네트워크 cmdlet을 사용하여 방화벽 규칙, 라우팅 테이블, 또는 네트워크 인터페이스를 수정하는 프로세스 생성 이벤트를 모니터링합니다. 또한, 비정상적인 프로세스에서 네트워크 장치 관리 포트(SSH, Telnet, HTTP/HTTPS, SNMP)로의 아웃바운드 연결 시도를 탐지합니다. 탐지된 이벤트는 높은 심각도로 분류되어 즉각적인 알람을 트리거하고, 해당 프로세스 및 관련 네트워크 활동에 대한 심층 조사를 시작하는 데 사용될 수 있습니다. 이는 방어 회피 및 명령 및 제어 전술과 연계될 때 특히 중요합니다.",
    "false_positive": "정상적인 시스템 관리 작업, 네트워크 설정 변경 유틸리티, VPN 소프트웨어, 또는 합법적인 애플리케이션이 네트워크 설정을 수정하거나 관리 포트에 연결하는 과정에서 오탐이 발생할 수 있습니다. 특히, 웹 브라우저가 HTTP/HTTPS 포트 80/443에 연결하는 경우 광범위한 오탐이 발생할 수 있으므로, 특정 프로세스나 IP 주소 대역에 대한 화이트리스트 적용이 필요합니다. 또한, SNMP 모니터링 도구와 같은 네트워크 관리 소프트웨어도 오탐을 유발할 수 있습니다."
}