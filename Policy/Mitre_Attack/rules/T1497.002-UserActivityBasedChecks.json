{
    "id": "T1497.002-UserActivityBasedChecks",
    "name": "User Activity Based Checks for Evasion",
    "description": "Detects attempts by adversaries to check for user activity on a system to evade virtualization or analysis environments. This includes monitoring for commands that query user sessions, PowerShell scripts attempting to retrieve last input information, direct API calls for mouse/keyboard activity, or access to browser history files, indicating an attempt to determine if a real user is interacting with the system.",
    "severity": "high",
    "mitre_attack": {
        "tactic": "TA0005",
        "technique_id": "T1497",
        "subtechnique_id": "T1497.002",
        "data_sources": [
            "Enterprise:Execution:Command and Scripting Interpreter:Windows Command Shell",
            "Enterprise:Execution:Native API",
            "Enterprise:Discovery:File and Directory Discovery"
        ]
    },
    "platform": [
        "windows"
    ],
    "detection": {
        "selections": {
            "s1_process_action_create": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.action",
                        "operator": "equals",
                        "value": "create"
                    }
                ]
            },
            "s2_cmdline_whoami": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "whoami.exe"
                    }
                ]
            },
            "s3_cmdline_query_user": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "query user"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "quser"
                    }
                ]
            },
            "s4_powershell_exe": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.exe_path",
                        "operator": "endswith",
                        "value": "powershell.exe"
                    }
                ]
            },
            "s5_powershell_get_lastinputinfo": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "Get-LastInputInfo"
                    }
                ]
            },
            "s6_filesystem_action_read_open_exists": {
                "event_type": "filesystem",
                "conditions": [
                    {
                        "field": "body.filesystem.action",
                        "operator": "equals",
                        "value": "read"
                    },
                    {
                        "field": "body.filesystem.action",
                        "operator": "equals",
                        "value": "open"
                    },
                    {
                        "field": "body.filesystem.action",
                        "operator": "equals",
                        "value": "exists"
                    }
                ]
            },
            "s7_filepath_browser_history_chrome_edge": {
                "event_type": "filesystem",
                "conditions": [
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "contains",
                        "value": "AppData\\Local\\Google\\Chrome\\User Data\\Default\\History"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "contains",
                        "value": "AppData\\Local\\Microsoft\\Edge\\User Data\\Default\\History"
                    }
                ]
            },
            "s8_filepath_browser_history_firefox": {
                "event_type": "filesystem",
                "conditions": [
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "contains",
                        "value": "AppData\\Roaming\\Mozilla\\Firefox\\Profiles\\"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "endswith",
                        "value": "places.sqlite"
                    }
                ]
            },
            "s9_apicall_getlastinputinfo": {
                "event_type": "apicall",
                "conditions": [
                    {
                        "field": "body.apicall.function",
                        "operator": "equals",
                        "value": "GetLastInputInfo"
                    }
                ]
            },
            "s10_apicall_getcursorpos": {
                "event_type": "apicall",
                "conditions": [
                    {
                        "field": "body.apicall.function",
                        "operator": "equals",
                        "value": "GetCursorPos"
                    }
                ]
            },
            "s11_apicall_enumwindows": {
                "event_type": "apicall",
                "conditions": [
                    {
                        "field": "body.apicall.function",
                        "operator": "equals",
                        "value": "EnumWindows"
                    }
                ]
            }
        },
        "condition": "(s1_process_action_create and (s2_cmdline_whoami or s3_cmdline_query_user or (s4_powershell_exe and s5_powershell_get_lastinputinfo))) or (s6_filesystem_action_read_open_exists and (s7_filepath_browser_history_chrome_edge or s8_filepath_browser_history_firefox)) or (s9_apicall_getlastinputinfo or s10_apicall_getcursorpos or s11_apicall_enumwindows)"
    },
    "operational_usage": "SOC 팀은 이 규칙을 활용하여 가상화/샌드박스 환경 회피를 위한 사용자 활동 확인 시도를 탐지할 수 있습니다. 시스템 사용자 세션 조회 명령(whoami, query user), PowerShell을 통한 마지막 입력 정보 획득 시도, 마우스/키보드 활동 관련 API 호출, 또는 브라우저 히스토리 파일 접근 등을 모니터링합니다. 탐지된 이벤트는 높은 심각도로 분류되어 즉각적인 알람을 트리거하고, 해당 프로세스의 행동 및 출처에 대한 추가적인 포렌식 조사를 시작하는 데 사용될 수 있습니다. 특히, 다른 방어 회피 전술과 결합될 때 중요도가 더욱 높아집니다.",
    "false_positive": "정상적인 시스템 관리 도구, 사용자 환경 설정 스크립트, 웹 브라우저 관련 유틸리티, 또는 합법적인 애플리케이션이 시스템 사용자 활동 정보를 조회하는 과정에서 오탐이 발생할 수 있습니다. 알려진 정상 프로세스나 특정 명령줄 패턴을 화이트리스트에 추가하여 오탐을 줄일 수 있습니다."
}