{
    "id": "T1556.001-DomainControllerAuthentication",
    "name": "Domain Controller Authentication Patching (Skeleton Key)",
    "description": "Detects attempts to patch the authentication process on a domain controller, typically targeting LSASS, to bypass normal authentication mechanisms. This often involves gaining broad access to the LSASS process memory or modifying critical authentication-related DLLs like cryptdll.dll or samsrv.dll. This technique is famously associated with malware like Skeleton Key.",
    "severity": "high",
    "mitre_attack": {
        "tactic": "TA0006,TA0005,TA0003",
        "technique_id": "T1556",
        "subtechnique_id": "T1556.001",
        "data_sources": [
            "Enterprise:Privilege Escalation:Process Injection",
            "Enterprise:Defense Evasion:File and Directory Permissions Modification",
            "Enterprise:Execution:Native API"
        ]
    },
    "platform": [
        "windows"
    ],
    "detection": {
        "selections": {
            "s1_processaccess_create_handle": {
                "event_type": "processaccess",
                "conditions": [
                    {
                        "field": "body.processaccess.handletype",
                        "operator": "equals",
                        "value": "create"
                    },
                    {
                        "field": "body.processaccess.handletype",
                        "operator": "equals",
                        "value": "duplicate"
                    }
                ]
            },
            "s2_target_lsass_process": {
                "event_type": "processaccess",
                "conditions": [
                    {
                        "field": "body.processaccess.filepath",
                        "operator": "endswith",
                        "value": "lsass.exe"
                    }
                ]
            },
            "s3_lsass_suspicious_access": {
                "event_type": "processaccess",
                "conditions": [
                    {
                        "field": "body.processaccess.desiredaccesses",
                        "operator": "contains",
                        "value": "PROCESS_ALL_ACCESS"
                    },
                    {
                        "field": "body.processaccess.desiredaccesses",
                        "operator": "contains",
                        "value": "PROCESS_VM_WRITE"
                    },
                    {
                        "field": "body.processaccess.desiredaccesses",
                        "operator": "contains",
                        "value": "PROCESS_CREATE_THREAD"
                    },
                    {
                        "field": "body.processaccess.desiredaccesses",
                        "operator": "contains",
                        "value": "PROCESS_DUP_HANDLE"
                    },
                    {
                        "field": "body.processaccess.desiredaccesses",
                        "operator": "contains",
                        "value": "GENERIC_ALL"
                    },
                    {
                        "field": "body.processaccess.desiredaccesses",
                        "operator": "contains",
                        "value": "WRITE_DAC"
                    },
                    {
                        "field": "body.processaccess.desiredaccesses",
                        "operator": "contains",
                        "value": "WRITE_OWNER"
                    }
                ]
            },
            "s4_filesystem_action_write_or_overwrite": {
                "event_type": "filesystem",
                "conditions": [
                    {
                        "field": "body.filesystem.action",
                        "operator": "equals",
                        "value": "write"
                    },
                    {
                        "field": "body.filesystem.action",
                        "operator": "equals",
                        "value": "overwritten"
                    }
                ]
            },
            "s5_filesystem_target_cryptdll": {
                "event_type": "filesystem",
                "conditions": [
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "endswith",
                        "value": "cryptdll.dll"
                    }
                ]
            },
            "s6_filesystem_target_samsrvdll": {
                "event_type": "filesystem",
                "conditions": [
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "endswith",
                        "value": "samsrv.dll"
                    }
                ]
            },
            "s7_apicall_injection_functions": {
                "event_type": "apicall",
                "conditions": [
                    {
                        "field": "body.apicall.function",
                        "operator": "equals",
                        "value": "WriteProcessMemory"
                    },
                    {
                        "field": "body.apicall.function",
                        "operator": "equals",
                        "value": "CreateRemoteThread"
                    },
                    {
                        "field": "body.apicall.function",
                        "operator": "equals",
                        "value": "NtWriteVirtualMemory"
                    },
                    {
                        "field": "body.apicall.function",
                        "operator": "equals",
                        "value": "NtCreateThreadEx"
                    },
                    {
                        "field": "body.apicall.function",
                        "operator": "equals",
                        "value": "RtlCreateUserThread"
                    }
                ]
            }
        },
        "condition": "(s1_processaccess_create_handle and s2_target_lsass_process and s3_lsass_suspicious_access) or (s4_filesystem_action_write_or_overwrite and (s5_filesystem_target_cryptdll or s6_filesystem_target_samsrvdll)) or s7_apicall_injection_functions"
    },
    "operational_usage": "SOC 팀은 이 규칙을 활용하여 도메인 컨트롤러에서 LSASS 프로세스 메모리 패치 또는 인증 관련 DLL 파일 조작 시도를 탐지할 수 있습니다. 특히, LSASS에 대한 광범위한 프로세스 접근 권한 획득, cryptdll.dll 또는 samsrv.dll 파일에 대한 쓰기/덮어쓰기 작업, 또는 프로세스 인젝션에 사용되는 특정 API 호출을 모니터링합니다. 탐지된 이벤트는 높은 심각도로 분류되어 즉각적인 알람을 트리거하고, 해당 시스템에 대한 긴급 조사 및 격리 조치를 시작하는 데 사용될 수 있습니다. 이는 도메인 관리자 계정 탈취와 같은 치명적인 공격으로 이어질 수 있으므로, 최우선 순위로 대응해야 합니다.",
    "false_positive": "정상적인 시스템 업데이트, 보안 소프트웨어 (예: EDR, 백신), 또는 합법적인 디버깅 도구가 LSASS 프로세스에 접근하거나 시스템 DLL을 수정하는 과정에서 오탐이 발생할 수 있습니다. 알려진 정상 프로세스나 특정 파일 경로에 대해 화이트리스트를 적용하여 오탐을 줄일 수 있습니다. 또한, 시스템 복원 또는 백업 솔루션이 DLL 파일을 변경할 때도 오탐될 수 있습니다."
}