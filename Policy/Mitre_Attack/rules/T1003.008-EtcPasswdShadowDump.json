{
    "id": "T1003.008-EtcPasswdShadowDump",
    "name": "/etc/passwd and /etc/shadow Credential Dumping",
    "description": "Detects attempts to dump the contents of /etc/passwd and /etc/shadow files on Linux systems to enable offline password cracking. This includes execution of command-line utilities like 'cat' or 'unshadow' to read these files, or direct file access events.",
    "severity": "high",
    "mitre_attack": {
        "tactic": "TA0006",
        "technique_id": "T1003",
        "subtechnique_id": "T1003.008",
        "data_sources": [
            "Enterprise:Credential Access:OS Credential Dumping:/etc/passwd and /etc/shadow",
            "Enterprise:Execution:Command and Scripting Interpreter:Unix Shell"
        ]
    },
    "platform": [
        "linux"
    ],
    "detection": {
        "selections": {
            "s_process_create_action": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.action",
                        "operator": "equals",
                        "value": "create"
                    }
                ]
            },
            "s_cmdline_targets": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "cat /etc/passwd"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "cat /etc/shadow"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "unshadow /etc/passwd /etc/shadow"
                    }
                ]
            },
            "s_filesystem_read_action": {
                "event_type": "filesystem",
                "conditions": [
                    {
                        "field": "body.filesystem.action",
                        "operator": "equals",
                        "value": "read"
                    },
                    {
                        "field": "body.filesystem.action",
                        "operator": "equals",
                        "value": "open"
                    }
                ]
            },
            "s_filesystem_filepath_targets": {
                "event_type": "filesystem",
                "conditions": [
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "equals",
                        "value": "/etc/passwd"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "equals",
                        "value": "/etc/shadow"
                    }
                ]
            }
        },
        "condition": "(s_process_create_action and s_cmdline_targets) or (s_filesystem_read_action and s_filesystem_filepath_targets)"
    },
    "operational_usage": "SOC 팀은 이 규칙을 활용하여 Linux 시스템에서 /etc/passwd 및 /etc/shadow 파일의 무단 접근 또는 덤프 시도를 탐지할 수 있습니다. 'cat', 'unshadow'와 같은 명령줄 유틸리티의 실행 또는 해당 파일에 대한 직접적인 읽기/열기 파일 시스템 이벤트를 모니터링합니다. 탐지된 이벤트는 높은 심각도로 분류되어 즉각적인 알람을 트리거하고, 관련 프로세스 및 사용자 활동에 대한 추가 조사를 시작하는 데 사용될 수 있습니다. 이는 자격 증명 접근 전술의 중요한 지표입니다.",
    "false_positive": "정상적인 시스템 관리 도구, 백업 스크립트, 또는 보안 감사 유틸리티가 /etc/passwd 또는 /etc/shadow 파일에 접근하는 경우 오탐이 발생할 수 있습니다. 알려진 정상 프로세스나 특정 사용자 계정의 활동을 화이트리스트에 추가하여 오탐을 줄일 수 있습니다."
}