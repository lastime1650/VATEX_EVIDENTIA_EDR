{
    "id": "T1586.001-SocialMediaAccountActivity",
    "name": "Social Media Account Compromise/Management Activity",
    "description": "Detects suspicious activities on an endpoint related to compromising or managing social media accounts. This includes the execution of tools or scripts for brute-forcing, credential stuffing, or automated interaction with social media platforms, as well as the handling of files potentially containing social media credentials.",
    "severity": "high",
    "mitre_attack": {
        "tactic": "TA0002",
        "technique_id": "T1586",
        "subtechnique_id": "T1586.001",
        "data_sources": [
            "Enterprise:Resource Development:Compromise Accounts:Social Media Accounts",
            "Enterprise:Execution:Command and Scripting Interpreter:Windows Command Shell",
            "Enterprise:Execution:Command and Scripting Interpreter:Python",
            "Enterprise:File:File Access"
        ]
    },
    "platform": [
        "windows"
    ],
    "detection": {
        "selections": {
            "s1_bruteforce_tool_exe": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.exe_path",
                        "operator": "endswith",
                        "value": "hydra.exe"
                    },
                    {
                        "field": "body.process.exe_path",
                        "operator": "endswith",
                        "value": "ncrack.exe"
                    },
                    {
                        "field": "body.process.exe_path",
                        "operator": "endswith",
                        "value": "john.exe"
                    },
                    {
                        "field": "body.process.exe_path",
                        "operator": "endswith",
                        "value": "hashcat.exe"
                    }
                ]
            },
            "s2_process_create_action": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.action",
                        "operator": "equals",
                        "value": "create"
                    }
                ]
            },
            "s3_script_interpreter_exe": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.exe_path",
                        "operator": "endswith",
                        "value": "powershell.exe"
                    },
                    {
                        "field": "body.process.exe_path",
                        "operator": "endswith",
                        "value": "python.exe"
                    },
                    {
                        "field": "body.process.exe_path",
                        "operator": "endswith",
                        "value": "wscript.exe"
                    },
                    {
                        "field": "body.process.exe_path",
                        "operator": "endswith",
                        "value": "cscript.exe"
                    }
                ]
            },
            "s4_cmdline_social_keywords": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "social"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "login"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "password"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "api.facebook.com"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "api.twitter.com"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "api.linkedin.com"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "instagram.com/api"
                    }
                ]
            },
            "s5_fs_credential_file_keywords": {
                "event_type": "filesystem",
                "conditions": [
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "endswith",
                        "value": "passwords.txt"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "endswith",
                        "value": "users.lst"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "endswith",
                        "value": "creds.txt"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "endswith",
                        "value": "social_accounts.txt"
                    }
                ]
            },
            "s6_fs_action_create_write": {
                "event_type": "filesystem",
                "conditions": [
                    {
                        "field": "body.filesystem.action",
                        "operator": "equals",
                        "value": "create"
                    },
                    {
                        "field": "body.filesystem.action",
                        "operator": "equals",
                        "value": "write"
                    }
                ]
            }
        },
        "condition": "s1_bruteforce_tool_exe or (s2_process_create_action and s3_script_interpreter_exe and s4_cmdline_social_keywords) or (s5_fs_credential_file_keywords and s6_fs_action_create_write)"
    },
    "operational_usage": "SOC 팀은 이 규칙을 활용하여 엔드포인트에서 소셜 미디어 계정 탈취 또는 관리 시도를 탐지할 수 있습니다. 이는 알려진 무차별 대입 도구의 실행, 소셜 미디어 API 상호작용 관련 키워드를 포함하는 스크립트 인터프리터의 실행, 또는 잠재적인 소셜 미디어 자격 증명 파일을 생성/수정하는 활동을 모니터링합니다. 탐지된 이벤트는 높은 우선순위 알림을 트리거하여 즉각적인 조사 및 침해 사고 대응을 시작하는 데 사용될 수 있습니다.",
    "false_positive": "정상적인 시스템 관리자가 비밀번호 감사 도구를 사용하거나, 개발자가 소셜 미디어 통합을 테스트하거나, 합법적인 마케팅 자동화 도구를 사용하는 경우 오탐이 발생할 수 있습니다. 특정 합법적인 실행 파일, 스크립트 경로 또는 명령줄 패턴을 화이트리스트에 추가하여 오탐을 줄일 수 있습니다."
}