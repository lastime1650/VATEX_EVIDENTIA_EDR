{
    "id": "T1505.005-TerminalServicesDLL",
    "name": "Persistence via Terminal Services DLL",
    "description": "Detects attempts to establish persistence by modifying or replacing the Terminal Services DLL (termsrv.dll) or its associated registry entry (ServiceDll). Adversaries may modify this DLL to execute arbitrary payloads or enable increased RDP functionality, allowing persistent access to the system.",
    "severity": "high",
    "mitre_attack": {
        "tactic": "TA0003",
        "technique_id": "T1505",
        "subtechnique_id": "T1505.005",
        "data_sources": [
            "Enterprise:Persistence:Create or Modify System Process:Windows Service",
            "Enterprise:Persistence:Modify Registry",
            "Enterprise:Defense Evasion:File and Directory Permissions Modification:Windows File and Directory Permissions Modification",
            "Enterprise:Execution:Command and Scripting Interpreter:Windows Command Shell",
            "Enterprise:Execution:Process Creation",
            "Enterprise:Execution:Shared Modules"
        ]
    },
    "platform": [
        "windows"
    ],
    "detection": {
        "selections": {
            "s1_registry_servicedll_path": {
                "event_type": "registry",
                "conditions": [
                    {
                        "field": "body.registry.name",
                        "operator": "startswith",
                        "value": "HKEY_LOCAL_MACHINE\\System\\CurrentControlSet\\services\\TermService\\Parameters\\ServiceDll"
                    }
                ]
            },
            "s2_registry_set_value_action": {
                "event_type": "registry",
                "conditions": [
                    {
                        "field": "body.registry.keyclass",
                        "operator": "equals",
                        "value": "RegNtSetValueKey"
                    },
                    {
                        "field": "body.registry.keyclass",
                        "operator": "equals",
                        "value": "RegNtPostSetValueKey"
                    }
                ]
            },
            "s3_filesystem_termsrv_dll_path": {
                "event_type": "filesystem",
                "conditions": [
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "endswith",
                        "value": "\\System32\\termsrv.dll"
                    }
                ]
            },
            "s4_filesystem_modify_action": {
                "event_type": "filesystem",
                "conditions": [
                    {
                        "field": "body.filesystem.action",
                        "operator": "equals",
                        "value": "create"
                    },
                    {
                        "field": "body.filesystem.action",
                        "operator": "equals",
                        "value": "write"
                    },
                    {
                        "field": "body.filesystem.action",
                        "operator": "equals",
                        "value": "overwritten"
                    },
                    {
                        "field": "body.filesystem.action",
                        "operator": "equals",
                        "value": "rename"
                    }
                ]
            },
            "s5_process_create_action": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.action",
                        "operator": "equals",
                        "value": "create"
                    }
                ]
            },
            "s6_reg_exe_path": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.exe_path",
                        "operator": "endswith",
                        "value": "reg.exe"
                    }
                ]
            },
            "s7_reg_command_modify_keywords": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "add"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "set"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "delete"
                    }
                ]
            },
            "s8_reg_command_termservice_path": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "HKLM\\System\\CurrentControlSet\\services\\TermService\\Parameters"
                    }
                ]
            },
            "s9_copy_move_exe_path": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.exe_path",
                        "operator": "endswith",
                        "value": "copy.exe"
                    },
                    {
                        "field": "body.process.exe_path",
                        "operator": "endswith",
                        "value": "move.exe"
                    }
                ]
            },
            "s10_copy_move_command_termsrv_dll": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "termsrv.dll"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "%SystemRoot%\\System32\\termsrv.dll"
                    }
                ]
            }
        },
        "condition": "(s1_registry_servicedll_path and s2_registry_set_value_action) or (s3_filesystem_termsrv_dll_path and s4_filesystem_modify_action) or (s5_process_create_action and s6_reg_exe_path and s7_reg_command_modify_keywords and s8_reg_command_termservice_path) or (s5_process_create_action and s9_copy_move_exe_path and s10_copy_move_command_termsrv_dll)"
    },
    "operational_usage": "SOC 팀은 이 규칙을 활용하여 Terminal Services DLL (termsrv.dll) 또는 관련 레지스트리 키에 대한 악의적인 변경 시도를 탐지할 수 있습니다. 특히, 'reg.exe' 또는 'copy.exe'와 같은 시스템 유틸리티를 사용하여 'ServiceDll' 레지스트리 값을 수정하거나 'termsrv.dll' 파일을 교체하는 행위를 모니터링합니다. 탐지된 이벤트는 높은 심각도로 분류되어 즉각적인 알람을 트리거하고, 관련 프로세스 및 파일 변경에 대한 심층적인 포렌식 조사를 시작하는 데 사용될 수 있습니다. 이는 시스템의 영구적인 백도어 또는 원격 접근을 가능하게 하는 중요한 지속성 메커니즘이므로, 다른 침해 활동과 결합될 때 더욱 중요합니다.",
    "false_positive": "정상적인 시스템 업데이트, 패치 적용, 또는 합법적인 관리 도구가 Terminal Services 구성이나 파일을 변경하는 경우 오탐이 발생할 수 있습니다. 특히, Windows Server 환경에서 RDP 관련 기능을 확장하는 합법적인 소프트웨어(예: RDP Wrapper) 설치 시 탐지될 수 있습니다. 알려진 정상적인 프로세스나 특정 명령줄 패턴을 화이트리스트에 추가하여 오탐을 줄일 수 있습니다."
}