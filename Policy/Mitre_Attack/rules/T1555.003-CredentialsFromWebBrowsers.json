{
    "id": "T1555.003-CredentialsFromWebBrowsers",
    "name": "Credentials from Web Browsers",
    "description": "Detects attempts to acquire credentials from web browsers by accessing their stored data files (e.g., Chrome's Login Data, Firefox's logins.json), or by executing commands/API calls (e.g., CryptUnprotectData) designed to extract plaintext credentials from browser memory or encrypted storage. Adversaries often target these stores to obtain usernames and passwords for lateral movement or further access.",
    "severity": "high",
    "mitre_attack": {
        "tactic": "TA0006",
        "technique_id": "T1555",
        "subtechnique_id": "T1555.003",
        "data_sources": [
            "Enterprise:Execution:Command and Scripting Interpreter:Windows Command Shell",
            "Enterprise:Execution:Command and Scripting Interpreter:PowerShell",
            "Enterprise:Collection:Data from Local System",
            "Enterprise:Execution:Native API",
            "Enterprise:Credential Access:OS Credential Dumping:LSASS Memory"
        ]
    },
    "platform": [
        "windows"
    ],
    "detection": {
        "selections": {
            "s1_process_action_create": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.action",
                        "operator": "equals",
                        "value": "create"
                    }
                ]
            },
            "s2_fs_action_read_or_open": {
                "event_type": "filesystem",
                "conditions": [
                    {
                        "field": "body.filesystem.action",
                        "operator": "equals",
                        "value": "read"
                    },
                    {
                        "field": "body.filesystem.action",
                        "operator": "equals",
                        "value": "open"
                    }
                ]
            },
            "s3_apicall_cryptunprotectdata": {
                "event_type": "apicall",
                "conditions": [
                    {
                        "field": "body.apicall.function",
                        "operator": "equals",
                        "value": "CryptUnprotectData"
                    }
                ]
            },
            "s4_chrome_login_data_filepath": {
                "event_type": "filesystem",
                "conditions": [
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "contains",
                        "value": "Google\\Chrome\\User Data\\Default\\Login Data"
                    }
                ]
            },
            "s5_edge_login_data_filepath": {
                "event_type": "filesystem",
                "conditions": [
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "contains",
                        "value": "Microsoft\\Edge\\User Data\\Default\\Login Data"
                    }
                ]
            },
            "s6_firefox_profiles_path": {
                "event_type": "filesystem",
                "conditions": [
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "contains",
                        "value": "Mozilla\\Firefox\\Profiles\\"
                    }
                ]
            },
            "s7_firefox_logins_json_filename": {
                "event_type": "filesystem",
                "conditions": [
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "contains",
                        "value": "logins.json"
                    }
                ]
            },
            "s8_powershell_exe_path": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.exe_path",
                        "operator": "endswith",
                        "value": "powershell.exe"
                    }
                ]
            },
            "s9_cmd_exe_path": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.exe_path",
                        "operator": "endswith",
                        "value": "cmd.exe"
                    }
                ]
            },
            "s10_powershell_browser_creds_cmdline": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "Get-Chrome"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "Get-Firefox"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "Invoke-Mimikatz"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "browser"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "password"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "CryptUnprotectData"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "SELECT action_url, username_value, password_value FROM logins"
                    }
                ]
            },
            "s11_generic_browser_creds_cmdline": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "Login Data"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "logins.json"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "sqlite3"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "type "
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "cat "
                    }
                ]
            }
        },
        "condition": "(s2_fs_action_read_or_open and (s4_chrome_login_data_filepath or s5_edge_login_data_filepath or (s6_firefox_profiles_path and s7_firefox_logins_json_filename))) or (s1_process_action_create and s8_powershell_exe_path and s10_powershell_browser_creds_cmdline) or (s1_process_action_create and s9_cmd_exe_path and s11_generic_browser_creds_cmdline) or s3_apicall_cryptunprotectdata"
    },
    "operational_usage": "SOC 팀은 이 규칙을 활용하여 웹 브라우저에 저장된 자격 증명 수집 시도를 탐지할 수 있습니다. Chrome, Edge, Firefox와 같은 주요 브라우저의 로그인 데이터 파일에 대한 비정상적인 읽기/열기 파일 시스템 활동을 모니터링합니다. 또한, PowerShell이나 CMD를 통해 브라우저 자격 증명 추출을 시도하는 명령줄 패턴, 또는 Windows API 함수인 'CryptUnprotectData' 호출을 탐지합니다. 탐지된 이벤트는 높은 심각도로 분류되어 즉각적인 알람을 트리거하고, 해당 프로세스 및 관련 파일에 대한 포렌식 조사를 시작하여 침해사고 대응의 우선순위를 지정하는 데 사용될 수 있습니다.",
    "false_positive": "정상적인 웹 브라우저 업데이트 프로세스, 합법적인 비밀번호 관리자 소프트웨어, 백신 또는 보안 솔루션, 그리고 개발 도구가 브라우저 데이터에 접근하거나 관련 API를 호출하는 경우 오탐이 발생할 수 있습니다. 알려진 정상 프로세스나 특정 파일 경로를 화이트리스트에 추가하여 오탐을 줄일 수 있습니다."
}