{
    "id": "T1204.001-MaliciousLinkExecution",
    "name": "Malicious Link Execution",
    "description": "Detects attempts to gain execution by relying on a user clicking a malicious link. This includes monitoring for process creation by web browsers or email clients with suspicious command-line arguments, execution of script interpreters with URLs, and the creation of potentially malicious files after a link click.",
    "severity": "high",
    "mitre_attack": {
        "tactic": "TA0002",
        "technique_id": "T1204",
        "subtechnique_id": "001",
        "data_sources": [
            "Enterprise:Execution:User Execution:Malicious Link",
            "Enterprise:Execution:Command and Scripting Interpreter:Windows Command Shell",
            "Enterprise:Collection:Data from Local System",
            "Enterprise:Command and Control:Application Layer Protocol:Web Protocols"
        ]
    },
    "platform": [
        "linux",
        "macos",
        "windows"
    ],
    "detection": {
        "selections": {
            "s1_process_create_action": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.action",
                        "operator": "equals",
                        "value": "create"
                    }
                ]
            },
            "s2_browser_or_email_process": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.exe_path",
                        "operator": "endswith",
                        "value": "chrome.exe"
                    },
                    {
                        "field": "body.process.exe_path",
                        "operator": "endswith",
                        "value": "firefox.exe"
                    },
                    {
                        "field": "body.process.exe_path",
                        "operator": "endswith",
                        "value": "msedge.exe"
                    },
                    {
                        "field": "body.process.exe_path",
                        "operator": "endswith",
                        "value": "iexplore.exe"
                    },
                    {
                        "field": "body.process.exe_path",
                        "operator": "endswith",
                        "value": "outlook.exe"
                    },
                    {
                        "field": "body.process.exe_path",
                        "operator": "endswith",
                        "value": "thunderbird.exe"
                    }
                ]
            },
            "s3_cmdline_contains_url": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "http://"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "https://"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "ftp://"
                    }
                ]
            },
            "s4_script_interpreter_process": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.exe_path",
                        "operator": "endswith",
                        "value": "mshta.exe"
                    },
                    {
                        "field": "body.process.exe_path",
                        "operator": "endswith",
                        "value": "powershell.exe"
                    },
                    {
                        "field": "body.process.exe_path",
                        "operator": "endswith",
                        "value": "wscript.exe"
                    },
                    {
                        "field": "body.process.exe_path",
                        "operator": "endswith",
                        "value": "cscript.exe"
                    },
                    {
                        "field": "body.process.exe_path",
                        "operator": "endswith",
                        "value": "cmd.exe"
                    }
                ]
            },
            "s5_cmdline_suspicious_download_keywords": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "downloadfile"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "wget"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "curl"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "Invoke-WebRequest"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "certutil -urlcache"
                    }
                ]
            },
            "s6_filesystem_create_or_write": {
                "event_type": "filesystem",
                "conditions": [
                    {
                        "field": "body.filesystem.action",
                        "operator": "equals",
                        "value": "create"
                    },
                    {
                        "field": "body.filesystem.action",
                        "operator": "equals",
                        "value": "write"
                    }
                ]
            },
            "s7_filesystem_common_download_temp_paths": {
                "event_type": "filesystem",
                "conditions": [
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "contains",
                        "value": "C:\\Users\\"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "contains",
                        "value": "\\Downloads\\"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "contains",
                        "value": "C:\\Windows\\Temp\\"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "contains",
                        "value": "\\AppData\\Local\\Temp\\"
                    }
                ]
            },
            "s8_filesystem_suspicious_extensions": {
                "event_type": "filesystem",
                "conditions": [
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "endswith",
                        "value": ".exe"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "endswith",
                        "value": ".dll"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "endswith",
                        "value": ".ps1"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "endswith",
                        "value": ".bat"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "endswith",
                        "value": ".cmd"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "endswith",
                        "value": ".vbs"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "endswith",
                        "value": ".js"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "endswith",
                        "value": ".hta"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "endswith",
                        "value": ".scr"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "endswith",
                        "value": ".zip"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "endswith",
                        "value": ".iso"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "endswith",
                        "value": ".img"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "endswith",
                        "value": ".chm"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "endswith",
                        "value": ".lnk"
                    }
                ]
            }
        },
        "condition": "(s1_process_create_action and s2_browser_or_email_process and s3_cmdline_contains_url) or (s1_process_create_action and s4_script_interpreter_process and (s3_cmdline_contains_url or s5_cmdline_suspicious_download_keywords)) or (s6_filesystem_create_or_write and s7_filesystem_common_download_temp_paths and s8_filesystem_suspicious_extensions)"
    },
    "operational_usage": "SOC 팀은 이 규칙을 활용하여 사용자가 악성 링크를 클릭하여 발생하는 초기 실행 시도를 탐지할 수 있습니다. 웹 브라우저나 이메일 클라이언트가 URL을 포함한 비정상적인 명령줄로 실행되거나, 스크립트 인터프리터가 의심스러운 다운로드 키워드 또는 URL과 함께 실행되는 프로세스 생성 이벤트를 모니터링합니다. 또한, 일반적인 다운로드/임시 경로에 실행 파일, 스크립트 등 의심스러운 확장자를 가진 파일이 생성되거나 쓰여지는 파일 시스템 이벤트도 탐지합니다. 탐지된 이벤트는 높은 심각도로 분류되어 즉각적인 알람을 트리거하고, 관련 프로세스, 네트워크 연결, 파일 활동에 대한 추가적인 포렌식 조사를 시작하는 데 사용될 수 있습니다. 특히, 피싱 캠페인이나 다른 초기 접근 전술과 결합될 때 중요도가 더욱 높아집니다.",
    "false_positive": "정상적인 웹 브라우저 활동, 소프트웨어 업데이트, 합법적인 파일 다운로드, 또는 시스템 관리 스크립트 실행으로 인해 오탐이 발생할 수 있습니다. 특히 특정 애플리케이션이나 도구가 임시 폴더에 파일을 생성하거나 URL을 명령줄 인자로 사용하는 경우 발생할 수 있습니다. 알려진 정상 프로세스, 파일 경로, 또는 명령줄 패턴을 화이트리스트에 추가하여 오탐을 줄일 수 있습니다."
}