{
    "id": "T1041-ExfiltrationOverC2Channel",
    "name": "Exfiltration Over C2 Channel",
    "description": "Detects attempts by adversaries to steal data by exfiltrating it over an existing command and control channel. This often involves encoding stolen data into normal communications using the same protocol as C2, or using common data transfer utilities and encoding techniques.",
    "severity": "high",
    "mitre_attack": {
        "tactic": "TA0010",
        "technique_id": "T1041",
        "subtechnique_id": "",
        "data_sources": [
            "Enterprise:Execution:Command and Scripting Interpreter:Windows Command Shell",
            "Enterprise:Collection:Data from Local System",
            "Enterprise:Command and Control:Application Layer Protocol:Web Protocols",
            "Enterprise:Command and Control:Data Encoding:Standard Encoding",
            "Enterprise:Exfiltration:Automated Exfiltration"
        ]
    },
    "platform": [
        "windows"
    ],
    "detection": {
        "selections": {
            "s1_process_create_action": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.action",
                        "operator": "equals",
                        "value": "create"
                    }
                ]
            },
            "s2_network_outbound_large_data": {
                "event_type": "network",
                "conditions": [
                    {
                        "field": "body.network.direction",
                        "operator": "equals",
                        "value": "out"
                    },
                    {
                        "field": "body.network.packetsize",
                        "operator": "gt",
                        "value": 500000
                    }
                ]
            },
            "s3_process_data_transfer_utilities": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "curl "
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "wget "
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "bitsadmin /transfer "
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "ftp -s"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "sftp "
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "scp "
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "nc -w"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "powershell -c (New-Object System.Net.WebClient).UploadFile"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "powershell -c (New-Object System.Net.WebClient).UploadString"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "rclone "
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "7z a -p"
                    }
                ]
            },
            "s4_process_encoding_utilities": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "certutil -encode "
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "powershell -c [System.Convert]::ToBase64String"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "base64 "
                    }
                ]
            },
            "s5_network_suspicious_c2_ports": {
                "event_type": "network",
                "conditions": [
                    {
                        "field": "body.network.direction",
                        "operator": "equals",
                        "value": "out"
                    },
                    {
                        "field": "body.network.destinationport",
                        "operator": "equals",
                        "value": 53
                    },
                    {
                        "field": "body.network.destinationport",
                        "operator": "equals",
                        "value": 80
                    },
                    {
                        "field": "body.network.destinationport",
                        "operator": "equals",
                        "value": 443
                    },
                    {
                        "field": "body.network.destinationport",
                        "operator": "equals",
                        "value": 8080
                    },
                    {
                        "field": "body.network.destinationport",
                        "operator": "equals",
                        "value": 1080
                    },
                    {
                        "field": "body.network.destinationport",
                        "operator": "equals",
                        "value": 3128
                    },
                    {
                        "field": "body.network.destinationport",
                        "operator": "equals",
                        "value": 4444
                    },
                    {
                        "field": "body.network.destinationport",
                        "operator": "equals",
                        "value": 9001
                    },
                    {
                        "field": "body.network.destinationport",
                        "operator": "equals",
                        "value": 6667
                    }
                ]
            }
        },
        "condition": "(s1_process_create_action and (s3_process_data_transfer_utilities or s4_process_encoding_utilities)) or (s2_network_outbound_large_data and s5_network_suspicious_c2_ports)"
    },
    "operational_usage": "SOC 팀은 이 규칙을 활용하여 C2 채널을 통한 데이터 유출 시도를 탐지할 수 있습니다. 프로세스 생성 이벤트에서 데이터 전송 또는 인코딩 유틸리티 사용을 모니터링하고, 동시에 대량의 아웃바운드 네트워크 트래픽이 의심스러운 C2 관련 포트로 전송되는 것을 탐지합니다. 탐지된 이벤트는 높은 심각도로 분류되어 즉각적인 알람을 트리거하고, 관련 프로세스 및 네트워크 연결에 대한 심층적인 포렌식 조사를 시작하는 데 사용될 수 있습니다. 특히, 다른 데이터 수집 및 명령 및 제어 활동과 결합될 때 중요도가 더욱 높아집니다.",
    "false_positive": "정상적인 시스템 관리 도구, 백업 솔루션, 클라우드 동기화 애플리케이션, 또는 합법적인 파일 전송 유틸리티가 대량의 데이터를 전송하거나 특정 포트를 사용하는 경우 오탐이 발생할 수 있습니다. 알려진 정상적인 프로세스나 특정 네트워크 목적지에 대해 화이트리스트를 적용하여 오탐을 줄일 수 있습니다."
}