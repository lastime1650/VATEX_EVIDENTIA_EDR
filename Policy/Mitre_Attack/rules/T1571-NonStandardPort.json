{
    "id": "T1571-NonStandardPort",
    "name": "Non-Standard Port Usage",
    "description": "Detects communication using protocol and port pairings that are typically not associated, such as HTTPS over port 8088 or SMTP over port 587 for C2. Adversaries leverage non-standard ports to bypass filtering and obscure malicious network activity.",
    "severity": "high",
    "mitre_attack": {
        "tactic": "TA0011",
        "technique_id": "T1571",
        "subtechnique_id": "",
        "data_sources": [
            "NetworkTraffic:NetworkTrafficFlow",
            "NetworkTraffic:NetworkTrafficContent"
        ]
    },
    "platform": [
        "windows"
    ],
    "detection": {
        "selections": {
            "s1_is_tcp_protocol": {
                "event_type": "network",
                "conditions": [
                    {
                        "field": "body.network.protocol",
                        "operator": "equals",
                        "value": "TCP"
                    }
                ]
            },
            "s2_is_udp_protocol": {
                "event_type": "network",
                "conditions": [
                    {
                        "field": "body.network.protocol",
                        "operator": "equals",
                        "value": "UDP"
                    }
                ]
            },
            "s3_dest_port_8080": {
                "event_type": "network",
                "conditions": [
                    {
                        "field": "body.network.destinationport",
                        "operator": "equals",
                        "value": 8080
                    }
                ]
            },
            "s4_src_port_8080": {
                "event_type": "network",
                "conditions": [
                    {
                        "field": "body.network.sourceport",
                        "operator": "equals",
                        "value": 8080
                    }
                ]
            },
            "s5_dest_port_8088": {
                "event_type": "network",
                "conditions": [
                    {
                        "field": "body.network.destinationport",
                        "operator": "equals",
                        "value": 8088
                    }
                ]
            },
            "s6_src_port_8088": {
                "event_type": "network",
                "conditions": [
                    {
                        "field": "body.network.sourceport",
                        "operator": "equals",
                        "value": 8088
                    }
                ]
            },
            "s7_dest_port_8443": {
                "event_type": "network",
                "conditions": [
                    {
                        "field": "body.network.destinationport",
                        "operator": "equals",
                        "value": 8443
                    }
                ]
            },
            "s8_src_port_8443": {
                "event_type": "network",
                "conditions": [
                    {
                        "field": "body.network.sourceport",
                        "operator": "equals",
                        "value": 8443
                    }
                ]
            },
            "s9_dest_port_587": {
                "event_type": "network",
                "conditions": [
                    {
                        "field": "body.network.destinationport",
                        "operator": "equals",
                        "value": 587
                    }
                ]
            },
            "s10_src_port_587": {
                "event_type": "network",
                "conditions": [
                    {
                        "field": "body.network.sourceport",
                        "operator": "equals",
                        "value": 587
                    }
                ]
            },
            "s11_dest_port_4444": {
                "event_type": "network",
                "conditions": [
                    {
                        "field": "body.network.destinationport",
                        "operator": "equals",
                        "value": 4444
                    }
                ]
            },
            "s12_src_port_4444": {
                "event_type": "network",
                "conditions": [
                    {
                        "field": "body.network.sourceport",
                        "operator": "equals",
                        "value": 4444
                    }
                ]
            },
            "s13_dest_port_6667": {
                "event_type": "network",
                "conditions": [
                    {
                        "field": "body.network.destinationport",
                        "operator": "equals",
                        "value": 6667
                    }
                ]
            },
            "s14_src_port_6667": {
                "event_type": "network",
                "conditions": [
                    {
                        "field": "body.network.sourceport",
                        "operator": "equals",
                        "value": 6667
                    }
                ]
            },
            "s15_dest_port_9001": {
                "event_type": "network",
                "conditions": [
                    {
                        "field": "body.network.destinationport",
                        "operator": "equals",
                        "value": 9001
                    }
                ]
            },
            "s16_src_port_9001": {
                "event_type": "network",
                "conditions": [
                    {
                        "field": "body.network.sourceport",
                        "operator": "equals",
                        "value": 9001
                    }
                ]
            },
            "s17_dest_port_1080": {
                "event_type": "network",
                "conditions": [
                    {
                        "field": "body.network.destinationport",
                        "operator": "equals",
                        "value": 1080
                    }
                ]
            },
            "s18_src_port_1080": {
                "event_type": "network",
                "conditions": [
                    {
                        "field": "body.network.sourceport",
                        "operator": "equals",
                        "value": 1080
                    }
                ]
            },
            "s19_dest_port_3128": {
                "event_type": "network",
                "conditions": [
                    {
                        "field": "body.network.destinationport",
                        "operator": "equals",
                        "value": 3128
                    }
                ]
            },
            "s20_src_port_3128": {
                "event_type": "network",
                "conditions": [
                    {
                        "field": "body.network.sourceport",
                        "operator": "equals",
                        "value": 3128
                    }
                ]
            }
        },
        "condition": "(s1_is_tcp_protocol or s2_is_udp_protocol) and (s3_dest_port_8080 or s4_src_port_8080 or s5_dest_port_8088 or s6_src_port_8088 or s7_dest_port_8443 or s8_src_port_8443 or s9_dest_port_587 or s10_src_port_587 or s11_dest_port_4444 or s12_src_port_4444 or s13_dest_port_6667 or s14_src_port_6667 or s15_dest_port_9001 or s16_src_port_9001 or s17_dest_port_1080 or s18_src_port_1080 or s19_dest_port_3128 or s20_src_port_3128)"
    },
    "operational_usage": "SOC 팀은 이 규칙을 활용하여 비표준 포트를 통한 통신 시도를 탐지할 수 있습니다. 이는 일반적으로 알려진 프로토콜의 기본 포트가 아닌 다른 포트에서 통신이 발생할 때 경고를 트리거합니다. 탐지된 이벤트는 C2 통신, 데이터 유출 또는 우회 시도의 지표가 될 수 있으므로, 높은 심각도로 분류되어 즉각적인 알람을 트리거하고, 네트워크 흐름 및 관련 프로세스에 대한 심층적인 조사를 시작하는 데 사용될 수 있습니다. 특히 다른 C2 전술과 결합될 때 중요도가 더욱 높아집니다.",
    "false_positive": "정상적인 애플리케이션, 개발 서버, P2P 통신, 또는 특정 기업 환경에서 커스텀 서비스가 비표준 포트를 사용하는 경우 오탐이 발생할 수 있습니다. 알려진 정상적인 비표준 포트 사용 패턴이나 특정 프로세스에 대해 화이트리스트를 적용하여 오탐을 줄일 수 있습니다."
}