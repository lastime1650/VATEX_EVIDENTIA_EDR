{
    "id": "T1012-QueryRegistry",
    "name": "Query Registry",
    "description": "Detects attempts by adversaries to query the Windows Registry to gather information about the system, configuration, and installed software. This includes using utilities like reg.exe, PowerShell cmdlets, or direct API calls to read registry keys and values.",
    "severity": "medium",
    "mitre_attack": {
        "tactic": "TA0007",
        "technique_id": "T1012",
        "subtechnique_id": "",
        "data_sources": [
            "Enterprise:Discovery:Query Registry",
            "Enterprise:Execution:Command and Scripting Interpreter:Windows Command Shell",
            "Enterprise:Execution:Native API"
        ]
    },
    "platform": [
        "windows"
    ],
    "detection": {
        "selections": {
            "s_proc_create": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.action",
                        "operator": "equals",
                        "value": "create"
                    }
                ]
            },
            "s_reg_exe_path": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.exe_path",
                        "operator": "endswith",
                        "value": "reg.exe"
                    }
                ]
            },
            "s_reg_cmd_query_or_export": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "query"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "export"
                    }
                ]
            },
            "s_powershell_exe_path": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.exe_path",
                        "operator": "endswith",
                        "value": "powershell.exe"
                    },
                    {
                        "field": "body.process.exe_path",
                        "operator": "endswith",
                        "value": "pwsh.exe"
                    }
                ]
            },
            "s_powershell_cmd_get_item_prop": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "Get-ItemProperty"
                    }
                ]
            },
            "s_powershell_cmd_get_child_item": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "Get-ChildItem"
                    }
                ]
            },
            "s_powershell_cmd_registry_path": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "HKLM:"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "HKCU:"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "HKCR:"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "HKU:"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "HKCC:"
                    }
                ]
            },
            "s_registry_key_query_event": {
                "event_type": "registry",
                "conditions": [
                    {
                        "field": "body.registry.keyclass",
                        "operator": "contains",
                        "value": "QueryKey"
                    },
                    {
                        "field": "body.registry.keyclass",
                        "operator": "contains",
                        "value": "QueryValueKey"
                    },
                    {
                        "field": "body.registry.keyclass",
                        "operator": "contains",
                        "value": "EnumerateKey"
                    }
                ]
            },
            "s_registry_key_open_event": {
                "event_type": "registry",
                "conditions": [
                    {
                        "field": "body.registry.keyclass",
                        "operator": "contains",
                        "value": "OpenKey"
                    }
                ]
            },
            "s_apicall_reg_query_value": {
                "event_type": "apicall",
                "conditions": [
                    {
                        "field": "body.apicall.function",
                        "operator": "equals",
                        "value": "RegQueryValueExW"
                    },
                    {
                        "field": "body.apicall.function",
                        "operator": "equals",
                        "value": "RegQueryValueExA"
                    },
                    {
                        "field": "body.apicall.function",
                        "operator": "equals",
                        "value": "RegGetValueW"
                    },
                    {
                        "field": "body.apicall.function",
                        "operator": "equals",
                        "value": "RegGetValueA"
                    }
                ]
            },
            "s_apicall_reg_open_key": {
                "event_type": "apicall",
                "conditions": [
                    {
                        "field": "body.apicall.function",
                        "operator": "equals",
                        "value": "RegOpenKeyExW"
                    },
                    {
                        "field": "body.apicall.function",
                        "operator": "equals",
                        "value": "RegOpenKeyExA"
                    }
                ]
            },
            "s_apicall_reg_enum_key": {
                "event_type": "apicall",
                "conditions": [
                    {
                        "field": "body.apicall.function",
                        "operator": "equals",
                        "value": "RegEnumKeyExW"
                    },
                    {
                        "field": "body.apicall.function",
                        "operator": "equals",
                        "value": "RegEnumKeyExA"
                    }
                ]
            }
        },
        "condition": "(s_proc_create and s_reg_exe_path and s_reg_cmd_query_or_export) or (s_proc_create and s_powershell_exe_path and (s_powershell_cmd_get_item_prop or (s_powershell_cmd_get_child_item and s_powershell_cmd_registry_path))) or (s_registry_key_query_event or s_registry_key_open_event) or (s_apicall_reg_query_value or s_apicall_reg_open_key or s_apicall_reg_enum_key)"
    },
    "operational_usage": "SOC 팀은 이 규칙을 활용하여 시스템 레지스트리 정보 수집 시도를 탐지할 수 있습니다. 'reg.exe' 명령줄 유틸리티 실행, PowerShell을 통한 레지스트리 조회 cmdlet 사용, 또는 레지스트리 접근 API 호출 등을 모니터링합니다. 탐지된 이벤트는 자동 알람을 트리거하고, 추가적인 조사 및 침해사고 대응의 우선순위를 지정하는 데 사용될 수 있습니다. 특히 다른 Discovery 또는 Collection 활동과 결합될 때 중요도가 높아집니다.",
    "false_positive": "정상적인 시스템 관리 도구, 백신 소프트웨어, 사용자 환경 설정 스크립트, 또는 합법적인 애플리케이션이 시스템 레지스트리 정보를 조회하는 과정에서 오탐이 발생할 수 있습니다. 알려진 정상 프로세스나 특정 명령줄 패턴을 화이트리스트에 추가하여 오탐을 줄일 수 있습니다."
}