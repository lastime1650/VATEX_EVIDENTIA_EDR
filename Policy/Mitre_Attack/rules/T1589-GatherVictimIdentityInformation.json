{
    "id": "T1589-GatherVictimIdentityInformation",
    "name": "Gather Victim Identity Information",
    "description": "Detects attempts by adversaries to gather information about the victim's identity, such as usernames, via active enumeration commands, PowerShell cmdlets, API calls, or network probing of authentication services. This technique is often used during reconnaissance to identify valid accounts for further attack stages.",
    "severity": "medium",
    "mitre_attack": {
        "tactic": "TA0007",
        "technique_id": "T1589",
        "subtechnique_id": "",
        "data_sources": [
            "Enterprise:Discovery:Account Discovery",
            "Enterprise:Execution:Command and Scripting Interpreter:Windows Command Shell",
            "Enterprise:Execution:Command and Scripting Interpreter:PowerShell",
            "Enterprise:Execution:Native API",
            "Enterprise:NetworkTraffic:NetworkTrafficContent"
        ]
    },
    "platform": [
        "windows"
    ],
    "detection": {
        "selections": {
            "s1_process_create_action": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.action",
                        "operator": "equals",
                        "value": "create"
                    }
                ]
            },
            "s2_cmd_whoami": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "whoami.exe"
                    }
                ]
            },
            "s3_cmd_query_user": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "query user"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "quser"
                    }
                ]
            },
            "s4_cmd_net_user": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "net user"
                    }
                ]
            },
            "s5_cmd_net_localgroup": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "net localgroup"
                    }
                ]
            },
            "s6_cmd_dsquery_user": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "dsquery user"
                    }
                ]
            },
            "s7_cmd_powershell_exe": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "powershell.exe"
                    }
                ]
            },
            "s8_cmd_powershell_enum_cmdlets": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "Get-LocalUser"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "Get-ADUser"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "Win32_UserAccount"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "Get-CimInstance"
                    }
                ]
            },
            "s9_apicall_user_enum": {
                "event_type": "apicall",
                "conditions": [
                    {
                        "field": "body.apicall.function",
                        "operator": "equals",
                        "value": "NetUserEnum"
                    },
                    {
                        "field": "body.apicall.function",
                        "operator": "equals",
                        "value": "LsaEnumerateLogonSessions"
                    },
                    {
                        "field": "body.apicall.function",
                        "operator": "equals",
                        "value": "GetUserNameW"
                    },
                    {
                        "field": "body.apicall.function",
                        "operator": "equals",
                        "value": "GetUserNameA"
                    },
                    {
                        "field": "body.apicall.function",
                        "operator": "equals",
                        "value": "WTSQuerySessionInformationW"
                    },
                    {
                        "field": "body.apicall.function",
                        "operator": "equals",
                        "value": "WTSQuerySessionInformationA"
                    }
                ]
            },
            "s10_net_auth_ldap_ports": {
                "event_type": "network",
                "conditions": [
                    {
                        "field": "body.network.destinationport",
                        "operator": "equals",
                        "value": 389
                    },
                    {
                        "field": "body.network.destinationport",
                        "operator": "equals",
                        "value": 636
                    }
                ]
            },
            "s11_net_auth_kerberos_port": {
                "event_type": "network",
                "conditions": [
                    {
                        "field": "body.network.destinationport",
                        "operator": "equals",
                        "value": 88
                    }
                ]
            },
            "s12_net_auth_smb_port": {
                "event_type": "network",
                "conditions": [
                    {
                        "field": "body.network.destinationport",
                        "operator": "equals",
                        "value": 445
                    }
                ]
            },
            "s13_net_protocol_tcp": {
                "event_type": "network",
                "conditions": [
                    {
                        "field": "body.network.protocol",
                        "operator": "equals",
                        "value": "TCP"
                    }
                ]
            },
            "s14_net_protocol_udp": {
                "event_type": "network",
                "conditions": [
                    {
                        "field": "body.network.protocol",
                        "operator": "equals",
                        "value": "UDP"
                    }
                ]
            }
        },
        "condition": "(s1_process_create_action and (s2_cmd_whoami or s3_cmd_query_user or s4_cmd_net_user or s5_cmd_net_localgroup or s6_cmd_dsquery_user or (s7_cmd_powershell_exe and s8_cmd_powershell_enum_cmdlets))) or s9_apicall_user_enum or ((s10_net_auth_ldap_ports or s11_net_auth_kerberos_port or s12_net_auth_smb_port) and (s13_net_protocol_tcp or s14_net_protocol_udp))"
    },
    "operational_usage": "SOC 팀은 이 규칙을 활용하여 시스템에서 사용자 신원 정보 수집 시도를 탐지할 수 있습니다. 'whoami', 'query user', 'net user' 등과 같은 명령 실행, PowerShell을 통한 사용자 열거 시도, 사용자 정보 조회 API 호출, 또는 LDAP/Kerberos/SMB와 같은 인증 서비스 포트로의 비정상적인 네트워크 연결 시도를 모니터링합니다. 탐지된 이벤트는 정찰(Reconnaissance) 활동으로 분류되어 자동 알람을 트리거하고, 추가적인 조사 및 침해사고 대응의 우선순위를 지정하는 데 사용될 수 있습니다. 특히, 다른 Discovery 또는 Initial Access 전술과 결합될 때 중요도가 높아집니다.",
    "false_positive": "정상적인 시스템 관리 도구, 백신/EDR 소프트웨어, 사용자 환경 설정 스크립트, 또는 합법적인 애플리케이션이 시스템 사용자 정보를 조회하거나 인증 서비스에 연결하는 과정에서 오탐이 발생할 수 있습니다. 알려진 정상 프로세스나 특정 명령줄 패턴을 화이트리스트에 추가하고, 정상적인 관리 트래픽을 제외하여 오탐을 줄일 수 있습니다."
}