{
    "id": "T1542-PreOSBoot",
    "name": "Pre-OS Boot Persistence",
    "description": "Detects attempts to establish persistence by abusing pre-OS boot mechanisms, such as modifying boot records (MBR/VBR), Boot Configuration Data (BCD), or firmware settings. Adversaries may overwrite boot drivers or firmware like BIOS/UEFI to execute malicious code before the operating system loads, making detection challenging for host-based defenses.",
    "severity": "high",
    "mitre_attack": {
        "tactic": "Persistence",
        "technique_id": "T1542",
        "subtechnique_id": "",
        "data_sources": [
            "Command:CommandExecution",
            "Process:ProcessCreation",
            "File:FileCreation",
            "File:FileModification",
            "WindowsRegistry:WindowsRegistryKeyModification"
        ]
    },
    "platform": [
        "windows"
    ],
    "detection": {
        "selections": {
            "s1_process_create_action": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.action",
                        "operator": "equals",
                        "value": "create"
                    }
                ]
            },
            "s2_cmdline_bcdedit_modify": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "bcdedit.exe"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "/set"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "/deletevalue"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "/createstore"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "/copy"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "/bootsequence"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "/default"
                    }
                ]
            },
            "s3_cmdline_bootrec_modify": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "bootrec.exe"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "/fixmbr"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "/fixboot"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "/rebuildbcd"
                    }
                ]
            },
            "s4_cmdline_diskpart_destructive": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "diskpart.exe"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "clean"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "format"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "active"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "create partition primary"
                    }
                ]
            },
            "s5_registry_bootexecute_key": {
                "event_type": "registry",
                "conditions": [
                    {
                        "field": "body.registry.name",
                        "operator": "equals",
                        "value": "HKEY_LOCAL_MACHINE\\SYSTEM\\CurrentControlSet\\Control\\Session Manager\\BootExecute"
                    }
                ]
            },
            "s6_registry_modification_action": {
                "event_type": "registry",
                "conditions": [
                    {
                        "field": "body.registry.keyclass",
                        "operator": "equals",
                        "value": "RegNtSetValueKey"
                    },
                    {
                        "field": "body.registry.keyclass",
                        "operator": "equals",
                        "value": "RegNtPostSetValueKey"
                    },
                    {
                        "field": "body.registry.keyclass",
                        "operator": "equals",
                        "value": "RegNtRenameKey"
                    },
                    {
                        "field": "body.registry.keyclass",
                        "operator": "equals",
                        "value": "RegNtPostRenameKey"
                    },
                    {
                        "field": "body.registry.keyclass",
                        "operator": "equals",
                        "value": "RegNtDeleteKey"
                    },
                    {
                        "field": "body.registry.keyclass",
                        "operator": "equals",
                        "value": "RegNtPostDeleteKey"
                    }
                ]
            },
            "s7_filesystem_boot_path": {
                "event_type": "filesystem",
                "conditions": [
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "contains",
                        "value": "\\EFI\\Microsoft\\Boot\\"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "contains",
                        "value": "\\bootmgr"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "contains",
                        "value": "\\Windows\\Boot\\"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "contains",
                        "value": "\\boot.ini"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "contains",
                        "value": "\\BCD"
                    }
                ]
            },
            "s8_filesystem_write_action": {
                "event_type": "filesystem",
                "conditions": [
                    {
                        "field": "body.filesystem.action",
                        "operator": "equals",
                        "value": "create"
                    },
                    {
                        "field": "body.filesystem.action",
                        "operator": "equals",
                        "value": "write"
                    },
                    {
                        "field": "body.filesystem.action",
                        "operator": "equals",
                        "value": "overwritten"
                    },
                    {
                        "field": "body.filesystem.action",
                        "operator": "equals",
                        "value": "superseded"
                    },
                    {
                        "field": "body.filesystem.action",
                        "operator": "equals",
                        "value": "rename"
                    },
                    {
                        "field": "body.filesystem.action",
                        "operator": "equals",
                        "value": "remove"
                    }
                ]
            }
        },
        "condition": "(s1_process_create_action and s2_cmdline_bcdedit_modify) or (s1_process_create_action and s3_cmdline_bootrec_modify) or (s1_process_create_action and s4_cmdline_diskpart_destructive) or (s5_registry_bootexecute_key and s6_registry_modification_action) or (s7_filesystem_boot_path and s8_filesystem_write_action)"
    },
    "operational_usage": "SOC 팀은 이 규칙을 활용하여 시스템의 Pre-OS 부트 메커니즘 변경 시도를 탐지할 수 있습니다. 'bcdedit.exe', 'bootrec.exe', 'diskpart.exe'와 같은 부트 관련 명령줄 유틸리티의 실행, 'BootExecute' 레지스트리 키의 수정, 또는 EFI/부트 관련 파일 경로에서의 생성/쓰기/삭제 활동을 모니터링합니다. 탐지된 이벤트는 높은 심각도로 분류되어 즉각적인 알람을 트리거하고, 시스템 무결성 검사 및 포렌식 조사를 시작하여 침해사고 대응의 우선순위를 지정하는 데 사용될 수 있습니다.",
    "false_positive": "정상적인 시스템 복구 작업, 운영체제 업데이트, 드라이버 설치, 또는 합법적인 디스크 관리 도구 사용 시 오탐이 발생할 수 있습니다. 특히 시스템 관리자가 부트 관련 문제를 해결하기 위해 위 명령어를 사용하는 경우, 알려진 정상 프로세스나 특정 명령줄 패턴을 화이트리스트에 추가하여 오탐을 줄일 수 있습니다."
}