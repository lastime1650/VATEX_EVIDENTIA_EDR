{
    "id": "T1087.001-LocalAccountDiscovery",
    "name": "Local Account Discovery",
    "description": "Detects attempts to get a listing of local system accounts and groups using utilities like 'net user', 'net localgroup', 'query user', 'whoami', PowerShell cmdlets (e.g., Get-LocalUser, Get-ADUser, Win32_UserAccount queries), or by accessing specific registry keys (e.g., ProfileList, HKEY_USERS) and API calls (e.g., NetUserEnum, WTSQuerySessionInformation) to discover local user information. This information helps adversaries determine which local accounts exist on a system to aid in follow-on behavior.",
    "severity": "high",
    "mitre_attack": {
        "tactic": "TA0007",
        "technique_id": "T1087",
        "subtechnique_id": "T1087.001",
        "data_sources": [
            "Enterprise:Discovery:Account Discovery:Local Account",
            "Enterprise:Discovery:Permission Groups Discovery:Local Groups",
            "Enterprise:Discovery:Query Registry",
            "Enterprise:Execution:Command and Scripting Interpreter:Windows Command Shell",
            "Enterprise:Execution:Command and Scripting Interpreter:PowerShell",
            "Enterprise:Execution:Native API"
        ]
    },
    "platform": [
        "windows"
    ],
    "detection": {
        "selections": {
            "s_proc_create": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.action",
                        "operator": "equals",
                        "value": "create"
                    }
                ]
            },
            "s_cmd_net_user_or_localgroup": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "net user"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "net localgroup"
                    }
                ]
            },
            "s_cmd_query_user_or_quser": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "query user"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "quser"
                    }
                ]
            },
            "s_cmd_whoami": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "whoami.exe"
                    }
                ]
            },
            "s_cmd_powershell_exe": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "powershell.exe"
                    }
                ]
            },
            "s_cmd_powershell_user_enum_cmdlets": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "Get-LocalUser"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "Get-ADUser"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "Win32_UserAccount"
                    }
                ]
            },
            "s_reg_access_type": {
                "event_type": "registry",
                "conditions": [
                    {
                        "field": "body.registry.keyclass",
                        "operator": "contains",
                        "value": "QueryKey"
                    },
                    {
                        "field": "body.registry.keyclass",
                        "operator": "contains",
                        "value": "OpenKey"
                    },
                    {
                        "field": "body.registry.keyclass",
                        "operator": "contains",
                        "value": "EnumerateKey"
                    }
                ]
            },
            "s_reg_profile_paths": {
                "event_type": "registry",
                "conditions": [
                    {
                        "field": "body.registry.name",
                        "operator": "startswith",
                        "value": "HKEY_LOCAL_MACHINE\\\\SOFTWARE\\\\Microsoft\\\\Windows NT\\\\CurrentVersion\\\\ProfileList"
                    },
                    {
                        "field": "body.registry.name",
                        "operator": "startswith",
                        "value": "HKEY_USERS"
                    }
                ]
            },
            "s_api_user_enum": {
                "event_type": "apicall",
                "conditions": [
                    {
                        "field": "body.apicall.function",
                        "operator": "equals",
                        "value": "GetUserNameW"
                    },
                    {
                        "field": "body.apicall.function",
                        "operator": "equals",
                        "value": "GetUserNameA"
                    },
                    {
                        "field": "body.apicall.function",
                        "operator": "equals",
                        "value": "NetUserEnum"
                    },
                    {
                        "field": "body.apicall.function",
                        "operator": "equals",
                        "value": "WTSQuerySessionInformationW"
                    },
                    {
                        "field": "body.apicall.function",
                        "operator": "equals",
                        "value": "WTSQuerySessionInformationA"
                    }
                ]
            }
        },
        "condition": "(s_proc_create and (s_cmd_net_user_or_localgroup or s_cmd_query_user_or_quser or s_cmd_whoami or (s_cmd_powershell_exe and s_cmd_powershell_user_enum_cmdlets))) or (s_reg_access_type and s_reg_profile_paths) or s_api_user_enum"
    },
    "operational_usage": "SOC 팀은 이 규칙을 활용하여 시스템 로컬 계정 및 그룹 정보 수집 시도를 탐지할 수 있습니다. 'net user', 'net localgroup', 'query user', 'whoami'와 같은 명령 실행, PowerShell을 통한 사용자 열거 시도, 사용자 프로필 관련 레지스트리 키 접근, 또는 사용자 정보 조회 API 호출 등을 모니터링합니다. 탐지된 이벤트는 높은 심각도로 분류되어 즉각적인 알람을 트리거하고, 추가적인 조사 및 침해사고 대응의 우선순위를 지정하는 데 사용될 수 있습니다. 특히 다른 Discovery 또는 Collection 활동과 결합될 때 중요도가 높아집니다.",
    "false_positive": "정상적인 시스템 관리 도구, 백신 소프트웨어, 사용자 환경 설정 스크립트, 또는 합법적인 애플리케이션이 시스템 로컬 계정 정보를 조회하는 과정에서 탐지될 수 있습니다. 알려진 정상 프로세스나 특정 명령줄 패턴을 화이트리스트에 추가하여 오탐을 줄일 수 있습니다."
}