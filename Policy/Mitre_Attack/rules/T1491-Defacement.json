{
    "id": "T1491-Defacement",
    "name": "Defacement",
    "description": "Detects attempts by adversaries to modify visual content available internally or externally to an enterprise network, such as web server files or system login screens, affecting the integrity of the original content. This includes direct file manipulation or use of command-line tools to alter files in sensitive directories.",
    "severity": "high",
    "mitre_attack": {
        "tactic": "TA0040",
        "technique_id": "T1491",
        "subtechnique_id": "",
        "data_sources": [
            "File:File Modification",
            "File:File Creation",
            "Process:Process Creation",
            "Command:Command Execution"
        ]
    },
    "platform": [
        "windows"
    ],
    "detection": {
        "selections": {
            "s1_proc_create_action": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.action",
                        "operator": "equals",
                        "value": "create"
                    }
                ]
            },
            "s2_proc_cmd_powershell_exe": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.exe_path",
                        "operator": "endswith",
                        "value": "cmd.exe"
                    },
                    {
                        "field": "body.process.exe_path",
                        "operator": "endswith",
                        "value": "powershell.exe"
                    }
                ]
            },
            "s3_proc_cmdline_file_mod_cmd": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "copy "
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "move "
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "ren "
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "echo "
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "type "
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "Set-Content"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "Add-Content"
                    }
                ]
            },
            "s4_proc_cmdline_web_root_target": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "C:\\inetpub\\wwwroot\\"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "C:\\Apache24\\htdocs\\"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "C:\\nginx\\html\\"
                    }
                ]
            },
            "s5_proc_cmdline_login_bg_target": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "C:\\Windows\\System32\\oobe\\info\\backgrounds\\"
                    }
                ]
            },
            "s6_fs_mod_create_action": {
                "event_type": "filesystem",
                "conditions": [
                    {
                        "field": "body.filesystem.action",
                        "operator": "equals",
                        "value": "create"
                    },
                    {
                        "field": "body.filesystem.action",
                        "operator": "equals",
                        "value": "write"
                    },
                    {
                        "field": "body.filesystem.action",
                        "operator": "equals",
                        "value": "overwritten"
                    },
                    {
                        "field": "body.filesystem.action",
                        "operator": "equals",
                        "value": "rename"
                    }
                ]
            },
            "s7_fs_web_root_path": {
                "event_type": "filesystem",
                "conditions": [
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "contains",
                        "value": "C:\\inetpub\\wwwroot\\"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "contains",
                        "value": "C:\\Apache24\\htdocs\\"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "contains",
                        "value": "C:\\nginx\\html\\"
                    }
                ]
            },
            "s8_fs_web_file_extension": {
                "event_type": "filesystem",
                "conditions": [
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "endswith",
                        "value": ".html"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "endswith",
                        "value": ".htm"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "endswith",
                        "value": ".php"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "endswith",
                        "value": ".asp"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "endswith",
                        "value": ".aspx"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "endswith",
                        "value": ".js"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "endswith",
                        "value": ".css"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "endswith",
                        "value": ".xml"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "endswith",
                        "value": ".txt"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "endswith",
                        "value": ".jpg"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "endswith",
                        "value": ".png"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "endswith",
                        "value": ".gif"
                    }
                ]
            },
            "s9_fs_login_bg_path": {
                "event_type": "filesystem",
                "conditions": [
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "contains",
                        "value": "C:\\Windows\\System32\\oobe\\info\\backgrounds\\"
                    }
                ]
            },
            "s10_fs_login_bg_extension": {
                "event_type": "filesystem",
                "conditions": [
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "endswith",
                        "value": ".bmp"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "endswith",
                        "value": ".jpg"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "endswith",
                        "value": ".jpeg"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "endswith",
                        "value": ".png"
                    }
                ]
            }
        },
        "condition": "(s1_proc_create_action and s2_proc_cmd_powershell_exe and s3_proc_cmdline_file_mod_cmd and (s4_proc_cmdline_web_root_target or s5_proc_cmdline_login_bg_target)) or (s6_fs_mod_create_action and s7_fs_web_root_path and s8_fs_web_file_extension) or (s6_fs_mod_create_action and s9_fs_login_bg_path and s10_fs_login_bg_extension)"
    },
    "operational_usage": "SOC 팀은 이 규칙을 활용하여 웹 서버 파일이나 시스템 로그인 화면과 같은 중요한 시각적 콘텐츠의 무단 변경 시도를 탐지할 수 있습니다. 프로세스 생성 이벤트에서 cmd.exe 또는 powershell.exe가 파일 수정 명령과 함께 웹 루트 경로 또는 로그인 배경 경로를 대상으로 하는 경우를 모니터링합니다. 또한, 파일 시스템 이벤트에서 웹 루트 또는 로그인 배경 경로 내의 파일에 대한 생성, 쓰기, 덮어쓰기, 이름 변경 활동을 감지합니다. 탐지된 이벤트는 높은 심각도로 분류되어 즉각적인 알람을 트리거하고, 관련된 프로세스 및 파일에 대한 추가적인 포렌식 조사를 시작하는 데 사용될 수 있습니다. 특히, 웹 애플리케이션 취약점 악용 또는 다른 Impact 전술과 결합될 때 중요도가 더욱 높아집니다.",
    "false_positive": "정상적인 웹 서버 관리 작업 (예: 콘텐츠 업데이트, 배포 스크립트 실행), 시스템 업데이트, 또는 합법적인 사용자 지정 로그인 화면 설정 도구에 의해 오탐이 발생할 수 있습니다. 알려진 정상적인 프로세스, 특정 명령줄 패턴, 또는 특정 파일 경로에 대해 화이트리스트를 적용하여 오탐을 줄일 수 있습니다."
}