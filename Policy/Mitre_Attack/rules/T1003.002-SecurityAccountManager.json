{
    "id": "T1003.002-SecurityAccountManager",
    "name": "Security Account Manager (SAM) Credential Access",
    "description": "Detects attempts to extract credential material from the Security Account Manager (SAM) database, either through in-memory techniques or by accessing the Windows Registry where the SAM database is stored. This includes execution of known credential dumping tools or specific commands to dump the SAM and SYSTEM hives.",
    "severity": "high",
    "mitre_attack": {
        "tactic": "TA0006",
        "technique_id": "T1003",
        "subtechnique_id": "T1003.002",
        "data_sources": [
            "Enterprise:Execution:Command and Scripting Interpreter:Windows Command Shell",
            "Enterprise:Collection:Data from Local System",
            "Enterprise:Discovery:Query Registry",
            "Enterprise:Collection:Data Staged:Local Data Staging",
            "Enterprise:Execution:Native API"
        ]
    },
    "platform": [
        "windows"
    ],
    "detection": {
        "selections": {
            "s1_process_create_action": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.action",
                        "operator": "equals",
                        "value": "create"
                    }
                ]
            },
            "s2_cmdline_reg_save_sam_or_system": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "reg save HKLM\\\\sam"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "reg save HKLM\\\\system"
                    }
                ]
            },
            "s3_cmdline_credential_dump_tools": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "mimikatz"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "gsecdump"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "pwdumpx"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "secretsdump"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "creddump7"
                    }
                ]
            },
            "s4_filesystem_sam_access_action": {
                "event_type": "filesystem",
                "conditions": [
                    {
                        "field": "body.filesystem.action",
                        "operator": "equals",
                        "value": "read"
                    },
                    {
                        "field": "body.filesystem.action",
                        "operator": "equals",
                        "value": "open"
                    },
                    {
                        "field": "body.filesystem.action",
                        "operator": "equals",
                        "value": "exists"
                    }
                ]
            },
            "s5_filesystem_sam_filepath": {
                "event_type": "filesystem",
                "conditions": [
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "contains",
                        "value": "\\\\Windows\\\\system32\\\\config\\\\SAM"
                    }
                ]
            },
            "s6_registry_access_action": {
                "event_type": "registry",
                "conditions": [
                    {
                        "field": "body.registry.keyclass",
                        "operator": "contains",
                        "value": "Query"
                    },
                    {
                        "field": "body.registry.keyclass",
                        "operator": "contains",
                        "value": "OpenKey"
                    },
                    {
                        "field": "body.registry.keyclass",
                        "operator": "contains",
                        "value": "Enumerate"
                    },
                    {
                        "field": "body.registry.keyclass",
                        "operator": "contains",
                        "value": "SetValue"
                    }
                ]
            },
            "s7_registry_sam_paths": {
                "event_type": "registry",
                "conditions": [
                    {
                        "field": "body.registry.name",
                        "operator": "startswith",
                        "value": "HKEY_LOCAL_MACHINE\\\\SAM"
                    },
                    {
                        "field": "body.registry.name",
                        "operator": "startswith",
                        "value": "HKEY_LOCAL_MACHINE\\\\SECURITY"
                    },
                    {
                        "field": "body.registry.name",
                        "operator": "startswith",
                        "value": "HKEY_LOCAL_MACHINE\\\\SYSTEM"
                    }
                ]
            },
            "s8_apicall_sam_enumeration_or_query": {
                "event_type": "apicall",
                "conditions": [
                    {
                        "field": "body.apicall.function",
                        "operator": "contains",
                        "value": "SamEnumerate"
                    },
                    {
                        "field": "body.apicall.function",
                        "operator": "contains",
                        "value": "SamOpen"
                    },
                    {
                        "field": "body.apicall.function",
                        "operator": "contains",
                        "value": "SamQuery"
                    },
                    {
                        "field": "body.apicall.function",
                        "operator": "contains",
                        "value": "LsaRetrievePrivateData"
                    },
                    {
                        "field": "body.apicall.function",
                        "operator": "contains",
                        "value": "LsaGetAppliedCAPs"
                    }
                ]
            }
        },
        "condition": "(s1_process_create_action and (s2_cmdline_reg_save_sam_or_system or s3_cmdline_credential_dump_tools)) or (s4_filesystem_sam_access_action and s5_filesystem_sam_filepath) or (s6_registry_access_action and s7_registry_sam_paths) or s8_apicall_sam_enumeration_or_query"
    },
    "operational_usage": "SOC 팀은 이 규칙을 활용하여 시스템의 SAM 데이터베이스에서 자격 증명 정보를 추출하려는 시도를 탐지할 수 있습니다. 'reg save' 명령을 사용한 SAM 및 SYSTEM 하이브 덤프 시도, Mimikatz와 같은 알려진 자격 증명 덤프 도구 실행, SAM 파일에 대한 직접적인 파일 시스템 접근, 또는 SAM 관련 레지스트리 키에 대한 비정상적인 접근 및 관련 API 호출을 모니터링합니다. 탐지된 이벤트는 높은 심각도로 분류되어 즉각적인 알람을 트리거하고, 해당 프로세스 및 관련 활동에 대한 심층적인 포렌식 조사를 시작하는 데 사용될 수 있습니다. 이는 자격 증명 탈취 공격의 핵심 단계이므로, 신속한 대응이 중요합니다.",
    "false_positive": "정상적인 시스템 관리 도구, 백신 소프트웨어, 또는 보안 감사 도구가 시스템의 SAM 데이터베이스나 관련 레지스트리 키를 합법적으로 조회하거나 백업하는 과정에서 오탐이 발생할 수 있습니다. 알려진 정상 프로세스나 특정 명령줄 패턴을 화이트리스트에 추가하여 오탐을 줄일 수 있습니다."
}