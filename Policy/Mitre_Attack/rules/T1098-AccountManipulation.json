{
    "id": "T1098-AccountManipulation",
    "name": "Account Manipulation",
    "description": "Detects attempts by adversaries to manipulate accounts to maintain and/or elevate access to victim systems. This includes creating new accounts, modifying existing account credentials or permissions, or altering group memberships through command-line utilities (e.g., net user, net localgroup), PowerShell cmdlets, or direct Windows API calls.",
    "severity": "high",
    "mitre_attack": {
        "tactic": "persistence",
        "technique_id": "T1098",
        "subtechnique_id": "",
        "data_sources": [
            "Command:CommandExecution",
            "Process:ProcessCreation",
            "ActiveDirectory:ActiveDirectoryObjectModification",
            "File:FileModification",
            "Group:GroupModification",
            "UserAccount:UserAccountModification"
        ]
    },
    "platform": [
        "windows"
    ],
    "detection": {
        "selections": {
            "s_proc_create": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.action",
                        "operator": "equals",
                        "value": "create"
                    }
                ]
            },
            "s_cmd_net_user": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "net user"
                    }
                ]
            },
            "s_cmd_net_localgroup": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "net localgroup"
                    }
                ]
            },
            "s_cmd_powershell": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "powershell.exe"
                    }
                ]
            },
            "s_cmd_arg_add": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "/add"
                    }
                ]
            },
            "s_cmd_arg_delete": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "/delete"
                    }
                ]
            },
            "s_cmd_arg_active": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "/active:"
                    }
                ]
            },
            "s_cmd_arg_passwordreq": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "/passwordreq:"
                    }
                ]
            },
            "s_cmd_arg_expires": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "/expires:"
                    }
                ]
            },
            "s_cmd_arg_comment": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "/comment:"
                    }
                ]
            },
            "s_cmd_arg_homedir": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "/homedir:"
                    }
                ]
            },
            "s_cmd_arg_logonpasswordchg": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "/logonpasswordchg:"
                    }
                ]
            },
            "s_cmd_ps_new_localuser": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "New-LocalUser"
                    }
                ]
            },
            "s_cmd_ps_set_localuser": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "Set-LocalUser"
                    }
                ]
            },
            "s_cmd_ps_remove_localuser": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "Remove-LocalUser"
                    }
                ]
            },
            "s_cmd_ps_add_localgroupmember": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "Add-LocalGroupMember"
                    }
                ]
            },
            "s_cmd_ps_remove_localgroupmember": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "Remove-LocalGroupMember"
                    }
                ]
            },
            "s_cmd_ps_new_aduser": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "New-ADUser"
                    }
                ]
            },
            "s_cmd_ps_set_aduser": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "Set-ADUser"
                    }
                ]
            },
            "s_cmd_ps_remove_aduser": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "Remove-ADUser"
                    }
                ]
            },
            "s_cmd_ps_add_adgroupmember": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "Add-ADGroupMember"
                    }
                ]
            },
            "s_cmd_ps_remove_adgroupmember": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "Remove-ADGroupMember"
                    }
                ]
            },
            "s_api_netuser_add": {
                "event_type": "apicall",
                "conditions": [
                    {
                        "field": "body.apicall.function",
                        "operator": "equals",
                        "value": "NetUserAdd"
                    }
                ]
            },
            "s_api_netuser_setinfo": {
                "event_type": "apicall",
                "conditions": [
                    {
                        "field": "body.apicall.function",
                        "operator": "equals",
                        "value": "NetUserSetInfo"
                    }
                ]
            },
            "s_api_netuser_del": {
                "event_type": "apicall",
                "conditions": [
                    {
                        "field": "body.apicall.function",
                        "operator": "equals",
                        "value": "NetUserDel"
                    }
                ]
            },
            "s_api_netuser_changepassword": {
                "event_type": "apicall",
                "conditions": [
                    {
                        "field": "body.apicall.function",
                        "operator": "equals",
                        "value": "NetUserChangePassword"
                    }
                ]
            },
            "s_api_netlocalgroup_addmembers": {
                "event_type": "apicall",
                "conditions": [
                    {
                        "field": "body.apicall.function",
                        "operator": "equals",
                        "value": "NetLocalGroupAddMembers"
                    }
                ]
            },
            "s_api_netlocalgroup_delmembers": {
                "event_type": "apicall",
                "conditions": [
                    {
                        "field": "body.apicall.function",
                        "operator": "equals",
                        "value": "NetLocalGroupDelMembers"
                    }
                ]
            },
            "s_api_lsa_addaccountrights": {
                "event_type": "apicall",
                "conditions": [
                    {
                        "field": "body.apicall.function",
                        "operator": "equals",
                        "value": "LsaAddAccountRights"
                    }
                ]
            },
            "s_api_lsa_removeaccountrights": {
                "event_type": "apicall",
                "conditions": [
                    {
                        "field": "body.apicall.function",
                        "operator": "equals",
                        "value": "LsaRemoveAccountRights"
                    }
                ]
            }
        },
        "condition": "s_proc_create and ((s_cmd_net_user and s_cmd_arg_add) or (s_cmd_net_user and s_cmd_arg_delete) or (s_cmd_net_user and (s_cmd_arg_active or s_cmd_arg_passwordreq or s_cmd_arg_expires or s_cmd_arg_comment or s_cmd_arg_homedir or s_cmd_arg_logonpasswordchg)) or (s_cmd_net_localgroup and s_cmd_arg_add) or (s_cmd_net_localgroup and s_cmd_arg_delete) or (s_cmd_powershell and (s_cmd_ps_new_localuser or s_cmd_ps_set_localuser or s_cmd_ps_remove_localuser)) or (s_cmd_powershell and (s_cmd_ps_add_localgroupmember or s_cmd_ps_remove_localgroupmember)) or (s_cmd_powershell and (s_cmd_ps_new_aduser or s_cmd_ps_set_aduser or s_cmd_ps_remove_aduser)) or (s_cmd_powershell and (s_cmd_ps_add_adgroupmember or s_cmd_ps_remove_adgroupmember))) or s_api_netuser_add or s_api_netuser_setinfo or s_api_netuser_del or s_api_netuser_changepassword or s_api_netlocalgroup_addmembers or s_api_netlocalgroup_delmembers or s_api_lsa_addaccountrights or s_api_lsa_removeaccountrights"
    },
    "operational_usage": "SOC 팀은 이 규칙을 활용하여 시스템 계정 조작 시도를 탐지할 수 있습니다. 'net user', 'net localgroup'과 같은 명령 실행, PowerShell을 통한 로컬 및 도메인 사용자/그룹 조작 시도, 또는 직접적인 Windows API 호출을 모니터링합니다. 탐지된 이벤트는 높은 심각도로 분류되어 즉각적인 알람을 트리거하고, 관련 프로세스 및 계정 변경 사항에 대한 추가적인 포렌식 조사를 시작하는 데 사용될 수 있습니다. 특히, 권한 상승 또는 지속성 전술과 결합될 때 중요도가 더욱 높아집니다.",
    "false_positive": "정상적인 시스템 관리 작업, 사용자 계정 관리 도구, 또는 합법적인 애플리케이션이 계정을 생성, 수정, 삭제하거나 그룹 멤버십을 변경하는 과정에서 오탐이 발생할 수 있습니다. 알려진 정상적인 관리 스크립트나 특정 프로세스에 대해 화이트리스트를 적용하여 오탐을 줄일 수 있습니다."
}