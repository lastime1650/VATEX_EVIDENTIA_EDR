{
    "id": "T1550-UseAlternateAuthenticationMaterial",
    "name": "Use Alternate Authentication Material",
    "description": "Detects attempts by adversaries to use stolen authentication material (such as password hashes, Kerberos tickets, or application access tokens) to move laterally or bypass normal system access controls. This often involves executing credential dumping tools like Mimikatz or Rubeus, accessing the LSASS process memory, or making specific API calls related to token impersonation or programmatic logon.",
    "severity": "high",
    "mitre_attack": {
        "tactic": "TA0005",
        "technique_id": "T1550",
        "subtechnique_id": "",
        "data_sources": [
            "Execution:Command and Scripting Interpreter:Windows Command Shell",
            "Credential Access:OS Credential Dumping:LSASS Memory",
            "Execution:Native API"
        ]
    },
    "platform": [
        "windows"
    ],
    "detection": {
        "selections": {
            "s1_process_create_action": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.action",
                        "operator": "equals",
                        "value": "create"
                    }
                ]
            },
            "s2_cmdline_mimikatz_tool": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "mimikatz.exe"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "sekurlsa::logonpasswords"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "lsadump::lsa"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "privilege::debug"
                    }
                ]
            },
            "s3_cmdline_rubeus_tool": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "rubeus.exe"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "dump"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "ptt"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "kerberoast"
                    }
                ]
            },
            "s4_lsass_process_access_target_path": {
                "event_type": "processaccess",
                "conditions": [
                    {
                        "field": "body.processaccess.filepath",
                        "operator": "endswith",
                        "value": "lsass.exe"
                    }
                ]
            },
            "s5_lsass_process_access_handle_type": {
                "event_type": "processaccess",
                "conditions": [
                    {
                        "field": "body.processaccess.handletype",
                        "operator": "equals",
                        "value": "create"
                    },
                    {
                        "field": "body.processaccess.handletype",
                        "operator": "equals",
                        "value": "duplicate"
                    }
                ]
            },
            "s6_lsass_process_access_rights_read_dup": {
                "event_type": "processaccess",
                "conditions": [
                    {
                        "field": "body.processaccess.desiredaccesses",
                        "operator": "contains",
                        "value": "PROCESS_VM_READ"
                    },
                    {
                        "field": "body.processaccess.desiredaccesses",
                        "operator": "contains",
                        "value": "PROCESS_DUP_HANDLE"
                    },
                    {
                        "field": "body.processaccess.desiredaccesses",
                        "operator": "contains",
                        "value": "PROCESS_ALL_ACCESS"
                    }
                ]
            },
            "s7_apicall_auth_related_functions": {
                "event_type": "apicall",
                "conditions": [
                    {
                        "field": "body.apicall.function",
                        "operator": "equals",
                        "value": "NtImpersonateThread"
                    },
                    {
                        "field": "body.apicall.function",
                        "operator": "equals",
                        "value": "NtImpersonateClientOfPort"
                    },
                    {
                        "field": "body.apicall.function",
                        "operator": "equals",
                        "value": "LsaLogonUser"
                    },
                    {
                        "field": "body.apicall.function",
                        "operator": "equals",
                        "value": "CreateProcessWithLogonW"
                    }
                ]
            }
        },
        "condition": "(s1_process_create_action and (s2_cmdline_mimikatz_tool or s3_cmdline_rubeus_tool)) or (s4_lsass_process_access_target_path and s5_lsass_process_access_handle_type and s6_lsass_process_access_rights_read_dup) or s7_apicall_auth_related_functions"
    },
    "operational_usage": "SOC 팀은 이 규칙을 활용하여 공격자가 대체 인증 자료를 사용하여 시스템에 접근하거나 측면 이동을 시도하는 것을 탐지할 수 있습니다. Mimikatz, Rubeus와 같은 크리덴셜 탈취 도구의 실행, LSASS 프로세스 메모리 접근 시도, 또는 토큰 조작 및 프로그램적 로그온과 관련된 API 호출을 모니터링합니다. 탐지된 이벤트는 높은 심각도로 분류되어 즉각적인 알람을 트리거하고, 관련 프로세스 및 사용자 활동에 대한 심층 조사를 시작하는 데 사용될 수 있습니다. 이는 크리덴셜 접근 및 측면 이동 전술의 핵심 지표로 활용됩니다.",
    "false_positive": "정상적인 시스템 관리 도구, 보안 소프트웨어, 또는 합법적인 애플리케이션이 LSASS 프로세스에 접근하거나 인증 관련 API를 호출하는 경우 오탐이 발생할 수 있습니다. 특히 디버거, 안티바이러스 소프트웨어, 또는 특정 관리 스크립트가 LSASS 메모리를 검사할 수 있습니다. 알려진 정상 프로세스나 특정 명령줄 패턴을 화이트리스트에 추가하여 오탐을 줄일 수 있습니다."
}