{
    "id": "T1606.001-WebCookies",
    "name": "Web Cookies Forging",
    "description": "Detects attempts by adversaries to forge web cookies to gain unauthorized access to web applications or Internet services. This involves monitoring the execution of command-line tools, scripts, or direct API calls that manipulate HTTP headers or access browser cookie storage files in an unusual manner, aiming to bypass authentication mechanisms.",
    "severity": "high",
    "mitre_attack": {
        "tactic": "TA0006",
        "technique_id": "T1606",
        "subtechnique_id": "T1606.001",
        "data_sources": [
            "LogonSession:LogonSessionCreation",
            "WebCredential:WebCredentialUsage"
        ]
    },
    "platform": [
        "windows"
    ],
    "detection": {
        "selections": {
            "s1_powershell_exe_create": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.action",
                        "operator": "equals",
                        "value": "create"
                    },
                    {
                        "field": "body.process.exe_path",
                        "operator": "endswith",
                        "value": "\\powershell.exe"
                    }
                ]
            },
            "s2_powershell_invoke_webrequest": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "Invoke-WebRequest"
                    }
                ]
            },
            "s3_powershell_custom_headers": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "-Headers"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "-SessionVariable"
                    }
                ]
            },
            "s4_curl_wget_exe_create": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.action",
                        "operator": "equals",
                        "value": "create"
                    },
                    {
                        "field": "body.process.exe_path",
                        "operator": "endswith",
                        "value": "\\curl.exe"
                    },
                    {
                        "field": "body.process.exe_path",
                        "operator": "endswith",
                        "value": "\\wget.exe"
                    }
                ]
            },
            "s5_curl_wget_cookie_args": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "--cookie"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "--header \"Cookie:"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "--load-cookies"
                    }
                ]
            },
            "s6_filesystem_write_create_action": {
                "event_type": "filesystem",
                "conditions": [
                    {
                        "field": "body.filesystem.action",
                        "operator": "equals",
                        "value": "write"
                    },
                    {
                        "field": "body.filesystem.action",
                        "operator": "equals",
                        "value": "create"
                    }
                ]
            },
            "s7_filesystem_browser_cookie_path": {
                "event_type": "filesystem",
                "conditions": [
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "contains",
                        "value": "\\AppData\\Local\\Google\\Chrome\\User Data\\Default\\Cookies"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "contains",
                        "value": "\\AppData\\Roaming\\Mozilla\\Firefox\\Profiles\\"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "contains",
                        "value": "\\AppData\\Local\\Microsoft\\Edge\\User Data\\Default\\Cookies"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "contains",
                        "value": "\\Web Data"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "contains",
                        "value": "\\Login Data"
                    }
                ]
            },
            "s8_apicall_internet_set_cookie": {
                "event_type": "apicall",
                "conditions": [
                    {
                        "field": "body.apicall.function",
                        "operator": "equals",
                        "value": "InternetSetCookieW"
                    },
                    {
                        "field": "body.apicall.function",
                        "operator": "equals",
                        "value": "InternetSetCookieA"
                    }
                ]
            },
            "s9_apicall_http_add_request_headers": {
                "event_type": "apicall",
                "conditions": [
                    {
                        "field": "body.apicall.function",
                        "operator": "equals",
                        "value": "HttpAddRequestHeadersW"
                    },
                    {
                        "field": "body.apicall.function",
                        "operator": "equals",
                        "value": "HttpAddRequestHeadersA"
                    }
                ]
            }
        },
        "condition": "(s1_powershell_exe_create and s2_powershell_invoke_webrequest and s3_powershell_custom_headers) or (s4_curl_wget_exe_create and s5_curl_wget_cookie_args) or (s6_filesystem_write_create_action and s7_filesystem_browser_cookie_path) or s8_apicall_internet_set_cookie or s9_apicall_http_add_request_headers"
    },
    "operational_usage": "SOC 팀은 이 규칙을 활용하여 웹 쿠키 위조 시도를 탐지할 수 있습니다. PowerShell의 Invoke-WebRequest와 같은 명령줄 도구를 사용하여 사용자 지정 헤더를 삽입하거나, curl/wget과 같은 유틸리티로 쿠키를 주입하는 프로세스 생성 이벤트를 모니터링합니다. 또한, 비정상적인 프로세스가 브라우저 쿠키 저장소 파일에 쓰기/생성 작업을 수행하거나, InternetSetCookie/HttpAddRequestHeaders와 같은 API를 호출하는 경우를 탐지합니다. 탐지된 이벤트는 즉각적인 알람을 트리거하고, 관련 프로세스 활동 및 네트워크 트래픽에 대한 심층 조사를 시작하여 침해사고 대응의 우선순위를 지정하는 데 사용될 수 있습니다.",
    "false_positive": "정상적인 웹 개발 도구, 브라우저 확장 프로그램, 자동화된 테스트 스크립트, 또는 시스템 관리 유틸리티가 합법적으로 쿠키를 조작하거나 브라우저 저장소에 접근하는 경우 오탐이 발생할 수 있습니다. 알려진 정상 프로세스나 특정 명령줄 패턴, 혹은 특정 사용자 활동에 대해 화이트리스트를 적용하여 오탐을 줄일 수 있습니다."
}