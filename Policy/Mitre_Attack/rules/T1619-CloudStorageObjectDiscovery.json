{
    "id": "T1619-CloudStorageObjectDiscovery",
    "name": "Cloud Storage Object Discovery",
    "description": "Detects attempts by an endpoint process to enumerate objects in cloud storage infrastructure (e.g., AWS S3, Azure Blob, Google Cloud Storage) using command-line interface (CLI) tools or PowerShell modules. Adversaries use this technique to identify available data for collection, exfiltration, or manipulation, often as a precursor to further malicious activities.",
    "severity": "high",
    "mitre_attack": {
        "tactic": "TA0007",
        "technique_id": "T1619",
        "subtechnique_id": "",
        "data_sources": [
            "Enterprise:Discovery:Cloud Storage Object Discovery"
        ]
    },
    "platform": [
        "windows"
    ],
    "detection": {
        "selections": {
            "s_process_create": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.action",
                        "operator": "equals",
                        "value": "create"
                    }
                ]
            },
            "s_aws_cli_exe": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "aws.exe"
                    }
                ]
            },
            "s_aws_s3_keyword": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "s3"
                    }
                ]
            },
            "s_aws_ls_action": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "ls"
                    }
                ]
            },
            "s_aws_list_objects_action": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "list-objects"
                    }
                ]
            },
            "s_az_cli_exe": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "az.exe"
                    }
                ]
            },
            "s_az_storage_keyword": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "storage"
                    }
                ]
            },
            "s_az_blob_keyword": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "blob"
                    }
                ]
            },
            "s_az_list_action": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "list"
                    }
                ]
            },
            "s_gcloud_cli_exe": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "gcloud.exe"
                    }
                ]
            },
            "s_gcloud_storage_keyword": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "storage"
                    }
                ]
            },
            "s_gcloud_ls_action": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "ls"
                    }
                ]
            },
            "s_gcloud_list_action": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "list"
                    }
                ]
            },
            "s_powershell_exe": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "powershell.exe"
                    }
                ]
            },
            "s_ps_get_s3object_cmdlet": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "Get-S3Object"
                    }
                ]
            },
            "s_ps_get_azstorageblob_cmdlet": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "Get-AzStorageBlob"
                    }
                ]
            },
            "s_ps_get_gcsobject_cmdlet": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "Get-GcsObject"
                    }
                ]
            }
        },
        "condition": "s_process_create and ((s_aws_cli_exe and s_aws_s3_keyword and (s_aws_ls_action or s_aws_list_objects_action)) or (s_az_cli_exe and s_az_storage_keyword and s_az_blob_keyword and s_az_list_action) or (s_gcloud_cli_exe and s_gcloud_storage_keyword and (s_gcloud_ls_action or s_gcloud_list_action)) or (s_powershell_exe and s_ps_get_s3object_cmdlet) or (s_powershell_exe and s_ps_get_azstorageblob_cmdlet) or (s_powershell_exe and s_ps_get_gcsobject_cmdlet))"
    },
    "operational_usage": "SOC 팀은 이 규칙을 활용하여 엔드포인트에서 클라우드 스토리지 객체 탐색 시도를 탐지할 수 있습니다. AWS CLI, Azure CLI, gcloud CLI 또는 PowerShell을 이용한 S3 버킷, Azure Blob, Google Cloud Storage 객체 목록 조회 명령 실행을 모니터링합니다. 탐지된 이벤트는 높은 심각도로 분류되어 즉각적인 알람을 트리거하고, 해당 프로세스의 활동 및 관련 사용자 계정에 대한 추가 조사를 시작하는 데 사용될 수 있습니다. 이는 데이터 유출 또는 조작 전 단계의 중요한 징후가 될 수 있습니다.",
    "false_positive": "정상적인 클라우드 관리 도구, 백업 스크립트, 개발자 환경, 또는 합법적인 애플리케이션이 클라우드 스토리지 객체를 조회하는 과정에서 오탐이 발생할 수 있습니다. 알려진 정상적인 CLI 명령 패턴, 특정 프로세스, 또는 사용자 계정을 화이트리스트에 추가하여 오탐을 줄일 수 있습니다."
}