{
    "id": "T1562-ImpairDefenses",
    "name": "Impair Defenses",
    "description": "Detects attempts by adversaries to maliciously modify components of a victim environment in order to hinder or disable defensive mechanisms. This includes disabling security software (e.g., Windows Defender), firewall rules, User Account Control (UAC), or event logging services through command-line utilities, registry modifications, or API calls.",
    "severity": "high",
    "mitre_attack": {
        "tactic": "TA0005",
        "technique_id": "T1562",
        "subtechnique_id": "",
        "data_sources": [
            "Enterprise:Execution:Command and Scripting Interpreter:Windows Command Shell",
            "Enterprise:Execution:Command and Scripting Interpreter:PowerShell",
            "Enterprise:Defense Evasion:Impair Defenses:Disable or Modify Tools",
            "Enterprise:Defense Evasion:Impair Defenses:Disable or Modify System Firewall",
            "Enterprise:Defense Evasion:Impair Defenses:Disable Windows Event Logging",
            "Enterprise:Defense Evasion:Modify Registry",
            "Enterprise:Execution:Native API"
        ]
    },
    "platform": [
        "windows"
    ],
    "detection": {
        "selections": {
            "s1_process_create_action": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.action",
                        "operator": "equals",
                        "value": "create"
                    }
                ]
            },
            "s2_cmd_disable_service": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "sc stop"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "net stop"
                    }
                ]
            },
            "s3_cmd_disable_defender": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "MpCmdRun.exe -DisableService"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "Set-MpPreference"
                    }
                ]
            },
            "s4_cmd_disable_firewall": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "netsh advfirewall set"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "Set-NetFirewallProfile"
                    }
                ]
            },
            "s5_cmd_disable_uac_registry": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "reg.exe add HKLM\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Policies\\System /v EnableLUA /t REG_DWORD /d 0"
                    }
                ]
            },
            "s6_cmd_clear_eventlogs": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "wevtutil cl"
                    }
                ]
            },
            "s7_process_terminate_action": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.action",
                        "operator": "equals",
                        "value": "remove"
                    }
                ]
            },
            "s8_terminate_security_process": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.exe_path",
                        "operator": "endswith",
                        "value": "MsMpEng.exe"
                    },
                    {
                        "field": "body.process.exe_path",
                        "operator": "endswith",
                        "value": "WmiPrvSE.exe"
                    },
                    {
                        "field": "body.process.exe_path",
                        "operator": "endswith",
                        "value": "SgrmBroker.exe"
                    }
                ]
            },
            "s9_registry_mod_action": {
                "event_type": "registry",
                "conditions": [
                    {
                        "field": "body.registry.keyclass",
                        "operator": "equals",
                        "value": "RegNtSetValueKey"
                    },
                    {
                        "field": "body.registry.keyclass",
                        "operator": "equals",
                        "value": "RegNtDeleteKey"
                    }
                ]
            },
            "s10_reg_uac_path": {
                "event_type": "registry",
                "conditions": [
                    {
                        "field": "body.registry.name",
                        "operator": "equals",
                        "value": "HKEY_LOCAL_MACHINE\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Policies\\System\\EnableLUA"
                    }
                ]
            },
            "s11_reg_defender_disable_path": {
                "event_type": "registry",
                "conditions": [
                    {
                        "field": "body.registry.name",
                        "operator": "contains",
                        "value": "HKEY_LOCAL_MACHINE\\SOFTWARE\\Microsoft\\Windows Defender\\DisableAntiSpyware"
                    },
                    {
                        "field": "body.registry.name",
                        "operator": "contains",
                        "value": "HKEY_LOCAL_MACHINE\\SOFTWARE\\Policies\\Microsoft\\Windows Defender"
                    }
                ]
            },
            "s12_reg_eventlog_disable_path": {
                "event_type": "registry",
                "conditions": [
                    {
                        "field": "body.registry.name",
                        "operator": "contains",
                        "value": "HKEY_LOCAL_MACHINE\\SYSTEM\\CurrentControlSet\\Services\\EventLog"
                    },
                    {
                        "field": "body.registry.name",
                        "operator": "contains",
                        "value": "\\Start"
                    }
                ]
            },
            "s13_reg_firewall_disable_path": {
                "event_type": "registry",
                "conditions": [
                    {
                        "field": "body.registry.name",
                        "operator": "contains",
                        "value": "HKEY_LOCAL_MACHINE\\SYSTEM\\CurrentControlSet\\Services\\SharedAccess\\Parameters\\FirewallPolicy"
                    },
                    {
                        "field": "body.registry.name",
                        "operator": "contains",
                        "value": "\\EnableFirewall"
                    }
                ]
            },
            "s14_apicall_service_control": {
                "event_type": "apicall",
                "conditions": [
                    {
                        "field": "body.apicall.function",
                        "operator": "equals",
                        "value": "ChangeServiceConfigW"
                    },
                    {
                        "field": "body.apicall.function",
                        "operator": "equals",
                        "value": "ChangeServiceConfigA"
                    },
                    {
                        "field": "body.apicall.function",
                        "operator": "equals",
                        "value": "ControlService"
                    }
                ]
            }
        },
        "condition": "(s1_process_create_action and (s2_cmd_disable_service or s3_cmd_disable_defender or s4_cmd_disable_firewall or s5_cmd_disable_uac_registry or s6_cmd_clear_eventlogs)) or (s7_process_terminate_action and s8_terminate_security_process) or (s9_registry_mod_action and (s10_reg_uac_path or s11_reg_defender_disable_path or (s12_reg_eventlog_disable_path and s9_registry_mod_action) or (s13_reg_firewall_disable_path and s9_registry_mod_action))) or s14_apicall_service_control"
    },
    "operational_usage": "SOC 팀은 이 규칙을 활용하여 시스템 방어 메커니즘 무력화 시도를 실시간으로 탐지할 수 있습니다. Windows Defender, 시스템 방화벽, UAC, 이벤트 로깅 서비스 등을 비활성화하거나 수정하려는 명령 실행, 관련 레지스트리 키 변경, 또는 서비스 제어 API 호출을 모니터링합니다. 탐지된 이벤트는 높은 심각도로 분류되어 즉각적인 알람을 트리거하고, 침해사고 대응팀에 전달되어 추가적인 조사 및 대응 조치를 시작하는 데 사용됩니다. 이는 공격자가 시스템에 대한 지속적인 접근을 확보하거나 악성 활동을 숨기기 위한 핵심 전술이므로, 초기 단계에서 탐지하는 것이 중요합니다.",
    "false_positive": "정상적인 시스템 관리 작업, 소프트웨어 설치/제거 프로세스, 시스템 업데이트, 또는 합법적인 보안 솔루션의 자체 비활성화/변경 과정에서 오탐이 발생할 수 있습니다. 특히 관리자가 서비스나 방화벽 설정을 변경하거나, 특정 보안 제품을 제거하는 경우에 해당될 수 있습니다. 이러한 경우, 알려진 정상 프로세스나 특정 명령줄 패턴을 화이트리스트에 추가하여 오탐을 줄일 수 있습니다."
}