{
    "id": "T1550.001-ApplicationAccessToken",
    "name": "Application Access Token Usage",
    "description": "Detects attempts to use or acquire application access tokens, often by interacting with cloud CLI tools, PowerShell scripts, or by accessing local credential stores (web browser databases, cloud SDK configuration files) on a Windows endpoint. This technique allows adversaries to bypass traditional authentication and access restricted resources.",
    "severity": "high",
    "mitre_attack": {
        "tactic": "TA0005,TA0008",
        "technique_id": "T1550",
        "subtechnique_id": "T1550.001",
        "data_sources": [
            "Enterprise:Credential Access:Credentials from Password Stores:Credentials from Web Browsers",
            "Enterprise:Credential Access:Unsecured Credentials:Credentials In Files",
            "Enterprise:Execution:Command and Scripting Interpreter:Windows Command Shell",
            "Enterprise:Execution:Native API"
        ]
    },
    "platform": [
        "windows"
    ],
    "detection": {
        "selections": {
            "s1_process_create_action": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.action",
                        "operator": "equals",
                        "value": "create"
                    }
                ]
            },
            "s2_cli_tool_executable": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.exe_path",
                        "operator": "endswith",
                        "value": "az.exe"
                    },
                    {
                        "field": "body.process.exe_path",
                        "operator": "endswith",
                        "value": "aws.exe"
                    },
                    {
                        "field": "body.process.exe_path",
                        "operator": "endswith",
                        "value": "gcloud.cmd"
                    },
                    {
                        "field": "body.process.exe_path",
                        "operator": "endswith",
                        "value": "powershell.exe"
                    },
                    {
                        "field": "body.process.exe_path",
                        "operator": "endswith",
                        "value": "pwsh.exe"
                    }
                ]
            },
            "s3_cli_command_keywords_token": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "token"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "access-key"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "get-credential"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "sts"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "login"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "configure"
                    }
                ]
            },
            "s4_powershell_web_keywords": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "Invoke-WebRequest"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "Invoke-RestMethod"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "System.Net.WebRequest"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "System.Net.Http"
                    }
                ]
            },
            "s5_filesystem_read_action": {
                "event_type": "filesystem",
                "conditions": [
                    {
                        "field": "body.filesystem.action",
                        "operator": "equals",
                        "value": "read"
                    },
                    {
                        "field": "body.filesystem.action",
                        "operator": "equals",
                        "value": "open"
                    }
                ]
            },
            "s6_browser_credential_paths": {
                "event_type": "filesystem",
                "conditions": [
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "contains",
                        "value": "\\AppData\\Local\\Google\\Chrome\\User Data\\Default\\Login Data"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "contains",
                        "value": "\\AppData\\Roaming\\Mozilla\\Firefox\\Profiles\\"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "contains",
                        "value": "\\AppData\\Local\\Microsoft\\Edge\\User Data\\Default\\Login Data"
                    }
                ]
            },
            "s7_cloud_credential_paths": {
                "event_type": "filesystem",
                "conditions": [
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "contains",
                        "value": "\\.aws\\credentials"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "contains",
                        "value": "\\.azure\\azureProfile.json"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "contains",
                        "value": "\\.config\\gcloud\\credentials"
                    }
                ]
            },
            "s8_apicall_credential_manager": {
                "event_type": "apicall",
                "conditions": [
                    {
                        "field": "body.apicall.function",
                        "operator": "equals",
                        "value": "CredReadW"
                    },
                    {
                        "field": "body.apicall.function",
                        "operator": "equals",
                        "value": "CredReadA"
                    },
                    {
                        "field": "body.apicall.function",
                        "operator": "equals",
                        "value": "CredEnumerateW"
                    },
                    {
                        "field": "body.apicall.function",
                        "operator": "equals",
                        "value": "CredEnumerateA"
                    },
                    {
                        "field": "body.apicall.function",
                        "operator": "equals",
                        "value": "LsaRetrievePrivateData"
                    },
                    {
                        "field": "body.apicall.function",
                        "operator": "equals",
                        "value": "LsaStorePrivateData"
                    }
                ]
            }
        },
        "condition": "(s1_process_create_action and s2_cli_tool_executable and s3_cli_command_keywords_token) or (s1_process_create_action and s2_cli_tool_executable and s4_powershell_web_keywords) or (s5_filesystem_read_action and (s6_browser_credential_paths or s7_cloud_credential_paths)) or s8_apicall_credential_manager"
    },
    "operational_usage": "SOC 팀은 이 규칙을 활용하여 애플리케이션 접근 토큰의 획득 또는 사용 시도를 탐지할 수 있습니다. 클라우드 CLI 도구(az.exe, aws.exe, gcloud.cmd) 또는 PowerShell 스크립트가 토큰 관련 명령줄 인자와 함께 실행되거나, 웹 브라우저의 로컬 자격 증명 데이터베이스 및 클라우드 SDK 구성 파일에 대한 비정상적인 읽기/열기 접근, 그리고 Windows Credential Manager API 호출을 모니터링합니다. 탐지된 이벤트는 높은 심각도로 분류되어 즉각적인 알람을 트리거하고, 관련된 프로세스, 파일 접근, API 호출에 대한 심층적인 조사를 시작하는 데 사용될 수 있습니다. 특히, 다른 자격 증명 접근 또는 방어 회피 전술과 결합될 때 중요도가 더욱 높아집니다.",
    "false_positive": "정상적인 클라우드 관리 도구, 개발 환경의 스크립트, 웹 브라우저의 정상적인 작동, 백신 및 보안 소프트웨어의 스캐닝 활동, 또는 합법적인 애플리케이션이 자격 증명 정보를 조회하는 과정에서 오탐이 발생할 수 있습니다. 알려진 정상 프로세스, 스크립트, 또는 특정 파일 경로에 대해 화이트리스트를 적용하여 오탐을 줄일 수 있습니다."
}