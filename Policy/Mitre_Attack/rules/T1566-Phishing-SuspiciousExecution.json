{
    "id": "T1566-Phishing-SuspiciousExecution",
    "name": "Phishing - Suspicious Execution from Downloads/Temp",
    "description": "Detects attempts by adversaries to gain initial access through phishing by monitoring for suspicious process creation or file activity originating from common download or temporary directories, often indicative of a user executing a malicious attachment or a downloaded payload from a malicious link.",
    "severity": "high",
    "mitre_attack": {
        "tactic": "TA0001",
        "technique_id": "T1566",
        "subtechnique_id": "",
        "data_sources": [
            "Enterprise:Initial Access:Phishing:Spearphishing Attachment",
            "Enterprise:Initial Access:Phishing:Spearphishing Link",
            "Enterprise:Execution:User Execution:Malicious File",
            "Enterprise:Execution:Command and Scripting Interpreter:Windows Command Shell",
            "Enterprise:Defense Evasion:Obfuscated Files or Information:Embedded Payloads"
        ]
    },
    "platform": [
        "windows"
    ],
    "detection": {
        "selections": {
            "s1_process_create_action": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.action",
                        "operator": "equals",
                        "value": "create"
                    }
                ]
            },
            "s2_exe_path_in_temp_or_downloads": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.exe_path",
                        "operator": "contains",
                        "value": "\\AppData\\Local\\Temp\\"
                    },
                    {
                        "field": "body.process.exe_path",
                        "operator": "contains",
                        "value": "\\Downloads\\"
                    },
                    {
                        "field": "body.process.exe_path",
                        "operator": "contains",
                        "value": "\\Temporary Internet Files\\"
                    }
                ]
            },
            "s3_exe_path_suspicious_extension": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.exe_path",
                        "operator": "endswith",
                        "value": ".exe"
                    },
                    {
                        "field": "body.process.exe_path",
                        "operator": "endswith",
                        "value": ".ps1"
                    },
                    {
                        "field": "body.process.exe_path",
                        "operator": "endswith",
                        "value": ".vbs"
                    },
                    {
                        "field": "body.process.exe_path",
                        "operator": "endswith",
                        "value": ".hta"
                    },
                    {
                        "field": "body.process.exe_path",
                        "operator": "endswith",
                        "value": ".js"
                    },
                    {
                        "field": "body.process.exe_path",
                        "operator": "endswith",
                        "value": ".bat"
                    },
                    {
                        "field": "body.process.exe_path",
                        "operator": "endswith",
                        "value": ".cmd"
                    },
                    {
                        "field": "body.process.exe_path",
                        "operator": "endswith",
                        "value": ".lnk"
                    },
                    {
                        "field": "body.process.exe_path",
                        "operator": "endswith",
                        "value": ".dll"
                    }
                ]
            },
            "s4_parent_is_office_app": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.parent_exe_path",
                        "operator": "endswith",
                        "value": "outlook.exe"
                    },
                    {
                        "field": "body.process.parent_exe_path",
                        "operator": "endswith",
                        "value": "winword.exe"
                    },
                    {
                        "field": "body.process.parent_exe_path",
                        "operator": "endswith",
                        "value": "excel.exe"
                    },
                    {
                        "field": "body.process.parent_exe_path",
                        "operator": "endswith",
                        "value": "powerpnt.exe"
                    }
                ]
            },
            "s5_parent_is_browser_app": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.parent_exe_path",
                        "operator": "endswith",
                        "value": "chrome.exe"
                    },
                    {
                        "field": "body.process.parent_exe_path",
                        "operator": "endswith",
                        "value": "firefox.exe"
                    },
                    {
                        "field": "body.process.parent_exe_path",
                        "operator": "endswith",
                        "value": "msedge.exe"
                    },
                    {
                        "field": "body.process.parent_exe_path",
                        "operator": "endswith",
                        "value": "iexplore.exe"
                    }
                ]
            },
            "s6_cmdline_suspicious_script_exec": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "powershell.exe"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "cmd.exe"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "mshta.exe"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "cscript.exe"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "wscript.exe"
                    }
                ]
            },
            "s7_filesystem_create_or_write_action": {
                "event_type": "filesystem",
                "conditions": [
                    {
                        "field": "body.filesystem.action",
                        "operator": "equals",
                        "value": "create"
                    },
                    {
                        "field": "body.filesystem.action",
                        "operator": "equals",
                        "value": "overwritten"
                    },
                    {
                        "field": "body.filesystem.action",
                        "operator": "equals",
                        "value": "write"
                    }
                ]
            },
            "s8_filepath_in_temp_or_downloads_fs": {
                "event_type": "filesystem",
                "conditions": [
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "contains",
                        "value": "\\AppData\\Local\\Temp\\"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "contains",
                        "value": "\\Downloads\\"
                    }
                ]
            },
            "s9_filepath_suspicious_extension_fs": {
                "event_type": "filesystem",
                "conditions": [
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "endswith",
                        "value": ".exe"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "endswith",
                        "value": ".dll"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "endswith",
                        "value": ".ps1"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "endswith",
                        "value": ".vbs"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "endswith",
                        "value": ".hta"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "endswith",
                        "value": ".js"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "endswith",
                        "value": ".bat"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "endswith",
                        "value": ".cmd"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "endswith",
                        "value": ".lnk"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "endswith",
                        "value": ".docm"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "endswith",
                        "value": ".xlsm"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "endswith",
                        "value": ".pptm"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "endswith",
                        "value": ".iso"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "endswith",
                        "value": ".img"
                    }
                ]
            }
        },
        "condition": "(s1_process_create_action and s2_exe_path_in_temp_or_downloads and s3_exe_path_suspicious_extension) or (s1_process_create_action and s4_parent_is_office_app and s3_exe_path_suspicious_extension and s6_cmdline_suspicious_script_exec) or (s1_process_create_action and s5_parent_is_browser_app and s2_exe_path_in_temp_or_downloads and s3_exe_path_suspicious_extension) or (s7_filesystem_create_or_write_action and s8_filepath_in_temp_or_downloads_fs and s9_filepath_suspicious_extension_fs)"
    },
    "operational_usage": "SOC 팀은 이 규칙을 활용하여 피싱 공격의 초기 단계에서 사용자 시스템에 악성 파일이 실행되거나 생성되는 것을 탐지할 수 있습니다. 특히, 다운로드 폴더나 임시 폴더에서 실행 가능한 파일, 스크립트 파일 등이 생성되거나, 이메일 클라이언트 또는 웹 브라우저를 부모 프로세스로 하는 의심스러운 자식 프로세스 생성을 모니터링합니다. 탐지된 이벤트는 높은 심각도로 분류되어 즉각적인 알람을 트리거하고, 관련 프로세스 및 파일에 대한 추가적인 포렌식 조사를 시작하는 데 사용될 수 있습니다.",
    "false_positive": "정상적인 소프트웨어 설치 프로그램, 업데이트 유틸리티, 또는 합법적인 애플리케이션이 임시 폴더나 다운로드 폴더에 파일을 생성하고 실행하는 경우 오탐이 발생할 수 있습니다. 또한, 개발 도구 또는 특정 업무용 스크립트가 유사한 패턴을 보일 수 있습니다. 알려진 정상적인 프로세스 경로, 파일 해시, 또는 명령줄 패턴을 화이트리스트에 추가하여 오탐을 줄일 수 있습니다."
}