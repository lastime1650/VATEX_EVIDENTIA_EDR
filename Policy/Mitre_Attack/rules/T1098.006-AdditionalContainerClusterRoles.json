{
    "id": "T1098.006-AdditionalContainerClusterRoles",
    "name": "Additional Container Cluster Roles",
    "description": "Detects attempts to add or modify roles and permissions within container orchestration systems (e.g., Kubernetes, Azure AKS, Google GKE, AWS EKS) from a Windows host. This technique aims to maintain persistent access or escalate privileges by leveraging command-line tools like kubectl, az, gcloud, or aws CLI to manipulate role bindings, cluster role bindings, or IAM policies.",
    "severity": "high",
    "mitre_attack": {
        "tactic": "TA0003",
        "technique_id": "T1098",
        "subtechnique_id": "T1098.006",
        "data_sources": [
            "Persistence:Account Manipulation:Additional Container Cluster Roles",
            "Privilege Escalation:Account Manipulation:Additional Container Cluster Roles",
            "Execution:Command and Scripting Interpreter:Windows Command Shell"
        ]
    },
    "platform": [
        "windows"
    ],
    "detection": {
        "selections": {
            "s_process_create": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.action",
                        "operator": "equals",
                        "value": "create"
                    }
                ]
            },
            "s_kubectl_exe": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.exe_path",
                        "operator": "endswith",
                        "value": "kubectl.exe"
                    }
                ]
            },
            "s_kubectl_role_commands": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "create rolebinding"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "create clusterrolebinding"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "apply -f"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "patch role"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "patch clusterrole"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "edit role"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "edit clusterrole"
                    }
                ]
            },
            "s_az_exe": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.exe_path",
                        "operator": "endswith",
                        "value": "az.exe"
                    }
                ]
            },
            "s_az_aks_role_commands": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "aks update"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "--role"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "--assign-identity"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "ad sp create-for-rbac"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "role assignment create"
                    }
                ]
            },
            "s_gcloud_exe": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.exe_path",
                        "operator": "endswith",
                        "value": "gcloud.exe"
                    }
                ]
            },
            "s_gcloud_cluster_role_commands": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "container clusters update"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "iam roles update"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "iam service-accounts add-iam-policy-binding"
                    }
                ]
            },
            "s_aws_exe": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.exe_path",
                        "operator": "endswith",
                        "value": "aws.exe"
                    }
                ]
            },
            "s_aws_iam_role_commands": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "iam attach-role-policy"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "iam put-role-policy"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "iam update-assume-role-policy"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "eks update-cluster-config"
                    }
                ]
            }
        },
        "condition": "s_process_create and ((s_kubectl_exe and s_kubectl_role_commands) or (s_az_exe and s_az_aks_role_commands) or (s_gcloud_exe and s_gcloud_cluster_role_commands) or (s_aws_exe and s_aws_iam_role_commands))"
    },
    "operational_usage": "SOC 팀은 이 규칙을 활용하여 Windows 호스트에서 컨테이너 오케스트레이션 시스템(Kubernetes, AKS, GKE, EKS 등)에 대한 역할 및 권한 추가/수정 시도를 탐지할 수 있습니다. kubectl, az, gcloud, aws CLI와 같은 도구의 프로세스 생성 이벤트와 함께 역할 바인딩 생성, 클러스터 역할 바인딩 생성, IAM 정책 업데이트 등과 관련된 명령줄 인자를 모니터링합니다. 탐지된 이벤트는 높은 심각도로 분류되어 즉각적인 알람을 트리거하고, 해당 프로세스의 사용자 계정, 부모 프로세스, 네트워크 연결 등을 추가로 조사하여 침해사고 대응의 우선순위를 지정하는 데 사용될 수 있습니다.",
    "false_positive": "정상적인 CI/CD 파이프라인, 자동화된 배포 스크립트, 클라우드 관리 도구, 또는 합법적인 시스템 관리자가 컨테이너 환경의 역할 및 권한을 설정하거나 업데이트하는 과정에서 오탐이 발생할 수 있습니다. 알려진 정상적인 CLI 호출 패턴, 특정 사용자 계정, 또는 특정 프로세스에 대해 화이트리스트를 적용하여 오탐을 줄일 수 있습니다."
}