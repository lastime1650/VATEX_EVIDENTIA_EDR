{
    "id": "T1040-NetworkSniffing",
    "name": "Network Sniffing",
    "description": "Detects attempts by adversaries to passively sniff network traffic using tools like Wireshark, TShark, netsh trace, pktmon, or Nmap, or by creating raw sockets to capture sensitive information and gain environmental knowledge. This includes monitoring for promiscuous mode activation or the creation of packet capture files.",
    "severity": "high",
    "mitre_attack": {
        "tactic": "TA0007",
        "technique_id": "T1040",
        "subtechnique_id": "",
        "data_sources": [
            "Enterprise:Discovery:Network Sniffing",
            "Enterprise:Credential Access:Network Sniffing",
            "Enterprise:Execution:Command and Scripting Interpreter:Windows Command Shell"
        ]
    },
    "platform": [
        "windows"
    ],
    "detection": {
        "selections": {
            "s1_process_create_action": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.action",
                        "operator": "equals",
                        "value": "create"
                    }
                ]
            },
            "s2_netsh_exe_path": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.exe_path",
                        "operator": "endswith",
                        "value": "netsh.exe"
                    }
                ]
            },
            "s3_netsh_sniff_cmdline": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "trace start"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "capture=yes"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "interface="
                    }
                ]
            },
            "s4_pktmon_exe_path": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.exe_path",
                        "operator": "endswith",
                        "value": "pktmon.exe"
                    }
                ]
            },
            "s5_pktmon_sniff_cmdline": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "start"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "--listen"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "--capture"
                    }
                ]
            },
            "s6_tshark_wireshark_exe_path": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.exe_path",
                        "operator": "endswith",
                        "value": "tshark.exe"
                    },
                    {
                        "field": "body.process.exe_path",
                        "operator": "endswith",
                        "value": "wireshark.exe"
                    },
                    {
                        "field": "body.process.exe_path",
                        "operator": "endswith",
                        "value": "dumpcap.exe"
                    }
                ]
            },
            "s7_sniffing_tool_common_args": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "-i "
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "-w "
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "--interface "
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "--write-buffer "
                    }
                ]
            },
            "s8_nmap_exe_path": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.exe_path",
                        "operator": "endswith",
                        "value": "nmap.exe"
                    }
                ]
            },
            "s9_nmap_sniff_cmdline": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "--sniff"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "--script=sniffer-detect"
                    }
                ]
            },
            "s10_filesystem_create_or_write": {
                "event_type": "filesystem",
                "conditions": [
                    {
                        "field": "body.filesystem.action",
                        "operator": "equals",
                        "value": "create"
                    },
                    {
                        "field": "body.filesystem.action",
                        "operator": "equals",
                        "value": "write"
                    }
                ]
            },
            "s11_pcap_file_extension": {
                "event_type": "filesystem",
                "conditions": [
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "endswith",
                        "value": ".pcap"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "endswith",
                        "value": ".cap"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "endswith",
                        "value": ".etl"
                    }
                ]
            },
            "s12_raw_socket_api_call": {
                "event_type": "apicall",
                "conditions": [
                    {
                        "field": "body.apicall.function",
                        "operator": "equals",
                        "value": "WSASocketW"
                    }
                ]
            }
        },
        "condition": "(s1_process_create_action and s2_netsh_exe_path and s3_netsh_sniff_cmdline) or (s1_process_create_action and s4_pktmon_exe_path and s5_pktmon_sniff_cmdline) or (s1_process_create_action and s6_tshark_wireshark_exe_path and s7_sniffing_tool_common_args) or (s1_process_create_action and s8_nmap_exe_path and s9_nmap_sniff_cmdline) or (s10_filesystem_create_or_write and s11_pcap_file_extension) or (s1_process_create_action and s12_raw_socket_api_call and (s6_tshark_wireshark_exe_path or s8_nmap_exe_path))"
    },
    "operational_usage": "SOC 팀은 이 규칙을 활용하여 시스템에서 네트워크 스니핑 시도를 탐지할 수 있습니다. netsh, pktmon, Wireshark/TShark, Nmap과 같은 도구의 실행 및 관련 명령줄 인자를 모니터링합니다. 또한, .pcap, .cap, .etl과 같은 패킷 캡처 파일의 생성 또는 쓰기 활동을 탐지합니다. WSASocketW API 호출과 같은 잠재적인 원시 소켓 사용 시도를 알려진 스니핑 도구와 연계하여 분석합니다. 탐지된 이벤트는 높은 심각도로 분류되어 즉각적인 알람을 트리거하고, 관련 프로세스 및 네트워크 활동에 대한 추가적인 포렌식 조사를 시작하는 데 사용될 수 있습니다. 특히, 자격 증명 탈취나 환경 정보 수집과 같은 다른 공격 단계와 결합될 때 중요도가 더욱 높아집니다.",
    "false_positive": "정상적인 네트워크 진단 도구, 시스템 관리 유틸리티, 개발 도구, 또는 보안 솔루션이 네트워크 트래픽을 분석하거나 캡처하는 경우 오탐이 발생할 수 있습니다. 예를 들어, 네트워크 엔지니어의 문제 해결 활동, 애플리케이션 개발자의 디버깅, 또는 합법적인 네트워크 모니터링 소프트웨어 등이 이에 해당합니다. 알려진 정상 프로세스, 특정 사용자, 또는 특정 파일 경로를 화이트리스트에 추가하여 오탐을 줄일 수 있습니다."
}