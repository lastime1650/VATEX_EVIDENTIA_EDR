{
    "id": "T1037-BootOrLogonInitializationScripts",
    "name": "Boot or Logon Initialization Scripts",
    "description": "Adversaries may use scripts automatically executed at boot or logon initialization to establish persistence. Initialization scripts can be used to perform administrative functions, which may often execute other programs or send information to an internal logging server. These scripts can vary based on operating system and whether applied locally or remotely. An adversary may also be able to escalate their privileges since some boot or logon initialization scripts run with higher privileges.",
    "severity": "high",
    "mitre_attack": {
        "tactic": "TA0003",
        "technique_id": "T1037",
        "subtechnique_id": "",
        "data_sources": [
            "File:FileModification",
            "WindowsRegistry:WindowsRegistryKeyCreation",
            "Command:CommandExecution",
            "File:FileCreation",
            "Process:ProcessCreation"
        ]
    },
    "platform": [
        "windows"
    ],
    "detection": {
        "selections": {
            "registry_logon_script_set_or_create": {
                "event_type": "registry",
                "conditions": [
                    {
                        "field": "body.registry.keyclass",
                        "operator": "equals",
                        "value": "RegNtSetValueKey"
                    },
                    {
                        "field": "body.registry.keyclass",
                        "operator": "equals",
                        "value": "RegNtPreCreateKeyEx"
                    },
                    {
                        "field": "body.registry.keyclass",
                        "operator": "equals",
                        "value": "RegNtPostCreateKeyEx"
                    },
                    {
                        "field": "body.registry.keyclass",
                        "operator": "equals",
                        "value": "RegNtRenameKey"
                    }
                ]
            },
            "registry_logon_script_target_keys": {
                "event_type": "registry",
                "conditions": [
                    {
                        "field": "body.registry.name",
                        "operator": "contains",
                        "value": "HKEY_CURRENT_USER\\\\Environment\\\\UserInitMprLogonScript"
                    },
                    {
                        "field": "body.registry.name",
                        "operator": "contains",
                        "value": "HKEY_LOCAL_MACHINE\\\\SOFTWARE\\\\Microsoft\\\\Windows NT\\\\CurrentVersion\\\\Winlogon\\\\Userinit"
                    },
                    {
                        "field": "body.registry.name",
                        "operator": "contains",
                        "value": "HKEY_LOCAL_MACHINE\\\\SOFTWARE\\\\Microsoft\\\\Windows NT\\\\CurrentVersion\\\\Winlogon\\\\Shell"
                    },
                    {
                        "field": "body.registry.name",
                        "operator": "contains",
                        "value": "HKEY_LOCAL_MACHINE\\\\SOFTWARE\\\\Microsoft\\\\Windows\\\\CurrentVersion\\\\Run"
                    },
                    {
                        "field": "body.registry.name",
                        "operator": "contains",
                        "value": "HKEY_CURRENT_USER\\\\SOFTWARE\\\\Microsoft\\\\Windows\\\\CurrentVersion\\\\Run"
                    },
                    {
                        "field": "body.registry.name",
                        "operator": "contains",
                        "value": "HKEY_LOCAL_MACHINE\\\\SOFTWARE\\\\Microsoft\\\\Windows\\\\CurrentVersion\\\\RunOnce"
                    },
                    {
                        "field": "body.registry.name",
                        "operator": "contains",
                        "value": "HKEY_CURRENT_USER\\\\SOFTWARE\\\\Microsoft\\\\Windows\\\\CurrentVersion\\\\RunOnce"
                    }
                ]
            },
            "filesystem_script_creation_or_write_action": {
                "event_type": "filesystem",
                "conditions": [
                    {
                        "field": "body.filesystem.action",
                        "operator": "equals",
                        "value": "create"
                    },
                    {
                        "field": "body.filesystem.action",
                        "operator": "equals",
                        "value": "write"
                    },
                    {
                        "field": "body.filesystem.action",
                        "operator": "equals",
                        "value": "overwritten"
                    },
                    {
                        "field": "body.filesystem.action",
                        "operator": "equals",
                        "value": "rename"
                    }
                ]
            },
            "filesystem_startup_script_path": {
                "event_type": "filesystem",
                "conditions": [
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "contains",
                        "value": "\\\\Microsoft\\\\Windows\\\\Start Menu\\\\Programs\\\\Startup"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "contains",
                        "value": "\\\\Windows\\\\System32\\\\GroupPolicy\\\\Scripts\\\\Logon"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "contains",
                        "value": "\\\\Windows\\\\System32\\\\GroupPolicy\\\\Scripts\\\\Shutdown"
                    }
                ]
            },
            "filesystem_script_extensions": {
                "event_type": "filesystem",
                "conditions": [
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "endswith",
                        "value": ".bat"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "endswith",
                        "value": ".cmd"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "endswith",
                        "value": ".ps1"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "endswith",
                        "value": ".vbs"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "endswith",
                        "value": ".js"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "endswith",
                        "value": ".hta"
                    }
                ]
            },
            "process_create_script_interpreter": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.action",
                        "operator": "equals",
                        "value": "create"
                    },
                    {
                        "field": "body.process.exe_path",
                        "operator": "endswith",
                        "value": "\\\\powershell.exe"
                    },
                    {
                        "field": "body.process.exe_path",
                        "operator": "endswith",
                        "value": "\\\\cmd.exe"
                    },
                    {
                        "field": "body.process.exe_path",
                        "operator": "endswith",
                        "value": "\\\\wscript.exe"
                    },
                    {
                        "field": "body.process.exe_path",
                        "operator": "endswith",
                        "value": "\\\\cscript.exe"
                    }
                ]
            },
            "process_create_script_commandline_logon_context": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "\\\\Startup\\\\"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "\\\\GroupPolicy\\\\Scripts\\\\Logon"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "\\\\GroupPolicy\\\\Scripts\\\\Shutdown"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "endswith",
                        "value": ".bat"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "endswith",
                        "value": ".cmd"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "endswith",
                        "value": ".ps1"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "endswith",
                        "value": ".vbs"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "endswith",
                        "value": ".js"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "endswith",
                        "value": ".hta"
                    }
                ]
            }
        },
        "condition": "(registry_logon_script_set_or_create and registry_logon_script_target_keys) or (filesystem_script_creation_or_write_action and filesystem_startup_script_path and filesystem_script_extensions) or (process_create_script_interpreter and process_create_script_commandline_logon_context)"
    },
    "operational_usage": "SOC에서는 이 룰을 통해 시스템 부팅 또는 사용자 로그인 시 자동으로 실행되는 초기화 스크립트의 생성, 수정 또는 비정상적인 실행 시도를 탐지합니다. 탐지된 이벤트는 자동 알람을 통해 보안 담당자에게 즉시 통보되며, 침해사고 조사 및 대응을 위한 보고서에 포함되어 위협의 우선순위를 지정하는 데 활용될 수 있습니다.",
    "false_positive": "정상적인 시스템 관리 스크립트, 그룹 정책 업데이트, 소프트웨어 설치 또는 업데이트 프로세스, 합법적인 백신 및 보안 도구가 초기화 스크립트를 생성하거나 수정하는 경우 오탐이 발생할 수 있습니다. 특히 그룹 정책 스크립트 경로는 정상적인 관리 활동에 의해 수정될 수 있습니다."
}