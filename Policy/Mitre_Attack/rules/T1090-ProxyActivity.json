{
    "id": "T1090-ProxyActivity",
    "name": "Proxy Activity",
    "description": "Detects the use of proxy tools or 'netsh' portproxy to redirect network traffic, commonly used by adversaries for command and control, lateral movement, or to evade direct connections to their infrastructure.",
    "severity": "high",
    "mitre_attack": {
        "tactic": "TA0011",
        "technique_id": "T1090",
        "subtechnique_id": "",
        "data_sources": [
            "Enterprise:Execution:Command and Scripting Interpreter:Windows Command Shell",
            "Enterprise:Command and Control:Proxy"
        ]
    },
    "platform": [
        "windows"
    ],
    "detection": {
        "selections": {
            "s1_process_create": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.action",
                        "operator": "equals",
                        "value": "create"
                    }
                ]
            },
            "s2_proxy_tool_in_cmdline": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "htran"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "ngrok"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "frp"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "remcos"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "socksbot"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "regeorg"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "xtunnel"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "neo-regeorg"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "chisel"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "ligolo"
                    }
                ]
            },
            "s3_netsh_exe_path": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.exe_path",
                        "operator": "endswith",
                        "value": "netsh.exe"
                    }
                ]
            },
            "s4_netsh_portproxy_command": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "interface portproxy add"
                    }
                ]
            },
            "s5_network_outbound": {
                "event_type": "network",
                "conditions": [
                    {
                        "field": "body.network.direction",
                        "operator": "equals",
                        "value": "out"
                    }
                ]
            },
            "s6_network_to_common_proxy_ports": {
                "event_type": "network",
                "conditions": [
                    {
                        "field": "body.network.destinationport",
                        "operator": "equals",
                        "value": 9050
                    },
                    {
                        "field": "body.network.destinationport",
                        "operator": "equals",
                        "value": 9051
                    },
                    {
                        "field": "body.network.destinationport",
                        "operator": "equals",
                        "value": 9150
                    },
                    {
                        "field": "body.network.destinationport",
                        "operator": "equals",
                        "value": 1080
                    },
                    {
                        "field": "body.network.destinationport",
                        "operator": "equals",
                        "value": 8080
                    },
                    {
                        "field": "body.network.destinationport",
                        "operator": "equals",
                        "value": 3128
                    },
                    {
                        "field": "body.network.destinationport",
                        "operator": "equals",
                        "value": 8888
                    },
                    {
                        "field": "body.network.destinationport",
                        "operator": "equals",
                        "value": 8000
                    },
                    {
                        "field": "body.network.destinationport",
                        "operator": "equals",
                        "value": 6000
                    }
                ]
            }
        },
        "condition": "(s1_process_create and s2_proxy_tool_in_cmdline) or (s1_process_create and s3_netsh_exe_path and s4_netsh_portproxy_command) or (s5_network_outbound and s6_network_to_common_proxy_ports)"
    },
    "operational_usage": "SOC 팀은 이 규칙을 활용하여 시스템에서 프록시 활동을 탐지할 수 있습니다. 이는 알려진 프록시 도구의 실행, 'netsh'를 이용한 포트 프록시 설정, 또는 비정상적인 포트를 통한 외부 네트워크 연결 시도를 모니터링합니다. 탐지된 이벤트는 C2 통신, 내부 네트워크 침투, 또는 데이터 유출 시도와 연관될 수 있으므로, 높은 심각도로 분류되어 즉각적인 알람을 트리거하고 추가적인 포렌식 조사를 시작하는 데 사용됩니다.",
    "false_positive": "정상적인 시스템 관리 도구, VPN 클라이언트, 개발 도구(예: 로컬 개발 서버용 프록시), 또는 합법적인 애플리케이션이 네트워크 트래픽을 프록시하거나 포트 포워딩을 설정하는 경우 오탐이 발생할 수 있습니다. 알려진 정상 프로세스, 특정 명령줄 패턴, 또는 특정 IP 주소/포트를 화이트리스트에 추가하여 오탐을 줄일 수 있습니다."
}