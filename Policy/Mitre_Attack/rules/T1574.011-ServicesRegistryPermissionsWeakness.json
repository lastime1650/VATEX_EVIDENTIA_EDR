{
    "id": "T1574.011-ServicesRegistryPermissionsWeakness",
    "name": "Services Registry Permissions Weakness",
    "description": "Detects attempts by adversaries to exploit weak permissions on service-related registry keys to modify service execution parameters, redirecting to adversary-controlled executables for persistence or privilege escalation. This includes changes to ImagePath, binPath, FailureCommand, or creation of malicious Performance/Parameters keys.",
    "severity": "high",
    "mitre_attack": {
        "tactic": "TA0003",
        "technique_id": "T1574",
        "subtechnique_id": "T1574.011",
        "data_sources": [
            "Enterprise:Persistence:Modify Registry",
            "Enterprise:Persistence:Create or Modify System Process:Windows Service",
            "Enterprise:Execution:Command and Scripting Interpreter:Windows Command Shell",
            "Enterprise:Execution:Command and Scripting Interpreter:PowerShell"
        ]
    },
    "platform": [
        "windows"
    ],
    "detection": {
        "selections": {
            "s1_registry_action_write": {
                "event_type": "registry",
                "conditions": [
                    {
                        "field": "body.registry.keyclass",
                        "operator": "equals",
                        "value": "RegNtSetValueKey"
                    },
                    {
                        "field": "body.registry.keyclass",
                        "operator": "equals",
                        "value": "RegNtPreSetValueKey"
                    }
                ]
            },
            "s2_registry_action_create_key": {
                "event_type": "registry",
                "conditions": [
                    {
                        "field": "body.registry.keyclass",
                        "operator": "equals",
                        "value": "RegNtPreCreateKey"
                    },
                    {
                        "field": "body.registry.keyclass",
                        "operator": "equals",
                        "value": "RegNtPostCreateKey"
                    }
                ]
            },
            "s3_registry_target_service_base_path": {
                "event_type": "registry",
                "conditions": [
                    {
                        "field": "body.registry.name",
                        "operator": "startswith",
                        "value": "HKEY_LOCAL_MACHINE\\SYSTEM\\CurrentControlSet\\Services\\"
                    }
                ]
            },
            "s4_registry_target_binpath_imagepath": {
                "event_type": "registry",
                "conditions": [
                    {
                        "field": "body.registry.name",
                        "operator": "contains",
                        "value": "ImagePath"
                    },
                    {
                        "field": "body.registry.name",
                        "operator": "contains",
                        "value": "binPath"
                    }
                ]
            },
            "s5_registry_target_failurecommand": {
                "event_type": "registry",
                "conditions": [
                    {
                        "field": "body.registry.name",
                        "operator": "contains",
                        "value": "FailureCommand"
                    }
                ]
            },
            "s6_registry_target_performance_key": {
                "event_type": "registry",
                "conditions": [
                    {
                        "field": "body.registry.name",
                        "operator": "contains",
                        "value": "\\Performance"
                    }
                ]
            },
            "s7_registry_target_parameters_key": {
                "event_type": "registry",
                "conditions": [
                    {
                        "field": "body.registry.name",
                        "operator": "contains",
                        "value": "\\Parameters"
                    }
                ]
            },
            "s8_registry_target_servicedll": {
                "event_type": "registry",
                "conditions": [
                    {
                        "field": "body.registry.name",
                        "operator": "contains",
                        "value": "ServiceDll"
                    }
                ]
            },
            "p1_process_action_create": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.action",
                        "operator": "equals",
                        "value": "create"
                    }
                ]
            },
            "p2_process_sc_exe": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.exe_path",
                        "operator": "endswith",
                        "value": "sc.exe"
                    }
                ]
            },
            "p3_cmdline_sc_config_create": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "config"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "create"
                    }
                ]
            },
            "p4_cmdline_sc_target_params": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "binPath="
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "ImagePath="
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "FailureCommand="
                    }
                ]
            },
            "p5_process_reg_exe": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.exe_path",
                        "operator": "endswith",
                        "value": "reg.exe"
                    }
                ]
            },
            "p6_cmdline_reg_add_setvalue": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "add"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "setvalue"
                    }
                ]
            },
            "p7_cmdline_reg_service_registry_path": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "HKEY_LOCAL_MACHINE\\SYSTEM\\CurrentControlSet\\Services\\"
                    }
                ]
            },
            "p8_cmdline_reg_target_value_names": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "ImagePath"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "binPath"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "FailureCommand"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "Performance"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "Parameters"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "ServiceDll"
                    }
                ]
            },
            "p9_process_powershell_exe": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.exe_path",
                        "operator": "endswith",
                        "value": "powershell.exe"
                    },
                    {
                        "field": "body.process.exe_path",
                        "operator": "endswith",
                        "value": "pwsh.exe"
                    }
                ]
            },
            "p10_cmdline_ps_set_commands": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "Set-Service"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "Set-ItemProperty"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "New-ItemProperty"
                    }
                ]
            },
            "p11_cmdline_ps_service_registry_path_or_target_value": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "HKLM:\\\\SYSTEM\\\\CurrentControlSet\\\\Services\\\\"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "ImagePath"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "binPath"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "FailureCommand"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "Performance"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "Parameters"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "ServiceDll"
                    }
                ]
            }
        },
        "condition": "(s1_registry_action_write and s3_registry_target_service_base_path and (s4_registry_target_binpath_imagepath or s5_registry_target_failurecommand or s8_registry_target_servicedll)) or (s2_registry_action_create_key and s3_registry_target_service_base_path and (s6_registry_target_performance_key or s7_registry_target_parameters_key)) or (p1_process_action_create and p2_process_sc_exe and p3_cmdline_sc_config_create and p4_cmdline_sc_target_params) or (p1_process_action_create and p5_process_reg_exe and p6_cmdline_reg_add_setvalue and p7_cmdline_reg_service_registry_path and p8_cmdline_reg_target_value_names) or (p1_process_action_create and p9_process_powershell_exe and p10_cmdline_ps_set_commands and p11_cmdline_ps_service_registry_path_or_target_value)"
    },
    "operational_usage": "SOC 팀은 이 규칙을 활용하여 서비스 레지스트리 권한 오용을 통한 영속성 또는 권한 상승 시도를 탐지할 수 있습니다. 특히, HKLM\\SYSTEM\\CurrentControlSet\\Services 경로 아래의 서비스 관련 레지스트리 키에 대한 쓰기 또는 생성 이벤트와, ImagePath, binPath, FailureCommand, Performance, Parameters, ServiceDll 값의 변경을 모니터링합니다. 또한, sc.exe, reg.exe, powershell.exe 등 시스템 유틸리티를 사용하여 이러한 키를 조작하는 명령줄 실행을 탐지합니다. 탐지된 이벤트는 높은 심각도로 분류되어 즉각적인 알람을 트리거하고, 관련 프로세스 및 시스템 변경 사항에 대한 심층적인 포렌식 조사를 시작하는 데 사용될 수 있습니다. 이는 특히 방어 회피 및 실행 전술과 결합될 때 중요도가 더욱 높아집니다.",
    "false_positive": "정상적인 소프트웨어 설치, 업데이트, 또는 시스템 관리 도구가 서비스를 구성하거나 수정하는 과정에서 오탐이 발생할 수 있습니다. 예를 들어, 합법적인 서비스 제어 관리자, 백신 소프트웨어, 또는 기업 정책에 따른 스크립트가 서비스 경로를 변경할 수 있습니다. 알려진 정상 프로세스나 특정 명령줄 패턴을 화이트리스트에 추가하여 오탐을 줄일 수 있습니다."
}