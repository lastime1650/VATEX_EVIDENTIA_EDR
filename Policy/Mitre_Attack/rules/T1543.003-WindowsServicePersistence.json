{
    "id": "T1543.003-WindowsServicePersistence",
    "name": "Windows Service Creation/Modification for Persistence",
    "description": "Detects attempts to create or modify Windows services or install malicious drivers to establish persistence or escalate privileges. This includes using system utilities like sc.exe, PnPUtil.exe, PowerShell cmdlets, direct registry modifications, or Windows API calls to manipulate service configurations.",
    "severity": "high",
    "mitre_attack": {
        "tactic": "TA0003",
        "technique_id": "T1543",
        "subtechnique_id": "T1543.003",
        "data_sources": [
            "Process:ProcessCreation",
            "Command:CommandExecution",
            "WindowsRegistry:WindowsRegistryKeyCreation",
            "WindowsRegistry:WindowsRegistryKeyModification",
            "Process:OSAPIExecution"
        ]
    },
    "platform": [
        "windows"
    ],
    "detection": {
        "selections": {
            "s1_process_action_create": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.action",
                        "operator": "equals",
                        "value": "create"
                    }
                ]
            },
            "s2_sc_exe_path": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.exe_path",
                        "operator": "endswith",
                        "value": "sc.exe"
                    }
                ]
            },
            "s3_sc_service_commands": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": " create "
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": " config "
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": " sdset "
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": " delete "
                    }
                ]
            },
            "s4_pnputil_exe_path": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.exe_path",
                        "operator": "endswith",
                        "value": "pnputil.exe"
                    }
                ]
            },
            "s5_pnputil_add_driver_command": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "add-driver"
                    }
                ]
            },
            "s6_powershell_exe_path": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.exe_path",
                        "operator": "endswith",
                        "value": "powershell.exe"
                    }
                ]
            },
            "s7_powershell_service_cmdlets": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "New-Service"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "Set-Service"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "Remove-Service"
                    }
                ]
            },
            "s8_registry_service_key_write_access": {
                "event_type": "registry",
                "conditions": [
                    {
                        "field": "body.registry.keyclass",
                        "operator": "equals",
                        "value": "RegNtSetValueKey"
                    },
                    {
                        "field": "body.registry.keyclass",
                        "operator": "equals",
                        "value": "RegNtPreSetValueKey"
                    },
                    {
                        "field": "body.registry.keyclass",
                        "operator": "equals",
                        "value": "RegNtPreCreateKey"
                    },
                    {
                        "field": "body.registry.keyclass",
                        "operator": "equals",
                        "value": "RegNtPostCreateKey"
                    },
                    {
                        "field": "body.registry.keyclass",
                        "operator": "equals",
                        "value": "RegNtPreDeleteKey"
                    },
                    {
                        "field": "body.registry.keyclass",
                        "operator": "equals",
                        "value": "RegNtPostDeleteKey"
                    },
                    {
                        "field": "body.registry.keyclass",
                        "operator": "equals",
                        "value": "RegNtPreRenameKey"
                    },
                    {
                        "field": "body.registry.keyclass",
                        "operator": "equals",
                        "value": "RegNtPostRenameKey"
                    }
                ]
            },
            "s9_registry_service_path": {
                "event_type": "registry",
                "conditions": [
                    {
                        "field": "body.registry.name",
                        "operator": "startswith",
                        "value": "HKEY_LOCAL_MACHINE\\SYSTEM\\CurrentControlSet\\Services\\"
                    }
                ]
            },
            "s10_apicall_service_manipulation": {
                "event_type": "apicall",
                "conditions": [
                    {
                        "field": "body.apicall.function",
                        "operator": "equals",
                        "value": "CreateServiceW"
                    },
                    {
                        "field": "body.apicall.function",
                        "operator": "equals",
                        "value": "ChangeServiceConfigW"
                    },
                    {
                        "field": "body.apicall.function",
                        "operator": "equals",
                        "value": "DeleteService"
                    },
                    {
                        "field": "body.apicall.function",
                        "operator": "equals",
                        "value": "ZwLoadDriver"
                    },
                    {
                        "field": "body.apicall.function",
                        "operator": "equals",
                        "value": "ZwSetValueKey"
                    }
                ]
            }
        },
        "condition": "(s1_process_action_create and s2_sc_exe_path and s3_sc_service_commands) or (s1_process_action_create and s4_pnputil_exe_path and s5_pnputil_add_driver_command) or (s1_process_action_create and s6_powershell_exe_path and s7_powershell_service_cmdlets) or (s8_registry_service_key_write_access and s9_registry_service_path) or s10_apicall_service_manipulation"
    },
    "operational_usage": "SOC 팀은 이 규칙을 활용하여 Windows 서비스 생성 또는 수정 시도를 탐지할 수 있습니다. sc.exe, PnPUtil.exe, PowerShell cmdlets를 통한 프로세스 생성 및 명령줄 인자, 서비스 관련 레지스트리 키에 대한 쓰기/생성/삭제/이름 변경 활동, 그리고 서비스 조작 관련 API 호출을 모니터링합니다. 탐지된 이벤트는 높은 심각도로 분류되어 즉각적인 알람을 트리거하고, 관련 프로세스 및 시스템 변경 사항에 대한 추가적인 포렌식 조사를 시작하는 데 사용될 수 있습니다. 특히, 권한 상승 또는 다른 방어 회피 전술과 결합될 때 중요도가 더욱 높아집니다.",
    "false_positive": "정상적인 시스템 관리 도구, 소프트웨어 설치 프로그램, 업데이트 유틸리티, 백신 소프트웨어, 또는 합법적인 드라이버 설치 과정에서 오탐이 발생할 수 있습니다. 알려진 정상적인 서비스 관리 활동이나 특정 프로세스에 대해 화이트리스트를 적용하여 오탐을 줄일 수 있습니다."
}