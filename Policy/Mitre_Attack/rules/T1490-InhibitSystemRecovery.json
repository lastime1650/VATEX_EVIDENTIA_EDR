{
    "id": "T1490-InhibitSystemRecovery",
    "name": "Inhibit System Recovery",
    "description": "Detects attempts to delete or disable system recovery features, such as volume shadow copies, Windows Backup Catalog, and automatic recovery options, using utilities like vssadmin.exe, wmic, wbadmin.exe, bcdedit.exe, REAgentC.exe, and diskshadow.exe. Adversaries use this technique to prevent system restoration and augment the impact of destructive attacks.",
    "severity": "high",
    "mitre_attack": {
        "tactic": "TA0007",
        "technique_id": "T1490",
        "subtechnique_id": "",
        "data_sources": [
            "Enterprise:Execution:Process Creation",
            "Enterprise:Execution:Command and Scripting Interpreter:Windows Command Shell",
            "Enterprise:Persistence:Modify Registry",
            "Enterprise:Impact:Data Destruction"
        ]
    },
    "platform": [
        "windows"
    ],
    "detection": {
        "selections": {
            "s_process_create_action": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.action",
                        "operator": "equals",
                        "value": "create"
                    }
                ]
            },
            "s_vssadmin_delete_shadows": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "vssadmin.exe"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "delete shadows"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "/all"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "/quiet"
                    }
                ]
            },
            "s_wmic_delete_shadowcopy": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "wmic"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "shadowcopy delete"
                    }
                ]
            },
            "s_wbadmin_delete_catalog": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "wbadmin.exe"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "delete catalog"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "-quiet"
                    }
                ]
            },
            "s_bcdedit_ignoreallfailures": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "bcdedit.exe"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "/set {default} bootstatuspolicy ignoreallfailures"
                    }
                ]
            },
            "s_bcdedit_recovery_disabled": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "bcdedit.exe"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "/set {default} recoveryenabled no"
                    }
                ]
            },
            "s_reagentc_disable": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "REAgentC.exe"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "/disable"
                    }
                ]
            },
            "s_diskshadow_delete_shadows": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "diskshadow"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "delete shadows all"
                    }
                ]
            },
            "s_registry_disable_local_page_set": {
                "event_type": "registry",
                "conditions": [
                    {
                        "field": "body.registry.keyclass",
                        "operator": "equals",
                        "value": "RegNtSetValueKey"
                    },
                    {
                        "field": "body.registry.name",
                        "operator": "contains",
                        "value": "HKEY_CURRENT_USER\\Software\\Policies\\Microsoft\\PreviousVersions\\DisableLocalPage"
                    }
                ]
            }
        },
        "condition": "s_process_create_action and (s_vssadmin_delete_shadows or s_wmic_delete_shadowcopy or s_wbadmin_delete_catalog or s_bcdedit_ignoreallfailures or s_bcdedit_recovery_disabled or s_reagentc_disable or s_diskshadow_delete_shadows) or s_registry_disable_local_page_set"
    },
    "operational_usage": "SOC 팀은 이 규칙을 활용하여 시스템 복구 기능 무력화 시도를 탐지할 수 있습니다. vssadmin.exe, wmic, wbadmin.exe, bcdedit.exe, REAgentC.exe, diskshadow.exe와 같은 유틸리티를 통한 볼륨 섀도 복사본 삭제, 백업 카탈로그 삭제, 자동 복구 비활성화 시도를 모니터링합니다. 또한, 'DisableLocalPage'와 같은 특정 레지스트리 키 변경 시도도 탐지합니다. 탐지된 이벤트는 높은 심각도로 분류되어 즉각적인 알람을 트리거하고, 시스템 복구 기능 무력화가 랜섬웨어 또는 파괴적 공격의 전조일 수 있으므로 신속한 조사 및 대응을 위한 우선순위를 지정하는 데 활용될 수 있습니다.",
    "false_positive": "정상적인 시스템 관리 작업, 백업 및 복구 소프트웨어, 또는 특정 시스템 유지보수 스크립트가 섀도 복사본을 관리하거나 시스템 복구 설정을 변경하는 과정에서 오탐이 발생할 수 있습니다. 알려진 정상적인 프로세스나 특정 명령줄 패턴을 화이트리스트에 추가하여 오탐을 줄일 수 있습니다."
}