{
    "id": "T1203-ClientExe_SuspiciousChildProcess",
    "name": "Exploitation for Client Execution: Suspicious Child Process",
    "description": "Detects suspicious child processes (e.g., command shells, scripting engines, proxy execution utilities like mshta.exe or rundll32.exe) launched by client applications (web browsers, Office applications, PDF readers). This behavior is often indicative of successful client-side exploitation where an attacker gains initial code execution within the context of the client application and then uses it to launch further malicious processes.",
    "severity": "high",
    "mitre_attack": {
        "tactic": "TA0002",
        "technique_id": "T1203",
        "subtechnique_id": "",
        "data_sources": [
            "Enterprise:Execution:Command and Scripting Interpreter:Windows Command Shell",
            "Enterprise:Execution:Command and Scripting Interpreter:PowerShell",
            "Enterprise:Execution:Command and Scripting Interpreter:Visual Basic",
            "Enterprise:Execution:Native API"
        ]
    },
    "platform": [
        "windows"
    ],
    "detection": {
        "selections": {
            "s1_process_action_create": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.action",
                        "operator": "equals",
                        "value": "create"
                    }
                ]
            },
            "s2_parent_is_client_app": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.parent_exe_path",
                        "operator": "contains",
                        "value": "chrome.exe"
                    },
                    {
                        "field": "body.process.parent_exe_path",
                        "operator": "contains",
                        "value": "firefox.exe"
                    },
                    {
                        "field": "body.process.parent_exe_path",
                        "operator": "contains",
                        "value": "msedge.exe"
                    },
                    {
                        "field": "body.process.parent_exe_path",
                        "operator": "contains",
                        "value": "iexplore.exe"
                    },
                    {
                        "field": "body.process.parent_exe_path",
                        "operator": "contains",
                        "value": "winword.exe"
                    },
                    {
                        "field": "body.process.parent_exe_path",
                        "operator": "contains",
                        "value": "excel.exe"
                    },
                    {
                        "field": "body.process.parent_exe_path",
                        "operator": "contains",
                        "value": "powerpnt.exe"
                    },
                    {
                        "field": "body.process.parent_exe_path",
                        "operator": "contains",
                        "value": "outlook.exe"
                    },
                    {
                        "field": "body.process.parent_exe_path",
                        "operator": "contains",
                        "value": "AcroRd32.exe"
                    }
                ]
            },
            "s3_child_is_scripting_host": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.exe_path",
                        "operator": "endswith",
                        "value": "cmd.exe"
                    },
                    {
                        "field": "body.process.exe_path",
                        "operator": "endswith",
                        "value": "powershell.exe"
                    },
                    {
                        "field": "body.process.exe_path",
                        "operator": "endswith",
                        "value": "wscript.exe"
                    },
                    {
                        "field": "body.process.exe_path",
                        "operator": "endswith",
                        "value": "cscript.exe"
                    }
                ]
            },
            "s4_child_is_mshta": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.exe_path",
                        "operator": "endswith",
                        "value": "mshta.exe"
                    }
                ]
            },
            "s5_child_is_rundll32": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.exe_path",
                        "operator": "endswith",
                        "value": "rundll32.exe"
                    }
                ]
            },
            "s6_mshta_javascript_vbs_cmdline": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "javascript:"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "vbscript:"
                    }
                ]
            },
            "s7_rundll32_dll_cpl_cmdline": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": ".dll,"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": ".cpl"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "javascript:"
                    }
                ]
            }
        },
        "condition": "s1_process_action_create and s2_parent_is_client_app and (s3_child_is_scripting_host or (s4_child_is_mshta and s6_mshta_javascript_vbs_cmdline) or (s5_child_is_rundll32 and s7_rundll32_dll_cpl_cmdline))"
    },
    "operational_usage": "SOC 팀은 이 규칙을 활용하여 웹 브라우저, Office 애플리케이션 또는 PDF 리더와 같은 클라이언트 앱에서 시작되는 의심스러운 자식 프로세스 생성을 탐지할 수 있습니다. 이는 클라이언트 측 익스플로잇 성공의 지표로, 공격자가 초기 코드 실행을 달성한 후 추가 악성 프로세스를 실행하는 데 사용합니다. 탐지된 이벤트는 높은 심각도로 분류되어 즉각적인 알람을 트리거하고, 관련 프로세스 및 명령줄 인자에 대한 추가적인 포렌식 조사를 시작하는 데 사용될 수 있습니다. 특히, 다른 실행 또는 방어 회피 전술과 결합될 때 중요도가 더욱 높아집니다.",
    "false_positive": "정상적인 애플리케이션 업데이트, 플러그인 설치, 또는 합법적인 스크립트 실행 등 시스템 관리 활동 중에 오탐이 발생할 수 있습니다. 또한, 일부 합법적인 소프트웨어가 브라우저나 Office 애플리케이션을 통해 제한된 명령을 실행할 수 있습니다. 알려진 정상 프로세스, 특정 명령줄 패턴, 또는 특정 부모-자식 프로세스 조합을 화이트리스트에 추가하여 오탐을 줄일 수 있습니다."
}