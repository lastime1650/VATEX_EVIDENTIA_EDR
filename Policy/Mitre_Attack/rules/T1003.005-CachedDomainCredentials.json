{
    "id": "T1003.005-CachedDomainCredentials",
    "name": "Cached Domain Credentials Access",
    "description": "Detects attempts to access cached domain credentials (DCC2/MS-Cache v2 on Windows) using tools like Mimikatz, secretsdump.py, or by directly querying relevant registry keys. Adversaries leverage these credentials for lateral movement or persistence.",
    "severity": "high",
    "mitre_attack": {
        "tactic": "TA0006",
        "technique_id": "T1003",
        "subtechnique_id": "T1003.005",
        "data_sources": [
            "Enterprise:Credential Access:OS Credential Dumping:Cached Domain Credentials",
            "Enterprise:Execution:Command and Scripting Interpreter:Windows Command Shell",
            "Enterprise:Execution:Command and Scripting Interpreter:PowerShell",
            "Enterprise:Discovery:Query Registry"
        ]
    },
    "platform": [
        "windows"
    ],
    "detection": {
        "selections": {
            "s1_process_create_action": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.action",
                        "operator": "equals",
                        "value": "create"
                    }
                ]
            },
            "s2_mimikatz_exe_path": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.exe_path",
                        "operator": "contains",
                        "value": "mimikatz.exe"
                    }
                ]
            },
            "s3_mimikatz_lsadump_cmdline": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "lsadump::cache"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "lsadump::sam"
                    }
                ]
            },
            "s4_python_exe_path": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.exe_path",
                        "operator": "endswith",
                        "value": "python.exe"
                    }
                ]
            },
            "s5_secretsdump_cmdline": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "secretsdump.py"
                    }
                ]
            },
            "s6_reg_exe_path": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.exe_path",
                        "operator": "endswith",
                        "value": "reg.exe"
                    }
                ]
            },
            "s7_reg_query_export_cmdline": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "query"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "export"
                    }
                ]
            },
            "s8_reg_cached_cred_paths_cmdline": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "HKLM\\SAM"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "HKLM\\SECURITY"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "HKLM\\SYSTEM\\CurrentControlSet\\Control\\Lsa\\Cache"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "HKLM\\SOFTWARE\\Microsoft\\Windows NT\\CurrentVersion\\ProfileList"
                    }
                ]
            },
            "s9_powershell_exe_path": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.exe_path",
                        "operator": "endswith",
                        "value": "powershell.exe"
                    },
                    {
                        "field": "body.process.exe_path",
                        "operator": "endswith",
                        "value": "pwsh.exe"
                    }
                ]
            },
            "s10_invoke_mimikatz_cmdline": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "Invoke-Mimikatz"
                    }
                ]
            },
            "s11_registry_access_keyclass": {
                "event_type": "registry",
                "conditions": [
                    {
                        "field": "body.registry.keyclass",
                        "operator": "contains",
                        "value": "QueryKey"
                    },
                    {
                        "field": "body.registry.keyclass",
                        "operator": "contains",
                        "value": "OpenKey"
                    },
                    {
                        "field": "body.registry.keyclass",
                        "operator": "contains",
                        "value": "EnumerateKey"
                    },
                    {
                        "field": "body.registry.keyclass",
                        "operator": "contains",
                        "value": "SetValueKey"
                    }
                ]
            },
            "s12_registry_cached_cred_paths_name": {
                "event_type": "registry",
                "conditions": [
                    {
                        "field": "body.registry.name",
                        "operator": "startswith",
                        "value": "HKEY_LOCAL_MACHINE\\SAM"
                    },
                    {
                        "field": "body.registry.name",
                        "operator": "startswith",
                        "value": "HKEY_LOCAL_MACHINE\\SECURITY"
                    },
                    {
                        "field": "body.registry.name",
                        "operator": "startswith",
                        "value": "HKEY_LOCAL_MACHINE\\SYSTEM\\CurrentControlSet\\Control\\Lsa\\Cache"
                    },
                    {
                        "field": "body.registry.name",
                        "operator": "startswith",
                        "value": "HKEY_LOCAL_MACHINE\\SOFTWARE\\Microsoft\\Windows NT\\CurrentVersion\\ProfileList"
                    }
                ]
            }
        },
        "condition": "s1_process_create_action and (s2_mimikatz_exe_path and s3_mimikatz_lsadump_cmdline or (s4_python_exe_path and s5_secretsdump_cmdline) or (s6_reg_exe_path and s7_reg_query_export_cmdline and s8_reg_cached_cred_paths_cmdline) or (s9_powershell_exe_path and s10_invoke_mimikatz_cmdline)) or (s11_registry_access_keyclass and s12_registry_cached_cred_paths_name)"
    },
    "operational_usage": "SOC 팀은 이 규칙을 활용하여 시스템에서 캐시된 도메인 자격 증명 수집 시도를 탐지할 수 있습니다. Mimikatz, secretsdump.py와 같은 도구의 실행, 'reg.exe'를 이용한 민감한 레지스트리 키 조회/내보내기, PowerShell의 Invoke-Mimikatz 사용, 또는 캐시된 자격 증명 관련 레지스트리 경로에 대한 직접적인 접근 시도를 모니터링합니다. 탐지된 이벤트는 높은 심각도로 분류되어 즉각적인 알람을 트리거하고, 추가적인 포렌식 조사 및 침해사고 대응의 우선순위를 지정하는 데 사용될 수 있습니다. 특히, 다른 자격 증명 접근 또는 방어 회피 활동과 결합될 때 중요도가 높아집니다.",
    "false_positive": "정상적인 시스템 관리 도구, 백신 소프트웨어, 또는 합법적인 애플리케이션이 시스템 보안 관련 레지스트리 키를 조회하는 과정에서 오탐이 발생할 수 있습니다. 알려진 정상 프로세스나 특정 명령줄 패턴을 화이트리스트에 추가하여 오탐을 줄일 수 있습니다."
}