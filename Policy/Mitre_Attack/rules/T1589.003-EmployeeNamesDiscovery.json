{
    "id": "T1589.003-EmployeeNamesDiscovery",
    "name": "Employee Names Discovery",
    "description": "Detects attempts by an adversary to discover employee names on a compromised system, which can be used for further targeting, social engineering, or to derive email addresses. This includes local user enumeration, querying domain users, or accessing user profile information.",
    "severity": "medium",
    "mitre_attack": {
        "tactic": "TA0007",
        "technique_id": "T1589",
        "subtechnique_id": "T1589.003",
        "data_sources": [
            "Enterprise:Reconnaissance:Gather Victim Identity Information:Employee Names",
            "Enterprise:Execution:Command and Scripting Interpreter:Windows Command Shell",
            "Enterprise:Execution:Command and Scripting Interpreter:PowerShell",
            "Enterprise:Discovery:Query Registry",
            "Enterprise:Execution:Native API"
        ]
    },
    "platform": [
        "windows"
    ],
    "detection": {
        "selections": {
            "s1_process_action_create": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.action",
                        "operator": "equals",
                        "value": "create"
                    }
                ]
            },
            "s2_cmdline_net_user": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "net user"
                    }
                ]
            },
            "s3_cmdline_wmic_useraccount": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "wmic useraccount get name"
                    }
                ]
            },
            "s4_cmdline_powershell_exe": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "powershell.exe"
                    }
                ]
            },
            "s5_cmdline_powershell_get_localuser": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "Get-LocalUser"
                    }
                ]
            },
            "s6_cmdline_powershell_get_aduser": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "Get-ADUser"
                    }
                ]
            },
            "s7_cmdline_powershell_win32_useraccount_query": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "Win32_UserAccount"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "Get-WmiObject"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "Get-CimInstance"
                    }
                ]
            },
            "s8_registry_discovery_keyclass": {
                "event_type": "registry",
                "conditions": [
                    {
                        "field": "body.registry.keyclass",
                        "operator": "contains",
                        "value": "QueryKey"
                    },
                    {
                        "field": "body.registry.keyclass",
                        "operator": "contains",
                        "value": "OpenKey"
                    },
                    {
                        "field": "body.registry.keyclass",
                        "operator": "contains",
                        "value": "EnumerateKey"
                    }
                ]
            },
            "s9_registry_profilelist_name_path": {
                "event_type": "registry",
                "conditions": [
                    {
                        "field": "body.registry.name",
                        "operator": "startswith",
                        "value": "HKEY_LOCAL_MACHINE\\SOFTWARE\\Microsoft\\Windows NT\\CurrentVersion\\ProfileList"
                    },
                    {
                        "field": "body.registry.name",
                        "operator": "startswith",
                        "value": "HKEY_USERS"
                    }
                ]
            },
            "s10_apicall_netuserenum": {
                "event_type": "apicall",
                "conditions": [
                    {
                        "field": "body.apicall.function",
                        "operator": "equals",
                        "value": "NetUserEnum"
                    }
                ]
            },
            "s11_apicall_getusername": {
                "event_type": "apicall",
                "conditions": [
                    {
                        "field": "body.apicall.function",
                        "operator": "equals",
                        "value": "GetUserNameW"
                    },
                    {
                        "field": "body.apicall.function",
                        "operator": "equals",
                        "value": "GetUserNameA"
                    }
                ]
            },
            "s12_apicall_wtsquerysessioninformation": {
                "event_type": "apicall",
                "conditions": [
                    {
                        "field": "body.apicall.function",
                        "operator": "equals",
                        "value": "WTSQuerySessionInformationW"
                    },
                    {
                        "field": "body.apicall.function",
                        "operator": "equals",
                        "value": "WTSQuerySessionInformationA"
                    }
                ]
            }
        },
        "condition": "(s1_process_action_create and s2_cmdline_net_user) or (s1_process_action_create and s3_cmdline_wmic_useraccount) or (s1_process_action_create and s4_cmdline_powershell_exe and s5_cmdline_powershell_get_localuser) or (s1_process_action_create and s4_cmdline_powershell_exe and s6_cmdline_powershell_get_aduser) or (s1_process_action_create and s4_cmdline_powershell_exe and s7_cmdline_powershell_win32_useraccount_query) or (s8_registry_discovery_keyclass and s9_registry_profilelist_name_path) or s10_apicall_netuserenum or s11_apicall_getusername or s12_apicall_wtsquerysessioninformation"
    },
    "operational_usage": "SOC 팀은 이 규칙을 활용하여 시스템 사용자(직원 이름) 정보 수집 시도를 탐지할 수 있습니다. 'net user', 'wmic useraccount'와 같은 명령 실행, PowerShell을 통한 로컬/도메인 사용자 열거 시도, 사용자 프로필 관련 레지스트리 키 접근, 또는 사용자 정보 조회 API 호출 등을 모니터링합니다. 탐지된 이벤트는 자동 알람을 트리거하고, 추가적인 조사 및 침해사고 대응의 우선순위를 지정하는 데 사용될 수 있습니다. 특히 다른 Discovery 또는 Collection 활동과 결합될 때 중요도가 높아집니다.",
    "false_positive": "정상적인 시스템 관리 도구, 백신 소프트웨어, 사용자 환경 설정 스크립트, 또는 합법적인 애플리케이션이 시스템 사용자 정보를 조회하는 과정에서 탐지될 수 있습니다. 알려진 정상 프로세스나 특정 명령줄 패턴을 화이트리스트에 추가하여 오탐을 줄일 수 있습니다."
}