{
    "id": "T1053-ScheduledTaskJob",
    "name": "Scheduled Task/Job Abuse",
    "description": "Detects attempts by adversaries to abuse task scheduling functionality to facilitate initial or recurring execution of malicious code. This technique is commonly used for persistence and privilege escalation, allowing programs or scripts to be executed at a specified date and time, often under elevated permissions. This includes monitoring for the use of utilities like schtasks.exe, PowerShell cmdlets (e.g., Register-ScheduledTask), and direct manipulation of task definition XML files.",
    "severity": "high",
    "mitre_attack": {
        "tactic": "TA0003",
        "technique_id": "T1053",
        "subtechnique_id": "",
        "data_sources": [
            "Enterprise:Execution:Scheduled Task/Job:Scheduled Task",
            "Enterprise:Persistence:Scheduled Task/Job:Scheduled Task",
            "Enterprise:Privilege Escalation:Scheduled Task/Job:Scheduled Task",
            "Enterprise:Execution:Command and Scripting Interpreter:Windows Command Shell",
            "Enterprise:Defense Evasion:File and Directory Permissions Modification"
        ]
    },
    "platform": [
        "windows"
    ],
    "detection": {
        "selections": {
            "s1_process_create_action": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.action",
                        "operator": "equals",
                        "value": "create"
                    }
                ]
            },
            "s2_schtasks_exe_path": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.exe_path",
                        "operator": "endswith",
                        "value": "schtasks.exe"
                    }
                ]
            },
            "s3_schtasks_command_arguments": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "/create"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "/change"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "/run"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "/delete"
                    }
                ]
            },
            "s4_powershell_exe_path": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.exe_path",
                        "operator": "endswith",
                        "value": "powershell.exe"
                    },
                    {
                        "field": "body.process.exe_path",
                        "operator": "endswith",
                        "value": "pwsh.exe"
                    }
                ]
            },
            "s5_powershell_scheduled_task_cmdlets": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "Register-ScheduledTask"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "Set-ScheduledTask"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "New-ScheduledTaskAction"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "Start-ScheduledTask"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "Unregister-ScheduledTask"
                    }
                ]
            },
            "s6_filesystem_create_or_write_action": {
                "event_type": "filesystem",
                "conditions": [
                    {
                        "field": "body.filesystem.action",
                        "operator": "equals",
                        "value": "create"
                    },
                    {
                        "field": "body.filesystem.action",
                        "operator": "equals",
                        "value": "write"
                    }
                ]
            },
            "s7_filesystem_task_xml_path": {
                "event_type": "filesystem",
                "conditions": [
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "contains",
                        "value": "C:\\Windows\\System32\\Tasks\\"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "contains",
                        "value": "C:\\Windows\\SysWOW64\\Tasks\\"
                    }
                ]
            },
            "s8_filesystem_task_xml_extension": {
                "event_type": "filesystem",
                "conditions": [
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "endswith",
                        "value": ".xml"
                    }
                ]
            }
        },
        "condition": "(s1_process_create_action and s2_schtasks_exe_path and s3_schtasks_command_arguments) or (s1_process_create_action and s4_powershell_exe_path and s5_powershell_scheduled_task_cmdlets) or (s6_filesystem_create_or_write_action and s7_filesystem_task_xml_path and s8_filesystem_task_xml_extension)"
    },
    "operational_usage": "SOC 팀은 이 규칙을 활용하여 예약된 작업 생성, 변경, 실행 또는 삭제 시도를 탐지할 수 있습니다. schtasks.exe 또는 PowerShell cmdlet을 통한 명령줄 실행, 그리고 Task Scheduler의 작업 정의 파일(.xml)에 대한 파일 시스템 생성/쓰기 이벤트를 모니터링합니다. 탐지된 이벤트는 높은 심각도로 분류되어 즉각적인 알람을 트리거하고, 관련된 프로세스 활동 및 파일 무결성 조사를 시작하는 데 사용될 수 있습니다. 특히, 다른 Persistence, Privilege Escalation 또는 Execution 전술과 결합될 때 중요도가 더욱 높아집니다.",
    "false_positive": "정상적인 시스템 관리 작업, 소프트웨어 설치/업데이트, 백신 소프트웨어 또는 기업 정책 스크립트가 예약된 작업을 생성, 변경 또는 실행하는 경우 오탐이 발생할 수 있습니다. 알려진 정상적인 예약된 작업 패턴, 프로세스 또는 특정 명령줄 인자에 대해 화이트리스트를 적용하여 오탐을 줄일 수 있습니다."
}