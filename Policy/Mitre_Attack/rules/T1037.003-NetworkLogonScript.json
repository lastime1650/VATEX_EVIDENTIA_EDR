{
    "id": "T1037.003-NetworkLogonScript",
    "name": "Network Logon Script",
    "description": "Adversaries may use network logon scripts automatically executed at logon initialization to establish persistence. These scripts can be assigned using Active Directory or Group Policy Objects and run with the privileges of the assigned user. This technique can affect multiple systems and is used to maintain persistence on a network.",
    "severity": "high",
    "mitre_attack": {
        "tactic": "TA0003",
        "technique_id": "T1037",
        "subtechnique_id": "T1037.003",
        "data_sources": [
            "Enterprise:Persistence:Boot or Logon Initialization Scripts:Logon Script (Windows)",
            "Enterprise:Execution:Command and Scripting Interpreter:Windows Command Shell"
        ]
    },
    "platform": [
        "windows"
    ],
    "detection": {
        "selections": {
            "s1_process_create_action": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.action",
                        "operator": "equals",
                        "value": "create"
                    }
                ]
            },
            "s2_process_script_interpreter": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.exe_path",
                        "operator": "endswith",
                        "value": "cmd.exe"
                    },
                    {
                        "field": "body.process.exe_path",
                        "operator": "endswith",
                        "value": "powershell.exe"
                    },
                    {
                        "field": "body.process.exe_path",
                        "operator": "endswith",
                        "value": "wscript.exe"
                    },
                    {
                        "field": "body.process.exe_path",
                        "operator": "endswith",
                        "value": "cscript.exe"
                    }
                ]
            },
            "s3_process_cmdline_network_path": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "\\\\netlogon\\"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "\\\\sysvol\\"
                    }
                ]
            },
            "s4_process_cmdline_script_ext": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "endswith",
                        "value": ".bat"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "endswith",
                        "value": ".cmd"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "endswith",
                        "value": ".ps1"
                    }
                ]
            },
            "s5_filesystem_write_create_action": {
                "event_type": "filesystem",
                "conditions": [
                    {
                        "field": "body.filesystem.action",
                        "operator": "equals",
                        "value": "create"
                    },
                    {
                        "field": "body.filesystem.action",
                        "operator": "equals",
                        "value": "write"
                    },
                    {
                        "field": "body.filesystem.action",
                        "operator": "equals",
                        "value": "overwritten"
                    }
                ]
            },
            "s6_filesystem_filepath_network_script": {
                "event_type": "filesystem",
                "conditions": [
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "contains",
                        "value": "\\\\netlogon\\"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "contains",
                        "value": "\\\\sysvol\\"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "endswith",
                        "value": ".bat"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "endswith",
                        "value": ".cmd"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "endswith",
                        "value": ".ps1"
                    }
                ]
            },
            "s7_registry_modify_action": {
                "event_type": "registry",
                "conditions": [
                    {
                        "field": "body.registry.keyclass",
                        "operator": "contains",
                        "value": "SetValueKey"
                    },
                    {
                        "field": "body.registry.keyclass",
                        "operator": "contains",
                        "value": "CreateKey"
                    }
                ]
            },
            "s8_registry_logon_script_key": {
                "event_type": "registry",
                "conditions": [
                    {
                        "field": "body.registry.name",
                        "operator": "startswith",
                        "value": "HKEY_CURRENT_USER\\\\Environment\\\\UserInitMprLogonScript"
                    },
                    {
                        "field": "body.registry.name",
                        "operator": "startswith",
                        "value": "HKEY_LOCAL_MACHINE\\\\SOFTWARE\\\\Microsoft\\\\Windows NT\\\\CurrentVersion\\\\Winlogon\\\\Userinit"
                    },
                    {
                        "field": "body.registry.name",
                        "operator": "startswith",
                        "value": "HKEY_CURRENT_USER\\\\Software\\\\Policies\\\\Microsoft\\\\Windows\\\\System\\\\Scripts\\\\Logon"
                    },
                    {
                        "field": "body.registry.name",
                        "operator": "startswith",
                        "value": "HKEY_LOCAL_MACHINE\\\\Software\\\\Policies\\\\Microsoft\\\\Windows\\\\System\\\\Scripts\\\\Logon"
                    }
                ]
            }
        },
        "condition": "(s1_process_create_action and s2_process_script_interpreter and s3_process_cmdline_network_path and s4_process_cmdline_script_ext) or (s5_filesystem_write_create_action and s6_filesystem_filepath_network_script) or (s7_registry_modify_action and s8_registry_logon_script_key)"
    },
    "operational_usage": "SOC 팀은 이 규칙을 활용하여 네트워크 로그온 스크립트를 통한 지속성 확보 시도를 탐지할 수 있습니다. 특히, 네트워크 공유 경로(\\netlogon\\, \\sysvol\\)에서 실행되는 스크립트(.bat, .cmd, .ps1)의 프로세스 생성 이벤트, 해당 경로 내 스크립트 파일의 생성/수정/덮어쓰기 이벤트, 또는 로그온 스크립트 관련 레지스트리 키 변경 이벤트를 모니터링합니다. 탐지된 이벤트는 높은 심각도로 분류되어 즉각적인 알람을 트리거하고, 관련된 사용자 계정, 프로세스, 파일 및 레지스트리 변경 사항에 대한 추가적인 조사를 시작하는 데 사용될 수 있습니다. 이는 사용자 로그인 시 자동 실행되는 악성 스크립트를 식별하는 데 중요합니다.",
    "false_positive": "정상적인 시스템 관리 스크립트, 그룹 정책 업데이트, 또는 합법적인 소프트웨어 배포 도구가 네트워크 로그온 스크립트를 생성, 수정 또는 실행하는 과정에서 오탐이 발생할 수 있습니다. 알려진 정상적인 스크립트 파일, 특정 실행 프로세스, 또는 특정 레지스트리 키 변경 패턴에 대해 화이트리스트를 적용하여 오탐을 줄일 수 있습니다."
}