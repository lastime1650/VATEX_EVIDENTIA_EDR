{
    "id": "T1110.002-PasswordCracking",
    "name": "Password Cracking",
    "description": "Detects attempts to perform password cracking on the local system, including the execution of password cracking tools like Hashcat or John the Ripper, or accessing files commonly associated with password hashes and wordlists. While cracking is often done off-system, local activity may indicate preparation or direct attempts.",
    "severity": "high",
    "mitre_attack": {
        "tactic": "TA0006",
        "technique_id": "T1110",
        "subtechnique_id": "T1110.002",
        "data_sources": [
            "Process:ProcessCreation",
            "Command:CommandExecution",
            "File:FileAccess"
        ]
    },
    "platform": [
        "windows"
    ],
    "detection": {
        "selections": {
            "s_process_create_action": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.action",
                        "operator": "equals",
                        "value": "create"
                    }
                ]
            },
            "s_cracking_tool_exe_path": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.exe_path",
                        "operator": "contains",
                        "value": "hashcat.exe"
                    },
                    {
                        "field": "body.process.exe_path",
                        "operator": "contains",
                        "value": "john.exe"
                    }
                ]
            },
            "s_cracking_tool_cmdline": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "--m"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "--hash-type"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "-w"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "--wordlist"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "--attack-mode"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "ntlm"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "lm"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "sha1"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "md5"
                    }
                ]
            },
            "s_filesystem_read_write_action": {
                "event_type": "filesystem",
                "conditions": [
                    {
                        "field": "body.filesystem.action",
                        "operator": "equals",
                        "value": "read"
                    },
                    {
                        "field": "body.filesystem.action",
                        "operator": "equals",
                        "value": "create"
                    },
                    {
                        "field": "body.filesystem.action",
                        "operator": "equals",
                        "value": "write"
                    },
                    {
                        "field": "body.filesystem.action",
                        "operator": "equals",
                        "value": "open"
                    }
                ]
            },
            "s_sensitive_hash_file_access": {
                "event_type": "filesystem",
                "conditions": [
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "contains",
                        "value": "C:\\\\Windows\\\\System32\\\\config\\\\SAM"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "contains",
                        "value": "C:\\\\Windows\\\\System32\\\\config\\\\SYSTEM"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "contains",
                        "value": "C:\\\\Windows\\\\NTDS\\\\ntds.dit"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "contains",
                        "value": "lsass.dmp"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "contains",
                        "value": "lsass.exe.dmp"
                    }
                ]
            },
            "s_wordlist_file_access": {
                "event_type": "filesystem",
                "conditions": [
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "contains",
                        "value": "wordlist"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "contains",
                        "value": "passwords.txt"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "contains",
                        "value": "rockyou.txt"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "endswith",
                        "value": ".lst"
                    }
                ]
            },
            "s_cracked_output_file_creation": {
                "event_type": "filesystem",
                "conditions": [
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "endswith",
                        "value": "cracked.txt"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "endswith",
                        "value": ".potfile"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "endswith",
                        "value": ".found"
                    }
                ]
            }
        },
        "condition": "(s_process_create_action and s_cracking_tool_exe_path and s_cracking_tool_cmdline) or (s_filesystem_read_write_action and (s_sensitive_hash_file_access or s_wordlist_file_access or s_cracked_output_file_creation))"
    },
    "operational_usage": "SOC 팀은 이 규칙을 활용하여 시스템 내에서 비밀번호 크래킹 시도를 탐지할 수 있습니다. Hashcat, John the Ripper와 같은 크래킹 도구의 실행 이벤트와 함께 관련 명령줄 인자를 모니터링합니다. 또한, SAM, SYSTEM, ntds.dit와 같은 민감한 해시 파일 접근, 대규모 워드리스트 파일 접근, 또는 크래킹 결과 파일 생성을 파일 시스템 이벤트로 탐지합니다. 탐지된 이벤트는 높은 심각도로 분류되어 즉각적인 알람을 트리거하고, 관련 프로세스 및 파일에 대한 추가적인 포렌식 조사를 시작하는 데 사용될 수 있습니다. 특히, 다른 자격 증명 접근 또는 방어 회피 전술과 결합될 때 중요도가 더욱 높아집니다.",
    "false_positive": "정상적인 시스템 관리 도구, 보안 감사 도구, 또는 개발/테스트 환경에서 합법적으로 비밀번호 크래킹 도구를 사용하거나 관련 파일에 접근하는 경우 오탐이 발생할 수 있습니다. 특정 파일 경로, 프로세스 이름, 또는 명령줄 패턴을 화이트리스트에 추가하여 오탐을 줄일 수 있습니다."
}