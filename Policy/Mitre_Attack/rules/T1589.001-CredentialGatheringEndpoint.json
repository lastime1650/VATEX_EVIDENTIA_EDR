{
    "id": "T1589.001-CredentialGatheringEndpoint",
    "name": "Endpoint Credential Gathering",
    "description": "Detects attempts by adversaries to gather credentials from the local system, which can include accessing browser password stores, dumping OS credentials (e.g., LSASS, SAM hives), or querying sensitive registry keys related to stored credentials. While the primary T1589.001 technique often involves external reconnaissance, this rule focuses on on-endpoint activities that facilitate credential collection or access once an adversary has gained a foothold.",
    "severity": "high",
    "mitre_attack": {
        "tactic": "TA0043",
        "technique_id": "T1589",
        "subtechnique_id": "T1589.001",
        "data_sources": [
            "Enterprise:Execution:Command and Scripting Interpreter:Windows Command Shell",
            "Enterprise:Execution:Native API",
            "Enterprise:Discovery:File and Directory Discovery",
            "Enterprise:Discovery:Query Registry",
            "Enterprise:Credential Access:OS Credential Dumping",
            "Enterprise:Credential Access:Credentials from Password Stores:Credentials from Web Browsers",
            "Enterprise:Credential Access:Unsecured Credentials:Credentials in Registry"
        ]
    },
    "platform": [
        "windows"
    ],
    "detection": {
        "selections": {
            "s1_process_creation_event": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.action",
                        "operator": "equals",
                        "value": "create"
                    }
                ]
            },
            "s2_mimikatz_commandline": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "mimikatz"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "sekurlsa::logonpasswords"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "privilege::debug"
                    }
                ]
            },
            "s3_procdump_lsass_commandline": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.exe_path",
                        "operator": "endswith",
                        "value": "procdump.exe"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "lsass.exe"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "-accepteula"
                    }
                ]
            },
            "s4_reg_save_hive_commandline": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.exe_path",
                        "operator": "endswith",
                        "value": "reg.exe"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "save"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "HKEY_LOCAL_MACHINE\\SAM"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "HKEY_LOCAL_MACHINE\\SYSTEM"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "HKEY_LOCAL_MACHINE\\SECURITY"
                    }
                ]
            },
            "s5_filesystem_read_access": {
                "event_type": "filesystem",
                "conditions": [
                    {
                        "field": "body.filesystem.action",
                        "operator": "equals",
                        "value": "read"
                    },
                    {
                        "field": "body.filesystem.action",
                        "operator": "equals",
                        "value": "open"
                    }
                ]
            },
            "s6_browser_credential_filepath": {
                "event_type": "filesystem",
                "conditions": [
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "contains",
                        "value": "Login Data"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "contains",
                        "value": "Web Data"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "contains",
                        "value": "logins.json"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "contains",
                        "value": "key4.db"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "contains",
                        "value": "Microsoft\\Edge\\User Data\\Default\\Login Data"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "contains",
                        "value": "Google\\Chrome\\User Data\\Default\\Login Data"
                    }
                ]
            },
            "s7_lsass_process_access_target": {
                "event_type": "processaccess",
                "conditions": [
                    {
                        "field": "body.processaccess.filepath",
                        "operator": "endswith",
                        "value": "lsass.exe"
                    }
                ]
            },
            "s8_lsass_process_access_rights": {
                "event_type": "processaccess",
                "conditions": [
                    {
                        "field": "body.processaccess.desiredaccesses",
                        "operator": "contains",
                        "value": "PROCESS_VM_READ"
                    },
                    {
                        "field": "body.processaccess.desiredaccesses",
                        "operator": "contains",
                        "value": "PROCESS_ALL_ACCESS"
                    }
                ]
            },
            "s9_api_minidumpwritedump": {
                "event_type": "apicall",
                "conditions": [
                    {
                        "field": "body.apicall.function",
                        "operator": "equals",
                        "value": "MiniDumpWriteDump"
                    }
                ]
            },
            "s10_api_lsaretrieveprivatedata": {
                "event_type": "apicall",
                "conditions": [
                    {
                        "field": "body.apicall.function",
                        "operator": "equals",
                        "value": "LsaRetrievePrivateData"
                    }
                ]
            },
            "s11_registry_credential_keyclass": {
                "event_type": "registry",
                "conditions": [
                    {
                        "field": "body.registry.keyclass",
                        "operator": "contains",
                        "value": "Query"
                    },
                    {
                        "field": "body.registry.keyclass",
                        "operator": "contains",
                        "value": "OpenKey"
                    },
                    {
                        "field": "body.registry.keyclass",
                        "operator": "contains",
                        "value": "Enumerate"
                    },
                    {
                        "field": "body.registry.keyclass",
                        "operator": "contains",
                        "value": "SetValueKey"
                    }
                ]
            },
            "s12_registry_credential_name": {
                "event_type": "registry",
                "conditions": [
                    {
                        "field": "body.registry.name",
                        "operator": "startswith",
                        "value": "HKEY_LOCAL_MACHINE\\SAM"
                    },
                    {
                        "field": "body.registry.name",
                        "operator": "startswith",
                        "value": "HKEY_LOCAL_MACHINE\\SECURITY"
                    },
                    {
                        "field": "body.registry.name",
                        "operator": "startswith",
                        "value": "HKEY_LOCAL_MACHINE\\SYSTEM\\CurrentControlSet\\Control\\Lsa"
                    },
                    {
                        "field": "body.registry.name",
                        "operator": "contains",
                        "value": "Creds"
                    },
                    {
                        "field": "body.registry.name",
                        "operator": "contains",
                        "value": "Password"
                    }
                ]
            }
        },
        "condition": "(s1_process_creation_event and s2_mimikatz_commandline) or (s1_process_creation_event and s3_procdump_lsass_commandline) or (s1_process_creation_event and s4_reg_save_hive_commandline) or (s5_filesystem_read_access and s6_browser_credential_filepath) or (s7_lsass_process_access_target and s8_lsass_process_access_rights) or s9_api_minidumpwritedump or s10_api_lsaretrieveprivatedata or (s11_registry_credential_keyclass and s12_registry_credential_name)"
    },
    "operational_usage": "SOC 팀은 이 규칙을 활용하여 엔드포인트에서 발생하는 자격 증명 수집 시도를 탐지할 수 있습니다. Mimikatz, ProcDump와 같은 도구 실행, 레지스트리 하이브(SAM, SYSTEM, SECURITY) 저장 시도, 웹 브라우저 자격 증명 파일에 대한 비정상적인 접근, LSASS 프로세스 메모리 읽기 시도, 또는 특정 자격 증명 관련 API 호출 등을 모니터링합니다. 탐지된 이벤트는 높은 심각도로 분류되어 즉각적인 알람을 트리거하고, 관련 프로세스 및 파일에 대한 추가적인 포렌식 조사를 시작하는 데 사용될 수 있습니다. 이는 후속 공격 단계인 권한 상승이나 횡적 이동을 방지하는 데 중요합니다.",
    "false_positive": "정상적인 시스템 관리 도구, 백신 소프트웨어, 또는 합법적인 애플리케이션이 시스템 진단, 백업, 또는 보안 감사 목적으로 자격 증명 관련 정보에 접근하는 경우 오탐이 발생할 수 있습니다. 예를 들어, 보안 스캐너가 브라우저 캐시를 분석하거나, 백업 솔루션이 시스템 레지스트리 하이브를 읽는 경우입니다. 알려진 정상 프로세스나 특정 명령줄 패턴을 화이트리스트에 추가하여 오탐을 줄일 수 있습니다."
}