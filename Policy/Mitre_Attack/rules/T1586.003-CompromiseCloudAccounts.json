{
    "id": "T1586.003-CompromiseCloudAccounts",
    "name": "Compromise Cloud Accounts - Endpoint Activity",
    "description": "Detects endpoint activities related to the use of compromised cloud accounts, including execution of cloud provider CLI tools (Azure CLI, AWS CLI, Google Cloud SDK) for authentication, account enumeration, or interaction with cloud resources. This rule focuses on the observable actions on the endpoint that indicate an adversary is leveraging access to cloud accounts.",
    "severity": "high",
    "mitre_attack": {
        "tactic": "TA0002",
        "technique_id": "T1586",
        "subtechnique_id": "T1586.003",
        "data_sources": [
            "Enterprise:Resource Development:Compromise Accounts:Cloud Accounts",
            "Enterprise:Execution:Command and Scripting Interpreter:Windows Command Shell",
            "Enterprise:Execution:Command and Scripting Interpreter:PowerShell",
            "Enterprise:Discovery:Cloud Infrastructure Discovery",
            "Enterprise:Exfiltration:Exfiltration Over Web Service:Exfiltration to Cloud Storage",
            "Enterprise:Resource Development:Obtain Capabilities:Tool"
        ]
    },
    "platform": [
        "windows"
    ],
    "detection": {
        "selections": {
            "s1_process_create_action": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.action",
                        "operator": "equals",
                        "value": "create"
                    }
                ]
            },
            "s2_az_cli_tool": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.exe_path",
                        "operator": "endswith",
                        "value": "az.exe"
                    }
                ]
            },
            "s3_az_sensitive_commands": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "az login"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "az account show"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "az ad user list"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "az vm list"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "az storage blob upload"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "az storage blob download"
                    }
                ]
            },
            "s4_aws_cli_tool": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.exe_path",
                        "operator": "endswith",
                        "value": "aws.exe"
                    },
                    {
                        "field": "body.process.exe_path",
                        "operator": "endswith",
                        "value": "aws.cmd"
                    }
                ]
            },
            "s5_aws_sensitive_commands": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "aws configure"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "aws sts get-caller-identity"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "aws ec2 describe-instances"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "aws s3 ls"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "aws s3 cp"
                    }
                ]
            },
            "s6_gcloud_cli_tool": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.exe_path",
                        "operator": "endswith",
                        "value": "gcloud.cmd"
                    }
                ]
            },
            "s7_gcloud_sensitive_commands": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "gcloud auth login"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "gcloud compute instances list"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "gcloud storage ls"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "gcloud storage cp"
                    }
                ]
            },
            "s8_powershell_exe": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.exe_path",
                        "operator": "endswith",
                        "value": "powershell.exe"
                    },
                    {
                        "field": "body.process.exe_path",
                        "operator": "endswith",
                        "value": "pwsh.exe"
                    }
                ]
            },
            "s9_powershell_az_cmdlets": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "Connect-AzAccount"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "Get-AzContext"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "Get-AzSubscription"
                    }
                ]
            },
            "s10_powershell_aws_cmdlets": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "Initialize-AWSDefaultConfiguration"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "Get-EC2Instance"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "Get-S3Bucket"
                    }
                ]
            },
            "s11_powershell_gcloud_cmdlets": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "gcloud compute powershell"
                    }
                ]
            }
        },
        "condition": "s1_process_create_action and ((s2_az_cli_tool and s3_az_sensitive_commands) or (s4_aws_cli_tool and s5_aws_sensitive_commands) or (s6_gcloud_cli_tool and s7_gcloud_sensitive_commands) or (s8_powershell_exe and (s9_powershell_az_cmdlets or s10_powershell_aws_cmdlets or s11_powershell_gcloud_cmdlets)))"
    },
    "operational_usage": "SOC 팀은 이 규칙을 활용하여 엔드포인트에서 손상된 클라우드 계정을 사용하거나 계정 정보를 수집하려는 시도를 탐지할 수 있습니다. Azure CLI, AWS CLI, Google Cloud SDK와 같은 클라우드 제공업체 CLI 도구의 실행과 함께 'login', 'account show', 'list', 'cp', 'upload' 등과 같은 민감한 명령줄 인자를 모니터링합니다. 또한 PowerShell을 통한 클라우드 관리 Cmdlet 사용도 탐지합니다. 탐지된 이벤트는 높은 심각도로 분류되어 즉각적인 알람을 트리거하고, 관련된 프로세스 활동 및 네트워크 연결에 대한 심층 조사를 시작하는 데 사용될 수 있습니다. 특히, 비정상적인 사용자 계정이나 호스트에서 이러한 활동이 관찰될 경우 중요도가 더욱 높아집니다.",
    "false_positive": "정상적인 클라우드 관리 작업, 개발자 활동, 자동화된 스크립트, 또는 CI/CD 파이프라인에서 클라우드 CLI 도구 및 PowerShell Cmdlet을 사용하는 경우 오탐이 발생할 수 있습니다. 알려진 정상적인 클라우드 관리 프로세스, 사용자, 또는 특정 명령줄 패턴을 화이트리스트에 추가하여 오탐을 줄일 수 있습니다. 특히, 'login'이나 'configure'와 같은 명령은 초기 설정 시에도 발생할 수 있으므로, 기준선 설정을 통한 이상 탐지가 중요합니다."
}