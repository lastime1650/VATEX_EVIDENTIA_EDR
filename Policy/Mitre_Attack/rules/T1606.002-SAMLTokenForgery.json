{
    "id": "T1606.002-SAMLTokenForgery",
    "name": "SAML Token Forgery",
    "description": "Detects attempts to forge SAML tokens, typically by compromising or generating a token-signing certificate. Adversaries can use forged SAML tokens to authenticate across services that rely on SAML 2.0 for single sign-on (SSO), potentially bypassing multi-factor authentication and gaining administrative privileges.",
    "severity": "high",
    "mitre_attack": {
        "tactic": "TA0006",
        "technique_id": "T1606",
        "subtechnique_id": "T1606.002",
        "data_sources": [
            "Enterprise:Credential Access:Forge Web Credentials:SAML Tokens",
            "Enterprise:Credential Access:LogonSession:LogonSessionCreation",
            "Enterprise:Credential Access:UserAccount:UserAccountAuthentication",
            "Enterprise:Execution:Process:ProcessCreation",
            "Enterprise:Discovery:Query Registry",
            "Enterprise:Defense Evasion:Modify Registry",
            "Enterprise:Discovery:File and Directory Discovery",
            "Enterprise:Execution:Native API"
        ]
    },
    "platform": [
        "windows"
    ],
    "detection": {
        "selections": {
            "s1_process_create": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.action",
                        "operator": "equals",
                        "value": "create"
                    }
                ]
            },
            "s2_aadinternals_cmd": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "AADInternals"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "Invoke-AADInt"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "Get-AADIntTokenSigningCertificate"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "Set-AADInt"
                    }
                ]
            },
            "s3_powershell_exe": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.exe_path",
                        "operator": "endswith",
                        "value": "powershell.exe"
                    },
                    {
                        "field": "body.process.exe_path",
                        "operator": "endswith",
                        "value": "pwsh.exe"
                    }
                ]
            },
            "s4_powershell_cert_export_cmd": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "Export-PfxCertificate"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "Get-ChildItem Cert:\\\\LocalMachine\\\\My"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "Get-Item Cert:\\\\"
                    }
                ]
            },
            "s5_filesystem_cert_action": {
                "event_type": "filesystem",
                "conditions": [
                    {
                        "field": "body.filesystem.action",
                        "operator": "equals",
                        "value": "read"
                    },
                    {
                        "field": "body.filesystem.action",
                        "operator": "equals",
                        "value": "create"
                    },
                    {
                        "field": "body.filesystem.action",
                        "operator": "equals",
                        "value": "write"
                    }
                ]
            },
            "s6_filesystem_cert_extension": {
                "event_type": "filesystem",
                "conditions": [
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "endswith",
                        "value": ".pfx"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "endswith",
                        "value": ".cer"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "endswith",
                        "value": ".key"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "endswith",
                        "value": ".pem"
                    }
                ]
            },
            "s7_registry_cert_keyclass": {
                "event_type": "registry",
                "conditions": [
                    {
                        "field": "body.registry.keyclass",
                        "operator": "contains",
                        "value": "Query"
                    },
                    {
                        "field": "body.registry.keyclass",
                        "operator": "contains",
                        "value": "Open"
                    },
                    {
                        "field": "body.registry.keyclass",
                        "operator": "contains",
                        "value": "Set"
                    }
                ]
            },
            "s8_registry_cert_path": {
                "event_type": "registry",
                "conditions": [
                    {
                        "field": "body.registry.name",
                        "operator": "startswith",
                        "value": "HKEY_LOCAL_MACHINE\\\\SOFTWARE\\\\Microsoft\\\\SystemCertificates"
                    },
                    {
                        "field": "body.registry.name",
                        "operator": "startswith",
                        "value": "HKEY_CURRENT_USER\\\\SOFTWARE\\\\Microsoft\\\\SystemCertificates"
                    }
                ]
            },
            "s9_apicall_crypto_function": {
                "event_type": "apicall",
                "conditions": [
                    {
                        "field": "body.apicall.function",
                        "operator": "equals",
                        "value": "CryptAcquireContext"
                    },
                    {
                        "field": "body.apicall.function",
                        "operator": "equals",
                        "value": "CertOpenStore"
                    },
                    {
                        "field": "body.apicall.function",
                        "operator": "equals",
                        "value": "CertFindCertificateInStore"
                    },
                    {
                        "field": "body.apicall.function",
                        "operator": "equals",
                        "value": "CryptSignHash"
                    }
                ]
            }
        },
        "condition": "(s1_process_create and s2_aadinternals_cmd) or (s1_process_create and s3_powershell_exe and s4_powershell_cert_export_cmd) or (s5_filesystem_cert_action and s6_filesystem_cert_extension) or (s7_registry_cert_keyclass and s8_registry_cert_path) or s9_apicall_crypto_function"
    },
    "operational_usage": "SOC 팀은 이 규칙을 활용하여 SAML 토큰 위조 시도를 탐지할 수 있습니다. 이는 AADInternals와 같은 특정 도구의 실행, PowerShell을 이용한 인증서 내보내기 또는 검색 명령, 인증서 파일에 대한 비정상적인 파일 시스템 접근, 그리고 시스템 인증서 저장소에 대한 레지스트리 접근을 모니터링하여 이루어집니다. 탐지된 이벤트는 높은 심각도로 분류되어 즉각적인 알람을 트리거하고, 해당 엔드포인트에 대한 추가 조사 및 침해사고 대응 프로세스를 시작하는 데 사용될 수 있습니다. 특히, 다른 자격 증명 접근 또는 방어 회피 전술과 결합될 때 중요도가 더욱 높아집니다.",
    "false_positive": "정상적인 시스템 관리 작업, 소프트웨어 설치 또는 업데이트, 백업 유틸리티, 또는 합법적인 애플리케이션이 인증서를 관리하거나 내보내는 과정에서 오탐이 발생할 수 있습니다. 알려진 정상 프로세스, 특정 명령줄 패턴, 또는 인증서 관리 도구에 대해 화이트리스트를 적용하여 오탐을 줄일 수 있습니다."
}