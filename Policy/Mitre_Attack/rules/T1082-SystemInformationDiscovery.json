{
    "id": "T1082-SystemInformationDiscovery",
    "name": "System Information Discovery",
    "description": "Detects attempts to gather detailed information about the operating system, hardware, and configuration using built-in Windows utilities, PowerShell cmdlets, or direct API calls. This includes commands like 'systeminfo.exe', 'wmic', and PowerShell commands to query system objects or registry keys related to system configuration.",
    "severity": "medium",
    "mitre_attack": {
        "tactic": "TA0007",
        "technique_id": "T1082",
        "subtechnique_id": "",
        "data_sources": [
            "Enterprise:Execution:Native API",
            "Enterprise:Execution:Command and Scripting Interpreter:Windows Command Shell",
            "Enterprise:Discovery:Query Registry"
        ]
    },
    "platform": [
        "windows"
    ],
    "detection": {
        "selections": {
            "s1_process_create_action": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.action",
                        "operator": "equals",
                        "value": "create"
                    }
                ]
            },
            "s2_systeminfo_exe": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.exe_path",
                        "operator": "endswith",
                        "value": "systeminfo.exe"
                    }
                ]
            },
            "s3_wmic_exe": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.exe_path",
                        "operator": "endswith",
                        "value": "wmic.exe"
                    }
                ]
            },
            "s4_wmic_os_cmdline": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "os get"
                    }
                ]
            },
            "s5_wmic_computersystem_cmdline": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "computersystem get"
                    }
                ]
            },
            "s6_powershell_exe": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.exe_path",
                        "operator": "endswith",
                        "value": "powershell.exe"
                    },
                    {
                        "field": "body.process.exe_path",
                        "operator": "endswith",
                        "value": "pwsh.exe"
                    }
                ]
            },
            "s7_powershell_get_computerinfo_cmdlet": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "Get-ComputerInfo"
                    }
                ]
            },
            "s8_powershell_wmi_os_cmdlet": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "Win32_OperatingSystem"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "Win32_ComputerSystem"
                    }
                ]
            },
            "s9_registry_access_action": {
                "event_type": "registry",
                "conditions": [
                    {
                        "field": "body.registry.keyclass",
                        "operator": "contains",
                        "value": "Query"
                    },
                    {
                        "field": "body.registry.keyclass",
                        "operator": "contains",
                        "value": "OpenKey"
                    },
                    {
                        "field": "body.registry.keyclass",
                        "operator": "contains",
                        "value": "Enumerate"
                    }
                ]
            },
            "s10_registry_os_version_path": {
                "event_type": "registry",
                "conditions": [
                    {
                        "field": "body.registry.name",
                        "operator": "startswith",
                        "value": "HKEY_LOCAL_MACHINE\\SOFTWARE\\Microsoft\\Windows NT\\CurrentVersion"
                    }
                ]
            },
            "s11_registry_hardware_path": {
                "event_type": "registry",
                "conditions": [
                    {
                        "field": "body.registry.name",
                        "operator": "startswith",
                        "value": "HKEY_LOCAL_MACHINE\\HARDWARE\\DESCRIPTION\\System"
                    }
                ]
            },
            "s12_apicall_get_system_info": {
                "event_type": "apicall",
                "conditions": [
                    {
                        "field": "body.apicall.function",
                        "operator": "equals",
                        "value": "GetVersionEx"
                    },
                    {
                        "field": "body.apicall.function",
                        "operator": "equals",
                        "value": "GetNativeSystemInfo"
                    },
                    {
                        "field": "body.apicall.function",
                        "operator": "equals",
                        "value": "GetSystemInfo"
                    }
                ]
            }
        },
        "condition": "s1_process_create_action and (s2_systeminfo_exe or (s3_wmic_exe and (s4_wmic_os_cmdline or s5_wmic_computersystem_cmdline)) or (s6_powershell_exe and (s7_powershell_get_computerinfo_cmdlet or s8_powershell_wmi_os_cmdlet))) or (s9_registry_access_action and (s10_registry_os_version_path or s11_registry_hardware_path)) or s12_apicall_get_system_info"
    },
    "operational_usage": "SOC 팀은 이 규칙을 활용하여 시스템 운영체제 및 하드웨어 정보 수집 시도를 탐지할 수 있습니다. 'systeminfo.exe', 'wmic'와 같은 명령 실행, PowerShell을 통한 시스템 정보 쿼리, 또는 시스템 구성 관련 레지스트리 키 접근 및 API 호출 등을 모니터링합니다. 탐지된 이벤트는 중간 심각도로 분류되어 알람을 트리거하고, 추가적인 조사 및 침해사고 대응의 우선순위를 지정하는 데 사용될 수 있습니다. 특히 다른 Discovery 또는 Collection 활동과 결합될 때 중요도가 높아집니다.",
    "false_positive": "정상적인 시스템 관리 도구, 백신 소프트웨어, 진단 유틸리티, 또는 합법적인 애플리케이션이 시스템 정보를 조회하는 과정에서 오탐이 발생할 수 있습니다. 알려진 정상 프로세스나 특정 명령줄 패턴을 화이트리스트에 추가하여 오탐을 줄일 수 있습니다."
}