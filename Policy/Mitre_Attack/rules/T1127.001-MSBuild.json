{
    "id": "T1127.001-MSBuild",
    "name": "MSBuild Proxy Execution",
    "description": "Detects attempts by adversaries to abuse MSBuild.exe for proxy execution of malicious code, often leveraging its inline task capability to execute C# or Visual Basic code directly from the command line or a crafted project file. This technique allows for arbitrary code execution and can bypass application control defenses by using a signed Microsoft binary.",
    "severity": "high",
    "mitre_attack": {
        "tactic": "TA0005",
        "technique_id": "T1127",
        "subtechnique_id": "T1127.001",
        "data_sources": [
            "Enterprise:Execution:Command and Scripting Interpreter:Windows Command Shell"
        ]
    },
    "platform": [
        "windows"
    ],
    "detection": {
        "selections": {
            "s1_process_action_create": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.action",
                        "operator": "equals",
                        "value": "create"
                    }
                ]
            },
            "s2_msbuild_exe_path": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.exe_path",
                        "operator": "endswith",
                        "value": "msbuild.exe"
                    }
                ]
            },
            "s3_cmdline_csharp_inline_keywords": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "using System;"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "public class"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "Microsoft.Build.Utilities.Task"
                    }
                ]
            },
            "s4_cmdline_vb_inline_keywords": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "Imports System"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "Public Class"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "Microsoft.Build.Utilities.Task"
                    }
                ]
            },
            "s5_cmdline_logger_flag": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "/l:"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "/logger:"
                    }
                ]
            },
            "s6_cmdline_logger_payload_extension": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": ".dll"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": ".exe"
                    }
                ]
            },
            "s7_cmdline_suspicious_target_exec": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "/target:Exec"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "/target:Run"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "/target:Start"
                    }
                ]
            },
            "s8_cmdline_powershell_encoded_command": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "powershell"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "-enc"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "-EncodedCommand"
                    }
                ]
            },
            "s9_cmdline_contains_url_or_base64_data": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "http://"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "https://"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "data:text/xml;base64,"
                    }
                ]
            },
            "s10_cmdline_project_file_presence": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": ".csproj"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": ".vbproj"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": ".targets"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": ".props"
                    }
                ]
            }
        },
        "condition": "s1_process_action_create and s2_msbuild_exe_path and ( (s3_cmdline_csharp_inline_keywords and not s10_cmdline_project_file_presence) or (s4_cmdline_vb_inline_keywords and not s10_cmdline_project_file_presence) or (s5_cmdline_logger_flag and s6_cmdline_logger_payload_extension) or s7_cmdline_suspicious_target_exec or s8_cmdline_powershell_encoded_command or s9_cmdline_contains_url_or_base64_data )"
    },
    "operational_usage": "SOC 팀은 이 규칙을 활용하여 MSBuild.exe를 통한 악성 코드 실행 시도를 탐지할 수 있습니다. MSBuild 프로세스 생성 이벤트와 함께 명령줄에서 C# 또는 Visual Basic 인라인 태스크 키워드, 의심스러운 타겟 실행, 사용자 지정 로거 DLL/EXE 사용, 인코딩된 PowerShell 명령, 또는 URL/Base64 데이터 포함 여부를 모니터링합니다. 특히, 표준 프로젝트 파일 없이 이러한 패턴이 나타나는 경우 높은 심각도로 분류하여 즉각적인 알람을 트리거하고, 관련 프로세스 및 명령줄에 대한 추가적인 포렌식 조사를 시작하는 데 사용될 수 있습니다. 이는 다른 방어 회피 또는 실행 전술과 결합될 때 중요도가 더욱 높아집니다.",
    "false_positive": "정상적인 소프트웨어 개발 및 빌드 환경, CI/CD 파이프라인, 또는 특정 개발 도구가 MSBuild.exe를 사용하여 복잡한 빌드 스크립트나 사용자 지정 태스크를 실행하는 경우 오탐이 발생할 수 있습니다. 특히, 인라인 태스크와 유사한 패턴을 포함하는 합법적인 프로젝트 파일이나 로거 사용이 있을 수 있습니다. 알려진 정상적인 MSBuild 호출 패턴, 특정 경로의 프로젝트 파일, 또는 신뢰할 수 있는 개발 프로세스에 대해 화이트리스트를 적용하여 오탐을 줄일 수 있습니다."
}