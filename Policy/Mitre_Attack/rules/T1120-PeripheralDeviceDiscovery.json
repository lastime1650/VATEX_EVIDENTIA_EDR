{
    "id": "T1120-PeripheralDeviceDiscovery",
    "name": "Peripheral Device Discovery",
    "description": "Detects attempts to gather information about attached peripheral devices and components connected to a computer system. This includes using command-line tools like wmic, systeminfo, devcon, PowerShell cmdlets, accessing device-related registry keys, or calling specific APIs to enumerate devices, disks, or network adapters.",
    "severity": "medium",
    "mitre_attack": {
        "tactic": "TA0007",
        "technique_id": "T1120",
        "subtechnique_id": "",
        "data_sources": [
            "Enterprise:Execution:Command and Scripting Interpreter:Windows Command Shell",
            "Enterprise:Execution:Native API",
            "Enterprise:Discovery:Query Registry"
        ]
    },
    "platform": [
        "windows"
    ],
    "detection": {
        "selections": {
            "s1_process_create": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.action",
                        "operator": "equals",
                        "value": "create"
                    }
                ]
            },
            "s2a_cmdline_wmic": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "wmic"
                    }
                ]
            },
            "s2b_cmdline_wmic_peripheral_keywords": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "PnPEntity"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "diskdrive"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "logicaldisk"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "nic"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "baseboard"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "cpu"
                    }
                ]
            },
            "s3_cmdline_systeminfo": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "systeminfo.exe"
                    }
                ]
            },
            "s4_cmdline_devcon": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "devcon.exe"
                    }
                ]
            },
            "s5_powershell_exe": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "powershell.exe"
                    }
                ]
            },
            "s6_powershell_pnp_cmdlets": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "Get-PnpDevice"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "Win32_PnPEntity"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "Get-Disk"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "Get-Volume"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "Win32_NetworkAdapter"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "Win32_Processor"
                    }
                ]
            },
            "s7_registry_query_or_open": {
                "event_type": "registry",
                "conditions": [
                    {
                        "field": "body.registry.keyclass",
                        "operator": "contains",
                        "value": "QueryKey"
                    },
                    {
                        "field": "body.registry.keyclass",
                        "operator": "contains",
                        "value": "OpenKey"
                    },
                    {
                        "field": "body.registry.keyclass",
                        "operator": "contains",
                        "value": "EnumerateKey"
                    }
                ]
            },
            "s8_registry_enum_path": {
                "event_type": "registry",
                "conditions": [
                    {
                        "field": "body.registry.name",
                        "operator": "startswith",
                        "value": "HKEY_LOCAL_MACHINE\\SYSTEM\\CurrentControlSet\\Enum"
                    },
                    {
                        "field": "body.registry.name",
                        "operator": "startswith",
                        "value": "HKEY_LOCAL_MACHINE\\HARDWARE\\DEVICEMAP"
                    },
                    {
                        "field": "body.registry.name",
                        "operator": "startswith",
                        "value": "HKEY_LOCAL_MACHINE\\SYSTEM\\CurrentControlSet\\Control\\Class"
                    }
                ]
            },
            "s9_apicall_peripheral_enum": {
                "event_type": "apicall",
                "conditions": [
                    {
                        "field": "body.apicall.function",
                        "operator": "equals",
                        "value": "SetupDiEnumDeviceInfo"
                    },
                    {
                        "field": "body.apicall.function",
                        "operator": "equals",
                        "value": "GetLogicalDriveStringsW"
                    },
                    {
                        "field": "body.apicall.function",
                        "operator": "equals",
                        "value": "GetDriveTypeW"
                    },
                    {
                        "field": "body.apicall.function",
                        "operator": "equals",
                        "value": "EnumDisplayDevicesW"
                    },
                    {
                        "field": "body.apicall.function",
                        "operator": "equals",
                        "value": "GetAdaptersInfo"
                    },
                    {
                        "field": "body.apicall.function",
                        "operator": "equals",
                        "value": "GetAdaptersAddresses"
                    }
                ]
            }
        },
        "condition": "s1_process_create and ((s2a_cmdline_wmic and s2b_cmdline_wmic_peripheral_keywords) or s3_cmdline_systeminfo or s4_cmdline_devcon or (s5_powershell_exe and s6_powershell_pnp_cmdlets)) or (s7_registry_query_or_open and s8_registry_enum_path) or s9_apicall_peripheral_enum"
    },
    "operational_usage": "SOC 팀은 이 규칙을 통해 시스템에 연결된 주변 장치 및 구성 요소에 대한 정보 수집 시도를 탐지할 수 있습니다. WMIC, systeminfo, devcon과 같은 명령줄 도구 실행, PowerShell을 통한 장치 정보 열거, 특정 레지스트리 키 접근, 또는 관련 API 호출을 모니터링합니다. 탐지된 이벤트는 자동 알람을 트리거하고, 추가적인 조사 및 침해사고 대응의 우선순위를 지정하는 데 사용될 수 있습니다. 특히 다른 Discovery 또는 Collection 활동과 결합될 때 중요도가 높아집니다.",
    "false_positive": "정상적인 시스템 관리 도구, 백신 소프트웨어, 하드웨어 진단 유틸리티, 또는 합법적인 애플리케이션이 시스템 주변 장치 정보를 조회하는 과정에서 오탐이 발생할 수 있습니다. 알려진 정상 프로세스나 특정 명령줄 패턴을 화이트리스트에 추가하여 오탐을 줄일 수 있습니다."
}