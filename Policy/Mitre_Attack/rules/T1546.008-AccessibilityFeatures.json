{
    "id": "T1546.008-AccessibilityFeatures",
    "name": "Persistence/Privilege Escalation via Accessibility Features",
    "description": "Detects attempts to establish persistence or elevate privileges by abusing Windows accessibility features like Sticky Keys (sethc.exe) or Utility Manager (utilman.exe). This includes replacing legitimate accessibility binaries with malicious executables (e.g., cmd.exe) or modifying registry pointers to these binaries, including the Image File Execution Options (IFEO) debugger key. Such modifications allow adversaries to gain unauthenticated access or execute arbitrary code at logon.",
    "severity": "high",
    "mitre_attack": {
        "tactic": "TA0003",
        "technique_id": "T1546",
        "subtechnique_id": "T1546.008",
        "data_sources": [
            "Process:ProcessCreation",
            "Command:CommandExecution",
            "File:FileCreation",
            "File:FileModification",
            "WindowsRegistry:WindowsRegistryKeyModification"
        ]
    },
    "platform": [
        "windows"
    ],
    "detection": {
        "selections": {
            "s1_process_create_action": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.action",
                        "operator": "equals",
                        "value": "create"
                    }
                ]
            },
            "s2_exe_is_system32_cmd_or_powershell": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.exe_path",
                        "operator": "contains",
                        "value": "\\Windows\\System32\\cmd.exe"
                    },
                    {
                        "field": "body.process.exe_path",
                        "operator": "contains",
                        "value": "\\Windows\\System32\\powershell.exe"
                    }
                ]
            },
            "s3_parent_is_accessibility_feature": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.parent_exe_path",
                        "operator": "endswith",
                        "value": "sethc.exe"
                    },
                    {
                        "field": "body.process.parent_exe_path",
                        "operator": "endswith",
                        "value": "utilman.exe"
                    },
                    {
                        "field": "body.process.parent_exe_path",
                        "operator": "endswith",
                        "value": "osk.exe"
                    },
                    {
                        "field": "body.process.parent_exe_path",
                        "operator": "endswith",
                        "value": "Magnify.exe"
                    },
                    {
                        "field": "body.process.parent_exe_path",
                        "operator": "endswith",
                        "value": "Narrator.exe"
                    },
                    {
                        "field": "body.process.parent_exe_path",
                        "operator": "endswith",
                        "value": "DisplaySwitch.exe"
                    },
                    {
                        "field": "body.process.parent_exe_path",
                        "operator": "endswith",
                        "value": "AtBroker.exe"
                    }
                ]
            },
            "s4_filesystem_modify_action": {
                "event_type": "filesystem",
                "conditions": [
                    {
                        "field": "body.filesystem.action",
                        "operator": "equals",
                        "value": "create"
                    },
                    {
                        "field": "body.filesystem.action",
                        "operator": "equals",
                        "value": "overwritten"
                    },
                    {
                        "field": "body.filesystem.action",
                        "operator": "equals",
                        "value": "rename"
                    },
                    {
                        "field": "body.filesystem.action",
                        "operator": "equals",
                        "value": "write"
                    }
                ]
            },
            "s5_filesystem_target_accessibility_binaries": {
                "event_type": "filesystem",
                "conditions": [
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "contains",
                        "value": "\\Windows\\System32\\sethc.exe"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "contains",
                        "value": "\\Windows\\System32\\utilman.exe"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "contains",
                        "value": "\\Windows\\System32\\osk.exe"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "contains",
                        "value": "\\Windows\\System32\\Magnify.exe"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "contains",
                        "value": "\\Windows\\System32\\Narrator.exe"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "contains",
                        "value": "\\Windows\\System32\\DisplaySwitch.exe"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "contains",
                        "value": "\\Windows\\System32\\AtBroker.exe"
                    }
                ]
            },
            "s6_registry_modify_action": {
                "event_type": "registry",
                "conditions": [
                    {
                        "field": "body.registry.keyclass",
                        "operator": "contains",
                        "value": "SetValueKey"
                    },
                    {
                        "field": "body.registry.keyclass",
                        "operator": "contains",
                        "value": "RenameKey"
                    }
                ]
            },
            "s7_registry_ifeo_base_path": {
                "event_type": "registry",
                "conditions": [
                    {
                        "field": "body.registry.name",
                        "operator": "startswith",
                        "value": "HKEY_LOCAL_MACHINE\\SOFTWARE\\Microsoft\\Windows NT\\CurrentVersion\\Image File Execution Options\\"
                    }
                ]
            },
            "s8_registry_ifeo_debugger_value_name": {
                "event_type": "registry",
                "conditions": [
                    {
                        "field": "body.registry.name",
                        "operator": "contains",
                        "value": "\\Debugger"
                    }
                ]
            },
            "s9_registry_accessibility_config_paths": {
                "event_type": "registry",
                "conditions": [
                    {
                        "field": "body.registry.name",
                        "operator": "contains",
                        "value": "HKEY_LOCAL_MACHINE\\SOFTWARE\\Microsoft\\Windows NT\\CurrentVersion\\Accessibility\\"
                    },
                    {
                        "field": "body.registry.name",
                        "operator": "contains",
                        "value": "HKEY_LOCAL_MACHINE\\SOFTWARE\\Microsoft\\Windows NT\\CurrentVersion\\Accessibility\\ATs\\"
                    },
                    {
                        "field": "body.registry.name",
                        "operator": "contains",
                        "value": "HKEY_LOCAL_MACHINE\\SOFTWARE\\Microsoft\\Windows NT\\CurrentVersion\\Utility Manager\\"
                    },
                    {
                        "field": "body.registry.name",
                        "operator": "contains",
                        "value": "HKEY_LOCAL_MACHINE\\SOFTWARE\\Microsoft\\Windows NT\\CurrentVersion\\Winlogon\\Shell"
                    }
                ]
            }
        },
        "condition": "(s4_filesystem_modify_action and s5_filesystem_target_accessibility_binaries) or (s6_registry_modify_action and s7_registry_ifeo_base_path and s8_registry_ifeo_debugger_value_name) or (s6_registry_modify_action and s9_registry_accessibility_config_paths) or (s1_process_create_action and s2_exe_is_system32_cmd_or_powershell and s3_parent_is_accessibility_feature)"
    },
    "operational_usage": "SOC 팀은 이 규칙을 활용하여 Windows 접근성 기능을 악용한 지속성 및 권한 상승 시도를 탐지할 수 있습니다. 시스템32 디렉토리 내 접근성 바이너리(예: sethc.exe, utilman.exe)에 대한 파일 생성/수정/이름 변경 이벤트, Image File Execution Options (IFEO) 레지스트리 키의 'Debugger' 값 변경, 또는 접근성 기능 관련 레지스트리 경로 수정 이벤트를 모니터링합니다. 또한, 접근성 기능이 cmd.exe 또는 powershell.exe와 같은 의심스러운 프로세스를 실행하는 경우를 탐지합니다. 탐지된 이벤트는 높은 심각도로 분류되어 즉각적인 알람을 트리거하고, 해당 시스템에 대한 긴급 조사 및 침해사고 대응을 시작하는 데 활용될 수 있습니다.",
    "false_positive": "정상적인 시스템 관리 도구, 소프트웨어 설치 프로그램, 또는 시스템 복구/진단 유틸리티가 접근성 기능 관련 파일이나 레지스트리를 합법적으로 수정하는 경우 오탐이 발생할 수 있습니다. 특히 시스템 업데이트나 복구 과정에서 이러한 파일 및 레지스트리 변경이 발생할 수 있습니다. 알려진 정상 프로세스나 특정 변경 패턴을 화이트리스트에 추가하여 오탐을 줄일 수 있습니다."
}