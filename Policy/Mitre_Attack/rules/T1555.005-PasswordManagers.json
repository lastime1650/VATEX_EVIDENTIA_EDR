{
    "id": "T1555.005-PasswordManagers",
    "name": "Password Managers",
    "description": "Detects attempts to acquire user credentials from third-party password managers by accessing their process memory or database files. This includes monitoring for suspicious process access to password manager executables, unauthorized reads of password manager database files, or API calls indicative of memory dumping from these applications.",
    "severity": "high",
    "mitre_attack": {
        "tactic": "TA0006",
        "technique_id": "T1555",
        "subtechnique_id": "T1555.005",
        "data_sources": [
            "Enterprise:Credential Access:OS Credential Dumping",
            "Enterprise:Execution:Native API",
            "Enterprise:Collection:Data from Local System",
            "Enterprise:Execution:Command and Scripting Interpreter:Windows Command Shell"
        ]
    },
    "platform": [
        "windows"
    ],
    "detection": {
        "selections": {
            "s1_processaccess_target_pm_exe": {
                "event_type": "processaccess",
                "conditions": [
                    {
                        "field": "body.processaccess.target_filepath",
                        "operator": "endswith",
                        "value": "KeePass.exe"
                    },
                    {
                        "field": "body.processaccess.target_filepath",
                        "operator": "endswith",
                        "value": "LastPass.exe"
                    },
                    {
                        "field": "body.processaccess.target_filepath",
                        "operator": "endswith",
                        "value": "1Password.exe"
                    },
                    {
                        "field": "body.processaccess.target_filepath",
                        "operator": "endswith",
                        "value": "Dashlane.exe"
                    },
                    {
                        "field": "body.processaccess.target_filepath",
                        "operator": "endswith",
                        "value": "Bitwarden.exe"
                    }
                ]
            },
            "s2_processaccess_desired_memory_read": {
                "event_type": "processaccess",
                "conditions": [
                    {
                        "field": "body.processaccess.desiredaccesses",
                        "operator": "contains",
                        "value": "PROCESS_VM_READ"
                    },
                    {
                        "field": "body.processaccess.desiredaccesses",
                        "operator": "contains",
                        "value": "PROCESS_VM_OPERATION"
                    },
                    {
                        "field": "body.processaccess.desiredaccesses",
                        "operator": "contains",
                        "value": "PROCESS_ALL_ACCESS"
                    }
                ]
            },
            "s3_filesystem_read_action": {
                "event_type": "filesystem",
                "conditions": [
                    {
                        "field": "body.filesystem.action",
                        "operator": "equals",
                        "value": "read"
                    },
                    {
                        "field": "body.filesystem.action",
                        "operator": "equals",
                        "value": "open"
                    },
                    {
                        "field": "body.filesystem.action",
                        "operator": "equals",
                        "value": "exists"
                    }
                ]
            },
            "s4_filesystem_pm_db_filepath": {
                "event_type": "filesystem",
                "conditions": [
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "endswith",
                        "value": ".kdbx"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "contains",
                        "value": "LastPass\\"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "contains",
                        "value": "1Password\\"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "contains",
                        "value": "Dashlane\\"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "contains",
                        "value": "Bitwarden\\"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "contains",
                        "value": "passwords.json"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "contains",
                        "value": "vault.dat"
                    }
                ]
            },
            "s5_apicall_memory_read_function": {
                "event_type": "apicall",
                "conditions": [
                    {
                        "field": "body.apicall.function",
                        "operator": "equals",
                        "value": "ReadProcessMemory"
                    },
                    {
                        "field": "body.apicall.function",
                        "operator": "equals",
                        "value": "NtReadVirtualMemory"
                    }
                ]
            }
        },
        "condition": "(s1_processaccess_target_pm_exe and s2_processaccess_desired_memory_read) or (s3_filesystem_read_action and s4_filesystem_pm_db_filepath) or s5_apicall_memory_read_function"
    },
    "operational_usage": "SOC 팀은 이 규칙을 활용하여 시스템에 설치된 비밀번호 관리자로부터 자격 증명을 탈취하려는 시도를 탐지할 수 있습니다. 비밀번호 관리자 애플리케이션의 프로세스에 대한 비정상적인 메모리 접근 시도, 알려진 비밀번호 관리자 데이터베이스 파일에 대한 읽기 또는 접근 시도, 그리고 메모리 덤핑과 관련된 API 호출을 모니터링합니다. 탐지된 이벤트는 높은 심각도로 분류되어 즉각적인 알람을 트리거하고, 관련 프로세스 및 파일 활동에 대한 추가적인 포렌식 조사를 시작하는 데 사용될 수 있습니다. 특히, 다른 자격 증명 접근 또는 데이터 수집 전술과 결합될 때 중요도가 더욱 높아집니다.",
    "false_positive": "합법적인 백업 소프트웨어, 보안 스캐너, 시스템 관리 도구 또는 개발 도구가 비밀번호 관리자 파일이나 프로세스 메모리에 접근할 때 오탐이 발생할 수 있습니다. 알려진 정상 프로세스나 특정 파일 경로에 대해 화이트리스트를 적용하여 오탐을 줄일 수 있습니다."
}