{
    "id": "T1011-ExfiltrationOverOtherNetworkMedium",
    "name": "Exfiltration Over Other Network Medium",
    "description": "Detects attempts by adversaries to exfiltrate data using alternative network mediums such as Bluetooth, Wi-Fi (when primary is wired), or modems, bypassing the primary command and control channel. This includes monitoring for the execution of tools or commands that configure or utilize these alternative interfaces, as well as relevant API calls.",
    "severity": "high",
    "mitre_attack": {
        "tactic": "TA0010",
        "technique_id": "T1011",
        "subtechnique_id": "",
        "data_sources": [
            "Exfiltration:Exfiltration Over Other Network Medium:Exfiltration Over Bluetooth",
            "Execution:Command and Scripting Interpreter:Windows Command Shell",
            "Execution:Command and Scripting Interpreter:PowerShell",
            "Execution:Native API"
        ]
    },
    "platform": [
        "windows"
    ],
    "detection": {
        "selections": {
            "s1_process_create_action": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.action",
                        "operator": "equals",
                        "value": "create"
                    }
                ]
            },
            "s2_cmd_fsquirt_exe": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "fsquirt.exe"
                    }
                ]
            },
            "s3_cmd_powershell_exe": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "powershell.exe"
                    }
                ]
            },
            "s4_cmd_get_bluetooth_device": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "Get-BluetoothDevice"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "Set-BluetoothRadio"
                    }
                ]
            },
            "s5_cmd_netsh_exe": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "netsh.exe"
                    }
                ]
            },
            "s6_cmd_netsh_interface_config": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "interface set interface"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "wlan connect"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "wlan set profile"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "wlan disconnect"
                    }
                ]
            },
            "s7_cmd_rasdial_exe": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "rasdial.exe"
                    }
                ]
            },
            "s8_apicall_bluetooth_enum": {
                "event_type": "apicall",
                "conditions": [
                    {
                        "field": "body.apicall.function",
                        "operator": "equals",
                        "value": "BluetoothFindFirstDevice"
                    },
                    {
                        "field": "body.apicall.function",
                        "operator": "equals",
                        "value": "BluetoothFindNextDevice"
                    },
                    {
                        "field": "body.apicall.function",
                        "operator": "equals",
                        "value": "BluetoothGetDeviceInfo"
                    }
                ]
            },
            "s9_apicall_bluetooth_gatt": {
                "event_type": "apicall",
                "conditions": [
                    {
                        "field": "body.apicall.function",
                        "operator": "contains",
                        "value": "BluetoothGATT"
                    }
                ]
            },
            "s10_apicall_wlan_config": {
                "event_type": "apicall",
                "conditions": [
                    {
                        "field": "body.apicall.function",
                        "operator": "equals",
                        "value": "WlanEnumInterfaces"
                    },
                    {
                        "field": "body.apicall.function",
                        "operator": "equals",
                        "value": "WlanConnect"
                    },
                    {
                        "field": "body.apicall.function",
                        "operator": "equals",
                        "value": "WlanSetProfile"
                    },
                    {
                        "field": "body.apicall.function",
                        "operator": "equals",
                        "value": "WlanDisconnect"
                    }
                ]
            },
            "s11_apicall_get_adapters_addresses": {
                "event_type": "apicall",
                "conditions": [
                    {
                        "field": "body.apicall.function",
                        "operator": "equals",
                        "value": "GetAdaptersAddresses"
                    }
                ]
            }
        },
        "condition": " (s1_process_create_action and s2_cmd_fsquirt_exe) or (s1_process_create_action and s3_cmd_powershell_exe and s4_cmd_get_bluetooth_device) or (s1_process_create_action and s5_cmd_netsh_exe and s6_cmd_netsh_interface_config) or (s1_process_create_action and s7_cmd_rasdial_exe) or s8_apicall_bluetooth_enum or s9_apicall_bluetooth_gatt or s10_apicall_wlan_config or s11_apicall_get_adapters_addresses"
    },
    "operational_usage": "SOC 팀은 이 규칙을 활용하여 공격자가 기본 C2 채널이 아닌 다른 네트워크 매체(예: Bluetooth, Wi-Fi, 모뎀)를 통해 데이터를 유출하려는 시도를 탐지할 수 있습니다. 'fsquirt.exe'와 같은 Bluetooth 파일 전송 도구 실행, PowerShell을 통한 Bluetooth 장치 열거/설정 변경, 'netsh' 명령어를 사용한 네트워크 인터페이스 조작, 'rasdial.exe'를 통한 다이얼업 연결 시도, 또는 Bluetooth 및 WLAN 관련 API 호출 등을 모니터링합니다. 탐지된 이벤트는 높은 심각도로 분류되어 즉각적인 알람을 트리거하고, 관련된 프로세스 활동 및 네트워크 연결에 대한 추가 포렌식 조사를 시작하는 데 사용될 수 있습니다. 특히, 데이터 수집(Collection) 활동과 결합될 때 중요도가 더욱 높아집니다.",
    "false_positive": "정상적인 사용자 또는 시스템 프로세스가 Bluetooth 장치를 관리하거나, Wi-Fi 연결을 구성하거나, 모뎀을 사용하는 경우 오탐이 발생할 수 있습니다. 예를 들어, 무선 헤드셋 연결, 파일 공유, 시스템 진단 도구, VPN 클라이언트, 또는 합법적인 애플리케이션이 네트워크 설정을 변경하는 경우입니다. 알려진 정상 프로세스나 특정 명령줄 패턴을 화이트리스트에 추가하여 오탐을 줄일 수 있습니다."
}