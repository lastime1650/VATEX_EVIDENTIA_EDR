{
    "id": "T1584.004-CompromiseInfrastructureServer",
    "name": "Compromise Infrastructure: Server",
    "description": "Detects attempts to compromise third-party servers to be used by adversaries for staging, launching, or executing operations, such as for Command and Control (C2). This includes detecting web shell uploads, suspicious processes launched from web server contexts, and modifications to server-related configurations or services.",
    "severity": "high",
    "mitre_attack": {
        "tactic": "TA0007",
        "technique_id": "T1584",
        "subtechnique_id": "T1584.004",
        "data_sources": [
            "Process:ProcessCreation",
            "File:FileCreation",
            "File:FileModification",
            "WindowsRegistry:WindowsRegistryKeyCreation",
            "WindowsRegistry:WindowsRegistryKeyModification",
            "WindowsRegistry:WindowsRegistryKeyAccess"
        ]
    },
    "platform": [
        "windows"
    ],
    "detection": {
        "selections": {
            "s1_process_create_action": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.action",
                        "operator": "equals",
                        "value": "create"
                    }
                ]
            },
            "s2_parent_is_webserver": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.parent_exe_path",
                        "operator": "contains",
                        "value": "w3wp.exe"
                    },
                    {
                        "field": "body.process.parent_exe_path",
                        "operator": "contains",
                        "value": "httpd.exe"
                    },
                    {
                        "field": "body.process.parent_exe_path",
                        "operator": "contains",
                        "value": "nginx.exe"
                    }
                ]
            },
            "s3_cmdline_suspicious_tools": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "cmd.exe"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "powershell.exe"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "certutil.exe"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "bitsadmin.exe"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "mshta.exe"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "wscript.exe"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "cscript.exe"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "net.exe"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "sc.exe"
                    }
                ]
            },
            "s4_filesystem_write_action": {
                "event_type": "filesystem",
                "conditions": [
                    {
                        "field": "body.filesystem.action",
                        "operator": "equals",
                        "value": "create"
                    },
                    {
                        "field": "body.filesystem.action",
                        "operator": "equals",
                        "value": "write"
                    },
                    {
                        "field": "body.filesystem.action",
                        "operator": "equals",
                        "value": "overwritten"
                    }
                ]
            },
            "s5_filepath_web_root_iis": {
                "event_type": "filesystem",
                "conditions": [
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "contains",
                        "value": "inetpub\\wwwroot"
                    }
                ]
            },
            "s6_filepath_web_root_apache": {
                "event_type": "filesystem",
                "conditions": [
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "contains",
                        "value": "Apache24\\htdocs"
                    }
                ]
            },
            "s7_filepath_webshell_extension": {
                "event_type": "filesystem",
                "conditions": [
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "endswith",
                        "value": ".aspx"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "endswith",
                        "value": ".php"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "endswith",
                        "value": ".jsp"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "endswith",
                        "value": ".asp"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "endswith",
                        "value": ".ashx"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "endswith",
                        "value": ".cfm"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "endswith",
                        "value": ".pl"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "endswith",
                        "value": ".py"
                    }
                ]
            },
            "s8_registry_modification_action": {
                "event_type": "registry",
                "conditions": [
                    {
                        "field": "body.registry.keyclass",
                        "operator": "contains",
                        "value": "SetValueKey"
                    },
                    {
                        "field": "body.registry.keyclass",
                        "operator": "contains",
                        "value": "CreateKey"
                    },
                    {
                        "field": "body.registry.keyclass",
                        "operator": "contains",
                        "value": "RenameKey"
                    }
                ]
            },
            "s9_registry_path_iis_config": {
                "event_type": "registry",
                "conditions": [
                    {
                        "field": "body.registry.name",
                        "operator": "startswith",
                        "value": "HKEY_LOCAL_MACHINE\\SOFTWARE\\Microsoft\\IIS"
                    },
                    {
                        "field": "body.registry.name",
                        "operator": "startswith",
                        "value": "HKEY_LOCAL_MACHINE\\SYSTEM\\CurrentControlSet\\Services\\W3SVC"
                    }
                ]
            },
            "s10_registry_path_service_creation": {
                "event_type": "registry",
                "conditions": [
                    {
                        "field": "body.registry.name",
                        "operator": "startswith",
                        "value": "HKEY_LOCAL_MACHINE\\SYSTEM\\CurrentControlSet\\Services"
                    }
                ]
            }
        },
        "condition": "(s1_process_create_action and s2_parent_is_webserver and s3_cmdline_suspicious_tools) or (s4_filesystem_write_action and (s5_filepath_web_root_iis or s6_filepath_web_root_apache) and s7_filepath_webshell_extension) or (s8_registry_modification_action and (s9_registry_path_iis_config or s10_registry_path_service_creation))"
    },
    "operational_usage": "SOC 팀은 이 규칙을 활용하여 공격자가 서버를 장악한 후 악성 활동을 위해 서버를 준비하거나 사용하는 시도를 탐지할 수 있습니다. 웹 서버 프로세스(예: w3wp.exe, httpd.exe)에서 비정상적인 자식 프로세스(예: cmd.exe, powershell.exe)가 실행되거나, 웹 루트 디렉터리 내에 웹 셸 확장자를 가진 파일이 생성/수정되는 경우를 모니터링합니다. 또한, IIS 관련 레지스트리 키 또는 시스템 서비스 레지스트리 키에 대한 의심스러운 변경 시도를 탐지합니다. 탐지된 이벤트는 높은 심각도로 분류되어 즉각적인 알람을 트리거하고, 서버 침해 여부 및 추가적인 악성 활동에 대한 포렌식 조사를 시작하는 데 사용될 수 있습니다.",
    "false_positive": "정상적인 웹 애플리케이션 업데이트, 서버 관리 스크립트, 합법적인 진단 도구 또는 웹 서버 구성 변경 작업으로 인해 오탐이 발생할 수 있습니다. 특히 개발 환경이나 테스트 서버에서는 웹 셸과 유사한 스크립트가 사용될 수 있으므로, 특정 프로세스, 파일 경로 또는 레지스트리 키에 대한 화이트리스트를 신중하게 적용하여 오탐을 줄일 수 있습니다."
}