{
    "id": "T1518.001-SecuritySoftwareDiscovery",
    "name": "Security Software Discovery",
    "description": "Detects attempts by adversaries to identify installed security software, configurations, and defensive tools on a system or in a cloud environment. This includes common command-line utilities (e.g., tasklist, netsh, reg query, wmic), PowerShell cmdlets, registry key access, and API calls used to enumerate security-related processes, services, or installed applications.",
    "severity": "medium",
    "mitre_attack": {
        "tactic": "TA0007",
        "technique_id": "T1518",
        "subtechnique_id": "T1518.001",
        "data_sources": [
            "Enterprise:Execution:Command and Scripting Interpreter:Windows Command Shell",
            "Enterprise:Execution:Command and Scripting Interpreter:PowerShell",
            "Enterprise:Discovery:System Network Configuration Discovery",
            "Enterprise:Execution:Native API",
            "Enterprise:Discovery:Query Registry",
            "Enterprise:Discovery:Software Discovery"
        ]
    },
    "platform": [
        "windows"
    ],
    "detection": {
        "selections": {
            "s1_process_create": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.action",
                        "operator": "equals",
                        "value": "create"
                    }
                ]
            },
            "s2_tasklist_cmd": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "tasklist.exe"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "tasklist /svc"
                    }
                ]
            },
            "s3_netsh_cmd": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "netsh.exe"
                    }
                ]
            },
            "s4_netsh_advfirewall_keywords": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "advfirewall"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "firewall show"
                    }
                ]
            },
            "s5_reg_cmd": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "reg.exe"
                    }
                ]
            },
            "s6_reg_query_cmd": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "query"
                    }
                ]
            },
            "s7_reg_query_av_paths": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "HKEY_LOCAL_MACHINE\\SOFTWARE\\Microsoft\\Windows Defender"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "HKEY_LOCAL_MACHINE\\SOFTWARE\\Microsoft\\SecurityCenter"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "HKEY_LOCAL_MACHINE\\SYSTEM\\CurrentControlSet\\Services\\SharedAccess\\Parameters\\FirewallPolicy"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "HKEY_LOCAL_MACHINE\\SOFTWARE\\AVAST Software"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "HKEY_LOCAL_MACHINE\\SOFTWARE\\Symantec"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "HKEY_LOCAL_MACHINE\\SOFTWARE\\KasperskyLab"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "HKEY_LOCAL_MACHINE\\SOFTWARE\\Malwarebytes"
                    }
                ]
            },
            "s8_wmic_cmd": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "wmic.exe"
                    }
                ]
            },
            "s9_wmic_av_product_query": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "AntiVirusProduct"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "FirewallProduct"
                    }
                ]
            },
            "s10_powershell_exe": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "powershell.exe"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "pwsh.exe"
                    }
                ]
            },
            "s11_powershell_mp_status": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "Get-MpComputerStatus"
                    }
                ]
            },
            "s12_powershell_wmi_av": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "Get-WmiObject -Class AntiVirusProduct"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "Get-CimInstance -ClassName AntiVirusProduct"
                    }
                ]
            },
            "s13_powershell_get_service_security_keywords": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "Get-Service"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "Where-Object"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "DisplayName -like '*security*'"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "DisplayName -like '*antivirus*'"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "DisplayName -like '*firewall*'"
                    }
                ]
            },
            "s14_registry_query_access_action": {
                "event_type": "registry",
                "conditions": [
                    {
                        "field": "body.registry.keyclass",
                        "operator": "contains",
                        "value": "Query"
                    },
                    {
                        "field": "body.registry.keyclass",
                        "operator": "contains",
                        "value": "Open"
                    },
                    {
                        "field": "body.registry.keyclass",
                        "operator": "contains",
                        "value": "Enumerate"
                    }
                ]
            },
            "s15_registry_security_paths": {
                "event_type": "registry",
                "conditions": [
                    {
                        "field": "body.registry.name",
                        "operator": "startswith",
                        "value": "HKEY_LOCAL_MACHINE\\SOFTWARE\\Microsoft\\Windows Defender"
                    },
                    {
                        "field": "body.registry.name",
                        "operator": "contains",
                        "value": "SecurityCenter"
                    },
                    {
                        "field": "body.registry.name",
                        "operator": "startswith",
                        "value": "HKEY_LOCAL_MACHINE\\SYSTEM\\CurrentControlSet\\Services\\SharedAccess\\Parameters\\FirewallPolicy"
                    },
                    {
                        "field": "body.registry.name",
                        "operator": "contains",
                        "value": "AVAST Software"
                    },
                    {
                        "field": "body.registry.name",
                        "operator": "contains",
                        "value": "Symantec"
                    },
                    {
                        "field": "body.registry.name",
                        "operator": "contains",
                        "value": "KasperskyLab"
                    },
                    {
                        "field": "body.registry.name",
                        "operator": "contains",
                        "value": "Malwarebytes"
                    }
                ]
            },
            "s16_apicall_enum_services": {
                "event_type": "apicall",
                "conditions": [
                    {
                        "field": "body.apicall.function",
                        "operator": "equals",
                        "value": "EnumServicesStatusExW"
                    },
                    {
                        "field": "body.apicall.function",
                        "operator": "equals",
                        "value": "EnumServicesStatusExA"
                    }
                ]
            },
            "s17_apicall_process_snapshot": {
                "event_type": "apicall",
                "conditions": [
                    {
                        "field": "body.apicall.function",
                        "operator": "equals",
                        "value": "CreateToolhelp32Snapshot"
                    },
                    {
                        "field": "body.apicall.function",
                        "operator": "equals",
                        "value": "Process32FirstW"
                    },
                    {
                        "field": "body.apicall.function",
                        "operator": "equals",
                        "value": "Process32NextW"
                    }
                ]
            }
        },
        "condition": "s1_process_create and (s2_tasklist_cmd or (s3_netsh_cmd and s4_netsh_advfirewall_keywords) or (s5_reg_cmd and s6_reg_query_cmd and s7_reg_query_av_paths) or (s8_wmic_cmd and s9_wmic_av_product_query) or (s10_powershell_exe and (s11_powershell_mp_status or s12_powershell_wmi_av or s13_powershell_get_service_security_keywords))) or (s14_registry_query_access_action and s15_registry_security_paths) or (s16_apicall_enum_services or s17_apicall_process_snapshot)"
    },
    "operational_usage": "SOC 팀은 이 규칙을 활용하여 시스템에 설치된 보안 소프트웨어 정보를 수집하려는 시도를 탐지할 수 있습니다. 'tasklist', 'netsh advfirewall', 'reg query', 'wmic'와 같은 명령 실행, PowerShell을 통한 보안 제품 상태 조회, 보안 관련 레지스트리 키 접근, 또는 서비스/프로세스 열거 API 호출 등을 모니터링합니다. 탐지된 이벤트는 중간 심각도로 분류되어 추가적인 조사 및 침해사고 대응의 우선순위를 지정하는 데 사용될 수 있습니다. 특히 다른 Discovery 또는 Initial Access 활동과 결합될 때 중요도가 높아집니다.",
    "false_positive": "정상적인 시스템 관리 도구, 백신 소프트웨어 자체의 동작, 사용자 환경 설정 스크립트, 또는 합법적인 애플리케이션이 시스템 보안 정보를 조회하는 과정에서 오탐이 발생할 수 있습니다. 알려진 정상 프로세스나 특정 명령줄 패턴을 화이트리스트에 추가하여 오탐을 줄일 수 있습니다."
}