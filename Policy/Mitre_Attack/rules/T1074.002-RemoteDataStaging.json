{
    "id": "T1074.002-RemoteDataStaging",
    "name": "Remote Data Staging",
    "description": "Detects attempts by adversaries to stage collected data in a central location or directory on a system prior to exfiltration. This includes using archiving/compression tools, encryption utilities, or direct file copy commands to move data into temporary or publicly writable directories, often with suspicious file types.",
    "severity": "high",
    "mitre_attack": {
        "tactic": "TA0009",
        "technique_id": "T1074",
        "subtechnique_id": "T1074.002",
        "data_sources": [
            "Enterprise:Collection:Data Staged:Local Data Staging",
            "Enterprise:Execution:Command and Scripting Interpreter:Windows Command Shell",
            "Enterprise:Collection:Data from Local System"
        ]
    },
    "platform": [
        "windows"
    ],
    "detection": {
        "selections": {
            "s1_process_action_create": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.action",
                        "operator": "equals",
                        "value": "create"
                    }
                ]
            },
            "s2_archive_tool_execution": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "7z.exe"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "winrar.exe"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "zip.exe"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "tar.exe"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "rar.exe"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "makecab.exe"
                    }
                ]
            },
            "s3_encryption_tool_execution": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "certutil.exe -encode"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "openssl"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "gpg"
                    }
                ]
            },
            "s4_copy_move_command": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "copy"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "xcopy"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "robocopy"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "move"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "Copy-Item"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "Move-Item"
                    }
                ]
            },
            "s5_suspicious_destination_path_cmd": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "C:\\Windows\\Temp\\"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "C:\\$Recycle.Bin\\"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "C:\\ProgramData\\"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "C:\\Users\\Public\\"
                    }
                ]
            },
            "s6_multiple_files_or_wildcard_cmd": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "*.*"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": ".txt .log"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": ".doc .docx"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": ".xls .xlsx"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": ".pdf"
                    }
                ]
            },
            "f1_filesystem_action_create_write": {
                "event_type": "filesystem",
                "conditions": [
                    {
                        "field": "body.filesystem.action",
                        "operator": "equals",
                        "value": "create"
                    },
                    {
                        "field": "body.filesystem.action",
                        "operator": "equals",
                        "value": "write"
                    },
                    {
                        "field": "body.filesystem.action",
                        "operator": "equals",
                        "value": "overwritten"
                    }
                ]
            },
            "f2_suspicious_staging_directory": {
                "event_type": "filesystem",
                "conditions": [
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "contains",
                        "value": "C:\\Windows\\Temp\\"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "contains",
                        "value": "C:\\$Recycle.Bin\\"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "contains",
                        "value": "C:\\ProgramData\\"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "contains",
                        "value": "C:\\Users\\Public\\"
                    }
                ]
            },
            "f3_archive_or_encrypted_extension": {
                "event_type": "filesystem",
                "conditions": [
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "endswith",
                        "value": ".zip"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "endswith",
                        "value": ".rar"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "endswith",
                        "value": ".7z"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "endswith",
                        "value": ".tar"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "endswith",
                        "value": ".gz"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "endswith",
                        "value": ".enc"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "endswith",
                        "value": ".crypt"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "endswith",
                        "value": ".aes"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "endswith",
                        "value": ".gpg"
                    }
                ]
            }
        },
        "condition": "(s1_process_action_create and (s2_archive_tool_execution or s3_encryption_tool_execution) and s5_suspicious_destination_path_cmd) or (s1_process_action_create and s4_copy_move_command and s5_suspicious_destination_path_cmd and s6_multiple_files_or_wildcard_cmd) or (f1_filesystem_action_create_write and f2_suspicious_staging_directory and f3_archive_or_encrypted_extension)"
    },
    "operational_usage": "SOC 팀은 이 규칙을 활용하여 공격자가 데이터를 외부로 유출하기 전에 시스템 내부에 준비하는 행위를 탐지할 수 있습니다. 압축, 암호화 도구 실행 또는 여러 파일을 임시/공개 폴더로 복사하는 명령줄 활동, 그리고 이러한 폴더에 아카이브/암호화된 파일이 생성되는 파일 시스템 이벤트를 모니터링합니다. 탐지된 이벤트는 높은 심각도로 분류되어 즉각적인 알람을 트리거하고, 추가적인 포렌식 조사 및 침해사고 대응의 우선순위를 지정하는 데 사용될 수 있습니다. 특히, 다른 데이터 수집 활동과 결합될 때 중요도가 더욱 높아집니다.",
    "false_positive": "정상적인 시스템 관리 작업, 소프트웨어 설치/업데이트, 백업 유틸리티, 또는 합법적인 애플리케이션이 임시 파일을 생성하거나 데이터를 압축/암호화하는 과정에서 오탐이 발생할 수 있습니다. 알려진 정상 프로세스, 특정 파일 경로, 또는 명령줄 패턴을 화이트리스트에 추가하여 오탐을 줄일 수 있습니다."
}