{
    "id": "T1204.004-MaliciousCopyAndPaste",
    "name": "Malicious Copy and Paste",
    "description": "Detects attempts by an adversary to rely upon a user copying and pasting code, often into a command and scripting interpreter (e.g., terminal, Windows Run Dialog). This technique can bypass email filtering, browser sandboxing, or other mitigations. Indicators include suspicious command-line patterns, obfuscation, and unusual parent-child process relationships.",
    "severity": "high",
    "mitre_attack": {
        "tactic": "TA0002",
        "technique_id": "T1204",
        "subtechnique_id": "T1204.004",
        "data_sources": [
            "Process:ProcessCreation",
            "Command:CommandExecution"
        ]
    },
    "platform": [
        "windows"
    ],
    "detection": {
        "selections": {
            "s1_process_action_create": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.action",
                        "operator": "equals",
                        "value": "create"
                    }
                ]
            },
            "s2_target_process_shell": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.exe_path",
                        "operator": "endswith",
                        "value": "cmd.exe"
                    },
                    {
                        "field": "body.process.exe_path",
                        "operator": "endswith",
                        "value": "powershell.exe"
                    },
                    {
                        "field": "body.process.exe_path",
                        "operator": "endswith",
                        "value": "pwsh.exe"
                    }
                ]
            },
            "s3_cmdline_suspicious_keywords": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "iex"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "Invoke-Expression"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "base64"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "certutil -decode"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "Start-Process"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "Invoke-WebRequest"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "curl"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "wget"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "http://"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "https://"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "schtasks /create"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "reg add"
                    }
                ]
            },
            "s4_cmdline_obfuscation_indicators": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "-EncodedCommand"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "-enc"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "^"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "`"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "0x"
                    }
                ]
            },
            "s5_unusual_parent_process": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.parent_exe_path",
                        "operator": "contains",
                        "value": "chrome.exe"
                    },
                    {
                        "field": "body.process.parent_exe_path",
                        "operator": "contains",
                        "value": "firefox.exe"
                    },
                    {
                        "field": "body.process.parent_exe_path",
                        "operator": "contains",
                        "value": "msedge.exe"
                    },
                    {
                        "field": "body.process.parent_exe_path",
                        "operator": "contains",
                        "value": "iexplore.exe"
                    },
                    {
                        "field": "body.process.parent_exe_path",
                        "operator": "contains",
                        "value": "winword.exe"
                    },
                    {
                        "field": "body.process.parent_exe_path",
                        "operator": "contains",
                        "value": "excel.exe"
                    },
                    {
                        "field": "body.process.parent_exe_path",
                        "operator": "contains",
                        "value": "powerpnt.exe"
                    },
                    {
                        "field": "body.process.parent_exe_path",
                        "operator": "contains",
                        "value": "acrord32.exe"
                    },
                    {
                        "field": "body.process.parent_exe_path",
                        "operator": "contains",
                        "value": "outlook.exe"
                    }
                ]
            }
        },
        "condition": "s1_process_action_create and s2_target_process_shell and (s3_cmdline_suspicious_keywords or s4_cmdline_obfuscation_indicators or s5_unusual_parent_process)"
    },
    "operational_usage": "SOC 팀은 이 규칙을 활용하여 사용자가 악성 코드를 복사하여 붙여넣어 실행하는 시도를 탐지할 수 있습니다. 특히 웹 브라우저나 문서 편집기 같은 일반적인 애플리케이션이 cmd.exe 또는 powershell.exe와 같은 쉘 프로세스를 생성하고, 해당 쉘의 명령줄에 의심스러운 키워드, 난독화된 구문, 또는 외부 통신 시도가 포함된 경우 높은 심각도의 알람을 트리거합니다. 이는 초기 침투, 권한 상승 또는 지속성 확보 시도에 대한 중요한 지표로 활용되며, 즉각적인 조사 및 대응 우선순위를 지정하는 데 사용될 수 있습니다.",
    "false_positive": "정상적인 시스템 관리 작업, 개발자 도구, 자동화 스크립트, 또는 특정 웹 애플리케이션이 쉘을 호출하거나 명령줄에 유사한 패턴을 포함할 수 있습니다. 예를 들어, 웹 개발 도구가 백엔드 명령을 실행하거나, 관리자가 PowerShell 스크립트를 수동으로 붙여넣어 실행하는 경우 오탐이 발생할 수 있습니다. 알려진 정상 프로세스, 특정 명령줄 패턴, 또는 특정 부모 프로세스를 화이트리스트에 추가하여 오탐을 줄일 수 있습니다."
}