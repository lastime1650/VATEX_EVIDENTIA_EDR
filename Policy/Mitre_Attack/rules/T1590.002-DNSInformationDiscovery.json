{
    "id": "T1590.002-DNSInformationDiscovery",
    "name": "DNS Information Discovery",
    "description": "Detects attempts by adversaries to gather victim's DNS information for targeting purposes, including querying registered name servers, subdomains, mail servers (MX, TXT, SPF records), or performing DNS zone transfers (AXFR). This information can reveal infrastructure details, third-party cloud/SaaS providers, and potential attack vectors.",
    "severity": "medium",
    "mitre_attack": {
        "tactic": "TA0007",
        "technique_id": "T1590",
        "subtechnique_id": "T1590.002",
        "data_sources": [
            "Enterprise:Reconnaissance:Gather Victim Network Information:DNS",
            "Enterprise:Execution:Command and Scripting Interpreter:Windows Command Shell",
            "Enterprise:Execution:Command and Scripting Interpreter:PowerShell",
            "Enterprise:Execution:Native API",
            "Enterprise:Discovery:System Network Connections Discovery"
        ]
    },
    "platform": [
        "windows"
    ],
    "detection": {
        "selections": {
            "s1_process_create_action": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.action",
                        "operator": "equals",
                        "value": "create"
                    }
                ]
            },
            "s2_nslookup_execution": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.exe_path",
                        "operator": "endswith",
                        "value": "nslookup.exe"
                    }
                ]
            },
            "s3_nslookup_recon_queries": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "set type=mx"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "set type=txt"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "set type=spf"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "set type=ns"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "set type=any"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "ls -d"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "server"
                    }
                ]
            },
            "s4_powershell_execution": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.exe_path",
                        "operator": "endswith",
                        "value": "powershell.exe"
                    },
                    {
                        "field": "body.process.exe_path",
                        "operator": "endswith",
                        "value": "pwsh.exe"
                    }
                ]
            },
            "s5_powershell_dns_cmdlets": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "Resolve-DnsName"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "Get-DnsClientServerAddress"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "Get-DnsServerResourceRecord"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "Get-DnsServerZoneTransfer"
                    }
                ]
            },
            "s6_network_dns_port_53": {
                "event_type": "network",
                "conditions": [
                    {
                        "field": "body.network.destinationport",
                        "operator": "equals",
                        "value": 53
                    }
                ]
            },
            "s7_network_outbound_direction": {
                "event_type": "network",
                "conditions": [
                    {
                        "field": "body.network.direction",
                        "operator": "equals",
                        "value": "out"
                    }
                ]
            },
            "s8_network_tcp_protocol": {
                "event_type": "network",
                "conditions": [
                    {
                        "field": "body.network.protocol",
                        "operator": "equals",
                        "value": "TCP"
                    }
                ]
            },
            "s9_network_large_packet_size": {
                "event_type": "network",
                "conditions": [
                    {
                        "field": "body.network.packetsize",
                        "operator": "gt",
                        "value": 500
                    }
                ]
            },
            "s10_apicall_dns_query": {
                "event_type": "apicall",
                "conditions": [
                    {
                        "field": "body.apicall.function",
                        "operator": "equals",
                        "value": "DnsQuery_W"
                    },
                    {
                        "field": "body.apicall.function",
                        "operator": "equals",
                        "value": "DnsQuery_A"
                    },
                    {
                        "field": "body.apicall.function",
                        "operator": "equals",
                        "value": "DnsQueryEx"
                    },
                    {
                        "field": "body.apicall.function",
                        "operator": "equals",
                        "value": "DnsGetHostByName"
                    },
                    {
                        "field": "body.apicall.function",
                        "operator": "equals",
                        "value": "gethostbyname"
                    }
                ]
            }
        },
        "condition": "(s1_process_create_action and s2_nslookup_execution and s3_nslookup_recon_queries) or (s1_process_create_action and s4_powershell_execution and s5_powershell_dns_cmdlets) or (s6_network_dns_port_53 and s7_network_outbound_direction and s8_network_tcp_protocol and s9_network_large_packet_size) or s10_apicall_dns_query"
    },
    "operational_usage": "SOC 팀은 이 규칙을 활용하여 시스템에서 DNS 정보 수집 시도를 탐지할 수 있습니다. 'nslookup', 'powershell'과 같은 명령줄 도구를 사용한 비정상적인 DNS 쿼리, 대량의 DNS 트래픽 (특히 TCP/53을 통한 존 전송 시도), 또는 DNS 관련 API 호출 등을 모니터링합니다. 탐지된 이벤트는 중간 심각도로 분류되어 추가적인 조사 및 침해사고 대응의 우선순위를 지정하는 데 사용될 수 있습니다. 특히 다른 Reconnaissance 또는 Initial Access 활동과 결합될 때 중요도가 높아집니다.",
    "false_positive": "정상적인 시스템 진단 도구, 네트워크 관리 유틸리티, 소프트웨어 업데이트 프로세스, 또는 합법적인 애플리케이션이 DNS 정보를 조회하는 과정에서 오탐이 발생할 수 있습니다. 알려진 정상적인 프로세스나 특정 DNS 쿼리 패턴을 화이트리스트에 추가하여 오탐을 줄일 수 있습니다."
}