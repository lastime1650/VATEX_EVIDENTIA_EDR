{
    "id": "T1497-VirtualizationSandboxEvasion",
    "name": "Virtualization/Sandbox Evasion",
    "description": "Adversaries may employ various means to detect and avoid virtualization and analysis environments. This may include changing behaviors based on the results of checks for the presence of artifacts indicative of a virtual machine environment (VME) or sandbox. If the adversary detects a VME, they may alter their malware to disengage from the victim or conceal the core functions of the implant. They may also search for VME artifacts before dropping secondary or additional payloads. Adversaries may use the information learned from Virtualization/Sandbox Evasion during automated discovery to shape follow-on behaviors. Adversaries may use several methods to accomplish Virtualization/Sandbox Evasion such as checking for security monitoring tools (e.g., Sysinternals, Wireshark, etc.) or other system artifacts associated with analysis or virtualization. Adversaries may also check for legitimate user activity to help determine if it is in an analysis environment. Additional methods include use of sleep timers or loops within malware code to avoid operating within a temporary sandbox.",
    "severity": "high",
    "mitre_attack": {
        "tactic": "TA0005",
        "technique_id": "T1497",
        "subtechnique_id": "",
        "data_sources": [
            "Enterprise:Defense Evasion:Virtualization/Sandbox Evasion:System Checks",
            "Enterprise:Defense Evasion:Virtualization/Sandbox Evasion:Debugger Evasion",
            "Enterprise:Execution:Command and Scripting Interpreter:Windows Command Shell",
            "Enterprise:Execution:Native API",
            "Enterprise:Discovery:Query Registry",
            "Enterprise:Discovery:File and Directory Discovery"
        ]
    },
    "platform": [
        "windows"
    ],
    "detection": {
        "selections": {
            "s1_process_create_action": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.action",
                        "operator": "equals",
                        "value": "create"
                    }
                ]
            },
            "s2_cmdline_systeminfo_query": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "systeminfo"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "wmic csproduct get name"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "wmic computersystem get model"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "query process"
                    }
                ]
            },
            "s3_cmdline_vm_process_check": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "VBoxTray.exe"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "VmTools.exe"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "vmtoolsd.exe"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "vboxservice.exe"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "procmon.exe"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "wireshark.exe"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "dbgview.exe"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "xenservice.exe"
                    }
                ]
            },
            "s4_registry_access_action": {
                "event_type": "registry",
                "conditions": [
                    {
                        "field": "body.registry.keyclass",
                        "operator": "contains",
                        "value": "QueryKey"
                    },
                    {
                        "field": "body.registry.keyclass",
                        "operator": "contains",
                        "value": "OpenKey"
                    },
                    {
                        "field": "body.registry.keyclass",
                        "operator": "contains",
                        "value": "EnumerateKey"
                    }
                ]
            },
            "s5_registry_vm_paths": {
                "event_type": "registry",
                "conditions": [
                    {
                        "field": "body.registry.name",
                        "operator": "contains",
                        "value": "VMware"
                    },
                    {
                        "field": "body.registry.name",
                        "operator": "contains",
                        "value": "VirtualBox"
                    },
                    {
                        "field": "body.registry.name",
                        "operator": "contains",
                        "value": "QEMU"
                    },
                    {
                        "field": "body.registry.name",
                        "operator": "contains",
                        "value": "VBoxGuest"
                    },
                    {
                        "field": "body.registry.name",
                        "operator": "contains",
                        "value": "vmmouse"
                    },
                    {
                        "field": "body.registry.name",
                        "operator": "contains",
                        "value": "vboxvideo"
                    },
                    {
                        "field": "body.registry.name",
                        "operator": "startswith",
                        "value": "HKEY_LOCAL_MACHINE\\HARDWARE\\DESCRIPTION\\System\\BIOS\\Vendor"
                    },
                    {
                        "field": "body.registry.name",
                        "operator": "startswith",
                        "value": "HKEY_LOCAL_MACHINE\\HARDWARE\\DESCRIPTION\\System\\SystemBiosVersion"
                    },
                    {
                        "field": "body.registry.name",
                        "operator": "startswith",
                        "value": "HKEY_LOCAL_MACHINE\\SYSTEM\\CurrentControlSet\\Control\\VirtualDeviceDrivers"
                    },
                    {
                        "field": "body.registry.name",
                        "operator": "startswith",
                        "value": "HKEY_LOCAL_MACHINE\\SYSTEM\\CurrentControlSet\\Services\\VBox"
                    },
                    {
                        "field": "body.registry.name",
                        "operator": "startswith",
                        "value": "HKEY_LOCAL_MACHINE\\SYSTEM\\CurrentControlSet\\Services\\VMTools"
                    }
                ]
            },
            "s6_filesystem_access_action": {
                "event_type": "filesystem",
                "conditions": [
                    {
                        "field": "body.filesystem.action",
                        "operator": "equals",
                        "value": "read"
                    },
                    {
                        "field": "body.filesystem.action",
                        "operator": "equals",
                        "value": "open"
                    },
                    {
                        "field": "body.filesystem.action",
                        "operator": "equals",
                        "value": "exists"
                    }
                ]
            },
            "s7_filesystem_vm_files_paths": {
                "event_type": "filesystem",
                "conditions": [
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "contains",
                        "value": "C:\\\\Program Files\\\\VMware\\\\VMware Tools"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "contains",
                        "value": "C:\\\\Program Files\\\\Oracle\\\\VirtualBox Guest Additions"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "contains",
                        "value": "vboxguest.sys"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "contains",
                        "value": "vmhgfs.sys"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "contains",
                        "value": "vmmouse.sys"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "contains",
                        "value": "\\\\.\\\\VBoxGuest"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "contains",
                        "value": "\\\\.\\\\vmci"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "contains",
                        "value": "C:\\\\Windows\\\\System32\\\\drivers\\\\vbox"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "contains",
                        "value": "C:\\\\Windows\\\\System32\\\\drivers\\\\vmware"
                    }
                ]
            },
            "s8_apicall_debugger_detection": {
                "event_type": "apicall",
                "conditions": [
                    {
                        "field": "body.apicall.function",
                        "operator": "equals",
                        "value": "IsDebuggerPresent"
                    },
                    {
                        "field": "body.apicall.function",
                        "operator": "equals",
                        "value": "CheckRemoteDebuggerPresent"
                    },
                    {
                        "field": "body.apicall.function",
                        "operator": "equals",
                        "value": "NtQueryInformationProcess"
                    },
                    {
                        "field": "body.apicall.function",
                        "operator": "equals",
                        "value": "OutputDebugString"
                    },
                    {
                        "field": "body.apicall.function",
                        "operator": "equals",
                        "value": "DbgUiRemoteBreakin"
                    }
                ]
            },
            "s9_apicall_system_info_query": {
                "event_type": "apicall",
                "conditions": [
                    {
                        "field": "body.apicall.function",
                        "operator": "equals",
                        "value": "GetSystemInfo"
                    },
                    {
                        "field": "body.apicall.function",
                        "operator": "equals",
                        "value": "GetNativeSystemInfo"
                    },
                    {
                        "field": "body.apicall.function",
                        "operator": "equals",
                        "value": "GlobalMemoryStatusEx"
                    }
                ]
            }
        },
        "condition": "(s1_process_create_action and (s2_cmdline_systeminfo_query or s3_cmdline_vm_process_check)) or (s4_registry_access_action and s5_registry_vm_paths) or (s6_filesystem_access_action and s7_filesystem_vm_files_paths) or (s8_apicall_debugger_detection or s9_apicall_system_info_query)"
    },
    "operational_usage": "SOC 팀은 이 규칙을 활용하여 악성 행위자가 가상화 또는 샌드박스 환경을 회피하려는 시도를 탐지할 수 있습니다. 시스템 정보 쿼리 명령 실행, VM 관련 프로세스 또는 드라이버 확인, VM 관련 레지스트리 키 접근, 특정 파일 경로 접근, 또는 디버거 감지 API 호출 등을 모니터링합니다. 탐지된 이벤트는 높은 심각도로 분류되어 즉각적인 알람을 트리거하고, 해당 프로세스에 대한 추가적인 조사 및 침해사고 대응의 우선순위를 지정하는 데 사용될 수 있습니다. 특히 초기 접근 또는 방어 회피 단계에서 중요한 지표가 됩니다.",
    "false_positive": "정상적인 시스템 관리 도구, 가상화 소프트웨어 자체의 구성 요소, 또는 합법적인 애플리케이션이 시스템 환경 정보를 조회하는 과정에서 오탐이 발생할 수 있습니다. 알려진 정상적인 프로세스, 명령줄 패턴, 또는 파일/레지스트리 경로에 대해 화이트리스트를 적용하여 오탐을 줄일 수 있습니다."
}