{
    "id": "T1137.006-OfficeAddinsPersistence",
    "name": "Persistence via Office Add-ins",
    "description": "Detects attempts to establish persistence by creating or modifying Microsoft Office add-ins (e.g., COM Add-ins, Excel/Word/PowerPoint Add-ins, Startup folder files) that execute malicious code when an Office application starts. This includes monitoring registry keys associated with add-ins and files created or modified in Office startup or add-in directories.",
    "severity": "high",
    "mitre_attack": {
        "tactic": "TA0003",
        "technique_id": "T1137",
        "subtechnique_id": "T1137.006",
        "data_sources": [
            "Enterprise:Persistence:Office Application Startup:Add-ins",
            "Enterprise:Defense Evasion:Modify Registry",
            "Enterprise:Defense Evasion:File and Directory Permissions Modification"
        ]
    },
    "platform": [
        "windows"
    ],
    "detection": {
        "selections": {
            "s1_registry_action_modify_create": {
                "event_type": "registry",
                "conditions": [
                    {
                        "field": "body.registry.keyclass",
                        "operator": "equals",
                        "value": "RegNtSetValueKey"
                    },
                    {
                        "field": "body.registry.keyclass",
                        "operator": "equals",
                        "value": "RegNtPreSetValueKey"
                    },
                    {
                        "field": "body.registry.keyclass",
                        "operator": "equals",
                        "value": "RegNtPostSetValueKey"
                    },
                    {
                        "field": "body.registry.keyclass",
                        "operator": "equals",
                        "value": "RegNtPreCreateKey"
                    },
                    {
                        "field": "body.registry.keyclass",
                        "operator": "equals",
                        "value": "RegNtPostCreateKey"
                    },
                    {
                        "field": "body.registry.keyclass",
                        "operator": "equals",
                        "value": "RegNtPreCreateKeyEx"
                    },
                    {
                        "field": "body.registry.keyclass",
                        "operator": "equals",
                        "value": "RegNtPostCreateKeyEx"
                    },
                    {
                        "field": "body.registry.keyclass",
                        "operator": "equals",
                        "value": "RegNtPreRenameKey"
                    },
                    {
                        "field": "body.registry.keyclass",
                        "operator": "equals",
                        "value": "RegNtPostRenameKey"
                    }
                ]
            },
            "s2_registry_office_addin_keys": {
                "event_type": "registry",
                "conditions": [
                    {
                        "field": "body.registry.name",
                        "operator": "startswith",
                        "value": "HKEY_CURRENT_USER\\Software\\Microsoft\\Office\\16.0\\Outlook\\Addins\\"
                    },
                    {
                        "field": "body.registry.name",
                        "operator": "startswith",
                        "value": "HKEY_LOCAL_MACHINE\\Software\\Microsoft\\Office\\16.0\\Outlook\\Addins\\"
                    },
                    {
                        "field": "body.registry.name",
                        "operator": "startswith",
                        "value": "HKEY_CURRENT_USER\\Software\\Microsoft\\Office\\16.0\\Word\\Addins\\"
                    },
                    {
                        "field": "body.registry.name",
                        "operator": "startswith",
                        "value": "HKEY_LOCAL_MACHINE\\Software\\Microsoft\\Office\\16.0\\Word\\Addins\\"
                    },
                    {
                        "field": "body.registry.name",
                        "operator": "startswith",
                        "value": "HKEY_CURRENT_USER\\Software\\Microsoft\\Office\\16.0\\Excel\\Addins\\"
                    },
                    {
                        "field": "body.registry.name",
                        "operator": "startswith",
                        "value": "HKEY_LOCAL_MACHINE\\Software\\Microsoft\\Office\\16.0\\Excel\\Addins\\"
                    },
                    {
                        "field": "body.registry.name",
                        "operator": "startswith",
                        "value": "HKEY_CURRENT_USER\\Software\\Microsoft\\Office\\16.0\\PowerPoint\\Addins\\"
                    },
                    {
                        "field": "body.registry.name",
                        "operator": "startswith",
                        "value": "HKEY_LOCAL_MACHINE\\Software\\Microsoft\\Office\\16.0\\PowerPoint\\Addins\\"
                    },
                    {
                        "field": "body.registry.name",
                        "operator": "startswith",
                        "value": "HKEY_CURRENT_USER\\Software\\Microsoft\\Office\\16.0\\Common\\COM Add-ins\\"
                    },
                    {
                        "field": "body.registry.name",
                        "operator": "startswith",
                        "value": "HKEY_LOCAL_MACHINE\\Software\\Microsoft\\Office\\16.0\\Common\\COM Add-ins\\"
                    },
                    {
                        "field": "body.registry.name",
                        "operator": "startswith",
                        "value": "HKEY_CURRENT_USER\\Software\\Microsoft\\Office\\15.0\\Outlook\\Addins\\"
                    },
                    {
                        "field": "body.registry.name",
                        "operator": "startswith",
                        "value": "HKEY_LOCAL_MACHINE\\Software\\Microsoft\\Office\\15.0\\Outlook\\Addins\\"
                    },
                    {
                        "field": "body.registry.name",
                        "operator": "startswith",
                        "value": "HKEY_CURRENT_USER\\Software\\Microsoft\\Office\\15.0\\Word\\Addins\\"
                    },
                    {
                        "field": "body.registry.name",
                        "operator": "startswith",
                        "value": "HKEY_LOCAL_MACHINE\\Software\\Microsoft\\Office\\15.0\\Word\\Addins\\"
                    },
                    {
                        "field": "body.registry.name",
                        "operator": "startswith",
                        "value": "HKEY_CURRENT_USER\\Software\\Microsoft\\Office\\15.0\\Excel\\Addins\\"
                    },
                    {
                        "field": "body.registry.name",
                        "operator": "startswith",
                        "value": "HKEY_LOCAL_MACHINE\\Software\\Microsoft\\Office\\15.0\\Excel\\Addins\\"
                    },
                    {
                        "field": "body.registry.name",
                        "operator": "startswith",
                        "value": "HKEY_CURRENT_USER\\Software\\Microsoft\\Office\\15.0\\PowerPoint\\Addins\\"
                    },
                    {
                        "field": "body.registry.name",
                        "operator": "startswith",
                        "value": "HKEY_LOCAL_MACHINE\\Software\\Microsoft\\Office\\15.0\\PowerPoint\\Addins\\"
                    },
                    {
                        "field": "body.registry.name",
                        "operator": "startswith",
                        "value": "HKEY_CURRENT_USER\\Software\\Microsoft\\Office\\15.0\\Common\\COM Add-ins\\"
                    },
                    {
                        "field": "body.registry.name",
                        "operator": "startswith",
                        "value": "HKEY_LOCAL_MACHINE\\Software\\Microsoft\\Office\\15.0\\Common\\COM Add-ins\\"
                    },
                    {
                        "field": "body.registry.name",
                        "operator": "contains",
                        "value": "\\Office\\16.0\\Excel\\Options"
                    },
                    {
                        "field": "body.registry.name",
                        "operator": "contains",
                        "value": "\\Office\\15.0\\Excel\\Options"
                    },
                    {
                        "field": "body.registry.name",
                        "operator": "contains",
                        "value": "\\Office\\14.0\\Excel\\Options"
                    },
                    {
                        "field": "body.registry.name",
                        "operator": "contains",
                        "value": "\\Office\\12.0\\Excel\\Options"
                    }
                ]
            },
            "s3_filesystem_action_create_write": {
                "event_type": "filesystem",
                "conditions": [
                    {
                        "field": "body.filesystem.action",
                        "operator": "equals",
                        "value": "create"
                    },
                    {
                        "field": "body.filesystem.action",
                        "operator": "equals",
                        "value": "write"
                    },
                    {
                        "field": "body.filesystem.action",
                        "operator": "equals",
                        "value": "overwritten"
                    },
                    {
                        "field": "body.filesystem.action",
                        "operator": "equals",
                        "value": "rename"
                    }
                ]
            },
            "s4_filesystem_office_startup_paths": {
                "event_type": "filesystem",
                "conditions": [
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "contains",
                        "value": "\\AppData\\Roaming\\Microsoft\\Word\\STARTUP\\"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "contains",
                        "value": "\\AppData\\Roaming\\Microsoft\\Excel\\XLSTART\\"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "contains",
                        "value": "\\AppData\\Roaming\\Microsoft\\PowerPoint\\ADDINS\\"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "contains",
                        "value": "\\AppData\\Roaming\\Microsoft\\AddIns\\"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "contains",
                        "value": "\\Program Files\\Microsoft Office\\Root\\Office"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "contains",
                        "value": "\\Program Files (x86)\\Microsoft Office\\Root\\Office"
                    }
                ]
            },
            "s5_filesystem_startup_subfolder_match": {
                "event_type": "filesystem",
                "conditions": [
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "contains",
                        "value": "\\STARTUP\\"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "contains",
                        "value": "\\XLSTART\\"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "contains",
                        "value": "\\ADDINS\\"
                    }
                ]
            },
            "s6_filesystem_suspicious_extensions": {
                "event_type": "filesystem",
                "conditions": [
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "endswith",
                        "value": ".dll"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "endswith",
                        "value": ".ocx"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "endswith",
                        "value": ".xll"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "endswith",
                        "value": ".wll"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "endswith",
                        "value": ".vba"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "endswith",
                        "value": ".vsto"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "endswith",
                        "value": ".ppa"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "endswith",
                        "value": ".ppam"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "endswith",
                        "value": ".xla"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "endswith",
                        "value": ".xlam"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "endswith",
                        "value": ".dotm"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "endswith",
                        "value": ".xlsm"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "endswith",
                        "value": ".docm"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "endswith",
                        "value": ".pptm"
                    }
                ]
            }
        },
        "condition": "(s1_registry_action_modify_create and s2_registry_office_addin_keys) or (s3_filesystem_action_create_write and s4_filesystem_office_startup_paths and s5_filesystem_startup_subfolder_match and s6_filesystem_suspicious_extensions)"
    },
    "operational_usage": "SOC 팀은 이 규칙을 활용하여 Microsoft Office 애플리케이션 시작 시 악성 코드를 실행하려는 Office Add-ins를 통한 지속성 확보 시도를 탐지할 수 있습니다. Office Add-in 관련 레지스트리 키의 생성/수정 이벤트와 Office 시작/Add-in 폴더 내에 의심스러운 확장자를 가진 파일의 생성/수정 이벤트를 모니터링합니다. 탐지된 이벤트는 높은 심각도로 분류되어 즉각적인 알람을 트리거하고, 해당 시스템 및 사용자 계정에 대한 추가적인 포렌식 조사 및 침해사고 대응의 우선순위를 지정하는 데 사용될 수 있습니다. 특히, 다른 방어 회피 또는 실행 전술과 결합될 때 중요도가 더욱 높아집니다.",
    "false_positive": "정상적인 소프트웨어 설치 프로그램, Office 업데이트 프로세스, 또는 합법적인 사용자/기업 정책에 따라 설치된 Office 생산성 Add-ins가 레지스트리 키를 수정하거나 파일을 생성하는 경우 오탐이 발생할 수 있습니다. 알려진 정상적인 Add-ins의 레지스트리 변경 패턴이나 파일 경로/해시에 대해 화이트리스트를 적용하여 오탐을 줄일 수 있습니다."
}