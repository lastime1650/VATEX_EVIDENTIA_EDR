{
    "id": "T1562.006-IndicatorBlocking",
    "name": "Indicator Blocking",
    "description": "Detects attempts by adversaries to block or tamper with host-based sensors, event logging, or network reporting to evade detection. This includes modifying Windows Event Log or ETW configurations via registry changes, PowerShell cmdlets, or direct API calls, as well as altering firewall rules to prevent telemetry exfiltration.",
    "severity": "high",
    "mitre_attack": {
        "tactic": "TA0005",
        "technique_id": "T1562",
        "subtechnique_id": "T1562.006",
        "data_sources": [
            "Enterprise:Execution:Command and Scripting Interpreter:Windows Command Shell",
            "Enterprise:Defense Evasion:Modify Registry",
            "Enterprise:Execution:Native API"
        ]
    },
    "platform": [
        "windows"
    ],
    "detection": {
        "selections": {
            "s1_process_create": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.action",
                        "operator": "equals",
                        "value": "create"
                    }
                ]
            },
            "s2_powershell_etw_cmdlet": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.exe_path",
                        "operator": "endswith",
                        "value": "powershell.exe"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "Set-EtwTraceProvider"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "Remove-EtwTraceSession"
                    }
                ]
            },
            "s3_netsh_firewall_command": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.exe_path",
                        "operator": "endswith",
                        "value": "netsh.exe"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "advfirewall firewall"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "add rule"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "delete rule"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "set rule"
                    }
                ]
            },
            "s4_powershell_firewall_cmdlet": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.exe_path",
                        "operator": "endswith",
                        "value": "powershell.exe"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "New-NetFirewallRule"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "Set-NetFirewallRule"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "Remove-NetFirewallRule"
                    }
                ]
            },
            "s5_registry_evtlog_path": {
                "event_type": "registry",
                "conditions": [
                    {
                        "field": "body.registry.name",
                        "operator": "startswith",
                        "value": "HKEY_LOCAL_MACHINE\\SYSTEM\\CurrentControlSet\\Services\\EventLog\\Security"
                    }
                ]
            },
            "s6_registry_etw_autologger_path": {
                "event_type": "registry",
                "conditions": [
                    {
                        "field": "body.registry.name",
                        "operator": "startswith",
                        "value": "HKEY_LOCAL_MACHINE\\SYSTEM\\CurrentControlSet\\Control\\WMI\\Autologger"
                    }
                ]
            },
            "s7_registry_mod_action": {
                "event_type": "registry",
                "conditions": [
                    {
                        "field": "body.registry.keyclass",
                        "operator": "contains",
                        "value": "SetValueKey"
                    },
                    {
                        "field": "body.registry.keyclass",
                        "operator": "contains",
                        "value": "DeleteValueKey"
                    },
                    {
                        "field": "body.registry.keyclass",
                        "operator": "contains",
                        "value": "CreateKey"
                    },
                    {
                        "field": "body.registry.keyclass",
                        "operator": "contains",
                        "value": "DeleteKey"
                    },
                    {
                        "field": "body.registry.keyclass",
                        "operator": "contains",
                        "value": "RenameKey"
                    },
                    {
                        "field": "body.registry.keyclass",
                        "operator": "contains",
                        "value": "SetInformationKey"
                    }
                ]
            },
            "s8_apicall_etw_control": {
                "event_type": "apicall",
                "conditions": [
                    {
                        "field": "body.apicall.function",
                        "operator": "equals",
                        "value": "ControlTrace"
                    },
                    {
                        "field": "body.apicall.function",
                        "operator": "equals",
                        "value": "EnableTraceEx2"
                    },
                    {
                        "field": "body.apicall.function",
                        "operator": "equals",
                        "value": "SetTraceProperties"
                    },
                    {
                        "field": "body.apicall.function",
                        "operator": "equals",
                        "value": "EventSetInformation"
                    }
                ]
            }
        },
        "condition": "(s1_process_create and (s2_powershell_etw_cmdlet or s3_netsh_firewall_command or s4_powershell_firewall_cmdlet)) or (s7_registry_mod_action and (s5_registry_evtlog_path or s6_registry_etw_autologger_path)) or s8_apicall_etw_control"
    },
    "operational_usage": "SOC 팀은 이 규칙을 활용하여 공격자가 보안 센서의 탐지 기능을 무력화하거나 이벤트 보고를 방해하려는 시도를 탐지할 수 있습니다. 특히, Windows 이벤트 로그나 ETW(Event Tracing for Windows) 관련 레지스트리 키에 대한 수정, PowerShell을 이용한 ETW 추적 공급자 변경, 또는 방화벽 규칙을 추가/삭제하여 네트워크 기반의 탐지 데이터 전송을 차단하는 행위를 모니터링합니다. 탐지된 이벤트는 높은 심각도로 분류되어 즉각적인 알람을 트리거하고, 해당 호스트의 센서 상태 및 네트워크 연결에 대한 추가 조사를 시작하는 데 사용될 수 있습니다. 이는 방어 회피 전술의 핵심이므로, 다른 공격 활동과 결합될 때 더욱 중요한 지표가 됩니다.",
    "false_positive": "정상적인 시스템 관리 도구, 보안 소프트웨어(예: 백신, EDR 에이전트), 또는 합법적인 애플리케이션이 시스템 로깅 설정, ETW 구성 또는 방화벽 규칙을 수정하는 과정에서 오탐이 발생할 수 있습니다. 특히, 보안 솔루션 자체가 이벤트 로깅을 최적화하거나 네트워크 트래픽을 제어할 때 이러한 행위가 발생할 수 있습니다. 알려진 정상 프로세스나 특정 명령줄 패턴을 화이트리스트에 추가하여 오탐을 줄일 수 있습니다."
}