{
    "id": "T1592.004-ClientConfigurationsDiscovery",
    "name": "Client Configurations Discovery",
    "description": "Detects attempts by an adversary to gather information about the victim's client configurations on a compromised host. This includes details such as operating system version, architecture (32 or 64 bit), language settings, and/or time zone. Adversaries may use built-in system utilities, PowerShell cmdlets, direct registry queries, or specific API calls to achieve this objective.",
    "severity": "medium",
    "mitre_attack": {
        "tactic": "TA0007",
        "technique_id": "T1592",
        "subtechnique_id": "T1592.004",
        "data_sources": [
            "Enterprise:Reconnaissance:Gather Victim Host Information:Software",
            "Enterprise:Reconnaissance:Gather Victim Host Information:Hardware",
            "Enterprise:Discovery:System Information Discovery",
            "Enterprise:Discovery:System Network Configuration Discovery",
            "Enterprise:Execution:Command and Scripting Interpreter:Windows Command Shell",
            "Enterprise:Execution:Command and Scripting Interpreter:PowerShell",
            "Enterprise:Execution:Native API",
            "Enterprise:Discovery:Query Registry"
        ]
    },
    "platform": [
        "windows"
    ],
    "detection": {
        "selections": {
            "s1_process_create_action": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.action",
                        "operator": "equals",
                        "value": "create"
                    }
                ]
            },
            "s2_cmdline_system_utilities": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "systeminfo"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "wmic os get"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "wmic computersystem get"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "wmic timezone get"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "ver"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "hostname"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "ipconfig /all"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "dxdiag"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "set "
                    }
                ]
            },
            "s3_cmdline_powershell_exe": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "powershell.exe"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "pwsh.exe"
                    }
                ]
            },
            "s4_cmdline_powershell_discovery_cmdlets": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "Get-ComputerInfo"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "Get-WmiObject -Class Win32_OperatingSystem"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "Get-WmiObject -Class Win32_ComputerSystem"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "Get-TimeZone"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "Get-Culture"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "Get-VM"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "Get-ItemProperty -Path \"HKLM:\\SOFTWARE\\Microsoft\\Windows NT\\CurrentVersion\""
                    }
                ]
            },
            "s5_registry_query_or_open_keyclass": {
                "event_type": "registry",
                "conditions": [
                    {
                        "field": "body.registry.keyclass",
                        "operator": "contains",
                        "value": "QueryKey"
                    },
                    {
                        "field": "body.registry.keyclass",
                        "operator": "contains",
                        "value": "OpenKey"
                    },
                    {
                        "field": "body.registry.keyclass",
                        "operator": "contains",
                        "value": "EnumerateKey"
                    }
                ]
            },
            "s6_registry_config_paths": {
                "event_type": "registry",
                "conditions": [
                    {
                        "field": "body.registry.name",
                        "operator": "startswith",
                        "value": "HKEY_LOCAL_MACHINE\\SOFTWARE\\Microsoft\\Windows NT\\CurrentVersion"
                    },
                    {
                        "field": "body.registry.name",
                        "operator": "startswith",
                        "value": "HKEY_LOCAL_MACHINE\\SYSTEM\\CurrentControlSet\\Control\\TimeZoneInformation"
                    },
                    {
                        "field": "body.registry.name",
                        "operator": "startswith",
                        "value": "HKEY_LOCAL_MACHINE\\SYSTEM\\CurrentControlSet\\Control\\Nls\\Language"
                    },
                    {
                        "field": "body.registry.name",
                        "operator": "startswith",
                        "value": "HKEY_LOCAL_MACHINE\\HARDWARE\\DESCRIPTION\\System"
                    }
                ]
            },
            "s7_apicall_system_info_functions": {
                "event_type": "apicall",
                "conditions": [
                    {
                        "field": "body.apicall.function",
                        "operator": "equals",
                        "value": "GetVersionExW"
                    },
                    {
                        "field": "body.apicall.function",
                        "operator": "equals",
                        "value": "GetVersionExA"
                    },
                    {
                        "field": "body.apicall.function",
                        "operator": "equals",
                        "value": "GetNativeSystemInfo"
                    },
                    {
                        "field": "body.apicall.function",
                        "operator": "equals",
                        "value": "GetSystemInfo"
                    },
                    {
                        "field": "body.apicall.function",
                        "operator": "equals",
                        "value": "GetComputerNameW"
                    },
                    {
                        "field": "body.apicall.function",
                        "operator": "equals",
                        "value": "GetComputerNameA"
                    },
                    {
                        "field": "body.apicall.function",
                        "operator": "equals",
                        "value": "GetLocaleInfoW"
                    },
                    {
                        "field": "body.apicall.function",
                        "operator": "equals",
                        "value": "GetLocaleInfoA"
                    },
                    {
                        "field": "body.apicall.function",
                        "operator": "equals",
                        "value": "GetTimeZoneInformation"
                    },
                    {
                        "field": "body.apicall.function",
                        "operator": "equals",
                        "value": "GetTimeZoneInformationForYear"
                    }
                ]
            }
        },
        "condition": "(s1_process_create_action and s2_cmdline_system_utilities) or (s1_process_create_action and s3_cmdline_powershell_exe and s4_cmdline_powershell_discovery_cmdlets) or (s5_registry_query_or_open_keyclass and s6_registry_config_paths) or s7_apicall_system_info_functions"
    },
    "operational_usage": "SOC 팀은 이 규칙을 활용하여 침해된 시스템에서 공격자가 클라이언트 구성 정보를 수집하려는 시도를 탐지할 수 있습니다. 'systeminfo', 'wmic', 'ver', 'hostname', 'ipconfig /all', 'dxdiag' 등의 시스템 유틸리티 실행, PowerShell을 통한 'Get-ComputerInfo', 'Get-WmiObject', 'Get-TimeZone' 등의 cmdlet 사용, 특정 레지스트리 키(예: HKLM\\SOFTWARE\\Microsoft\\Windows NT\\CurrentVersion)에 대한 쿼리/열기/열거 시도, 또는 'GetVersionEx', 'GetSystemInfo', 'GetComputerName' 등의 시스템 정보 조회 API 호출을 모니터링합니다. 탐지된 이벤트는 자동 알람을 트리거하고, 추가적인 조사 및 침해사고 대응의 우선순위를 지정하는 데 사용될 수 있습니다. 특히 다른 Discovery 또는 Collection 활동과 결합될 때 중요도가 높아집니다.",
    "false_positive": "정상적인 시스템 관리 도구, 백신 소프트웨어, 사용자 환경 설정 스크립트, 또는 합법적인 애플리케이션이 시스템 구성 정보를 조회하는 과정에서 오탐이 발생할 수 있습니다. 특히 'systeminfo', 'wmic', 'ipconfig' 등은 일상적으로 사용될 수 있는 명령이므로, 알려진 정상 프로세스나 특정 명령줄 패턴을 화이트리스트에 추가하여 오탐을 줄일 수 있습니다."
}