{
    "id": "T1036.010-MasqueradeAccountName",
    "name": "Masquerade Account Name",
    "description": "Detects attempts by adversaries to create or modify accounts with names that mimic legitimate accounts or common service accounts (e.g., 'admin', 'help', 'root', 'svc_') to appear benign and evade detection. This technique is often used during account creation or renaming to establish persistence or facilitate other malicious activities.",
    "severity": "high",
    "mitre_attack": {
        "tactic": "TA0005",
        "technique_id": "T1036",
        "subtechnique_id": "T1036.010",
        "data_sources": [
            "Enterprise:Defense Evasion:Masquerading:Masquerade Account Name",
            "Enterprise:Persistence:Create Account:Local Account",
            "Enterprise:Persistence:Create Account:Domain Account",
            "Enterprise:Execution:Command and Scripting Interpreter:Windows Command Shell",
            "Enterprise:Execution:Command and Scripting Interpreter:PowerShell",
            "Enterprise:Execution:Native API",
            "Enterprise:Defense Evasion:Modify Registry"
        ]
    },
    "platform": [
        "windows"
    ],
    "detection": {
        "selections": {
            "s1_process_create_action": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.action",
                        "operator": "equals",
                        "value": "create"
                    }
                ]
            },
            "s2_cmdline_net_user_command": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "net user"
                    }
                ]
            },
            "s3_cmdline_powershell_user_mgmt": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "Add-LocalUser"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "New-ADUser"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "Set-LocalUser"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "Set-ADUser"
                    }
                ]
            },
            "s4_cmdline_suspicious_account_name": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": " admin "
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": " help "
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": " root "
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": " guest "
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": " defaultuser "
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": " svc_"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "_svc"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "backupuser"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "tempadmin"
                    }
                ]
            },
            "s5_registry_action_account_modify": {
                "event_type": "registry",
                "conditions": [
                    {
                        "field": "body.registry.keyclass",
                        "operator": "equals",
                        "value": "RegNtPostCreateKeyEx"
                    },
                    {
                        "field": "body.registry.keyclass",
                        "operator": "equals",
                        "value": "RegNtSetValueKey"
                    },
                    {
                        "field": "body.registry.keyclass",
                        "operator": "equals",
                        "value": "RegNtPostRenameKey"
                    }
                ]
            },
            "s6_registry_user_account_path": {
                "event_type": "registry",
                "conditions": [
                    {
                        "field": "body.registry.name",
                        "operator": "startswith",
                        "value": "HKEY_LOCAL_MACHINE\\SAM\\SAM\\Domains\\Account\\Users"
                    },
                    {
                        "field": "body.registry.name",
                        "operator": "startswith",
                        "value": "HKEY_LOCAL_MACHINE\\SOFTWARE\\Microsoft\\Windows NT\\CurrentVersion\\ProfileList"
                    },
                    {
                        "field": "body.registry.name",
                        "operator": "startswith",
                        "value": "HKEY_USERS\\"
                    }
                ]
            },
            "s7_apicall_user_management": {
                "event_type": "apicall",
                "conditions": [
                    {
                        "field": "body.apicall.function",
                        "operator": "equals",
                        "value": "NetUserAdd"
                    },
                    {
                        "field": "body.apicall.function",
                        "operator": "equals",
                        "value": "NetUserSetInfo"
                    },
                    {
                        "field": "body.apicall.function",
                        "operator": "equals",
                        "value": "LsaCreateAccount"
                    },
                    {
                        "field": "body.apicall.function",
                        "operator": "equals",
                        "value": "LsaSetInformationObject"
                    }
                ]
            }
        },
        "condition": "(s1_process_create_action and (s2_cmdline_net_user_command or s3_cmdline_powershell_user_mgmt) and s4_cmdline_suspicious_account_name) or (s5_registry_action_account_modify and s6_registry_user_account_path) or s7_apicall_user_management"
    },
    "operational_usage": "SOC 팀은 이 규칙을 활용하여 시스템에서 가장 계정 생성 또는 기존 계정 변경 시도를 탐지할 수 있습니다. 'net user' 명령어나 PowerShell Cmdlet을 사용하여 'admin', 'root', 'svc_'와 같은 의심스러운 이름으로 계정을 생성하거나 변경하는 프로세스 이벤트를 모니터링합니다. 또한, SAM 데이터베이스나 사용자 프로필 관련 레지스트리 키에 대한 생성/수정/이름 변경 활동, 그리고 'NetUserAdd', 'LsaCreateAccount'와 같은 사용자 관리 API 호출을 추적합니다. 탐지된 이벤트는 높은 심각도로 분류되어 즉각적인 알람을 트리거하고, 해당 계정의 활동 및 관련 프로세스에 대한 심층 조사를 시작하는 데 사용될 수 있습니다. 이는 방어 회피 및 권한 상승 전술과 결합될 때 특히 중요합니다.",
    "false_positive": "정상적인 시스템 관리 작업, IT 스크립트, 자동화된 배포 도구, 또는 특정 소프트웨어 설치 프로세스가 시스템 계정을 생성하거나 수정하는 과정에서 오탐이 발생할 수 있습니다. 예를 들어, 백업 솔루션이 'backupuser' 계정을 만들거나, 개발 환경에서 'dev_svc'와 같은 서비스 계정을 설정하는 경우입니다. 알려진 정상 프로세스, 특정 명령줄 패턴, 또는 특정 계정 이름을 화이트리스트에 추가하여 오탐을 줄일 수 있습니다."
}