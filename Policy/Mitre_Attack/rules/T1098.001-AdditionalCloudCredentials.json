{
    "id": "T1098.001-AdditionalCloudCredentials",
    "name": "Additional Cloud Credentials",
    "description": "Detects attempts by adversaries to add their controlled credentials (e.g., SSH keys, access keys, app passwords, service principal credentials) to cloud accounts or resources (Azure, AWS, GCP) to maintain persistent access or escalate privileges. This includes actions performed via cloud command-line interfaces (az, gcloud, aws), PowerShell modules, or direct API calls.",
    "severity": "high",
    "mitre_attack": {
        "tactic": "TA0003",
        "technique_id": "T1098",
        "subtechnique_id": "T1098.001",
        "data_sources": [
            "Process:ProcessCreation",
            "Process:OSAPIExecution"
        ]
    },
    "platform": [
        "windows"
    ],
    "detection": {
        "selections": {
            "s_proc_create": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.action",
                        "operator": "equals",
                        "value": "create"
                    }
                ]
            },
            "s_az_cli_exe": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.exe_path",
                        "operator": "contains",
                        "value": "az.exe"
                    }
                ]
            },
            "s_az_add_cred_cmd": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "ad app credential reset"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "ad sp credential reset"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "account credential create"
                    }
                ]
            },
            "s_gcloud_cli_exe": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.exe_path",
                        "operator": "contains",
                        "value": "gcloud.exe"
                    }
                ]
            },
            "s_gcloud_ssh_key_add_cmd": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "compute os-login ssh-keys add"
                    }
                ]
            },
            "s_gcloud_access_key_create_cmd": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "iam service-accounts keys create"
                    }
                ]
            },
            "s_aws_cli_exe": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.exe_path",
                        "operator": "contains",
                        "value": "aws.exe"
                    }
                ]
            },
            "s_aws_iam_create_access_key_cmd": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "iam create-access-key"
                    }
                ]
            },
            "s_aws_iam_upload_ssh_key_cmd": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "iam upload-ssh-public-key"
                    }
                ]
            },
            "s_aws_iam_create_login_profile_cmd": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "iam create-login-profile"
                    }
                ]
            },
            "s_aws_sts_get_federation_token_cmd": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "sts get-federation-token"
                    }
                ]
            },
            "s_powershell_exe": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.exe_path",
                        "operator": "contains",
                        "value": "powershell.exe"
                    },
                    {
                        "field": "body.process.exe_path",
                        "operator": "contains",
                        "value": "pwsh.exe"
                    }
                ]
            },
            "s_powershell_azure_add_cred_cmdlets": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "Add-AzADAppCredential"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "New-AzADServicePrincipal"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "New-AzADUser"
                    }
                ]
            },
            "s_powershell_aws_add_cred_cmdlets": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "New-IAMAccessKey"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "Import-EC2KeyPair"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "Add-IAMUser"
                    }
                ]
            },
            "s_apicall_cred_creation_functions": {
                "event_type": "apicall",
                "conditions": [
                    {
                        "field": "body.apicall.function",
                        "operator": "equals",
                        "value": "CreateKeyPair"
                    },
                    {
                        "field": "body.apicall.function",
                        "operator": "equals",
                        "value": "ImportKeyPair"
                    },
                    {
                        "field": "body.apicall.function",
                        "operator": "equals",
                        "value": "CreateAccessKey"
                    },
                    {
                        "field": "body.apicall.function",
                        "operator": "equals",
                        "value": "CreateLoginProfile"
                    },
                    {
                        "field": "body.apicall.function",
                        "operator": "equals",
                        "value": "GetFederationToken"
                    },
                    {
                        "field": "body.apicall.function",
                        "operator": "equals",
                        "value": "NetUserAdd"
                    }
                ]
            }
        },
        "condition": "(s_proc_create and s_az_cli_exe and s_az_add_cred_cmd) or (s_proc_create and s_gcloud_cli_exe and (s_gcloud_ssh_key_add_cmd or s_gcloud_access_key_create_cmd)) or (s_proc_create and s_aws_cli_exe and (s_aws_iam_create_access_key_cmd or s_aws_iam_upload_ssh_key_cmd or s_aws_iam_create_login_profile_cmd or s_aws_sts_get_federation_token_cmd)) or (s_proc_create and s_powershell_exe and (s_powershell_azure_add_cred_cmdlets or s_powershell_aws_add_cred_cmdlets)) or s_apicall_cred_creation_functions"
    },
    "operational_usage": "SOC 팀은 이 규칙을 활용하여 클라우드 환경에서 계정 영속성 확보 또는 권한 상승을 위한 추가 자격 증명 생성/추가 시도를 탐지할 수 있습니다. Azure, AWS, GCP CLI 도구(az, gcloud, aws) 또는 PowerShell 모듈을 통한 자격 증명 관리 명령 실행, 그리고 관련 API 호출을 모니터링합니다. 탐지된 이벤트는 높은 심각도로 분류되어 즉각적인 알람을 트리거하고, 해당 활동을 수행한 계정 및 프로세스에 대한 심층 조사를 시작하는 데 사용될 수 있습니다. 특히, 비정상적인 사용자 계정이나 시스템에서 발생 시 중요도가 높아집니다.",
    "false_positive": "정상적인 클라우드 관리 작업, 자동화 스크립트, DevOps 파이프라인, 또는 합법적인 애플리케이션이 클라우드 자격 증명을 생성하거나 관리하는 과정에서 오탐이 발생할 수 있습니다. 알려진 정상적인 관리 계정, 특정 스크립트 경로, 또는 자동화 도구의 명령줄 패턴을 화이트리스트에 추가하여 오탐을 줄일 수 있습니다."
}