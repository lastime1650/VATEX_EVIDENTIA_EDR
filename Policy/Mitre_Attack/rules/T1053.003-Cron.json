{
    "id": "T1053.003-Cron",
    "name": "Scheduled Task/Job: Cron",
    "description": "Detects attempts to abuse the cron utility to perform task scheduling for initial or recurring execution of malicious code. This includes direct modification of crontab files or execution of the 'crontab' command with suspicious arguments, commonly used by adversaries for persistence and privilege escalation on Unix-like systems.",
    "severity": "high",
    "mitre_attack": {
        "tactic": "TA0003",
        "technique_id": "T1053",
        "subtechnique_id": "T1053.003",
        "data_sources": [
            "file:filemodification",
            "Process:ProcessCreation",
            "Enterprise:Persistence:Scheduled Task/Job:Cron",
            "Enterprise:Execution:Command and Scripting Interpreter:Unix Shell"
        ]
    },
    "platform": [
        "linux",
        "macos",
        "esxi"
    ],
    "detection": {
        "selections": {
            "s1_process_create_action": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.action",
                        "operator": "equals",
                        "value": "create"
                    }
                ]
            },
            "s2_crontab_utility_execution": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "crontab -e"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "crontab -r"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "crontab "
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "crontab <"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "crontab -"
                    }
                ]
            },
            "s3_crontab_file_modification_action": {
                "event_type": "filesystem",
                "conditions": [
                    {
                        "field": "body.filesystem.action",
                        "operator": "equals",
                        "value": "write"
                    },
                    {
                        "field": "body.filesystem.action",
                        "operator": "equals",
                        "value": "create"
                    },
                    {
                        "field": "body.filesystem.action",
                        "operator": "equals",
                        "value": "overwritten"
                    },
                    {
                        "field": "body.filesystem.action",
                        "operator": "equals",
                        "value": "rename"
                    },
                    {
                        "field": "body.filesystem.action",
                        "operator": "equals",
                        "value": "superseded"
                    }
                ]
            },
            "s4_crontab_filepath_target": {
                "event_type": "filesystem",
                "conditions": [
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "contains",
                        "value": "/etc/crontab"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "contains",
                        "value": "/var/spool/cron/crontabs/"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "contains",
                        "value": "/etc/cron.d/"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "contains",
                        "value": "/etc/cron.hourly/"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "contains",
                        "value": "/etc/cron.daily/"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "contains",
                        "value": "/etc/cron.weekly/"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "contains",
                        "value": "/etc/cron.monthly/"
                    }
                ]
            },
            "s5_editor_process_execution": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.exe_path",
                        "operator": "endswith",
                        "value": "/bin/vi"
                    },
                    {
                        "field": "body.process.exe_path",
                        "operator": "endswith",
                        "value": "/usr/bin/vi"
                    },
                    {
                        "field": "body.process.exe_path",
                        "operator": "endswith",
                        "value": "/bin/vim"
                    },
                    {
                        "field": "body.process.exe_path",
                        "operator": "endswith",
                        "value": "/usr/bin/vim"
                    },
                    {
                        "field": "body.process.exe_path",
                        "operator": "endswith",
                        "value": "/bin/nano"
                    },
                    {
                        "field": "body.process.exe_path",
                        "operator": "endswith",
                        "value": "/usr/bin/nano"
                    },
                    {
                        "field": "body.process.exe_path",
                        "operator": "endswith",
                        "value": "/bin/emacs"
                    },
                    {
                        "field": "body.process.exe_path",
                        "operator": "endswith",
                        "value": "/usr/bin/emacs"
                    }
                ]
            },
            "s6_editor_commandline_target_crontab": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "/etc/crontab"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "/var/spool/cron/crontabs/"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "/etc/cron.d/"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "/etc/cron.hourly/"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "/etc/cron.daily/"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "/etc/cron.weekly/"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "/etc/cron.monthly/"
                    }
                ]
            }
        },
        "condition": "(s1_process_create_action and s2_crontab_utility_execution) or (s3_crontab_file_modification_action and s4_crontab_filepath_target) or (s1_process_create_action and s5_editor_process_execution and s6_editor_commandline_target_crontab)"
    },
    "operational_usage": "SOC 팀은 이 규칙을 활용하여 cron 작업을 통한 악성 코드 실행 및 지속성 유지 시도를 탐지할 수 있습니다. 'crontab' 명령 실행, crontab 파일에 대한 직접적인 파일 시스템 쓰기/생성/수정 이벤트, 또는 텍스트 편집기(vi, nano 등)를 사용하여 crontab 관련 파일을 수정하는 프로세스 생성을 모니터링합니다. 탐지된 이벤트는 높은 심각도로 분류되어 즉각적인 알람을 트리거하고, 관련된 프로세스 및 파일 변경 사항에 대한 추가적인 포렌식 조사를 시작하는 데 사용될 수 있습니다. 특히 권한 상승 또는 다른 악성 활동과 결합될 때 중요도가 더욱 높아집니다.",
    "false_positive": "합법적인 시스템 관리자가 cron 작업을 설정하거나 수정하는 경우, 소프트웨어 설치 또는 업데이트 프로세스가 예약 작업을 생성하는 경우, 또는 시스템 모니터링/백업 스크립트가 cron을 사용하는 경우 오탐이 발생할 수 있습니다. 알려진 정상적인 cron 작업 변경 패턴이나 특정 사용자/프로세스에 대해 화이트리스트를 적용하여 오탐을 줄일 수 있습니다."
}