{
    "id": "T1562.001-DisableOrModifyTools",
    "name": "Disable or Modify Tools",
    "description": "Adversaries may modify and/or disable security tools (e.g., antivirus, EDR, Sysmon) to avoid detection of their malicious activities. This can involve terminating security software processes or services, modifying/deleting registry keys or configuration files, disabling updates, or tampering with security artifacts like hooks. They may also add new directories to an EDR tool’s exclusion list to hide malicious files.",
    "severity": "high",
    "mitre_attack": {
        "tactic": "TA0005",
        "technique_id": "T1562",
        "subtechnique_id": "T1562.001",
        "data_sources": [
            "Enterprise:Defense Evasion:Impair Defenses:Disable or Modify Tools",
            "Enterprise:Execution:Command and Scripting Interpreter:Windows Command Shell",
            "Enterprise:Defense Evasion:Modify Registry"
        ]
    },
    "platform": [
        "windows"
    ],
    "detection": {
        "selections": {
            "s1_process_create_action": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.action",
                        "operator": "equals",
                        "value": "create"
                    }
                ]
            },
            "s2_process_remove_action": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.action",
                        "operator": "equals",
                        "value": "remove"
                    }
                ]
            },
            "s3_registry_modify_or_delete_action": {
                "event_type": "registry",
                "conditions": [
                    {
                        "field": "body.registry.keyclass",
                        "operator": "contains",
                        "value": "SetValueKey"
                    },
                    {
                        "field": "body.registry.keyclass",
                        "operator": "contains",
                        "value": "DeleteValueKey"
                    },
                    {
                        "field": "body.registry.keyclass",
                        "operator": "contains",
                        "value": "DeleteKey"
                    }
                ]
            },
            "s4_cmdline_kill_service_process_keywords": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "taskkill"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "net stop"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "sc stop"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "Stop-Service"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "Stop-Process"
                    }
                ]
            },
            "s5_cmdline_disable_defender_keywords": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "Set-MpPreference -Disable"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "Disable-MpProtection"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "MpCmdRun.exe -Disable"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "Add-MpPreference -ExclusionPath"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "Set-MpPreference -ExclusionPath"
                    }
                ]
            },
            "s6_cmdline_driver_unload_keywords": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "fltmc unload"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "sc delete"
                    }
                ]
            },
            "s7_target_security_exe_path": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.exe_path",
                        "operator": "contains",
                        "value": "MsMpEng.exe"
                    },
                    {
                        "field": "body.process.exe_path",
                        "operator": "contains",
                        "value": "MsSense.exe"
                    },
                    {
                        "field": "body.process.exe_path",
                        "operator": "contains",
                        "value": "SophosEDR.exe"
                    },
                    {
                        "field": "body.process.exe_path",
                        "operator": "contains",
                        "value": "CrowdStrike.exe"
                    },
                    {
                        "field": "body.process.exe_path",
                        "operator": "contains",
                        "value": "sysmon.exe"
                    },
                    {
                        "field": "body.process.exe_path",
                        "operator": "contains",
                        "value": "carbonblack.exe"
                    },
                    {
                        "field": "body.process.exe_path",
                        "operator": "contains",
                        "value": "sentinelone.exe"
                    },
                    {
                        "field": "body.process.exe_path",
                        "operator": "contains",
                        "value": "eset.exe"
                    },
                    {
                        "field": "body.process.exe_path",
                        "operator": "contains",
                        "value": "avast.exe"
                    },
                    {
                        "field": "body.process.exe_path",
                        "operator": "contains",
                        "value": "kaspersky.exe"
                    },
                    {
                        "field": "body.process.exe_path",
                        "operator": "contains",
                        "value": "mcafee.exe"
                    }
                ]
            },
            "s8_target_sysmon_registry_path": {
                "event_type": "registry",
                "conditions": [
                    {
                        "field": "body.registry.name",
                        "operator": "contains",
                        "value": "HKEY_LOCAL_MACHINE\\SYSTEM\\CurrentControlSet\\Control\\WMI\\Autologger\\EventLog-Microsoft-Windows-Sysmon-Operational"
                    },
                    {
                        "field": "body.registry.name",
                        "operator": "contains",
                        "value": "HKEY_LOCAL_MACHINE\\SYSTEM\\CurrentControlSet\\Services\\Sysmon"
                    }
                ]
            },
            "s9_target_defender_registry_path": {
                "event_type": "registry",
                "conditions": [
                    {
                        "field": "body.registry.name",
                        "operator": "contains",
                        "value": "HKEY_LOCAL_MACHINE\\SOFTWARE\\Policies\\Microsoft\\Windows Defender"
                    },
                    {
                        "field": "body.registry.name",
                        "operator": "contains",
                        "value": "DisableAntiSpyware"
                    },
                    {
                        "field": "body.registry.name",
                        "operator": "contains",
                        "value": "DisableRealtimeMonitoring"
                    },
                    {
                        "field": "body.registry.name",
                        "operator": "contains",
                        "value": "DisableBehaviorMonitoring"
                    }
                ]
            }
        },
        "condition": "(s2_process_remove_action and s7_target_security_exe_path) or (s1_process_create_action and (s4_cmdline_kill_service_process_keywords or s5_cmdline_disable_defender_keywords or s6_cmdline_driver_unload_keywords)) or (s3_registry_modify_or_delete_action and (s8_target_sysmon_registry_path or s9_target_defender_registry_path))"
    },
    "operational_usage": "SOC 팀은 이 규칙을 활용하여 공격자가 방어 도구를 비활성화하거나 수정하려는 시도를 탐지할 수 있습니다. 이는 보안 프로세스 종료, 서비스 중지/삭제 명령 실행, Windows Defender 기능 비활성화, 드라이버 언로드 시도, 또는 Sysmon 및 Windows Defender 관련 레지스트리 키 변경/삭제와 같은 행동을 모니터링합니다. 탐지된 이벤트는 높은 심각도로 분류되어 즉각적인 알람을 트리거하고, 해당 프로세스 및 시스템 변경 사항에 대한 심층적인 포렌식 조사를 시작하는 데 사용됩니다. 이는 초기 침투 후 방어 회피 전술의 핵심 지표가 됩니다.",
    "false_positive": "정상적인 시스템 관리 작업, 소프트웨어 설치/제거, 업데이트 프로세스, 또는 합법적인 진단 도구가 보안 소프트웨어의 상태를 조회하거나 일시적으로 중지하는 경우 오탐이 발생할 수 있습니다. 알려진 정상 프로세스, 특정 명령줄 패턴, 또는 특정 레지스트리 변경에 대해 화이트리스트를 적용하여 오탐을 줄일 수 있습니다."
}