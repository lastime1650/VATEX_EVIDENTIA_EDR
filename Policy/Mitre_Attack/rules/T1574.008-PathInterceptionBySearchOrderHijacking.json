{
    "id": "T1574.008-PathInterceptionBySearchOrderHijacking",
    "name": "Path Interception by Search Order Hijacking",
    "description": "Detects attempts to execute malicious payloads by abusing the operating system's search order for programs without a specified full path. This technique involves placing a malicious executable with a common name (e.g., 'net.exe') in a directory that is searched before the legitimate system utility.",
    "severity": "high",
    "mitre_attack": {
        "tactic": "TA0003,TA0004,TA0005",
        "technique_id": "T1574",
        "subtechnique_id": "T1574.008",
        "data_sources": [
            "Enterprise:Execution:Command and Scripting Interpreter:Windows Command Shell",
            "Enterprise:Defense Evasion:Masquerading:Match Legitimate Resource Name or Location",
            "Enterprise:Defense Evasion:File and Directory Permissions Modification:Windows File and Directory Permissions Modification"
        ]
    },
    "platform": [
        "windows"
    ],
    "detection": {
        "selections": {
            "s1_process_create_action": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.action",
                        "operator": "equals",
                        "value": "create"
                    }
                ]
            },
            "s2_hijacked_process_exe_name": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.exe_path",
                        "operator": "endswith",
                        "value": "net.exe"
                    },
                    {
                        "field": "body.process.exe_path",
                        "operator": "endswith",
                        "value": "findstr.exe"
                    },
                    {
                        "field": "body.process.exe_path",
                        "operator": "endswith",
                        "value": "python.exe"
                    },
                    {
                        "field": "body.process.exe_path",
                        "operator": "endswith",
                        "value": "net.com"
                    },
                    {
                        "field": "body.process.exe_path",
                        "operator": "endswith",
                        "value": "net.bat"
                    },
                    {
                        "field": "body.process.exe_path",
                        "operator": "endswith",
                        "value": "net.cmd"
                    }
                ]
            },
            "s3_process_exe_in_system_path": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.exe_path",
                        "operator": "startswith",
                        "value": "C:\\Windows\\System32\\"
                    },
                    {
                        "field": "body.process.exe_path",
                        "operator": "startswith",
                        "value": "C:\\Windows\\SysWOW64\\"
                    },
                    {
                        "field": "body.process.exe_path",
                        "operator": "startswith",
                        "value": "C:\\Windows\\WinSxS\\"
                    }
                ]
            },
            "f1_file_write_create_action": {
                "event_type": "filesystem",
                "conditions": [
                    {
                        "field": "body.filesystem.action",
                        "operator": "equals",
                        "value": "create"
                    },
                    {
                        "field": "body.filesystem.action",
                        "operator": "equals",
                        "value": "write"
                    },
                    {
                        "field": "body.filesystem.action",
                        "operator": "equals",
                        "value": "overwritten"
                    }
                ]
            },
            "f2_hijacked_file_name": {
                "event_type": "filesystem",
                "conditions": [
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "endswith",
                        "value": "net.exe"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "endswith",
                        "value": "findstr.exe"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "endswith",
                        "value": "python.exe"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "endswith",
                        "value": "net.com"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "endswith",
                        "value": "net.bat"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "endswith",
                        "value": "net.cmd"
                    }
                ]
            },
            "f3_file_in_system_path": {
                "event_type": "filesystem",
                "conditions": [
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "startswith",
                        "value": "C:\\Windows\\System32\\"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "startswith",
                        "value": "C:\\Windows\\SysWOW64\\"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "startswith",
                        "value": "C:\\Windows\\WinSxS\\"
                    }
                ]
            }
        },
        "condition": "(s1_process_create_action and s2_hijacked_process_exe_name and not s3_process_exe_in_system_path) or (f1_file_write_create_action and f2_hijacked_file_name and not f3_file_in_system_path)"
    },
    "operational_usage": "SOC 팀은 이 규칙을 활용하여 경로 검색 순서 하이재킹을 통한 악성 코드 실행 시도 및 파일 생성 행위를 탐지할 수 있습니다. 시스템 유틸리티와 동일한 이름의 실행 파일이 비표준 경로에서 생성되거나 실행되는 이벤트를 모니터링합니다. 탐지된 이벤트는 높은 심각도로 분류되어 즉각적인 알람을 트리거하고, 관련 프로세스 및 파일에 대한 추가적인 포렌식 조사를 시작하는 데 사용될 수 있습니다. 특히, 다른 방어 회피, 지속성 또는 권한 상승 전술과 결합될 때 중요도가 더욱 높아집니다.",
    "false_positive": "일부 레거시 애플리케이션, 개발 도구, 또는 특정 관리 스크립트가 경로를 명시하지 않고 실행 파일을 호출하거나, 특정 유틸리티를 비표준 경로에 배치하여 사용하는 경우 오탐이 발생할 수 있습니다. 알려진 정상적인 소프트웨어의 동작 패턴이나 특정 프로세스에 대해 화이트리스트를 적용하여 오탐을 줄일 수 있습니다."
}