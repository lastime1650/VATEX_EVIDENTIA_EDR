{
    "id": "T1048-ExfiltrationOverAlternativeProtocol-Process",
    "name": "Exfiltration Over Alternative Protocol (Process Execution)",
    "description": "Detects attempts by adversaries to steal data by exfiltrating it over alternative protocols using common operating system utilities and scripting tools. This rule focuses on the execution of tools like curl, ftp, bitsadmin, PowerShell, and certutil with command-line arguments indicative of data transfer via non-standard or alternative channels.",
    "severity": "high",
    "mitre_attack": {
        "tactic": "TA0010",
        "technique_id": "T1048",
        "subtechnique_id": "",
        "data_sources": [
            "Enterprise:Execution:Command and Scripting Interpreter:Windows Command Shell",
            "Enterprise:Execution:Command and Scripting Interpreter:PowerShell",
            "Enterprise:Exfiltration:Exfiltration Over Alternative Protocol"
        ]
    },
    "platform": [
        "windows"
    ],
    "detection": {
        "selections": {
            "s1_process_create_action": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.action",
                        "operator": "equals",
                        "value": "create"
                    }
                ]
            },
            "s2_curl_exe_path": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.exe_path",
                        "operator": "endswith",
                        "value": "curl.exe"
                    }
                ]
            },
            "s3_curl_exfil_cmdline": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "http://"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "https://"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "ftp://"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "sftp://"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "--upload-file"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": " -T "
                    }
                ]
            },
            "s4_ftp_exe_path": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.exe_path",
                        "operator": "endswith",
                        "value": "ftp.exe"
                    }
                ]
            },
            "s5_bitsadmin_exe_path": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.exe_path",
                        "operator": "endswith",
                        "value": "bitsadmin.exe"
                    }
                ]
            },
            "s6_bitsadmin_exfil_cmdline": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": " /transfer "
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": " /upload "
                    }
                ]
            },
            "s7_powershell_exe_path": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.exe_path",
                        "operator": "endswith",
                        "value": "powershell.exe"
                    },
                    {
                        "field": "body.process.exe_path",
                        "operator": "endswith",
                        "value": "pwsh.exe"
                    }
                ]
            },
            "s8_powershell_webrequest_cmdlet": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "Invoke-WebRequest"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "Invoke-RestMethod"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "System.Net.WebClient"
                    }
                ]
            },
            "s9_certutil_exe_path": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.exe_path",
                        "operator": "endswith",
                        "value": "certutil.exe"
                    }
                ]
            },
            "s10_certutil_exfil_cmdline": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": " -urlcache "
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": " -retrieve "
                    }
                ]
            }
        },
        "condition": "s1_process_create_action and ((s2_curl_exe_path and s3_curl_exfil_cmdline) or s4_ftp_exe_path or (s5_bitsadmin_exe_path and s6_bitsadmin_exfil_cmdline) or (s7_powershell_exe_path and s8_powershell_webrequest_cmdlet) or (s9_certutil_exe_path and s10_certutil_exfil_cmdline))"
    },
    "operational_usage": "SOC 팀은 이 규칙을 활용하여 시스템에서 대체 프로토콜을 통한 데이터 유출 시도를 탐지할 수 있습니다. curl, ftp, bitsadmin, PowerShell, certutil과 같은 도구의 프로세스 생성 이벤트를 모니터링하고, 이와 함께 데이터 전송을 지시하는 특정 명령줄 인자를 분석합니다. 탐지된 이벤트는 높은 심각도로 분류되어 즉각적인 알람을 트리거하며, 관련 프로세스의 활동 및 대상 네트워크 연결에 대한 추가적인 조사를 시작하는 데 사용될 수 있습니다. 특히, 다른 데이터 수집(Collection) 또는 명령 및 제어(Command and Control) 활동과 결합될 때 중요도가 더욱 높아집니다.",
    "false_positive": "정상적인 시스템 관리 작업, 소프트웨어 업데이트, 파일 동기화 도구, 개발 스크립트 또는 합법적인 애플리케이션이 데이터를 전송하는 과정에서 오탐이 발생할 수 있습니다. 예를 들어, 개발자가 curl을 사용하여 API에 데이터를 전송하거나, 시스템 관리자가 ftp를 통해 로그를 전송하는 경우입니다. 알려진 정상적인 프로세스나 특정 명령줄 패턴을 화이트리스트에 추가하여 오탐을 줄일 수 있습니다."
}