{
    "id": "T1553.006-CodeSigningPolicyModification",
    "name": "Code Signing Policy Modification",
    "description": "Detects attempts to modify code signing policies on a system, which can enable the execution of unsigned or self-signed code. This includes monitoring for specific command-line utilities like bcdedit.exe used to enable test signing, and modifications to critical Windows Registry keys related to driver signing enforcement.",
    "severity": "high",
    "mitre_attack": {
        "tactic": "TA0005",
        "technique_id": "T1553",
        "subtechnique_id": "T1553.006",
        "data_sources": [
            "Command:CommandExecution",
            "WindowsRegistry:WindowsRegistryKeyModification",
            "Process:ProcessCreation"
        ]
    },
    "platform": [
        "windows"
    ],
    "detection": {
        "selections": {
            "s1_process_create": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.action",
                        "operator": "equals",
                        "value": "create"
                    }
                ]
            },
            "s2_bcdedit_exe_path": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.exe_path",
                        "operator": "endswith",
                        "value": "bcdedit.exe"
                    }
                ]
            },
            "s3_bcdedit_testsigning_on_cmdline": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "-set TESTSIGNING ON"
                    }
                ]
            },
            "s4_registry_set_value_keyclass": {
                "event_type": "registry",
                "conditions": [
                    {
                        "field": "body.registry.keyclass",
                        "operator": "equals",
                        "value": "RegNtSetValueKey"
                    }
                ]
            },
            "s5_driver_signing_registry_path": {
                "event_type": "registry",
                "conditions": [
                    {
                        "field": "body.registry.name",
                        "operator": "startswith",
                        "value": "HKEY_LOCAL_MACHINE\\SOFTWARE\\Policies\\Microsoft\\Windows NT\\Driver Signing"
                    },
                    {
                        "field": "body.registry.name",
                        "operator": "startswith",
                        "value": "HKEY_CURRENT_USER\\SOFTWARE\\Policies\\Microsoft\\Windows NT\\Driver Signing"
                    }
                ]
            }
        },
        "condition": "(s1_process_create and s2_bcdedit_exe_path and s3_bcdedit_testsigning_on_cmdline) or (s4_registry_set_value_keyclass and s5_driver_signing_registry_path)"
    },
    "operational_usage": "SOC 팀은 이 규칙을 활용하여 시스템 코드 서명 정책 변경 시도를 탐지할 수 있습니다. 특히 'bcdedit.exe -set TESTSIGNING ON'과 같은 명령줄 실행 이벤트와 드라이버 서명 관련 레지스트리 키 변경을 모니터링합니다. 탐지된 이벤트는 높은 심각도로 분류되어 즉각적인 알람을 트리거하고, 시스템 무결성 및 잠재적인 커널 수준 공격에 대한 추가적인 포렌식 조사를 시작하는 데 사용될 수 있습니다.",
    "false_positive": "정상적인 드라이버 개발, 테스트 환경 설정, 또는 특정 시스템 관리 도구가 일시적으로 테스트 서명을 활성화하거나 드라이버 서명 관련 레지스트리 키를 변경하는 경우 오탐이 발생할 수 있습니다. 알려진 정상적인 프로세스나 특정 명령줄 패턴을 화이트리스트에 추가하여 오탐을 줄일 수 있습니다."
}