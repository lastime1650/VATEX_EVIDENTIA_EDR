{
    "id": "T1029-ScheduledTransfer",
    "name": "Scheduled Transfer",
    "description": "Detects attempts by adversaries to schedule data exfiltration to occur at specific times or intervals, aiming to blend with normal network activity or leverage periods of higher bandwidth availability. This often involves the use of legitimate scheduling tools like schtasks.exe or at.exe, or scripting languages like PowerShell to initiate data transfers.",
    "severity": "high",
    "mitre_attack": {
        "tactic": "TA0010",
        "technique_id": "T1029",
        "subtechnique_id": "",
        "data_sources": [
            "Process: Process Creation",
            "Network Traffic: Network Connection Creation",
            "Network Traffic: Network Traffic Flow"
        ]
    },
    "platform": [
        "windows"
    ],
    "detection": {
        "selections": {
            "s1_process_create_action": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.action",
                        "operator": "equals",
                        "value": "create"
                    }
                ]
            },
            "s2_schtasks_exe_path": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.exe_path",
                        "operator": "endswith",
                        "value": "schtasks.exe"
                    }
                ]
            },
            "s3_schtasks_create_cmd": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "/create"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "/run"
                    }
                ]
            },
            "s4_at_exe_path": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.exe_path",
                        "operator": "endswith",
                        "value": "at.exe"
                    }
                ]
            },
            "s5_at_schedule_cmd": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": " /every:"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": " /next:"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "matches",
                        "value": "\\s(?:[01]?\\d|2[0-3]):[0-5]\\d(?:AM|PM|am|pm)?\\s"
                    }
                ]
            },
            "s6_powershell_exe_path": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.exe_path",
                        "operator": "endswith",
                        "value": "powershell.exe"
                    }
                ]
            },
            "s7_powershell_scheduled_task_cmd": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "Register-ScheduledTask"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "New-ScheduledTaskAction"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "Set-ScheduledTask"
                    }
                ]
            },
            "s8_powershell_transfer_cmd": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "Invoke-WebRequest"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "Start-BitsTransfer"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "bitsadmin /transfer"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "ftp.exe"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "sftp.exe"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "scp.exe"
                    }
                ]
            },
            "s9_outbound_network_direction": {
                "event_type": "network",
                "conditions": [
                    {
                        "field": "body.network.direction",
                        "operator": "equals",
                        "value": "out"
                    }
                ]
            },
            "s10_large_network_packetsize": {
                "event_type": "network",
                "conditions": [
                    {
                        "field": "body.network.packetsize",
                        "operator": "gte",
                        "value": 1048576
                    }
                ]
            }
        },
        "condition": "(s1_process_create_action and s2_schtasks_exe_path and s3_schtasks_create_cmd) or (s1_process_create_action and s4_at_exe_path and s5_at_schedule_cmd) or (s1_process_create_action and s6_powershell_exe_path and (s7_powershell_scheduled_task_cmd or s8_powershell_transfer_cmd)) or (s9_outbound_network_direction and s10_large_network_packetsize)"
    },
    "operational_usage": "SOC 팀은 이 규칙을 활용하여 시스템에서 예약된 데이터 전송 시도를 탐지할 수 있습니다. schtasks.exe 또는 at.exe와 같은 예약 도구의 프로세스 생성 이벤트를 모니터링하여 새로운 작업 생성이나 실행 시도를 식별합니다. 또한, PowerShell을 사용하여 예약된 작업을 생성하거나 파일 전송을 시도하는 명령줄 패턴을 탐지합니다. 더불어, 단일 네트워크 이벤트에서 1MB 이상의 대규모 아웃바운드 패킷이 감지되는 경우를 통해 잠재적인 데이터 유출 시도를 파악합니다. 탐지된 이벤트는 높은 심각도로 분류되어 즉각적인 알람을 트리거하고, 관련 프로세스 및 네트워크 활동에 대한 추가적인 포렌식 조사를 시작하는 데 사용될 수 있습니다.",
    "false_positive": "정상적인 시스템 관리 작업, 백업 소프트웨어, 대규모 파일 동기화 도구, 또는 합법적인 애플리케이션의 업데이트 프로세스가 schtasks.exe, at.exe 또는 PowerShell을 사용하여 작업을 예약하거나 대량의 데이터를 전송하는 경우 오탐이 발생할 수 있습니다. 특히, 대규모 네트워크 패킷 감지는 정상적인 대용량 파일 다운로드 또는 업로드 시에도 발생할 수 있습니다. 알려진 정상적인 예약 작업, 프로세스, 또는 특정 네트워크 트래픽 패턴에 대해 화이트리스트를 적용하여 오탐을 줄일 수 있습니다."
}