{
    "id": "T1598.002-SpearphishingAttachment",
    "name": "Spearphishing Attachment",
    "description": "Detects the execution or interaction with malicious attachments delivered via spearphishing. This includes process creation from email clients or browsers, suspicious file writes in temporary/download directories, and API calls indicative of code execution or defense evasion.",
    "severity": "high",
    "mitre_attack": {
        "tactic": "TA0043",
        "technique_id": "T1598",
        "subtechnique_id": "T1598.002",
        "data_sources": [
            "Network Traffic:Network Traffic Flow",
            "Application Log:Application Log Content",
            "Network Traffic:Network Traffic Content",
            "Process:Process Creation",
            "File:File Creation",
            "API:API Call"
        ]
    },
    "platform": [
        "windows"
    ],
    "detection": {
        "selections": {
            "s1_proc_create_action": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.action",
                        "operator": "equals",
                        "value": "create"
                    }
                ]
            },
            "s2_parent_email_client_browser": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.parent_exe_path",
                        "operator": "contains",
                        "value": "outlook.exe"
                    },
                    {
                        "field": "body.process.parent_exe_path",
                        "operator": "contains",
                        "value": "thunderbird.exe"
                    },
                    {
                        "field": "body.process.parent_exe_path",
                        "operator": "contains",
                        "value": "chrome.exe"
                    },
                    {
                        "field": "body.process.parent_exe_path",
                        "operator": "contains",
                        "value": "msedge.exe"
                    },
                    {
                        "field": "body.process.parent_exe_path",
                        "operator": "contains",
                        "value": "firefox.exe"
                    },
                    {
                        "field": "body.process.parent_exe_path",
                        "operator": "contains",
                        "value": "iexplore.exe"
                    }
                ]
            },
            "s3_child_suspicious_exe": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.exe_path",
                        "operator": "endswith",
                        "value": ".exe"
                    },
                    {
                        "field": "body.process.exe_path",
                        "operator": "endswith",
                        "value": ".dll"
                    },
                    {
                        "field": "body.process.exe_path",
                        "operator": "endswith",
                        "value": ".ps1"
                    },
                    {
                        "field": "body.process.exe_path",
                        "operator": "endswith",
                        "value": ".bat"
                    },
                    {
                        "field": "body.process.exe_path",
                        "operator": "endswith",
                        "value": ".cmd"
                    },
                    {
                        "field": "body.process.exe_path",
                        "operator": "endswith",
                        "value": ".vbs"
                    },
                    {
                        "field": "body.process.exe_path",
                        "operator": "endswith",
                        "value": ".js"
                    },
                    {
                        "field": "body.process.exe_path",
                        "operator": "endswith",
                        "value": ".hta"
                    },
                    {
                        "field": "body.process.exe_path",
                        "operator": "endswith",
                        "value": ".cpl"
                    },
                    {
                        "field": "body.process.exe_path",
                        "operator": "endswith",
                        "value": "powershell.exe"
                    },
                    {
                        "field": "body.process.exe_path",
                        "operator": "endswith",
                        "value": "cmd.exe"
                    },
                    {
                        "field": "body.process.exe_path",
                        "operator": "endswith",
                        "value": "wscript.exe"
                    },
                    {
                        "field": "body.process.exe_path",
                        "operator": "endswith",
                        "value": "cscript.exe"
                    },
                    {
                        "field": "body.process.exe_path",
                        "operator": "endswith",
                        "value": "mshta.exe"
                    },
                    {
                        "field": "body.process.exe_path",
                        "operator": "endswith",
                        "value": "rundll32.exe"
                    }
                ]
            },
            "s4_child_suspicious_cmdline": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "powershell -enc"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "powershell -nop"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "cmd.exe /c"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "certutil -urlcache -f"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "Invoke-WebRequest"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "iwr -uri"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "msiexec /q /i"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "regsvr32 /s"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "rundll32.exe javascript:"
                    }
                ]
            },
            "s5_fs_create_write_action": {
                "event_type": "filesystem",
                "conditions": [
                    {
                        "field": "body.filesystem.action",
                        "operator": "equals",
                        "value": "create"
                    },
                    {
                        "field": "body.filesystem.action",
                        "operator": "equals",
                        "value": "write"
                    }
                ]
            },
            "s6_fs_suspicious_path": {
                "event_type": "filesystem",
                "conditions": [
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "contains",
                        "value": "\\Users\\Public\\Downloads\\"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "contains",
                        "value": "\\Users\\Public\\Documents\\"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "contains",
                        "value": "\\AppData\\Local\\Temp\\"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "contains",
                        "value": "\\Windows\\Temp\\"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "contains",
                        "value": "\\Download\\"
                    }
                ]
            },
            "s7_fs_suspicious_extension": {
                "event_type": "filesystem",
                "conditions": [
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "endswith",
                        "value": ".exe"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "endswith",
                        "value": ".dll"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "endswith",
                        "value": ".ps1"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "endswith",
                        "value": ".bat"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "endswith",
                        "value": ".cmd"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "endswith",
                        "value": ".vbs"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "endswith",
                        "value": ".js"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "endswith",
                        "value": ".hta"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "endswith",
                        "value": ".cpl"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "endswith",
                        "value": ".iso"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "endswith",
                        "value": ".img"
                    }
                ]
            },
            "s8_apicall_suspicious_function": {
                "event_type": "apicall",
                "conditions": [
                    {
                        "field": "body.apicall.function",
                        "operator": "equals",
                        "value": "CreateRemoteThread"
                    },
                    {
                        "field": "body.apicall.function",
                        "operator": "equals",
                        "value": "WriteProcessMemory"
                    },
                    {
                        "field": "body.apicall.function",
                        "operator": "equals",
                        "value": "NtCreateUserProcess"
                    },
                    {
                        "field": "body.apicall.function",
                        "operator": "equals",
                        "value": "ShellExecuteA"
                    },
                    {
                        "field": "body.apicall.function",
                        "operator": "equals",
                        "value": "ShellExecuteW"
                    },
                    {
                        "field": "body.apicall.function",
                        "operator": "equals",
                        "value": "CreateProcessA"
                    },
                    {
                        "field": "body.apicall.function",
                        "operator": "equals",
                        "value": "CreateProcessW"
                    },
                    {
                        "field": "body.apicall.function",
                        "operator": "equals",
                        "value": "WinExec"
                    },
                    {
                        "field": "body.apicall.function",
                        "operator": "equals",
                        "value": "URLDownloadToFileA"
                    },
                    {
                        "field": "body.apicall.function",
                        "operator": "equals",
                        "value": "URLDownloadToFileW"
                    }
                ]
            }
        },
        "condition": "(s1_proc_create_action and s2_parent_email_client_browser and (s3_child_suspicious_exe or s4_child_suspicious_cmdline)) or (s5_fs_create_write_action and s6_fs_suspicious_path and s7_fs_suspicious_extension) or s8_apicall_suspicious_function"
    },
    "operational_usage": "SOC 팀은 이 규칙을 활용하여 스피어 피싱 첨부 파일에 의한 악성 활동을 탐지할 수 있습니다. 이메일 클라이언트나 웹 브라우저에서 시작된 의심스러운 프로세스 생성, 임시 또는 다운로드 폴더에 작성된 악성 파일, 그리고 코드 실행 또는 방어 회피와 관련된 API 호출을 모니터링합니다. 탐지된 이벤트는 높은 심각도로 분류되어 즉각적인 알람을 트리거하고, 관련 프로세스, 파일, 네트워크 연결에 대한 심층적인 포렌식 조사를 시작하는 데 사용될 수 있습니다. 특히, 초기 접근 단계에서 악성코드 실행을 탐지하는 데 중요합니다.",
    "false_positive": "정상적인 소프트웨어 설치, 업데이트, 합법적인 문서 처리, 또는 사용자가 다운로드한 합법적인 파일 실행 과정에서 오탐이 발생할 수 있습니다. 예를 들어, 브라우저가 다운로드 폴더에 파일을 생성하고 실행하는 경우, 또는 이메일 클라이언트가 첨부된 PDF 뷰어를 실행하는 경우 등이 있습니다. 알려진 정상 프로세스, 파일 경로, 또는 명령줄 패턴에 대한 화이트리스트를 적용하여 오탐을 줄일 수 있습니다."
}