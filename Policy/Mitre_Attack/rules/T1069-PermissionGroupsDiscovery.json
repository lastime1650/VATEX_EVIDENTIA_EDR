{
    "id": "T1069-PermissionGroupsDiscovery",
    "name": "Permission Groups Discovery",
    "description": "Adversaries may attempt to discover group and permission settings. This information can help adversaries determine which user accounts and groups are available, the membership of users in particular groups, and which users and groups have elevated permissions. Adversaries may attempt to discover group permission settings in many different ways. This data may provide the adversary with information about the compromised environment that can be used in follow-on activity and targeting.",
    "severity": "medium",
    "mitre_attack": {
        "tactic": "TA0007",
        "technique_id": "T1069",
        "subtechnique_id": "",
        "data_sources": [
            "Enterprise:Discovery:Permission Groups Discovery",
            "Enterprise:Execution:Command and Scripting Interpreter:Windows Command Shell",
            "Enterprise:Discovery:Query Registry",
            "Enterprise:Execution:Native API"
        ]
    },
    "platform": [
        "windows"
    ],
    "detection": {
        "selections": {
            "s1_process_create_action": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.action",
                        "operator": "equals",
                        "value": "create"
                    }
                ]
            },
            "s2_cmdline_group_enumeration": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "net group"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "net localgroup"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "whoami /groups"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "Get-LocalGroup"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "Get-ADGroup"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "Get-WmiObject -Class Win32_Group"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "Get-CimInstance -ClassName Win32_Group"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "dsquery group"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "dsget group"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "wmic group"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "net user"
                    }
                ]
            },
            "s3_registry_discovery_action": {
                "event_type": "registry",
                "conditions": [
                    {
                        "field": "body.registry.keyclass",
                        "operator": "contains",
                        "value": "Query"
                    },
                    {
                        "field": "body.registry.keyclass",
                        "operator": "contains",
                        "value": "OpenKey"
                    },
                    {
                        "field": "body.registry.keyclass",
                        "operator": "contains",
                        "value": "Enumerate"
                    }
                ]
            },
            "s4_registry_group_paths": {
                "event_type": "registry",
                "conditions": [
                    {
                        "field": "body.registry.name",
                        "operator": "startswith",
                        "value": "HKEY_LOCAL_MACHINE\\SAM\\SAM"
                    },
                    {
                        "field": "body.registry.name",
                        "operator": "startswith",
                        "value": "HKEY_LOCAL_MACHINE\\SECURITY"
                    },
                    {
                        "field": "body.registry.name",
                        "operator": "startswith",
                        "value": "HKEY_LOCAL_MACHINE\\SOFTWARE\\Microsoft\\Windows NT\\CurrentVersion\\ProfileList"
                    },
                    {
                        "field": "body.registry.name",
                        "operator": "startswith",
                        "value": "HKEY_USERS"
                    }
                ]
            },
            "s5_apicall_group_enumeration": {
                "event_type": "apicall",
                "conditions": [
                    {
                        "field": "body.apicall.function",
                        "operator": "equals",
                        "value": "NetLocalGroupEnum"
                    },
                    {
                        "field": "body.apicall.function",
                        "operator": "equals",
                        "value": "NetGroupEnum"
                    },
                    {
                        "field": "body.apicall.function",
                        "operator": "equals",
                        "value": "LsaEnumerateLogonSessions"
                    },
                    {
                        "field": "body.apicall.function",
                        "operator": "equals",
                        "value": "LsaEnumerateAccountsWithUserRight"
                    },
                    {
                        "field": "body.apicall.function",
                        "operator": "equals",
                        "value": "LookupAccountSid"
                    },
                    {
                        "field": "body.apicall.function",
                        "operator": "equals",
                        "value": "GetSecurityInfo"
                    },
                    {
                        "field": "body.apicall.function",
                        "operator": "equals",
                        "value": "GetNamedSecurityInfo"
                    },
                    {
                        "field": "body.apicall.function",
                        "operator": "equals",
                        "value": "GetExplicitEntriesFromAcl"
                    }
                ]
            }
        },
        "condition": "(s1_process_create_action and s2_cmdline_group_enumeration) or (s3_registry_discovery_action and s4_registry_group_paths) or s5_apicall_group_enumeration"
    },
    "operational_usage": "SOC 팀은 이 규칙을 활용하여 시스템의 그룹 및 권한 설정 정보를 수집하려는 시도를 탐지할 수 있습니다. 'net group', 'whoami /groups'와 같은 명령 실행, PowerShell cmdlets를 통한 그룹 열거 시도, 보안 계정 관리자(SAM) 및 보안(SECURITY) 레지스트리 하이브와 관련된 키 접근, 또는 그룹/사용자 정보 조회 API 호출 등을 모니터링합니다. 탐지된 이벤트는 자동 알람을 트리거하고, 추가적인 조사 및 침해사고 대응의 우선순위를 지정하는 데 사용될 수 있습니다. 특히 다른 Discovery 또는 Privilege Escalation 활동과 결합될 때 중요도가 높아집니다.",
    "false_positive": "정상적인 시스템 관리 도구, 사용자 환경 설정 스크립트, 백신 소프트웨어, 또는 합법적인 애플리케이션이 시스템 그룹 및 권한 정보를 조회하는 과정에서 오탐이 발생할 수 있습니다. 알려진 정상 프로세스나 특정 명령줄 패턴을 화이트리스트에 추가하여 오탐을 줄일 수 있습니다."
}