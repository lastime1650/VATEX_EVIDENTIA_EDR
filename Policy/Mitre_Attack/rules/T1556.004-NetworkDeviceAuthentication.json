{
    "id": "T1556.004-NetworkDeviceAuthentication",
    "name": "Network Device Authentication Bypass via Image Modification",
    "description": "Detects attempts by an adversary on a Windows host to bypass native authentication mechanisms on network devices by preparing or deploying modified system images (e.g., firmware). This involves monitoring for file system activities related to network device images/configurations and process execution of tools used for interacting with or transferring files to network devices.",
    "severity": "high",
    "mitre_attack": {
        "tactic": "TA0006",
        "technique_id": "T1556",
        "subtechnique_id": "T1556.004",
        "data_sources": [
            "Enterprise:Credential Access:Modify Authentication Process:Network Device Authentication",
            "Enterprise:Defense Evasion:Modify System Image:Patch System Image",
            "Enterprise:Execution:Command and Scripting Interpreter:Windows Command Shell",
            "Enterprise:Collection:Data from Local System"
        ]
    },
    "platform": [
        "windows"
    ],
    "detection": {
        "selections": {
            "s1_process_create_action": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.action",
                        "operator": "equals",
                        "value": "create"
                    }
                ]
            },
            "s2_tftp_execution": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "tftp.exe"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "put"
                    }
                ]
            },
            "s3_scp_execution": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "scp.exe"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "@"
                    }
                ]
            },
            "s4_filesystem_write_or_create_action": {
                "event_type": "filesystem",
                "conditions": [
                    {
                        "field": "body.filesystem.action",
                        "operator": "equals",
                        "value": "write"
                    },
                    {
                        "field": "body.filesystem.action",
                        "operator": "equals",
                        "value": "create"
                    },
                    {
                        "field": "body.filesystem.action",
                        "operator": "equals",
                        "value": "overwritten"
                    }
                ]
            },
            "s5_firmware_filepath_pattern": {
                "event_type": "filesystem",
                "conditions": [
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "endswith",
                        "value": ".bin"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "endswith",
                        "value": ".img"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "endswith",
                        "value": ".fw"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "contains",
                        "value": "firmware"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "contains",
                        "value": "ios.bin"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "contains",
                        "value": "junos.tgz"
                    }
                ]
            },
            "s6_network_config_filepath_pattern": {
                "event_type": "filesystem",
                "conditions": [
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "contains",
                        "value": "config.txt"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "contains",
                        "value": "running-config"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "contains",
                        "value": "startup-config"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "contains",
                        "value": "network_device_config"
                    }
                ]
            }
        },
        "condition": "(s1_process_create_action and (s2_tftp_execution or s3_scp_execution)) or (s4_filesystem_write_or_create_action and (s5_firmware_filepath_pattern or s6_network_config_filepath_pattern))"
    },
    "operational_usage": "SOC 팀은 이 규칙을 활용하여 Windows 호스트에서 네트워크 장비의 인증 우회를 위한 이미지 조작 시도를 탐지할 수 있습니다. TFTP, SCP와 같은 파일 전송 도구의 실행을 모니터링하고, 네트워크 장비 펌웨어 또는 설정 파일로 의심되는 파일에 대한 쓰기/생성/덮어쓰기 활동을 탐지합니다. 탐지된 이벤트는 높은 심각도로 분류되어 즉각적인 알람을 트리거하고, 관련 프로세스 및 파일에 대한 추가적인 조사를 시작하는 데 사용될 수 있습니다. 특히, 네트워크 장비에 대한 직접적인 접근이 어려운 환경에서 Windows 기반 공격자의 준비 활동을 포착하는 데 유용합니다.",
    "false_positive": "정상적인 네트워크 장비 관리 활동, 펌웨어 업데이트, 설정 백업/복원, 또는 합법적인 파일 전송 도구 사용으로 인해 오탐이 발생할 수 있습니다. 알려진 관리 서버, 스크립트, 특정 파일 경로, 또는 특정 사용자 계정을 화이트리스트에 추가하여 오탐을 줄일 수 있습니다."
}