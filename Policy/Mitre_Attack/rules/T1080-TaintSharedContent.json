{
    "id": "T1080-TaintSharedContent",
    "name": "Taint Shared Content",
    "description": "Detects attempts by adversaries to deliver payloads to remote systems by adding malicious content to shared storage locations, such as network drives or internal code repositories. This includes tainting valid files with malicious programs, scripts, or exploit code, or modifying .LNK files that masquerade as real directories. Execution occurs when a user opens the tainted content, enabling lateral movement. This rule focuses on file system modifications and process creation events on network shares.",
    "severity": "high",
    "mitre_attack": {
        "tactic": "TA0008",
        "technique_id": "T1080",
        "subtechnique_id": "",
        "data_sources": [
            "Enterprise:Collection:Data from Network Shared Drive",
            "Enterprise:Defense Evasion:File and Directory Permissions Modification:Windows File and Directory Permissions Modification",
            "Enterprise:Execution:Command and Scripting Interpreter:Windows Command Shell"
        ]
    },
    "platform": [
        "windows"
    ],
    "detection": {
        "selections": {
            "s1_filesystem_action_modify": {
                "event_type": "filesystem",
                "conditions": [
                    {
                        "field": "body.filesystem.action",
                        "operator": "equals",
                        "value": "create"
                    },
                    {
                        "field": "body.filesystem.action",
                        "operator": "equals",
                        "value": "write"
                    },
                    {
                        "field": "body.filesystem.action",
                        "operator": "equals",
                        "value": "overwritten"
                    },
                    {
                        "field": "body.filesystem.action",
                        "operator": "equals",
                        "value": "rename"
                    }
                ]
            },
            "s2_filepath_is_network_share": {
                "event_type": "filesystem",
                "conditions": [
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "startswith",
                        "value": "\\\\"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "contains",
                        "value": "\\Users\\Public\\"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "contains",
                        "value": "\\ProgramData\\"
                    }
                ]
            },
            "s3_filepath_suspicious_extension": {
                "event_type": "filesystem",
                "conditions": [
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "endswith",
                        "value": ".lnk"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "endswith",
                        "value": ".exe"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "endswith",
                        "value": ".dll"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "endswith",
                        "value": ".ps1"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "endswith",
                        "value": ".bat"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "endswith",
                        "value": ".cmd"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "endswith",
                        "value": ".vbs"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "endswith",
                        "value": ".js"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "endswith",
                        "value": ".hta"
                    }
                ]
            },
            "s4_filepath_hidden_file_pattern": {
                "event_type": "filesystem",
                "conditions": [
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "contains",
                        "value": "~$"
                    }
                ]
            },
            "s5_process_action_create": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.action",
                        "operator": "equals",
                        "value": "create"
                    }
                ]
            },
            "s6_process_execution_from_network_share": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.exe_path",
                        "operator": "startswith",
                        "value": "\\\\"
                    },
                    {
                        "field": "body.process.parent_exe_path",
                        "operator": "startswith",
                        "value": "\\\\"
                    }
                ]
            },
            "s7_process_cmdline_suspicious_script": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": ".lnk"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "powershell.exe -file"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "cmd.exe /c"
                    }
                ]
            }
        },
        "condition": "(s1_filesystem_action_modify and s2_filepath_is_network_share and (s3_filepath_suspicious_extension or s4_filepath_hidden_file_pattern)) or (s5_process_action_create and s6_process_execution_from_network_share and s7_process_cmdline_suspicious_script)"
    },
    "operational_usage": "SOC 팀은 이 규칙을 활용하여 공유 네트워크 드라이브나 공용 폴더에서 악성 콘텐츠가 생성, 수정되거나 실행되는 시도를 실시간으로 탐지할 수 있습니다. 파일 시스템 이벤트에서 네트워크 경로에 대한 의심스러운 파일 생성/수정(예: .lnk, 실행 파일, 숨겨진 파일 패턴)을 모니터링하고, 네트워크 경로에서 직접 실행되는 프로세스 및 관련 명령줄을 감시합니다. 탐지된 이벤트는 높은 심각도로 분류되어 즉각적인 알람을 트리거하고, 해당 파일 및 프로세스에 대한 추가적인 포렌식 조사를 시작하는 데 사용될 수 있습니다. 특히, 다른 측면 이동 또는 실행 전술과 결합될 때 중요도가 더욱 높아집니다.",
    "false_positive": "정상적인 소프트웨어 배포, 자동화된 백업 솔루션, 시스템 관리 스크립트, 또는 합법적인 애플리케이션이 공유 폴더에 파일을 생성하거나 수정하는 경우 오탐이 발생할 수 있습니다. 특정 관리 도구, 알려진 정상 프로세스 또는 특정 파일 경로에 대한 화이트리스트를 적용하여 오탐을 줄일 수 있습니다."
}