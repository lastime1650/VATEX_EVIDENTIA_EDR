{
    "id": "T1656-Impersonation-SocialEngineering",
    "name": "Impersonation (Social Engineering)",
    "description": "Detects activities related to social engineering impersonation attempts, such as PowerShell scripts sending emails, suspicious web requests, use of download utilities (certutil, bitsadmin), or creation of potentially malicious files in user download/temp directories, which are commonly used by adversaries to trick targets into performing actions.",
    "severity": "high",
    "mitre_attack": {
        "tactic": "TA0005",
        "technique_id": "T1656",
        "subtechnique_id": "",
        "data_sources": [
            "Enterprise:Execution:Command and Scripting Interpreter:PowerShell",
            "Enterprise:Execution:Command and Scripting Interpreter:Windows Command Shell",
            "Enterprise:Initial Access:Phishing:Spearphishing Attachment",
            "Enterprise:Command and Control:Application Layer Protocol:Web Protocols"
        ]
    },
    "platform": [
        "windows"
    ],
    "detection": {
        "selections": {
            "s1_process_create_action": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.action",
                        "operator": "equals",
                        "value": "create"
                    }
                ]
            },
            "s2_powershell_exe_path": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.exe_path",
                        "operator": "endswith",
                        "value": "powershell.exe"
                    }
                ]
            },
            "s3_cmdline_send_mail_kw": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "Send-MailMessage"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "-To"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "-Subject"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "-SmtpServer"
                    }
                ]
            },
            "s4_cmdline_web_request_kw": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "Invoke-WebRequest"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "Invoke-Expression"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "System.Net.WebClient"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "-Uri"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "http"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "https"
                    }
                ]
            },
            "s5_certutil_exe_path": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.exe_path",
                        "operator": "endswith",
                        "value": "certutil.exe"
                    }
                ]
            },
            "s6_bitsadmin_exe_path": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.exe_path",
                        "operator": "endswith",
                        "value": "bitsadmin.exe"
                    }
                ]
            },
            "s7_cmdline_download_kw": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "-urlcache"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "-f"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "/transfer"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "download"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "create"
                    }
                ]
            },
            "s8_filesystem_create_action": {
                "event_type": "filesystem",
                "conditions": [
                    {
                        "field": "body.filesystem.action",
                        "operator": "equals",
                        "value": "create"
                    }
                ]
            },
            "s9_filepath_user_downloads_temp": {
                "event_type": "filesystem",
                "conditions": [
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "contains",
                        "value": "\\Users\\"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "contains",
                        "value": "\\Downloads\\"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "contains",
                        "value": "\\Temp\\"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "contains",
                        "value": "\\AppData\\Local\\Temp\\"
                    }
                ]
            },
            "s10_filepath_suspicious_extension": {
                "event_type": "filesystem",
                "conditions": [
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "endswith",
                        "value": ".exe"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "endswith",
                        "value": ".js"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "endswith",
                        "value": ".vbs"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "endswith",
                        "value": ".hta"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "endswith",
                        "value": ".lnk"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "endswith",
                        "value": ".iso"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "endswith",
                        "value": ".img"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "endswith",
                        "value": ".zip"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "endswith",
                        "value": ".rar"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "endswith",
                        "value": ".7z"
                    }
                ]
            }
        },
        "condition": "(s1_process_create_action and s2_powershell_exe_path and s3_cmdline_send_mail_kw) or (s1_process_create_action and s2_powershell_exe_path and s4_cmdline_web_request_kw) or (s1_process_create_action and (s5_certutil_exe_path or s6_bitsadmin_exe_path) and s7_cmdline_download_kw) or (s8_filesystem_create_action and s9_filepath_user_downloads_temp and s10_filepath_suspicious_extension)"
    },
    "operational_usage": "SOC 팀은 이 규칙을 통해 사회 공학적 위장 시도 및 관련 활동을 탐지할 수 있습니다. PowerShell을 이용한 비정상적인 이메일 전송, 의심스러운 웹 요청, certutil.exe 또는 bitsadmin.exe와 같은 시스템 도구를 사용한 파일 다운로드, 그리고 사용자 다운로드 또는 임시 디렉토리에 악성 파일로 의심되는 확장자를 가진 파일이 생성되는 이벤트를 모니터링합니다. 탐지된 이벤트는 높은 심각도로 분류되어 즉각적인 알람을 트리거하고, 관련된 프로세스, 네트워크 연결, 파일에 대한 추가적인 조사를 시작하는 데 활용될 수 있습니다. 특히, 위장 시도가 다른 초기 접근 또는 방어 회피 전술과 결합될 때 중요도가 더욱 높아집니다.",
    "false_positive": "정상적인 시스템 관리 스크립트, 소프트웨어 업데이트, 합법적인 파일 다운로드, 또는 개발 도구가 유사한 명령줄 패턴이나 파일 생성 활동을 수행하는 경우 오탐이 발생할 수 있습니다. 특히 PowerShell 스크립트나 다운로드 유틸리티는 관리 목적으로도 자주 사용되므로, 알려진 정상 프로세스, 명령줄 패턴, 또는 특정 파일 경로를 화이트리스트에 추가하여 오탐을 줄일 수 있습니다."
}