{
    "id": "T1566.001-SpearphishingAttachment",
    "name": "Spearphishing Attachment",
    "description": "Detects attempts to gain initial access via malicious attachments. This rule focuses on common post-delivery activities such as productivity applications (e.g., Microsoft Office, Adobe Reader) spawning suspicious child processes (e.g., command interpreters, scripting engines, proxy execution tools) or the creation of suspicious executable files in common user download/temporary directories.",
    "severity": "high",
    "mitre_attack": {
        "tactic": "TA0001",
        "technique_id": "T1566",
        "subtechnique_id": "T1566.001",
        "data_sources": [
            "Process:ProcessCreation",
            "File:FileCreation"
        ]
    },
    "platform": [
        "windows"
    ],
    "detection": {
        "selections": {
            "s1_process_action_create": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.action",
                        "operator": "equals",
                        "value": "create"
                    }
                ]
            },
            "s2_parent_is_office_or_reader": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.parent_exe_path",
                        "operator": "endswith",
                        "value": "winword.exe"
                    },
                    {
                        "field": "body.process.parent_exe_path",
                        "operator": "endswith",
                        "value": "excel.exe"
                    },
                    {
                        "field": "body.process.parent_exe_path",
                        "operator": "endswith",
                        "value": "powerpnt.exe"
                    },
                    {
                        "field": "body.process.parent_exe_path",
                        "operator": "endswith",
                        "value": "outlook.exe"
                    },
                    {
                        "field": "body.process.parent_exe_path",
                        "operator": "endswith",
                        "value": "acrobat.exe"
                    },
                    {
                        "field": "body.process.parent_exe_path",
                        "operator": "endswith",
                        "value": "reader_sl.exe"
                    }
                ]
            },
            "s3_child_is_script_interpreter": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.exe_path",
                        "operator": "endswith",
                        "value": "powershell.exe"
                    },
                    {
                        "field": "body.process.exe_path",
                        "operator": "endswith",
                        "value": "cmd.exe"
                    },
                    {
                        "field": "body.process.exe_path",
                        "operator": "endswith",
                        "value": "wscript.exe"
                    },
                    {
                        "field": "body.process.exe_path",
                        "operator": "endswith",
                        "value": "cscript.exe"
                    },
                    {
                        "field": "body.process.exe_path",
                        "operator": "endswith",
                        "value": "mshta.exe"
                    }
                ]
            },
            "s4_child_is_proxy_execution_tool": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.exe_path",
                        "operator": "endswith",
                        "value": "rundll32.exe"
                    },
                    {
                        "field": "body.process.exe_path",
                        "operator": "endswith",
                        "value": "regsvr32.exe"
                    },
                    {
                        "field": "body.process.exe_path",
                        "operator": "endswith",
                        "value": "certutil.exe"
                    },
                    {
                        "field": "body.process.exe_path",
                        "operator": "endswith",
                        "value": "msiexec.exe"
                    },
                    {
                        "field": "body.process.exe_path",
                        "operator": "endswith",
                        "value": "bitsadmin.exe"
                    }
                ]
            },
            "f1_filesystem_create_action": {
                "event_type": "filesystem",
                "conditions": [
                    {
                        "field": "body.filesystem.action",
                        "operator": "equals",
                        "value": "create"
                    }
                ]
            },
            "f2a_filepath_contains_users": {
                "event_type": "filesystem",
                "conditions": [
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "contains",
                        "value": "\\Users\\"
                    }
                ]
            },
            "f2b_filepath_contains_downloads_or_temp": {
                "event_type": "filesystem",
                "conditions": [
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "contains",
                        "value": "\\Downloads\\"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "contains",
                        "value": "\\AppData\\Local\\Temp\\"
                    }
                ]
            },
            "f3_filepath_suspicious_extension": {
                "event_type": "filesystem",
                "conditions": [
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "endswith",
                        "value": ".exe"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "endswith",
                        "value": ".dll"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "endswith",
                        "value": ".ps1"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "endswith",
                        "value": ".vbs"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "endswith",
                        "value": ".js"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "endswith",
                        "value": ".hta"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "endswith",
                        "value": ".bat"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "endswith",
                        "value": ".cmd"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "endswith",
                        "value": ".lnk"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "endswith",
                        "value": ".chm"
                    }
                ]
            }
        },
        "condition": "(s1_process_action_create and s2_parent_is_office_or_reader and (s3_child_is_script_interpreter or s4_child_is_proxy_execution_tool)) or (f1_filesystem_create_action and f2a_filepath_contains_users and f2b_filepath_contains_downloads_or_temp and f3_filepath_suspicious_extension)"
    },
    "operational_usage": "SOC 팀은 이 규칙을 활용하여 스피어 피싱 첨부 파일을 통한 초기 접근 시도를 탐지할 수 있습니다. 특히, Microsoft Office 또는 Adobe Reader와 같은 생산성 애플리케이션이 명령 프롬프트, PowerShell, 스크립트 호스트 또는 프록시 실행 도구와 같은 비정상적인 자식 프로세스를 생성하는 행위를 모니터링합니다. 또한, 사용자의 다운로드 폴더나 임시 폴더 내에 실행 파일, 스크립트 파일 등 의심스러운 확장자를 가진 파일이 생성되는 이벤트를 탐지합니다. 탐지된 이벤트는 높은 심각도로 분류되어 즉각적인 알람을 트리거하고, 관련 프로세스 활동 및 파일 생성 경로에 대한 심층적인 조사를 시작하는 데 사용될 수 있습니다. 이는 초기 침해를 식별하고 확산을 방지하는 데 필수적입니다.",
    "false_positive": "정상적인 소프트웨어 설치, 업데이트 프로세스, 또는 합법적인 애플리케이션이 문서 파일을 처리하거나 임시 파일을 생성하는 과정에서 오탐이 발생할 수 있습니다. 특히, 개발자 도구, 시스템 관리 스크립트, 또는 특정 업무용 애플리케이션이 유사한 프로세스 스폰 또는 파일 생성 패턴을 보일 수 있습니다. 알려진 정상 프로세스나 특정 파일 경로를 화이트리스트에 추가하여 오탐을 줄일 수 있습니다."
}