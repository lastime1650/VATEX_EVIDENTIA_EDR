{
    "id": "T1111-MultiFactorAuthenticationInterception",
    "name": "Multi-Factor Authentication Interception",
    "description": "Detects attempts by adversaries to intercept multi-factor authentication (MFA) mechanisms, such as smart card passwords or one-time passcodes, to gain unauthorized access to systems. This includes keylogging activities, API hooking, or process injection to capture credentials and authentication factors.",
    "severity": "high",
    "mitre_attack": {
        "tactic": "TA0006",
        "technique_id": "T1111",
        "subtechnique_id": "",
        "data_sources": [
            "Enterprise:Credential Access:Input Capture:Keylogging",
            "Enterprise:Execution:Native API",
            "Enterprise:Persistence:Modify Registry",
            "Enterprise:Defense Evasion:Process Injection",
            "Enterprise:Execution:Command and Scripting Interpreter:Windows Command Shell",
            "Enterprise:Process:ProcessCreation"
        ]
    },
    "platform": [
        "windows"
    ],
    "detection": {
        "selections": {
            "s1_keylogger_process_create": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.action",
                        "operator": "equals",
                        "value": "create"
                    }
                ]
            },
            "s2_keylogger_commandline_keywords": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "keylogger"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "logkeys"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "get-keystrokes"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "dumpkeys"
                    }
                ]
            },
            "s3_keyboard_hook_api": {
                "event_type": "apicall",
                "conditions": [
                    {
                        "field": "body.apicall.function",
                        "operator": "equals",
                        "value": "SetWindowsHookExA"
                    },
                    {
                        "field": "body.apicall.function",
                        "operator": "equals",
                        "value": "SetWindowsHookExW"
                    }
                ]
            },
            "s4_keyboard_polling_api": {
                "event_type": "apicall",
                "conditions": [
                    {
                        "field": "body.apicall.function",
                        "operator": "equals",
                        "value": "GetAsyncKeyState"
                    },
                    {
                        "field": "body.apicall.function",
                        "operator": "equals",
                        "value": "GetKeyState"
                    },
                    {
                        "field": "body.apicall.function",
                        "operator": "equals",
                        "value": "GetKeyboardState"
                    }
                ]
            },
            "s5_registry_setvalue_keyclass": {
                "event_type": "registry",
                "conditions": [
                    {
                        "field": "body.registry.keyclass",
                        "operator": "contains",
                        "value": "SetValueKey"
                    },
                    {
                        "field": "body.registry.keyclass",
                        "operator": "contains",
                        "value": "CreateKey"
                    },
                    {
                        "field": "body.registry.keyclass",
                        "operator": "contains",
                        "value": "RenameKey"
                    }
                ]
            },
            "s6_registry_appinit_dlls_path": {
                "event_type": "registry",
                "conditions": [
                    {
                        "field": "body.registry.name",
                        "operator": "startswith",
                        "value": "HKEY_LOCAL_MACHINE\\SOFTWARE\\Microsoft\\Windows NT\\CurrentVersion\\Windows\\AppInit_DLLs"
                    }
                ]
            },
            "s7_registry_ifeo_path": {
                "event_type": "registry",
                "conditions": [
                    {
                        "field": "body.registry.name",
                        "operator": "startswith",
                        "value": "HKEY_LOCAL_MACHINE\\SOFTWARE\\Microsoft\\Windows NT\\CurrentVersion\\Image File Execution Options"
                    }
                ]
            },
            "s8_process_injection_access_rights": {
                "event_type": "processaccess",
                "conditions": [
                    {
                        "field": "body.processaccess.desiredaccesses",
                        "operator": "contains",
                        "value": "PROCESS_VM_WRITE"
                    },
                    {
                        "field": "body.processaccess.desiredaccesses",
                        "operator": "contains",
                        "value": "PROCESS_CREATE_REMOTE_THREAD"
                    }
                ]
            },
            "s9_process_injection_handletype": {
                "event_type": "processaccess",
                "conditions": [
                    {
                        "field": "body.processaccess.handletype",
                        "operator": "equals",
                        "value": "create"
                    },
                    {
                        "field": "body.processaccess.handletype",
                        "operator": "equals",
                        "value": "duplicate"
                    }
                ]
            }
        },
        "condition": "s3_keyboard_hook_api or s4_keyboard_polling_api or (s1_keylogger_process_create and s2_keylogger_commandline_keywords) or (s5_registry_setvalue_keyclass and (s6_registry_appinit_dlls_path or s7_registry_ifeo_path)) or (s9_process_injection_handletype and s8_process_injection_access_rights)"
    },
    "operational_usage": "SOC 팀은 이 규칙을 활용하여 다단계 인증(MFA) 정보 가로채기 시도를 탐지할 수 있습니다. 키보드 후킹/폴링 API 호출, 의심스러운 키로거 프로세스 생성, AppInit_DLLs나 Image File Execution Options와 같은 레지스트리 키 조작을 통한 영속성 확보 시도, 또는 프로세스 인젝션을 위한 비정상적인 접근 권한 요청 등을 모니터링합니다. 탐지된 이벤트는 높은 심각도로 분류되어 즉각적인 알람을 트리거하고, 관련 프로세스 및 시스템 활동에 대한 추가적인 포렌식 조사를 시작하는 데 사용될 수 있습니다. 특히, 다른 자격 증명 접근 또는 방어 회피 전술과 결합될 때 중요도가 더욱 높아집니다.",
    "false_positive": "정상적인 시스템 모니터링 도구, 원격 제어 소프트웨어, 접근성 기능, 또는 합법적인 애플리케이션이 키보드 입력 또는 프로세스 메모리에 접근하는 경우 오탐이 발생할 수 있습니다. 알려진 정상적인 프로세스나 특정 명령줄 패턴을 화이트리스트에 추가하고, 특정 레지스트리 변경 사항을 허용하여 오탐을 줄일 수 있습니다."
}