{
    "id": "T1115-ClipboardData",
    "name": "Clipboard Data Collection",
    "description": "Adversaries may collect data stored in the clipboard from users copying information within or between applications. This includes using utilities like clip.exe, PowerShell cmdlets like Get-Clipboard, or direct API calls to access clipboard contents. Adversaries may also monitor and replace clipboard data.",
    "severity": "medium",
    "mitre_attack": {
        "tactic": "TA0009",
        "technique_id": "T1115",
        "subtechnique_id": "",
        "data_sources": [
            "Enterprise:Execution:Native API",
            "Enterprise:Execution:Command and Scripting Interpreter:Windows Command Shell"
        ]
    },
    "platform": [
        "windows"
    ],
    "detection": {
        "selections": {
            "s1_clip_exe_process_creation": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.action",
                        "operator": "equals",
                        "value": "create"
                    },
                    {
                        "field": "body.process.exe_path",
                        "operator": "endswith",
                        "value": "clip.exe"
                    }
                ]
            },
            "s2_powershell_get_clipboard_command": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.action",
                        "operator": "equals",
                        "value": "create"
                    },
                    {
                        "field": "body.process.exe_path",
                        "operator": "endswith",
                        "value": "powershell.exe"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "Get-Clipboard"
                    }
                ]
            },
            "s3_clipboard_api_calls": {
                "event_type": "apicall",
                "conditions": [
                    {
                        "field": "body.apicall.function",
                        "operator": "equals",
                        "value": "GetClipboardData"
                    },
                    {
                        "field": "body.apicall.function",
                        "operator": "equals",
                        "value": "OpenClipboard"
                    },
                    {
                        "field": "body.apicall.function",
                        "operator": "equals",
                        "value": "SetClipboardData"
                    },
                    {
                        "field": "body.apicall.function",
                        "operator": "equals",
                        "value": "EmptyClipboard"
                    }
                ]
            }
        },
        "condition": "s1_clip_exe_process_creation or s2_powershell_get_clipboard_command or s3_clipboard_api_calls"
    },
    "operational_usage": "SOC 팀은 이 규칙을 활용하여 시스템 클립보드 데이터 수집 시도를 탐지할 수 있습니다. 'clip.exe' 또는 PowerShell의 'Get-Clipboard' 명령 실행, 그리고 클립보드 관련 WinAPI 호출(OpenClipboard, GetClipboardData 등)을 모니터링합니다. 탐지된 이벤트는 자동 알람을 트리거하고, 추가적인 조사 및 침해사고 대응의 우선순위를 지정하는 데 사용될 수 있습니다. 특히 다른 Discovery 또는 Collection 활동과 결합될 때 중요도가 높아집니다.",
    "false_positive": "정상적인 애플리케이션(예: 텍스트 편집기, 브라우저, 개발 도구)은 클립보드에 접근하거나 데이터를 조작하는 것이 일반적이므로 오탐이 발생할 수 있습니다. 알려진 정상 프로세스나 특정 API 호출 패턴을 화이트리스트에 추가하여 오탐을 줄일 수 있습니다."
}