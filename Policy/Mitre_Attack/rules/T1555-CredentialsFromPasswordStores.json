{
    "id": "T1555-CredentialsFromPasswordStores",
    "name": "Credentials from Password Stores",
    "description": "Detects attempts by adversaries to search for common password storage locations to obtain user credentials. This includes accessing known browser credential files, password manager databases, RDP connection files, or executing tools and API calls designed for credential dumping from processes or local files.",
    "severity": "high",
    "mitre_attack": {
        "tactic": "TA0006",
        "technique_id": "T1555",
        "subtechnique_id": "",
        "data_sources": [
            "Enterprise:Credential Access:Unsecured Credentials:Credentials In Files",
            "Enterprise:Execution:Command and Scripting Interpreter:Windows Command Shell",
            "Enterprise:Credential Access:OS Credential Dumping:LSASS Memory",
            "Enterprise:Execution:Native API"
        ]
    },
    "platform": [
        "windows"
    ],
    "detection": {
        "selections": {
            "s1_process_create_action": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.action",
                        "operator": "equals",
                        "value": "create"
                    }
                ]
            },
            "s2_cmd_mimikatz": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "mimikatz.exe"
                    }
                ]
            },
            "s3_cmd_lazagne": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "lazagne.exe"
                    }
                ]
            },
            "s4_cmd_procdump": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "procdump.exe"
                    }
                ]
            },
            "s5_cmd_lsass": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "lsass.exe"
                    }
                ]
            },
            "s6_cmd_powershell": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "powershell.exe"
                    }
                ]
            },
            "s7_cmd_ps_get_cred": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "Get-Credential"
                    }
                ]
            },
            "s8_cmd_ps_export_xml": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "Export-CliXml"
                    }
                ]
            },
            "s9_cmd_ps_convert_secure": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "ConvertTo-SecureString"
                    }
                ]
            },
            "s10_cmd_ps_get_vault": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "Get-VaultCredential"
                    }
                ]
            },
            "s11_cmd_ps_get_wmi_cred": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "Get-WmiObject -Class Win32_Credential"
                    }
                ]
            },
            "s12_cmd_ps_get_cim_cred": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "Get-CimInstance -ClassName Win32_Credential"
                    }
                ]
            },
            "s13_filesystem_access_action": {
                "event_type": "filesystem",
                "conditions": [
                    {
                        "field": "body.filesystem.action",
                        "operator": "equals",
                        "value": "read"
                    },
                    {
                        "field": "body.filesystem.action",
                        "operator": "equals",
                        "value": "open"
                    },
                    {
                        "field": "body.filesystem.action",
                        "operator": "equals",
                        "value": "exists"
                    }
                ]
            },
            "s14_filepath_browser_login_data": {
                "event_type": "filesystem",
                "conditions": [
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "contains",
                        "value": "Login Data"
                    }
                ]
            },
            "s15_filepath_browser_web_data": {
                "event_type": "filesystem",
                "conditions": [
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "contains",
                        "value": "Web Data"
                    }
                ]
            },
            "s16_filepath_browser_cookies": {
                "event_type": "filesystem",
                "conditions": [
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "contains",
                        "value": "Cookies"
                    }
                ]
            },
            "s17_filepath_firefox_key4": {
                "event_type": "filesystem",
                "conditions": [
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "contains",
                        "value": "key4.db"
                    }
                ]
            },
            "s18_filepath_firefox_signons": {
                "event_type": "filesystem",
                "conditions": [
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "contains",
                        "value": "signons.sqlite"
                    }
                ]
            },
            "s19_filepath_password_manager_generic": {
                "event_type": "filesystem",
                "conditions": [
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "contains",
                        "value": "vault.dat"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "contains",
                        "value": "wallet.dat"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "contains",
                        "value": "credentials.xml"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "contains",
                        "value": "masterkey"
                    }
                ]
            },
            "s20_filepath_keepass": {
                "event_type": "filesystem",
                "conditions": [
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "contains",
                        "value": "keepass"
                    }
                ]
            },
            "s21_filepath_lastpass": {
                "event_type": "filesystem",
                "conditions": [
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "contains",
                        "value": "lastpass"
                    }
                ]
            },
            "s22_filepath_1password": {
                "event_type": "filesystem",
                "conditions": [
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "contains",
                        "value": "1password"
                    }
                ]
            },
            "s23_filepath_rdp_file": {
                "event_type": "filesystem",
                "conditions": [
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "contains",
                        "value": "Default.rdp"
                    }
                ]
            },
            "s24_filepath_rdp_cred_keyword": {
                "event_type": "filesystem",
                "conditions": [
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "contains",
                        "value": "credentials"
                    }
                ]
            },
            "s25_registry_access_action": {
                "event_type": "registry",
                "conditions": [
                    {
                        "field": "body.registry.keyclass",
                        "operator": "contains",
                        "value": "Query"
                    },
                    {
                        "field": "body.registry.keyclass",
                        "operator": "contains",
                        "value": "Open"
                    },
                    {
                        "field": "body.registry.keyclass",
                        "operator": "contains",
                        "value": "Enumerate"
                    }
                ]
            },
            "s26_reg_name_browser_vault": {
                "event_type": "registry",
                "conditions": [
                    {
                        "field": "body.registry.name",
                        "operator": "contains",
                        "value": "Software\\Microsoft\\Windows\\CurrentVersion\\Vault"
                    }
                ]
            },
            "s27_reg_name_chrome_data": {
                "event_type": "registry",
                "conditions": [
                    {
                        "field": "body.registry.name",
                        "operator": "contains",
                        "value": "Software\\Google\\Chrome\\UserData"
                    }
                ]
            },
            "s28_reg_name_firefox_profiles": {
                "event_type": "registry",
                "conditions": [
                    {
                        "field": "body.registry.name",
                        "operator": "contains",
                        "value": "Software\\Mozilla\\Firefox\\Profiles"
                    }
                ]
            },
            "s29_reg_name_wifi_profiles": {
                "event_type": "registry",
                "conditions": [
                    {
                        "field": "body.registry.name",
                        "operator": "contains",
                        "value": "SYSTEM\\CurrentControlSet\\Services\\WlanSvc\\Parameters\\Profiles"
                    }
                ]
            },
            "s30_reg_name_rdp_client": {
                "event_type": "registry",
                "conditions": [
                    {
                        "field": "body.registry.name",
                        "operator": "contains",
                        "value": "Terminal Server Client"
                    }
                ]
            },
            "s31_apicall_lsaretreive": {
                "event_type": "apicall",
                "conditions": [
                    {
                        "field": "body.apicall.function",
                        "operator": "equals",
                        "value": "LsaRetrievePrivateData"
                    }
                ]
            },
            "s32_apicall_credread": {
                "event_type": "apicall",
                "conditions": [
                    {
                        "field": "body.apicall.function",
                        "operator": "equals",
                        "value": "CredReadW"
                    },
                    {
                        "field": "body.apicall.function",
                        "operator": "equals",
                        "value": "CredReadA"
                    }
                ]
            },
            "s33_apicall_crypt_data": {
                "event_type": "apicall",
                "conditions": [
                    {
                        "field": "body.apicall.function",
                        "operator": "equals",
                        "value": "CryptProtectData"
                    },
                    {
                        "field": "body.apicall.function",
                        "operator": "equals",
                        "value": "CryptUnprotectData"
                    }
                ]
            },
            "s34_apicall_read_process_mem": {
                "event_type": "apicall",
                "conditions": [
                    {
                        "field": "body.apicall.function",
                        "operator": "equals",
                        "value": "ReadProcessMemory"
                    },
                    {
                        "field": "body.apicall.function",
                        "operator": "equals",
                        "value": "NtReadVirtualMemory"
                    }
                ]
            },
            "s35_apicall_minidump": {
                "event_type": "apicall",
                "conditions": [
                    {
                        "field": "body.apicall.function",
                        "operator": "equals",
                        "value": "MiniDumpWriteDump"
                    }
                ]
            }
        },
        "condition": "(s1_process_create_action and (s2_cmd_mimikatz or s3_cmd_lazagne or (s4_cmd_procdump and s5_cmd_lsass) or (s6_cmd_powershell and (s7_cmd_ps_get_cred or s8_cmd_ps_export_xml or s9_cmd_ps_convert_secure or s10_cmd_ps_get_vault or s11_cmd_ps_get_wmi_cred or s12_cmd_ps_get_cim_cred)))) or (s13_filesystem_access_action and (s14_filepath_browser_login_data or s15_filepath_browser_web_data or s16_filepath_browser_cookies or s17_filepath_firefox_key4 or s18_filepath_firefox_signons or s19_filepath_password_manager_generic or s20_filepath_keepass or s21_filepath_lastpass or s22_filepath_1password or (s23_filepath_rdp_file and s24_filepath_rdp_cred_keyword))) or (s25_registry_access_action and (s26_reg_name_browser_vault or s27_reg_name_chrome_data or s28_reg_name_firefox_profiles or s29_reg_name_wifi_profiles or s30_reg_name_rdp_client)) or (s31_apicall_lsaretreive or s32_apicall_credread or s33_apicall_crypt_data or s34_apicall_read_process_mem or s35_apicall_minidump)"
    },
    "operational_usage": "SOC 팀은 이 규칙을 활용하여 시스템 내에 저장된 자격 증명(비밀번호)을 수집하려는 시도를 탐지할 수 있습니다. Mimikatz, LaZagne 또는 Procdump와 같은 도구의 실행, PowerShell을 이용한 자격 증명 조작 명령, 웹 브라우저나 비밀번호 관리자 데이터베이스 파일에 대한 접근, RDP 연결 파일 열람, Wi-Fi 프로필 레지스트리 키 조회, 또는 LsaRetrievePrivateData, CredRead와 같은 민감한 API 호출 등을 모니터링합니다. 탐지된 이벤트는 높은 심각도로 분류되어 즉각적인 알람을 트리거하고, 자격 증명 접근을 시도한 프로세스 및 사용자 계정에 대한 추가적인 조사를 시작하는 데 사용됩니다.",
    "false_positive": "정상적인 시스템 관리 도구, 백업 소프트웨어, 개발자 도구, 또는 합법적인 애플리케이션이 자격 증명 관련 파일을 읽거나 API를 호출하는 경우 오탐이 발생할 수 있습니다. 예를 들어, 브라우저가 자체 로그인 데이터를 읽거나, IT 관리 도구가 사용자 프로필 정보를 수집하는 경우입니다. 알려진 정상 프로세스, 특정 파일 경로, 또는 API 호출 패턴에 대한 화이트리스트를 적용하여 오탐을 줄일 수 있습니다."
}