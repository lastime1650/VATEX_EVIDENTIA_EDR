{
    "id": "T1546.012-ImageFileExecutionOptionsInjection",
    "name": "Image File Execution Options Injection",
    "description": "Detects attempts by adversaries to establish persistence and/or elevate privileges by executing malicious content triggered via Image File Execution Options (IFEO) debuggers or Silent Process Exit monitoring. This involves modifications to specific Registry keys or the use of the 'GFlags' tool.",
    "severity": "high",
    "mitre_attack": {
        "tactic": "TA0004,TA0003",
        "technique_id": "T1546",
        "subtechnique_id": "T1546.012",
        "data_sources": [
            "Command:CommandExecution",
            "Process:ProcessCreation",
            "WindowsRegistry:WindowsRegistryKeyModification",
            "Process:OSAPIExecution"
        ]
    },
    "platform": [
        "windows"
    ],
    "detection": {
        "selections": {
            "s1_process_create_action": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.action",
                        "operator": "equals",
                        "value": "create"
                    }
                ]
            },
            "s2_gflags_exe_path": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.exe_path",
                        "operator": "endswith",
                        "value": "gflags.exe"
                    }
                ]
            },
            "s3_gflags_commandline_debugger_set": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "/p"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "/enable"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "/disable"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "/debug"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "/sih"
                    }
                ]
            },
            "s4_registry_modify_keyclass": {
                "event_type": "registry",
                "conditions": [
                    {
                        "field": "body.registry.keyclass",
                        "operator": "equals",
                        "value": "RegNtSetValueKey"
                    },
                    {
                        "field": "body.registry.keyclass",
                        "operator": "equals",
                        "value": "RegNtPreSetValueKey"
                    },
                    {
                        "field": "body.registry.keyclass",
                        "operator": "equals",
                        "value": "RegNtPostCreateKey"
                    },
                    {
                        "field": "body.registry.keyclass",
                        "operator": "equals",
                        "value": "RegNtPostCreateKeyEx"
                    },
                    {
                        "field": "body.registry.keyclass",
                        "operator": "equals",
                        "value": "RegNtPreRenameKey"
                    },
                    {
                        "field": "body.registry.keyclass",
                        "operator": "equals",
                        "value": "RegNtPostRenameKey"
                    }
                ]
            },
            "s5_registry_ifeo_path": {
                "event_type": "registry",
                "conditions": [
                    {
                        "field": "body.registry.name",
                        "operator": "startswith",
                        "value": "HKEY_LOCAL_MACHINE\\SOFTWARE\\Microsoft\\Windows NT\\CurrentVersion\\Image File Execution Options\\"
                    },
                    {
                        "field": "body.registry.name",
                        "operator": "startswith",
                        "value": "HKEY_LOCAL_MACHINE\\SOFTWARE\\Wow6432Node\\Microsoft\\Windows NT\\CurrentVersion\\Image File Execution Options\\"
                    }
                ]
            },
            "s6_registry_silentexit_path": {
                "event_type": "registry",
                "conditions": [
                    {
                        "field": "body.registry.name",
                        "operator": "startswith",
                        "value": "HKEY_LOCAL_MACHINE\\SOFTWARE\\Microsoft\\Windows NT\\CurrentVersion\\SilentProcessExit\\"
                    }
                ]
            },
            "s7_apicall_reg_write_function": {
                "event_type": "apicall",
                "conditions": [
                    {
                        "field": "body.apicall.function",
                        "operator": "equals",
                        "value": "RegCreateKeyExW"
                    },
                    {
                        "field": "body.apicall.function",
                        "operator": "equals",
                        "value": "RegCreateKeyExA"
                    },
                    {
                        "field": "body.apicall.function",
                        "operator": "equals",
                        "value": "RegSetValueExW"
                    },
                    {
                        "field": "body.apicall.function",
                        "operator": "equals",
                        "value": "RegSetValueExA"
                    }
                ]
            }
        },
        "condition": "(s1_process_create_action and s2_gflags_exe_path and s3_gflags_commandline_debugger_set) or (s4_registry_modify_keyclass and (s5_registry_ifeo_path or s6_registry_silentexit_path)) or s7_apicall_reg_write_function"
    },
    "operational_usage": "SOC 팀은 이 규칙을 활용하여 Image File Execution Options (IFEO) 또는 Silent Process Exit 기능을 악용하여 지속성 또는 권한 상승을 시도하는 행위를 탐지할 수 있습니다. GFlags.exe의 비정상적인 실행, IFEO 및 Silent Process Exit 관련 레지스트리 키에 대한 수정 시도, 또는 Registry API 호출을 모니터링합니다. 탐지된 이벤트는 높은 심각도로 분류되어 즉각적인 알람을 트리거하고, 관련 프로세스 및 레지스트리 변경에 대한 추가적인 포렌식 조사를 시작하는 데 사용될 수 있습니다.",
    "false_positive": "정상적인 시스템 관리 도구, 개발 환경 설정, 또는 특정 소프트웨어의 설치/업데이트 과정에서 IFEO 관련 레지스트리 키를 합법적으로 수정할 수 있습니다. 특히 GFlags.exe는 시스템 디버깅 및 개발 목적으로 사용될 수 있으므로, 특정 프로세스나 사용자 계정에 대한 화이트리스트를 적용하여 오탐을 줄일 수 있습니다."
}