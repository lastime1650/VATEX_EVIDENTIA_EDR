{
    "id": "T1020-AutomatedExfiltration",
    "name": "Automated Exfiltration",
    "description": "Detects attempts to exfiltrate data through automated processes. This includes monitoring for the execution of scripting interpreters, archiving utilities, or data transfer tools with command-line arguments indicative of data compression, encoding, and outbound transfer. Adversaries automate exfiltration to quickly move collected data out of a compromised environment.",
    "severity": "high",
    "mitre_attack": {
        "tactic": "TA0010",
        "technique_id": "T1020",
        "subtechnique_id": "",
        "data_sources": [
            "Enterprise:Exfiltration:Automated Exfiltration",
            "Enterprise:Execution:Command and Scripting Interpreter:Windows Command Shell",
            "Enterprise:Execution:Command and Scripting Interpreter:PowerShell",
            "Enterprise:Collection:Data from Local System",
            "Enterprise:Command and Control:Application Layer Protocol:File Transfer Protocols",
            "Enterprise:Command and Control:Application Layer Protocol:Web Protocols"
        ]
    },
    "platform": [
        "windows"
    ],
    "detection": {
        "selections": {
            "s1_process_create_action": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.action",
                        "operator": "equals",
                        "value": "create"
                    }
                ]
            },
            "s2_exe_is_script_interpreter": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.exe_path",
                        "operator": "endswith",
                        "value": "powershell.exe"
                    },
                    {
                        "field": "body.process.exe_path",
                        "operator": "endswith",
                        "value": "cmd.exe"
                    },
                    {
                        "field": "body.process.exe_path",
                        "operator": "endswith",
                        "value": "wscript.exe"
                    },
                    {
                        "field": "body.process.exe_path",
                        "operator": "endswith",
                        "value": "cscript.exe"
                    }
                ]
            },
            "s3_exe_is_archiver": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.exe_path",
                        "operator": "endswith",
                        "value": "tar.exe"
                    },
                    {
                        "field": "body.process.exe_path",
                        "operator": "endswith",
                        "value": "zip.exe"
                    },
                    {
                        "field": "body.process.exe_path",
                        "operator": "endswith",
                        "value": "7z.exe"
                    },
                    {
                        "field": "body.process.exe_path",
                        "operator": "endswith",
                        "value": "rar.exe"
                    }
                ]
            },
            "s4_exe_is_transfer_tool": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.exe_path",
                        "operator": "endswith",
                        "value": "curl.exe"
                    },
                    {
                        "field": "body.process.exe_path",
                        "operator": "endswith",
                        "value": "bitsadmin.exe"
                    },
                    {
                        "field": "body.process.exe_path",
                        "operator": "endswith",
                        "value": "certutil.exe"
                    },
                    {
                        "field": "body.process.exe_path",
                        "operator": "endswith",
                        "value": "ftp.exe"
                    },
                    {
                        "field": "body.process.exe_path",
                        "operator": "endswith",
                        "value": "sftp.exe"
                    },
                    {
                        "field": "body.process.exe_path",
                        "operator": "endswith",
                        "value": "scp.exe"
                    },
                    {
                        "field": "body.process.exe_path",
                        "operator": "endswith",
                        "value": "netcat.exe"
                    },
                    {
                        "field": "body.process.exe_path",
                        "operator": "endswith",
                        "value": "nc.exe"
                    }
                ]
            },
            "s5_cmdline_archiving_keywords": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "compress"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "archive"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": ".zip"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": ".rar"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": ".7z"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": ".tar"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "Compress-Archive"
                    }
                ]
            },
            "s6_cmdline_encoding_keywords": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "base64"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "encode"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "btoa"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "certutil -encode"
                    }
                ]
            },
            "s7_cmdline_transfer_keywords": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "upload"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "send"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "post"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "transfer"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "ftp://"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "http://"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "https://"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "sftp"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "scp"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "nc -l"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "netcat -l"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "Invoke-WebRequest"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "Invoke-RestMethod"
                    }
                ]
            }
        },
        "condition": "s1_process_create_action and (s2_exe_is_script_interpreter or s3_exe_is_archiver or s4_exe_is_transfer_tool) and (s5_cmdline_archiving_keywords or s6_cmdline_encoding_keywords or s7_cmdline_transfer_keywords)"
    },
    "operational_usage": "SOC 팀은 이 규칙을 활용하여 시스템에서 자동화된 데이터 유출 시도를 탐지할 수 있습니다. PowerShell, CMD, 압축 도구(tar, zip, 7z), 또는 네트워크 전송 도구(curl, bitsadmin, certutil, ftp, netcat)와 같은 프로세스의 생성 이벤트를 모니터링합니다. 특히, 명령줄에 데이터 압축, 인코딩, 또는 외부 전송을 지시하는 키워드(예: 'compress', 'base64', 'upload', 'http://')가 포함된 경우를 탐지합니다. 탐지된 이벤트는 높은 심각도로 분류되어 즉각적인 알람을 트리거하고, 관련 프로세스 및 네트워크 활동에 대한 추가적인 포렌식 조사를 시작하는 데 사용될 수 있습니다. 이는 데이터 유출의 초기 또는 진행 중인 단계에서 중요한 지표가 됩니다.",
    "false_positive": "정상적인 시스템 관리 스크립트, 백업 유틸리티, 소프트웨어 업데이트 프로세스, 또는 합법적인 애플리케이션이 데이터를 압축하거나 외부 서버로 전송하는 과정에서 오탐이 발생할 수 있습니다. 특히 개발 도구, CI/CD 파이프라인, 또는 클라우드 동기화 서비스에서 유사한 명령줄 패턴이 나타날 수 있습니다. 알려진 정상 프로세스, 특정 명령줄 패턴, 또는 화이트리스트에 추가하여 오탐을 줄일 수 있습니다."
}