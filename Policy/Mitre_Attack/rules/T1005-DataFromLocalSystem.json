{
    "id": "T1005-DataFromLocalSystem",
    "name": "Data from Local System",
    "description": "Detects attempts by adversaries to search local system sources, such as file systems, configuration files, local databases, or virtual machine files, to find and collect files of interest and sensitive data prior to Exfiltration. This includes using command-line interpreters or PowerShell to enumerate and access files, and direct file system read/open operations.",
    "severity": "medium",
    "mitre_attack": {
        "tactic": "TA0009",
        "technique_id": "T1005",
        "subtechnique_id": "",
        "data_sources": [
            "Enterprise:Execution:Command and Scripting Interpreter:Windows Command Shell",
            "Enterprise:Execution:Command and Scripting Interpreter:PowerShell",
            "Enterprise:Execution:Native API",
            "Enterprise:Collection:Data from Local System"
        ]
    },
    "platform": [
        "windows"
    ],
    "detection": {
        "selections": {
            "s1_process_create_action": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.action",
                        "operator": "equals",
                        "value": "create"
                    }
                ]
            },
            "s2_cmd_or_powershell_exe": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.exe_path",
                        "operator": "endswith",
                        "value": "cmd.exe"
                    },
                    {
                        "field": "body.process.exe_path",
                        "operator": "endswith",
                        "value": "powershell.exe"
                    }
                ]
            },
            "s3_cmdline_file_enumeration": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "dir"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "Get-ChildItem"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "tree"
                    }
                ]
            },
            "s4_cmdline_file_content_access": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "type "
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "more "
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "findstr"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "Get-Content"
                    }
                ]
            },
            "s5_cmdline_file_copy_move": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "copy "
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "xcopy "
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "robocopy "
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "move "
                    }
                ]
            },
            "s6_cmdline_zip_archive": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": ".zip"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": ".rar"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": ".7z"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "tar "
                    }
                ]
            },
            "s7_filesystem_read_open_action": {
                "event_type": "filesystem",
                "conditions": [
                    {
                        "field": "body.filesystem.action",
                        "operator": "equals",
                        "value": "read"
                    },
                    {
                        "field": "body.filesystem.action",
                        "operator": "equals",
                        "value": "open"
                    }
                ]
            },
            "s8_filesystem_sensitive_paths": {
                "event_type": "filesystem",
                "conditions": [
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "contains",
                        "value": "C:\\Users\\"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "contains",
                        "value": "C:\\ProgramData\\"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "contains",
                        "value": "C:\\Windows\\Temp\\"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "contains",
                        "value": "\\Documents\\"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "contains",
                        "value": "\\Downloads\\"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "contains",
                        "value": "\\Desktop\\"
                    }
                ]
            },
            "s9_filesystem_sensitive_extensions": {
                "event_type": "filesystem",
                "conditions": [
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "endswith",
                        "value": ".doc"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "endswith",
                        "value": ".docx"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "endswith",
                        "value": ".xls"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "endswith",
                        "value": ".xlsx"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "endswith",
                        "value": ".pdf"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "endswith",
                        "value": ".zip"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "endswith",
                        "value": ".rar"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "endswith",
                        "value": ".7z"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "endswith",
                        "value": ".txt"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "endswith",
                        "value": ".bak"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "endswith",
                        "value": ".config"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "endswith",
                        "value": ".log"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "endswith",
                        "value": ".db"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "endswith",
                        "value": ".sql"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "endswith",
                        "value": ".key"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "endswith",
                        "value": ".pem"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "endswith",
                        "value": ".ps1"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "endswith",
                        "value": ".bat"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "endswith",
                        "value": ".cmd"
                    }
                ]
            },
            "s10_apicall_file_enumeration": {
                "event_type": "apicall",
                "conditions": [
                    {
                        "field": "body.apicall.function",
                        "operator": "equals",
                        "value": "FindFirstFileW"
                    },
                    {
                        "field": "body.apicall.function",
                        "operator": "equals",
                        "value": "FindFirstFileA"
                    },
                    {
                        "field": "body.apicall.function",
                        "operator": "equals",
                        "value": "FindNextFileW"
                    },
                    {
                        "field": "body.apicall.function",
                        "operator": "equals",
                        "value": "FindNextFileA"
                    }
                ]
            },
            "s11_apicall_file_read": {
                "event_type": "apicall",
                "conditions": [
                    {
                        "field": "body.apicall.function",
                        "operator": "equals",
                        "value": "ReadFile"
                    },
                    {
                        "field": "body.apicall.function",
                        "operator": "equals",
                        "value": "ReadFileEx"
                    }
                ]
            }
        },
        "condition": "(s1_process_create_action and s2_cmd_or_powershell_exe and (s3_cmdline_file_enumeration or s4_cmdline_file_content_access or s5_cmdline_file_copy_move or s6_cmdline_zip_archive)) or (s7_filesystem_read_open_action and (s8_filesystem_sensitive_paths or s9_filesystem_sensitive_extensions)) or (s10_apicall_file_enumeration or s11_apicall_file_read)"
    },
    "operational_usage": "SOC 팀은 이 규칙을 활용하여 시스템 내 민감한 데이터 및 파일을 수집하려는 시도를 탐지할 수 있습니다. 'dir', 'type', 'copy', 'Get-ChildItem', 'Get-Content' 등과 같은 명령줄 유틸리티나 PowerShell 스크립트의 실행을 모니터링합니다. 또한, 일반적이지 않은 프로세스가 사용자 프로필, 임시 디렉터리, 또는 특정 민감한 확장자를 가진 파일에 대해 '읽기' 또는 '열기' 작업을 수행하는 파일 시스템 이벤트를 탐지합니다. 파일 열거 및 읽기 관련 API 호출도 모니터링 대상입니다. 탐지된 이벤트는 자동 알람을 트리거하고, 추가적인 포렌식 조사 및 침해사고 대응의 우선순위를 지정하는 데 사용될 수 있습니다. 특히, 다른 Discovery 또는 Exfiltration 활동과 결합될 때 중요도가 높아집니다.",
    "false_positive": "정상적인 시스템 관리 도구, 백업 소프트웨어, 개발 도구, 또는 합법적인 애플리케이션이 파일 시스템을 탐색하거나 파일을 읽는 과정에서 오탐이 발생할 수 있습니다. 알려진 정상 프로세스, 특정 파일 경로, 또는 명령줄 패턴을 화이트리스트에 추가하여 오탐을 줄일 수 있습니다. 예를 들어, 백신 소프트웨어의 파일 스캔, 개발 환경의 코드 빌드 프로세스, 또는 IT 관리 스크립트 등이 이에 해당할 수 있습니다."
}