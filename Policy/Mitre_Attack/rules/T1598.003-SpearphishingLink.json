{
    "id": "T1598.003-SpearphishingLink",
    "name": "Spearphishing Link Detection",
    "description": "Detects attempts to deliver spearphishing messages containing malicious links, often leveraging URL shorteners, IP-based hostnames, or @-symbol obfuscation within process command lines to trick users into divulging sensitive information. This rule focuses on the execution of browsers or script interpreters with suspicious URL patterns.",
    "severity": "high",
    "mitre_attack": {
        "tactic": "TA0007",
        "technique_id": "T1598",
        "subtechnique_id": "T1598.003",
        "data_sources": [
            "Enterprise:Execution:Command and Scripting Interpreter:Windows Command Shell",
            "Enterprise:Execution:Command and Scripting Interpreter:PowerShell",
            "Enterprise:Execution:User Execution:Malicious Link",
            "Enterprise:Command and Control:Application Layer Protocol:Web Protocols"
        ]
    },
    "platform": [
        "windows"
    ],
    "detection": {
        "selections": {
            "s1_process_create_action": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.action",
                        "operator": "equals",
                        "value": "create"
                    }
                ]
            },
            "s2_exe_is_browser_or_script_host": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.exe_path",
                        "operator": "endswith",
                        "value": "chrome.exe"
                    },
                    {
                        "field": "body.process.exe_path",
                        "operator": "endswith",
                        "value": "msedge.exe"
                    },
                    {
                        "field": "body.process.exe_path",
                        "operator": "endswith",
                        "value": "firefox.exe"
                    },
                    {
                        "field": "body.process.exe_path",
                        "operator": "endswith",
                        "value": "iexplore.exe"
                    },
                    {
                        "field": "body.process.exe_path",
                        "operator": "endswith",
                        "value": "cmd.exe"
                    },
                    {
                        "field": "body.process.exe_path",
                        "operator": "endswith",
                        "value": "powershell.exe"
                    }
                ]
            },
            "s3_cmdline_has_url_prefix": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "http://"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "https://"
                    }
                ]
            },
            "s4_cmdline_contains_url_shortener": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "bit.ly/"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "tinyurl.com/"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "goo.gl/"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "ow.ly/"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "is.gd/"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "cutt.ly/"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "rebrand.ly/"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "t.co/"
                    }
                ]
            },
            "s5_cmdline_contains_obfuscated_at_in_url": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "matches",
                        "value": "https?://[^/]+@"
                    }
                ]
            },
            "s6_cmdline_contains_ip_as_host": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "matches",
                        "value": "https?://(?:[0-9]{1,3}\\.){3}[0-9]{1,3}(?:[:/])"
                    }
                ]
            },
            "s7_cmdline_contains_obfuscated_hex_ip": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "matches",
                        "value": "https?://0x[0-9a-fA-F]{1,8}(?:[:/])"
                    }
                ]
            }
        },
        "condition": "s1_process_create_action and s2_exe_is_browser_or_script_host and s3_cmdline_has_url_prefix and (s4_cmdline_contains_url_shortener or s5_cmdline_contains_obfuscated_at_in_url or s6_cmdline_contains_ip_as_host or s7_cmdline_contains_obfuscated_hex_ip)"
    },
    "operational_usage": "SOC 팀은 이 규칙을 활용하여 스피어 피싱 링크를 통한 초기 접근 시도를 탐지할 수 있습니다. 웹 브라우저나 스크립트 인터프리터(cmd, PowerShell)의 프로세스 생성 이벤트를 모니터링하며, 명령줄에 포함된 URL에서 단축 URL, '@' 기호가 포함된 난독화된 URL, 또는 직접 IP 주소를 사용하는 URL 패턴을 탐지합니다. 탐지된 이벤트는 높은 심각도로 분류되어 즉각적인 알람을 트리거하고, 해당 프로세스 및 관련 네트워크 활동에 대한 심층적인 포렌식 조사를 시작하는 데 사용될 수 있습니다. 특히, 다른 Discovery 또는 Execution 활동과 결합될 때 중요도가 더욱 높아집니다.",
    "false_positive": "정상적인 URL 단축 서비스, 내부망에서 IP 주소를 직접 사용하는 웹 애플리케이션, 또는 특정 개발/테스트 환경에서 난독화된 URL을 사용하는 경우 오탐이 발생할 수 있습니다. 알려진 정상적인 프로세스나 특정 명령줄 패턴을 화이트리스트에 추가하여 오탐을 줄일 수 있습니다."
}