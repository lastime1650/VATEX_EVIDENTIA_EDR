{
    "id": "T1565-DataManipulation",
    "name": "Data Manipulation",
    "description": "Detects attempts by adversaries to insert, delete, or modify data on the system, including critical files, registry keys, or through specific API calls, to influence outcomes or hide activity, thus threatening the integrity of the data.",
    "severity": "high",
    "mitre_attack": {
        "tactic": "TA0008",
        "technique_id": "T1565",
        "subtechnique_id": "",
        "data_sources": [
            "Process:OSAPIExecution",
            "NetworkTraffic:NetworkTrafficContent",
            "File:FileCreation",
            "NetworkTraffic:NetworkTrafficFlow",
            "File:FileDeletion",
            "File:FileModification",
            "File:FileMetadata"
        ]
    },
    "platform": [
        "windows"
    ],
    "detection": {
        "selections": {
            "s1_file_modify_actions": {
                "event_type": "filesystem",
                "conditions": [
                    {
                        "field": "body.filesystem.action",
                        "operator": "equals",
                        "value": "write"
                    },
                    {
                        "field": "body.filesystem.action",
                        "operator": "equals",
                        "value": "overwritten"
                    },
                    {
                        "field": "body.filesystem.action",
                        "operator": "equals",
                        "value": "superseded"
                    },
                    {
                        "field": "body.filesystem.action",
                        "operator": "equals",
                        "value": "remove"
                    },
                    {
                        "field": "body.filesystem.action",
                        "operator": "equals",
                        "value": "rename"
                    }
                ]
            },
            "s2_critical_system_file_paths": {
                "event_type": "filesystem",
                "conditions": [
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "contains",
                        "value": "C:\\Windows\\System32\\"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "contains",
                        "value": "C:\\Windows\\SysWOW64\\"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "contains",
                        "value": "C:\\Windows\\System\\"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "contains",
                        "value": "C:\\Program Files\\"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "contains",
                        "value": "C:\\Program Files (x86)\\"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "contains",
                        "value": "C:\\Users\\Public\\"
                    }
                ]
            },
            "s3_critical_file_extensions": {
                "event_type": "filesystem",
                "conditions": [
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "endswith",
                        "value": ".exe"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "endswith",
                        "value": ".dll"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "endswith",
                        "value": ".sys"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "endswith",
                        "value": ".ini"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "endswith",
                        "value": ".config"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "endswith",
                        "value": ".dat"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "endswith",
                        "value": ".json"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "endswith",
                        "value": ".xml"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "endswith",
                        "value": ".db"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "endswith",
                        "value": ".mdf"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "endswith",
                        "value": ".ldf"
                    }
                ]
            },
            "s4_specific_critical_files": {
                "event_type": "filesystem",
                "conditions": [
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "contains",
                        "value": "\\hosts"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "contains",
                        "value": "\\boot.ini"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "contains",
                        "value": "\\win.ini"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "contains",
                        "value": "\\system.ini"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "contains",
                        "value": "\\sam"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "contains",
                        "value": "\\security"
                    }
                ]
            },
            "s5_registry_modify_actions": {
                "event_type": "registry",
                "conditions": [
                    {
                        "field": "body.registry.keyclass",
                        "operator": "equals",
                        "value": "RegNtSetValueKey"
                    },
                    {
                        "field": "body.registry.keyclass",
                        "operator": "equals",
                        "value": "RegNtDeleteKey"
                    },
                    {
                        "field": "body.registry.keyclass",
                        "operator": "equals",
                        "value": "RegNtRenameKey"
                    },
                    {
                        "field": "body.registry.keyclass",
                        "operator": "equals",
                        "value": "RegNtSetInformationKey"
                    }
                ]
            },
            "s6_critical_registry_paths": {
                "event_type": "registry",
                "conditions": [
                    {
                        "field": "body.registry.name",
                        "operator": "startswith",
                        "value": "HKEY_LOCAL_MACHINE\\SYSTEM\\CurrentControlSet\\"
                    },
                    {
                        "field": "body.registry.name",
                        "operator": "startswith",
                        "value": "HKEY_LOCAL_MACHINE\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\"
                    },
                    {
                        "field": "body.registry.name",
                        "operator": "startswith",
                        "value": "HKEY_LOCAL_MACHINE\\SECURITY"
                    },
                    {
                        "field": "body.registry.name",
                        "operator": "startswith",
                        "value": "HKEY_LOCAL_MACHINE\\SAM"
                    },
                    {
                        "field": "body.registry.name",
                        "operator": "startswith",
                        "value": "HKEY_LOCAL_MACHINE\\BCD00000000\\"
                    }
                ]
            },
            "s7_api_data_write_functions": {
                "event_type": "apicall",
                "conditions": [
                    {
                        "field": "body.apicall.function",
                        "operator": "equals",
                        "value": "WriteFile"
                    },
                    {
                        "field": "body.apicall.function",
                        "operator": "equals",
                        "value": "NtWriteFile"
                    },
                    {
                        "field": "body.apicall.function",
                        "operator": "equals",
                        "value": "RegSetValueExW"
                    },
                    {
                        "field": "body.apicall.function",
                        "operator": "equals",
                        "value": "RegSetValueExA"
                    },
                    {
                        "field": "body.apicall.function",
                        "operator": "equals",
                        "value": "DeleteFileW"
                    },
                    {
                        "field": "body.apicall.function",
                        "operator": "equals",
                        "value": "DeleteFileA"
                    },
                    {
                        "field": "body.apicall.function",
                        "operator": "equals",
                        "value": "MoveFileW"
                    },
                    {
                        "field": "body.apicall.function",
                        "operator": "equals",
                        "value": "MoveFileA"
                    }
                ]
            }
        },
        "condition": "(s1_file_modify_actions and (s2_critical_system_file_paths or s3_critical_file_extensions or s4_specific_critical_files)) or (s5_registry_modify_actions and s6_critical_registry_paths) or s7_api_data_write_functions"
    },
    "operational_usage": "SOC 팀은 이 규칙을 활용하여 시스템 데이터 무결성을 위협하는 데이터 조작 시도를 탐지할 수 있습니다. 이는 중요한 시스템 파일 및 레지스트리 키에 대한 쓰기, 수정, 삭제, 이름 변경과 같은 변경 행위와 데이터 조작과 관련된 특정 API 호출을 모니터링합니다. 탐지된 이벤트는 높은 심각도로 분류되어 즉각적인 알람을 트리거하고, 관련 프로세스 및 사용자 활동에 대한 심층적인 조사를 시작하여 악의적인 의도를 판단하는 데 사용될 수 있습니다. 이 규칙은 데이터 무결성 공격으로부터 시스템을 보호하고 핵심 시스템 구성 요소의 신뢰성을 보장하는 데 필수적입니다.",
    "false_positive": "정상적인 시스템 업데이트, 소프트웨어 설치 프로그램, 패치 관리 도구, 백업 솔루션, 또는 관리 스크립트가 시스템 파일이나 레지스트리 키를 수정하거나 데이터 조작 API를 사용하는 경우 오탐이 발생할 수 있습니다. 알려진 합법적인 프로세스, 파일 경로, 또는 레지스트리 키를 화이트리스트에 추가하여 오탐을 줄일 수 있습니다."
}