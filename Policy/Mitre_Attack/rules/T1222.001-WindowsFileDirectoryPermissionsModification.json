{
    "id": "T1222.001-WindowsFileDirectoryPermissionsModification",
    "name": "Windows File and Directory Permissions Modification",
    "description": "Detects attempts to modify file or directory permissions/attributes on Windows systems to evade access control lists (ACLs) or gain unauthorized access. This includes the execution of built-in commands like 'icacls', 'cacls', 'takeown', 'attrib', and PowerShell cmdlets such as 'Set-Acl' to change Discretionary Access Control Lists (DACLs).",
    "severity": "high",
    "mitre_attack": {
        "tactic": "TA0005",
        "technique_id": "T1222",
        "subtechnique_id": "T1222.001",
        "data_sources": [
            "Enterprise:Execution:Command and Scripting Interpreter:Windows Command Shell",
            "Enterprise:Execution:Command and Scripting Interpreter:PowerShell",
            "Enterprise:Process:Process Creation",
            "Enterprise:Defense Evasion:File and Directory Permissions Modification"
        ]
    },
    "platform": [
        "windows"
    ],
    "detection": {
        "selections": {
            "s1_process_create_action": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.action",
                        "operator": "equals",
                        "value": "create"
                    }
                ]
            },
            "s2_icacls_tool": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "icacls.exe"
                    }
                ]
            },
            "s3_icacls_perms_arg": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "/grant"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "/setowner"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "/inheritance"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "/deny"
                    }
                ]
            },
            "s4_cacls_tool": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "cacls.exe"
                    }
                ]
            },
            "s5_cacls_perms_arg": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "/g"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "/e"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "/p"
                    }
                ]
            },
            "s6_takeown_tool": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "takeown.exe"
                    }
                ]
            },
            "s7_takeown_perms_arg": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "/f"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "/a"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "/r"
                    }
                ]
            },
            "s8_attrib_tool": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "attrib.exe"
                    }
                ]
            },
            "s9_attrib_perms_arg": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "+h"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "-h"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "+r"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "-r"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "+s"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "-s"
                    }
                ]
            },
            "s10_powershell_tool": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "powershell.exe"
                    }
                ]
            },
            "s11_powershell_setacl_cmdlet": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "Set-Acl"
                    }
                ]
            },
            "s12_fs_action_modify_metadata": {
                "event_type": "filesystem",
                "conditions": [
                    {
                        "field": "body.filesystem.action",
                        "operator": "equals",
                        "value": "write"
                    },
                    {
                        "field": "body.filesystem.action",
                        "operator": "equals",
                        "value": "overwritten"
                    },
                    {
                        "field": "body.filesystem.action",
                        "operator": "equals",
                        "value": "superseded"
                    }
                ]
            },
            "s13_fs_critical_path_target": {
                "event_type": "filesystem",
                "conditions": [
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "startswith",
                        "value": "C:\\Windows\\"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "startswith",
                        "value": "C:\\Program Files\\"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "startswith",
                        "value": "C:\\Program Files (x86)\\"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "contains",
                        "value": "\\Drivers\\"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "contains",
                        "value": "\\System32\\"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "contains",
                        "value": "\\SysWOW64\\"
                    }
                ]
            }
        },
        "condition": "(s1_process_create_action and ((s2_icacls_tool and s3_icacls_perms_arg) or (s4_cacls_tool and s5_cacls_perms_arg) or (s6_takeown_tool and s7_takeown_perms_arg) or (s8_attrib_tool and s9_attrib_perms_arg) or (s10_powershell_tool and s11_powershell_setacl_cmdlet))) or (s12_fs_action_modify_metadata and s13_fs_critical_path_target)"
    },
    "operational_usage": "SOC 팀은 이 규칙을 활용하여 Windows 시스템에서 파일 및 디렉터리 권한 변경 시도를 탐지할 수 있습니다. 'icacls', 'cacls', 'takeown', 'attrib'와 같은 시스템 유틸리티의 실행 또는 PowerShell 'Set-Acl' cmdlet 사용을 모니터링합니다. 탐지된 이벤트는 높은 심각도로 분류되어 즉각적인 알람을 트리거하고, 변경된 파일이나 디렉터리, 관련 프로세스에 대한 추가적인 포렌식 조사를 시작하는 데 사용될 수 있습니다. 특히, 중요한 시스템 파일이나 실행 파일의 권한 변경은 방어 회피 및 권한 상승의 초기 지표가 될 수 있으므로 우선순위를 높여 대응해야 합니다.",
    "false_positive": "정상적인 시스템 관리 작업, 소프트웨어 설치 및 업데이트, 백업 솔루션, 또는 합법적인 보안 도구가 파일 및 디렉터리 권한을 변경할 때 오탐이 발생할 수 있습니다. 알려진 정상 프로세스나 특정 명령줄 패턴, 또는 특정 경로에 대한 화이트리스트를 적용하여 오탐을 줄일 수 있습니다."
}