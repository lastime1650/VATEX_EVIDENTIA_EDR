{
    "id": "T1560-ArchiveCollectedData",
    "name": "Archive Collected Data",
    "description": "Detects attempts by an adversary to compress and/or encrypt data collected prior to exfiltration. This technique helps obfuscate the collected data and minimize the amount of data sent over the network. Encryption can further hide information from detection or make exfiltration less conspicuous. Both compression and encryption are performed before exfiltration, using utilities, 3rd party libraries, or custom methods.",
    "severity": "high",
    "mitre_attack": {
        "tactic": "TA0009",
        "technique_id": "T1560",
        "subtechnique_id": "",
        "data_sources": [
            "Process:ProcessCreation",
            "Enterprise:Execution:Command and Scripting Interpreter:Windows Command Shell",
            "Enterprise:Execution:Command and Scripting Interpreter:PowerShell",
            "Enterprise:Defense Evasion:Shared Modules",
            "Enterprise:Collection:Data from Local System",
            "Enterprise:Defense Evasion:Obfuscated Files or Information:Compression",
            "Enterprise:Defense Evasion:Obfuscated Files or Information:Encrypted/Encoded File"
        ]
    },
    "platform": [
        "windows",
        "linux",
        "macos"
    ],
    "detection": {
        "selections": {
            "s1_process_action_create": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.action",
                        "operator": "equals",
                        "value": "create"
                    }
                ]
            },
            "s2_archiver_exe_path": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.exe_path",
                        "operator": "contains",
                        "value": "7z.exe"
                    },
                    {
                        "field": "body.process.exe_path",
                        "operator": "contains",
                        "value": "winrar.exe"
                    },
                    {
                        "field": "body.process.exe_path",
                        "operator": "contains",
                        "value": "zip.exe"
                    },
                    {
                        "field": "body.process.exe_path",
                        "operator": "contains",
                        "value": "tar.exe"
                    },
                    {
                        "field": "body.process.exe_path",
                        "operator": "contains",
                        "value": "rar.exe"
                    },
                    {
                        "field": "body.process.exe_path",
                        "operator": "contains",
                        "value": "certutil.exe"
                    },
                    {
                        "field": "body.process.exe_path",
                        "operator": "contains",
                        "value": "makecab.exe"
                    },
                    {
                        "field": "body.process.exe_path",
                        "operator": "contains",
                        "value": "compact.exe"
                    },
                    {
                        "field": "body.process.exe_path",
                        "operator": "contains",
                        "value": "cipher.exe"
                    },
                    {
                        "field": "body.process.exe_path",
                        "operator": "contains",
                        "value": "esentutl.exe"
                    }
                ]
            },
            "s3_archiver_cmdline_args": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": " a "
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": " -p"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": " -m"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": " -sdel"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": " -sfx"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": " -hp"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": " -k "
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": " -mx="
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": " -ep1"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": " -t"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": " -e "
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": " -encode"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": " /c "
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": " /e "
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": " /a "
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": " /y "
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "copy "
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "move "
                    }
                ]
            },
            "s4_dll_crypt32_load": {
                "event_type": "imageload",
                "conditions": [
                    {
                        "field": "body.imageload.filepath",
                        "operator": "contains",
                        "value": "crypt32.dll"
                    }
                ]
            },
            "s5_filesystem_action_create_or_write": {
                "event_type": "filesystem",
                "conditions": [
                    {
                        "field": "body.filesystem.action",
                        "operator": "equals",
                        "value": "create"
                    },
                    {
                        "field": "body.filesystem.action",
                        "operator": "equals",
                        "value": "overwritten"
                    },
                    {
                        "field": "body.filesystem.action",
                        "operator": "equals",
                        "value": "write"
                    }
                ]
            },
            "s6_filesystem_archive_extension": {
                "event_type": "filesystem",
                "conditions": [
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "endswith",
                        "value": ".zip"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "endswith",
                        "value": ".rar"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "endswith",
                        "value": ".7z"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "endswith",
                        "value": ".tar"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "endswith",
                        "value": ".gz"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "endswith",
                        "value": ".bz2"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "endswith",
                        "value": ".xz"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "endswith",
                        "value": ".iso"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "endswith",
                        "value": ".cab"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "endswith",
                        "value": ".enc"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "endswith",
                        "value": ".aes"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "endswith",
                        "value": ".gpg"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "endswith",
                        "value": ".pgp"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "endswith",
                        "value": ".dat"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "endswith",
                        "value": ".bin"
                    }
                ]
            }
        },
        "condition": "(s1_process_action_create and s2_archiver_exe_path and s3_archiver_cmdline_args) or s4_dll_crypt32_load or (s5_filesystem_action_create_or_write and s6_filesystem_archive_extension)"
    },
    "operational_usage": "SOC 팀은 이 규칙을 활용하여 시스템에서 수집된 데이터를 압축 또는 암호화하려는 시도를 탐지할 수 있습니다. 7-Zip, WinRAR, certutil 등과 같은 아카이빙 및 암호화 도구의 프로세스 생성 이벤트와 함께 의심스러운 명령줄 인자를 모니터링합니다. 또한, crypt32.dll 로드 이벤트나 특정 압축/암호화 파일 확장자를 가진 파일의 생성 또는 쓰기 활동을 탐지합니다. 탐지된 이벤트는 높은 심각도로 분류되어 즉각적인 알람을 트리거하고, 관련 프로세스, 명령줄, 생성된 파일에 대한 추가적인 조사를 시작하여 침해사고 대응의 우선순위를 지정하는 데 사용될 수 있습니다.",
    "false_positive": "정상적인 시스템 백업 프로세스, 소프트웨어 설치 프로그램, 업데이트 유틸리티, 또는 합법적인 사용자 아카이빙 활동으로 인해 오탐이 발생할 수 있습니다. 알려진 정상 프로세스나 특정 파일 경로에 대해 화이트리스트를 적용하여 오탐을 줄일 수 있습니다. 특히, .dat, .bin과 같은 일반적인 확장자는 오탐률이 높을 수 있으므로 추가적인 컨텍스트 분석이 필요합니다."
}