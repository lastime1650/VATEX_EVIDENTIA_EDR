{
    "id": "T1587.002-SelfSignedCertificates",
    "name": "Creation or Installation of Self-Signed Code Signing Certificates",
    "description": "Detects attempts to create or install self-signed code signing certificates on an endpoint, or related activities that adversaries might use for defense evasion or persistence. This includes the use of utilities like 'makecert.exe', 'certutil.exe', 'certreq.exe', 'mmc.exe' with 'certmgr.msc', specific registry modifications to certificate trust stores, or API calls for certificate installation.",
    "severity": "high",
    "mitre_attack": {
        "tactic": "TA0002",
        "technique_id": "T1587",
        "subtechnique_id": "T1587.002",
        "data_sources": [
            "Enterprise:Execution:Command and Scripting Interpreter:Windows Command Shell",
            "Enterprise:Persistence:Modify Registry",
            "Enterprise:Defense Evasion:Subvert Trust Controls:Install Root Certificate",
            "Enterprise:Execution:Native API"
        ]
    },
    "platform": [
        "windows"
    ],
    "detection": {
        "selections": {
            "s1_process_create_action": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.action",
                        "operator": "equals",
                        "value": "create"
                    }
                ]
            },
            "s2_makecert_exe_path": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.exe_path",
                        "operator": "endswith",
                        "value": "makecert.exe"
                    }
                ]
            },
            "s3_certutil_exe_path": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.exe_path",
                        "operator": "endswith",
                        "value": "certutil.exe"
                    }
                ]
            },
            "s4_certutil_addstore_cmdline": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "-addstore"
                    }
                ]
            },
            "s5_certutil_trusted_store_cmdline": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "Root"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "TrustedPublisher"
                    }
                ]
            },
            "s6_certreq_exe_path": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.exe_path",
                        "operator": "endswith",
                        "value": "certreq.exe"
                    }
                ]
            },
            "s7_certreq_accept_cmdline": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "-accept"
                    }
                ]
            },
            "s8_mmc_exe_path": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.exe_path",
                        "operator": "endswith",
                        "value": "mmc.exe"
                    }
                ]
            },
            "s9_mmc_certmgr_cmdline": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "certmgr.msc"
                    }
                ]
            },
            "s10_reg_mod_action": {
                "event_type": "registry",
                "conditions": [
                    {
                        "field": "body.registry.keyclass",
                        "operator": "equals",
                        "value": "RegNtSetValueKey"
                    },
                    {
                        "field": "body.registry.keyclass",
                        "operator": "equals",
                        "value": "RegNtPostSetValueKey"
                    },
                    {
                        "field": "body.registry.keyclass",
                        "operator": "equals",
                        "value": "RegNtPreCreateKey"
                    },
                    {
                        "field": "body.registry.keyclass",
                        "operator": "equals",
                        "value": "RegNtPostCreateKey"
                    },
                    {
                        "field": "body.registry.keyclass",
                        "operator": "equals",
                        "value": "RegNtPreCreateKeyEx"
                    },
                    {
                        "field": "body.registry.keyclass",
                        "operator": "equals",
                        "value": "RegNtPostCreateKeyEx"
                    }
                ]
            },
            "s11_reg_cert_paths": {
                "event_type": "registry",
                "conditions": [
                    {
                        "field": "body.registry.name",
                        "operator": "startswith",
                        "value": "HKEY_LOCAL_MACHINE\\SOFTWARE\\Microsoft\\SystemCertificates\\ROOT\\Certificates"
                    },
                    {
                        "field": "body.registry.name",
                        "operator": "startswith",
                        "value": "HKEY_LOCAL_MACHINE\\SOFTWARE\\Microsoft\\SystemCertificates\\TrustedPublisher\\Certificates"
                    }
                ]
            },
            "s12_api_cert_add_functions": {
                "event_type": "apicall",
                "conditions": [
                    {
                        "field": "body.apicall.function",
                        "operator": "equals",
                        "value": "CertAddCertificateContextToStore"
                    },
                    {
                        "field": "body.apicall.function",
                        "operator": "equals",
                        "value": "CertInstallCertificateFromBlob"
                    },
                    {
                        "field": "body.apicall.function",
                        "operator": "equals",
                        "value": "CertAddEncodedCertificateToStore"
                    }
                ]
            }
        },
        "condition": "(s1_process_create_action and s2_makecert_exe_path) or (s1_process_create_action and s3_certutil_exe_path and s4_certutil_addstore_cmdline and s5_certutil_trusted_store_cmdline) or (s1_process_create_action and s6_certreq_exe_path and s7_certreq_accept_cmdline) or (s1_process_create_action and s8_mmc_exe_path and s9_mmc_certmgr_cmdline) or (s10_reg_mod_action and s11_reg_cert_paths) or s12_api_cert_add_functions"
    },
    "operational_usage": "SOC 팀은 이 규칙을 활용하여 시스템에서 자가 서명 코드 서명 인증서의 생성 또는 설치 시도를 탐지할 수 있습니다. 'makecert.exe'와 같은 인증서 생성 도구, 'certutil.exe'나 'certreq.exe'를 이용한 인증서 저장소 추가/설치, 'mmc.exe'를 통한 인증서 관리 스냅인 실행, 신뢰할 수 있는 루트 인증서 저장소에 대한 레지스트리 변경, 또는 인증서 추가 관련 API 호출 등을 모니터링합니다. 탐지된 이벤트는 높은 심각도로 분류되어 즉각적인 알람을 트리거하고, 해당 프로세스, 사용자, 그리고 관련된 파일에 대한 추가적인 포렌식 조사를 시작하는 데 사용될 수 있습니다. 특히, 방어 회피 및 권한 상승과 같은 다른 공격 전술과 결합될 때 중요도가 더욱 높아집니다.",
    "false_positive": "정상적인 소프트웨어 개발 활동, 시스템 관리자의 인증서 관리 작업, 또는 특정 엔터프라이즈 애플리케이션의 설치/업데이트 프로세스에서 자가 서명 인증서를 생성하거나 설치할 수 있습니다. 알려진 정상적인 프로세스나 특정 명령줄 패턴을 화이트리스트에 추가하여 오탐을 줄일 수 있습니다."
}