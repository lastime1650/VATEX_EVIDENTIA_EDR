{
    "id": "T1657-FinancialTheft",
    "name": "Financial Theft",
    "description": "Detects activities associated with financial theft, including ransomware precursors like shadow copy deletion, attempts to create administrative accounts for unauthorized access, access to cryptocurrency wallet files, or suspicious access to LSA secrets for credential dumping. This technique aims at monetary gain through various methods such as extortion, fraud, or direct theft.",
    "severity": "high",
    "mitre_attack": {
        "tactic": "TA0011",
        "technique_id": "T1657",
        "subtechnique_id": "",
        "data_sources": [
            "Enterprise:Impact:Data Encrypted for Impact",
            "Enterprise:Persistence:Account Manipulation:Additional Local or Domain Groups",
            "Enterprise:Credential Access:OS Credential Dumping:LSA Secrets",
            "Enterprise:Collection:Data from Local System",
            "Enterprise:Execution:Command and Scripting Interpreter:Windows Command Shell",
            "Enterprise:Execution:Native API",
            "Enterprise:Discovery:File and Directory Discovery"
        ]
    },
    "platform": [
        "windows"
    ],
    "detection": {
        "selections": {
            "s1_process_create_action": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.action",
                        "operator": "equals",
                        "value": "create"
                    }
                ]
            },
            "s2_cmdline_vssadmin": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "vssadmin.exe"
                    }
                ]
            },
            "s3_cmdline_delete_shadows": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "delete shadows"
                    }
                ]
            },
            "s4_cmdline_wmic": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "wmic"
                    }
                ]
            },
            "s5_cmdline_shadowcopy_delete": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "shadowcopy delete"
                    }
                ]
            },
            "s6_cmdline_net_user_add": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "net user"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "/add"
                    }
                ]
            },
            "s7_cmdline_net_localgroup_admin_add": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "net localgroup administrators"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "/add"
                    }
                ]
            },
            "s8_filesystem_action_read_write_open": {
                "event_type": "filesystem",
                "conditions": [
                    {
                        "field": "body.filesystem.action",
                        "operator": "equals",
                        "value": "read"
                    },
                    {
                        "field": "body.filesystem.action",
                        "operator": "equals",
                        "value": "write"
                    },
                    {
                        "field": "body.filesystem.action",
                        "operator": "equals",
                        "value": "open"
                    }
                ]
            },
            "s9_filesystem_crypto_wallet_paths": {
                "event_type": "filesystem",
                "conditions": [
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "contains",
                        "value": "wallet.dat"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "contains",
                        "value": "keystore"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "contains",
                        "value": "\\Bitcoin\\wallets\\"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "contains",
                        "value": "\\Ethereum\\keystore\\"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "contains",
                        "value": "\\Litecoin\\wallets\\"
                    }
                ]
            },
            "s10_registry_action_query_open_enum": {
                "event_type": "registry",
                "conditions": [
                    {
                        "field": "body.registry.keyclass",
                        "operator": "contains",
                        "value": "QueryKey"
                    },
                    {
                        "field": "body.registry.keyclass",
                        "operator": "contains",
                        "value": "OpenKey"
                    },
                    {
                        "field": "body.registry.keyclass",
                        "operator": "contains",
                        "value": "EnumerateKey"
                    }
                ]
            },
            "s11_registry_lsa_secrets_paths": {
                "event_type": "registry",
                "conditions": [
                    {
                        "field": "body.registry.name",
                        "operator": "startswith",
                        "value": "HKEY_LOCAL_MACHINE\\SECURITY\\Policy\\Secrets"
                    },
                    {
                        "field": "body.registry.name",
                        "operator": "startswith",
                        "value": "HKEY_LOCAL_MACHINE\\SYSTEM\\CurrentControlSet\\Control\\Lsa"
                    }
                ]
            },
            "s12_apicall_lsa_retrieve_private_data": {
                "event_type": "apicall",
                "conditions": [
                    {
                        "field": "body.apicall.function",
                        "operator": "equals",
                        "value": "LsaRetrievePrivateData"
                    }
                ]
            }
        },
        "condition": "(s1_process_create_action and s2_cmdline_vssadmin and s3_cmdline_delete_shadows) or (s1_process_create_action and s4_cmdline_wmic and s5_cmdline_shadowcopy_delete) or (s1_process_create_action and s6_cmdline_net_user_add) or (s1_process_create_action and s7_cmdline_net_localgroup_admin_add) or (s8_filesystem_action_read_write_open and s9_filesystem_crypto_wallet_paths) or (s10_registry_action_query_open_enum and s11_registry_lsa_secrets_paths) or s12_apicall_lsa_retrieve_private_data"
    },
    "operational_usage": "SOC 팀은 이 규칙을 활용하여 금융 탈취로 이어질 수 있는 다양한 악성 행위를 탐지할 수 있습니다. 여기에는 랜섬웨어 공격의 전조인 섀도 복사본 삭제 시도, 무단 접근을 위한 관리자 계정 생성, 암호화폐 지갑 파일 접근, 또는 자격 증명 덤프를 위한 LSA 비밀 키 접근 시도 등이 포함됩니다. 탐지된 이벤트는 높은 심각도로 분류되어 즉각적인 알람을 트리거하고, 관련 프로세스, 파일, 레지스트리 및 API 호출에 대한 심층적인 포렌식 조사를 시작하는 데 사용될 수 있습니다. 특히, 다른 초기 접근, 방어 회피 또는 지속성 전술과 결합될 때 중요도가 더욱 높아집니다.",
    "false_positive": "정상적인 시스템 관리 도구, 백업 솔루션, 보안 소프트웨어, 또는 합법적인 애플리케이션이 섀도 복사본을 관리하거나, 사용자 계정을 생성/수정하거나, 특정 파일이나 레지스트리 키에 접근하는 경우 오탐이 발생할 수 있습니다. 알려진 정상 프로세스, 특정 명령줄 패턴, 또는 특정 파일 경로에 대해 화이트리스트를 적용하여 오탐을 줄일 수 있습니다. 또한, LsaRetrievePrivateData API는 합법적인 시스템 구성 요소나 인증 프로세스에서도 사용될 수 있으므로 추가적인 컨텍스트 분석이 필요합니다."
}