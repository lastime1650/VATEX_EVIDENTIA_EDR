{
    "id": "T1133-ExternalRemoteServices",
    "name": "External Remote Services Access",
    "description": "Detects attempts by adversaries to leverage external-facing remote services (such as RDP, SSH, VNC, WinRM, or Citrix) for initial access or persistence within a network. This includes monitoring for network connections to common remote service ports and the execution of associated client or server applications.",
    "severity": "high",
    "mitre_attack": {
        "tactic": "TA0001,TA0003",
        "technique_id": "T1133",
        "subtechnique_id": "",
        "data_sources": [
            "NetworkTraffic:NetworkConnectionCreation",
            "NetworkTraffic:NetworkTrafficFlow",
            "LogonSession:LogonSessionMetadata",
            "ApplicationLog:ApplicationLogContent",
            "NetworkTraffic:NetworkTrafficContent"
        ]
    },
    "platform": [
        "windows"
    ],
    "detection": {
        "selections": {
            "s_net_common_outbound_tcp": {
                "event_type": "network",
                "conditions": [
                    {
                        "field": "body.network.protocol",
                        "operator": "equals",
                        "value": "TCP"
                    },
                    {
                        "field": "body.network.direction",
                        "operator": "equals",
                        "value": "out"
                    }
                ]
            },
            "s_net_rdp_port": {
                "event_type": "network",
                "conditions": [
                    {
                        "field": "body.network.destinationport",
                        "operator": "equals",
                        "value": 3389
                    }
                ]
            },
            "s_net_ssh_port": {
                "event_type": "network",
                "conditions": [
                    {
                        "field": "body.network.destinationport",
                        "operator": "equals",
                        "value": 22
                    }
                ]
            },
            "s_net_vnc_ports": {
                "event_type": "network",
                "conditions": [
                    {
                        "field": "body.network.destinationport",
                        "operator": "equals",
                        "value": 5900
                    },
                    {
                        "field": "body.network.destinationport",
                        "operator": "equals",
                        "value": 5901
                    },
                    {
                        "field": "body.network.destinationport",
                        "operator": "equals",
                        "value": 5902
                    },
                    {
                        "field": "body.network.destinationport",
                        "operator": "equals",
                        "value": 5800
                    },
                    {
                        "field": "body.network.destinationport",
                        "operator": "equals",
                        "value": 5801
                    },
                    {
                        "field": "body.network.destinationport",
                        "operator": "equals",
                        "value": 5802
                    }
                ]
            },
            "s_net_winrm_ports": {
                "event_type": "network",
                "conditions": [
                    {
                        "field": "body.network.destinationport",
                        "operator": "equals",
                        "value": 5985
                    },
                    {
                        "field": "body.network.destinationport",
                        "operator": "equals",
                        "value": 5986
                    }
                ]
            },
            "s_net_smb_port": {
                "event_type": "network",
                "conditions": [
                    {
                        "field": "body.network.destinationport",
                        "operator": "equals",
                        "value": 445
                    }
                ]
            },
            "s_proc_create_action": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.action",
                        "operator": "equals",
                        "value": "create"
                    }
                ]
            },
            "s_proc_mstsc_exe": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.exe_path",
                        "operator": "endswith",
                        "value": "mstsc.exe"
                    }
                ]
            },
            "s_proc_ssh_exe": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.exe_path",
                        "operator": "endswith",
                        "value": "ssh.exe"
                    }
                ]
            },
            "s_proc_vnc_client_exe": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.exe_path",
                        "operator": "contains",
                        "value": "vncviewer.exe"
                    },
                    {
                        "field": "body.process.exe_path",
                        "operator": "contains",
                        "value": "winvnc.exe"
                    }
                ]
            },
            "s_proc_winrm_cmdline_keywords": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "winrm"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "Invoke-Command"
                    }
                ]
            },
            "s_proc_citrix_client_exe": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.exe_path",
                        "operator": "endswith",
                        "value": "wfica32.exe"
                    }
                ]
            }
        },
        "condition": "(s_net_common_outbound_tcp and (s_net_rdp_port or s_net_ssh_port or s_net_vnc_ports or s_net_winrm_ports or s_net_smb_port)) or (s_proc_create_action and (s_proc_mstsc_exe or s_proc_ssh_exe or s_proc_vnc_client_exe or s_proc_winrm_cmdline_keywords or s_proc_citrix_client_exe))"
    },
    "operational_usage": "SOC 팀은 이 규칙을 활용하여 RDP, SSH, VNC, WinRM, Citrix 등 외부 원격 서비스에 대한 악의적인 접근 시도를 탐지할 수 있습니다. 특정 원격 서비스 포트로의 비정상적인 네트워크 연결이나, 해당 서비스를 시작하는 클라이언트/서버 애플리케이션의 실행을 모니터링합니다. 탐지된 이벤트는 높은 심각도로 분류되어 즉각적인 알람을 트리거하고, 관련 프로세스 및 네트워크 활동에 대한 추가적인 조사를 시작하는 데 사용될 수 있습니다. 특히, 다른 초기 접근 또는 지속성 전술과 결합될 때 중요도가 더욱 높아집니다.",
    "false_positive": "정상적인 원격 지원 활동, 시스템 관리 작업, 합법적인 VPN 클라이언트 연결, 소프트웨어 업데이트, 또는 기업 내에서 허용된 원격 접속 도구 사용 시 오탐이 발생할 수 있습니다. 알려진 정상적인 원격 접속 패턴이나 특정 프로세스에 대해 화이트리스트를 적용하여 오탐을 줄일 수 있습니다."
}