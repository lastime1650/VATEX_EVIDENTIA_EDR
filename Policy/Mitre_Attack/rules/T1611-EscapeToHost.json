{
    "id": "T1611-EscapeToHost",
    "name": "Escape to Host",
    "description": "Detects attempts by adversaries to break out of a container or virtualized environment to gain access to the underlying host. This includes monitoring for suspicious container runtime commands with privileged access or bind mounts, as well as direct manipulation of critical host filesystems from within a containerized context.",
    "severity": "high",
    "mitre_attack": {
        "tactic": "TA0004",
        "technique_id": "T1611",
        "subtechnique_id": "",
        "data_sources": [
            "Enterprise:Execution:Command and Scripting Interpreter:Windows Command Shell",
            "Enterprise:Execution:Container Administration Command:Deploy Container",
            "Enterprise:Defense Evasion:File and Directory Permissions Modification:Windows File and Directory Permissions Modification",
            "Enterprise:Execution:Native API"
        ]
    },
    "platform": [
        "windows"
    ],
    "detection": {
        "selections": {
            "s_proc_create": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.action",
                        "operator": "equals",
                        "value": "create"
                    }
                ]
            },
            "s_docker_cli": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "docker"
                    }
                ]
            },
            "s_kubectl_cli": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "kubectl"
                    }
                ]
            },
            "s_container_runtime_cli": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "containerd"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "runc"
                    }
                ]
            },
            "s_privileged_flag": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "--privileged"
                    }
                ]
            },
            "s_bind_mount_option": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "-v"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "--mount"
                    }
                ]
            },
            "s_host_path_mount_target": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "/:/host"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "C:\\\\:/host"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "C:\\\\Windows"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "C:\\\\Program Files"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "/etc"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "/root"
                    }
                ]
            },
            "s_docker_socket_access_cmd": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "/var/run/docker.sock"
                    },
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "//./pipe/docker_engine"
                    }
                ]
            },
            "s_kubectl_exec_cmd": {
                "event_type": "process",
                "conditions": [
                    {
                        "field": "body.process.commandline",
                        "operator": "contains",
                        "value": "exec"
                    }
                ]
            },
            "s_fs_write_create": {
                "event_type": "filesystem",
                "conditions": [
                    {
                        "field": "body.filesystem.action",
                        "operator": "equals",
                        "value": "write"
                    },
                    {
                        "field": "body.filesystem.action",
                        "operator": "equals",
                        "value": "create"
                    },
                    {
                        "field": "body.filesystem.action",
                        "operator": "equals",
                        "value": "overwritten"
                    }
                ]
            },
            "s_fs_critical_host_config": {
                "event_type": "filesystem",
                "conditions": [
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "contains",
                        "value": "C:\\\\Windows\\\\System32\\\\Tasks"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "contains",
                        "value": "C:\\\\Windows\\\\System32\\\\Drivers\\\\Etc\\\\hosts"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "contains",
                        "value": "C:\\\\Windows\\\\System32\\\\GroupPolicy"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "contains",
                        "value": "C:\\\\ProgramData\\\\Microsoft\\\\Windows\\\\Start Menu\\\\Programs\\\\Startup"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "contains",
                        "value": "/etc/cron"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "contains",
                        "value": "/etc/passwd"
                    },
                    {
                        "field": "body.filesystem.filepath",
                        "operator": "contains",
                        "value": "/etc/shadow"
                    }
                ]
            }
        },
        "condition": "s_proc_create and ( (s_docker_cli and (s_privileged_flag or (s_bind_mount_option and s_host_path_mount_target) or s_docker_socket_access_cmd)) or (s_kubectl_cli and s_kubectl_exec_cmd) or (s_container_runtime_cli and (s_privileged_flag or (s_bind_mount_option and s_host_path_mount_target) or s_docker_socket_access_cmd)) ) or (s_fs_write_create and s_fs_critical_host_config)"
    },
    "operational_usage": "SOC 팀은 이 규칙을 활용하여 컨테이너 또는 가상화 환경에서 호스트로 탈출하려는 시도를 탐지할 수 있습니다. Docker, Kubernetes (kubectl), containerd, runc와 같은 컨테이너 런타임 명령줄에서 '--privileged' 플래그, 호스트 파일 시스템 바인드 마운트 ('-v', '--mount'와 같은 옵션과 함께 호스트 경로 지정), 또는 Docker 소켓 직접 접근 시도를 모니터링합니다. 또한, 호스트의 중요한 구성 파일(예: Windows 예약 작업, hosts 파일, 시작 프로그램 폴더, Linux cron 설정, /etc/passwd, /etc/shadow)에 대한 비정상적인 쓰기/생성/덮어쓰기 파일 시스템 활동을 탐지합니다. 탐지된 이벤트는 높은 심각도로 분류되어 즉각적인 알람을 트리거하고, 관련된 프로세스 및 파일 시스템 활동에 대한 심층적인 포렌식 조사를 시작하는 데 사용될 수 있습니다. 이는 컨테이너 보안 위반 및 잠재적인 시스템 전체 침해를 식별하는 데 중요합니다.",
    "false_positive": "정상적인 컨테이너 관리 작업 (예: 개발 환경 설정, CI/CD 파이프라인), 보안 스캐너, 또는 시스템 관리 도구가 컨테이너를 배포하거나 호스트 리소스에 접근하는 과정에서 오탐이 발생할 수 있습니다. 알려진 정상적인 컨테이너 이미지, 특정 명령줄 패턴, 또는 화이트리스트에 등록된 프로세스에 대해 예외를 적용하여 오탐을 줄일 수 있습니다."
}