{
    "id": "F-PROC-046-DefenderCLIExecution",
    "name": "Feature: Windows Defender Command-Line Execution",
    "description": "Identifies the execution of MpCmdRun.exe, the command-line tool for Microsoft Defender. It can be used legitimately, but also to add exclusions or disable defenses.",
    "severity": "info",
    "mitre_attack": [
        {
            "tactic": "TA0005",
            "technique_id": "T1562",
            "subtechnique_id": "T1562.001"
        }
    ],
    "platform": ["windows"],
    "detection": {
        "inclusion": [
            {
                "id": "mpcmdrun_execution",
                "selections": {
                    "selection_mpcmdrun": {
                        "event_type": "process",
                        "condition_method": "and",
                        "conditions": [
                            {"field": "body.process.exe_path", "operator": "endswith", "value": "MpCmdRun.exe"}
                        ]
                    }
                },
                "action": {
                    "type": "notice",
                    "description": "Feature Captured: Windows Defender command-line utility (MpCmdRun.exe) was executed."
                }
            }
        ]
    }
}