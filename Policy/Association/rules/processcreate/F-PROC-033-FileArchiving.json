{
    "id": "F-PROC-033-FileArchiving",
    "name": "Feature: File Archiving Utility Execution",
    "description": "Identifies the execution of file archiving utilities like tar.exe, zip.exe, or 7z.exe. This can be a precursor to data exfiltration.",
    "severity": "info",
    "mitre_attack": [
        {
            "tactic": "TA0009",
            "technique_id": "T1560",
            "subtechnique_id": "T1560.001"
        }
    ],
    "platform": ["windows"],
    "detection": {
        "inclusion": [
            {
                "id": "archiving_tool_execution",
                "selections": {
                    "selection_archiver": {
                        "event_type": "process",
                        "condition_method": "or",
                        "conditions": [
                            {"field": "body.process.exe_path", "operator": "endswith", "value": "tar.exe"},
                            {"field": "body.process.exe_path", "operator": "endswith", "value": "zip.exe"},
                            {"field": "body.process.exe_path", "operator": "endswith", "value": "7z.exe"},
                            {"field": "body.process.exe_path", "operator": "endswith", "value": "makecab.exe"},
                            {"field": "body.process.exe_path", "operator": "endswith", "value": "Bandizip.exe"}
                        ]
                    }
                },
                "action": {
                    "type": "notice",
                    "description": "Feature Captured: File archiving utility was executed."
                }
            }
        ]
    }
}