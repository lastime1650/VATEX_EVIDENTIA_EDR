{
    "id": "F-PROC-044-GroupPolicyUpdate",
    "name": "Feature: Group Policy Update or Query",
    "description": "Identifies the execution of gpupdate.exe (force policy refresh) or gpresult.exe (view applied policies). This is significant in Active Directory environments.",
    "severity": "info",
    "mitre_attack": [
        {
            "tactic": "TA0007",
            "technique_id": "T1518"
        }
    ],
    "platform": ["windows"],
    "detection": {
        "inclusion": [
            {
                "id": "grouppolicy_tool_execution",
                "selections": {
                    "selection_gp": {
                        "event_type": "process",
                        "condition_method": "or",
                        "conditions": [
                            {"field": "body.process.exe_path", "operator": "endswith", "value": "gpupdate.exe"},
                            {"field": "body.process.exe_path", "operator": "endswith", "value": "gpresult.exe"}
                        ]
                    }
                },
                "action": {
                    "type": "notice",
                    "description": "Feature Captured: Group Policy was updated or queried (gpupdate/gpresult)."
                }
            }
        ]
    }
}