{
    "id": "F-PROC-039-PsExecExecution",
    "name": "Feature: PsExec Execution",
    "description": "Identifies the execution of PsExec (psexec.exe or the remote service psexesvc.exe), a tool commonly used for remote administration and lateral movement.",
    "severity": "info",
    "mitre_attack": [
        {
            "tactic": "TA0002",
            "technique_id": "T1569",
            "subtechnique_id": "T1569.002"
        }
    ],
    "platform": ["windows"],
    "detection": {
        "inclusion": [
            {
                "id": "psexec_tool_execution",
                "selections": {
                    "selection_psexec": {
                        "event_type": "process",
                        "condition_method": "or",
                        "conditions": [
                            {"field": "body.process.exe_path", "operator": "endswith", "value": "psexec.exe"},
                            {"field": "body.process.exe_path", "operator": "endswith", "value": "psexec64.exe"},
                            {"field": "body.process.exe_path", "operator": "endswith", "value": "psexesvc.exe"}
                        ]
                    }
                },
                "action": {
                    "type": "notice",
                    "description": "Feature Captured: PsExec remote administration tool was executed."
                }
            }
        ]
    }
}