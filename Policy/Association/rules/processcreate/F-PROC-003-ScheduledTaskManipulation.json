{
    "id": "F-PROC-003-ScheduledTaskManipulation",
    "name": "Feature: Scheduled Task Manipulation via schtasks.exe",
    "description": "Identifies the use of schtasks.exe to create, delete, or change scheduled tasks. This is a key indicator for persistence mechanisms.",
    "severity": "info",
    "mitre_attack": [
        {
            "tactic": "TA0003",
            "technique_id": "T1053",
            "subtechnique_id": "T1053.005"
        }
    ],
    "platform": ["windows"],
    "detection": {
        "inclusion": [
            {
                "id": "schtasks_process_started",
                "selections": {
                    "selection_schtasks_execution": {
                        "event_type": "process",
                        "condition_method": "and",
                        "conditions": [
                            {"field": "body.process.exe_path", "operator": "endswith", "value": "schtasks.exe"},
                            {"field": "body.process.commandline", "operator": "contains", "value": "create"}
                        ]
                    }
                },
                "action": {
                    "type": "notice",
                    "description": "Feature Captured: Scheduled Task Creation (schtasks.exe)"
                }
            }
        ]
    }
}