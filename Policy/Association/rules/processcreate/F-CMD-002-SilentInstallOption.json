{
    "id": "F-CMD-002-SilentInstallOption",
    "name": "Feature: Silent or Quiet Execution Option",
    "description": "Identifies the use of common silent or quiet installation flags (/q, /s, etc.) in a command line. This indicates an attempt to run a process without user interaction.",
    "severity": "critical",
    "mitre_attack": [
        {
            "tactic": "TA0002",
            "technique_id": "T1569"
        }
    ],
    "platform": ["windows"],
    "detection": {
        "inclusion": [
            {
                "id": "silent_option_used",
                "selections": {
                    "selection_silent_flag": {
                        "event_type": "process",
                        "condition_method": "and",
                        "conditions": [
                            {
                                "field": "body.process.commandline",
                                "operator": "regex",
                                "value": "\\s(/q|/s|/quiet|/silent|--quiet|--silent)\\s?"
                            }
                        ]
                    }
                },
                "action": {
                    "type": "notice",
                    "description": "Feature Captured: A process was launched with a silent/quiet execution flag."
                }
            }
        ]
    }
}