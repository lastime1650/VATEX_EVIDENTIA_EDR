{
    "id": "F-PS-002-HiddenOrNonInteractive",
    "name": "Feature: PowerShell Hidden or Non-Interactive Mode",
    "description": "Identifies PowerShell running in a non-interactive or hidden window mode. This is typical for automated scripts or malware attempting to run silently.",
    "severity": "high",
    "mitre_attack": [
        {
            "tactic": "TA0002",
            "technique_id": "T1059",
            "subtechnique_id": "T1059.001"
        }
    ],
    "platform": ["windows"],
    "detection": {
        "inclusion": [
            {
                "id": "ps_silent_mode",
                "selections": {
                    "selection_ps_silent": {
                        "event_type": "process",
                        "condition_method": "and",
                        "conditions": [
                            {"field": "body.process.exe_path", "operator": "endswith", "value": "powershell.exe"},
                            {
                                "field": "body.process.commandline",
                                "operator": "regex",
                                "value": "-(noni|noninteractive|w|windowstyle)\\s+(1|hidden)"
                            }
                        ]
                    }
                },
                "action": {
                    "type": "notice",
                    "description": "Feature Captured: PowerShell was launched in a hidden or non-interactive mode."
                }
            }
        ]
    }
}