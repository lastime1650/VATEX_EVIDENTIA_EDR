{
    "id": "F-PROC-030-AppLockerPolicyDiscovery",
    "name": "Feature: AppLocker Policy Discovery",
    "description": "Identifies PowerShell commands used to discover AppLocker policies. This is a reconnaissance technique to understand application control defenses before an attack.",
    "severity": "info",
    "mitre_attack": [
        {
            "tactic": "TA0007",
            "technique_id": "T1518",
            "subtechnique_id": "T1518.001"
        }
    ],
    "platform": ["windows"],
    "detection": {
        "inclusion": [
            {
                "id": "applocker_discovery_pattern",
                "selections": {
                    "selection_applocker_discovery": {
                        "event_type": "process",
                        "condition_method": "and",
                        "conditions": [
                            {"field": "body.process.exe_path", "operator": "endswith", "value": "powershell.exe"},
                            {
                                "field": "body.process.commandline",
                                "operator": "contains",
                                "value": "Get-AppLockerPolicy"
                            }
                        ]
                    }
                },
                "action": {
                    "type": "notice",
                    "description": "Feature Captured: AppLocker policy discovery attempt."
                }
            }
        ]
    }
}