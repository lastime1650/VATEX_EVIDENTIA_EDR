{
    "id": "F-PROC-020-BootConfigModification",
    "name": "Feature: Boot Configuration Modification via bcdedit.exe",
    "description": "Identifies the use of bcdedit.exe to modify boot configuration data. This can be used to disable recovery options or to establish persistence for bootkits.",
    "severity": "info",
    "mitre_attack": [
        {
            "tactic": "TA0005",
            "technique_id": "T1490"
        },
        {
            "tactic": "TA0003",
            "technique_id": "T1542"
        }
    ],
    "platform": ["windows"],
    "detection": {
        "inclusion": [
            {
                "id": "bcdedit_process_started",
                "selections": {
                    "selection_bcdedit_path": {
                        "event_type": "process",
                        "condition_method": "and",
                        "conditions": [
                            {"field": "body.process.exe_path", "operator": "endswith", "value": "bcdedit.exe"}
                        ]
                    }
                },
                "action": {
                    "type": "notice",
                    "description": "Feature Captured: Boot Configuration modification attempt (bcdedit.exe)"
                }
            }
        ]
    }
}