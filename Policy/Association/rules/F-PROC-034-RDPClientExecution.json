{
    "id": "F-PROC-034-RDPClientExecution",
    "name": "Feature: RDP Client Execution",
    "description": "Identifies the execution of the Remote Desktop Protocol client (mstsc.exe), indicating an outgoing RDP connection attempt.",
    "severity": "info",
    "mitre_attack": [
        {
            "tactic": "TA0008",
            "technique_id": "T1021",
            "subtechnique_id": "T1021.001"
        }
    ],
    "platform": ["windows"],
    "detection": {
        "inclusion": [
            {
                "id": "rdp_client_started",
                "selections": {
                    "selection_mstsc": {
                        "event_type": "process",
                        "condition_method": "and",
                        "conditions": [
                            {"field": "body.process.exe_path", "operator": "endswith", "value": "mstsc.exe"}
                        ]
                    }
                },
                "action": {
                    "type": "notice",
                    "description": "Feature Captured: Remote Desktop client (mstsc.exe) was executed."
                }
            }
        ]
    }
}