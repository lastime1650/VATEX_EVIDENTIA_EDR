{
    "id": "F-PROC-049-RemoteShareMount",
    "name": "Feature: Remote Share Mounting via 'net use'",
    "description": "Identifies the use of 'net use' to map a remote network share. This is a common method for accessing resources during lateral movement or for data staging.",
    "severity": "info",
    "mitre_attack": [
        {
            "tactic": "TA0008",
            "technique_id": "T1021",
            "subtechnique_id": "T1021.002"
        }
    ],
    "platform": ["windows"],
    "detection": {
        "inclusion": [
            {
                "id": "net_use_execution",
                "selections": {
                    "selection_net_use": {
                        "event_type": "process",
                        "condition_method": "and",
                        "conditions": [
                            {"field": "body.process.exe_path", "operator": "endswith", "value": "net.exe"},
                            {"field": "body.process.commandline", "operator": "contains", "value": "use"}
                        ]
                    }
                },
                "action": {
                    "type": "notice",
                    "description": "Feature Captured: Remote share mapping was attempted (net use)."
                }
            }
        ]
    }
}