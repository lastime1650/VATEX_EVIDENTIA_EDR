{
    "id": "F-PROC-029-ForFilesScriptExecution",
    "name": "Feature: Script Execution via ForFiles",
    "description": "Identifies the use of forfiles.exe with the '/c' parameter to execute commands. This is a known LOLBin technique for arbitrary code execution.",
    "severity": "info",
    "mitre_attack": [
        {
            "tactic": "TA0002",
            "technique_id": "T1202"
        }
    ],
    "platform": ["windows"],
    "detection": {
        "inclusion": [
            {
                "id": "forfiles_execution_pattern",
                "selections": {
                    "selection_forfiles_exec": {
                        "event_type": "process",
                        "condition_method": "and",
                        "conditions": [
                            {"field": "body.process.exe_path", "operator": "endswith", "value": "forfiles.exe"},
                            {"field": "body.process.commandline", "operator": "contains", "value": "/c"}
                        ]
                    }
                },
                "action": {
                    "type": "notice",
                    "description": "Feature Captured: Command execution using forfiles.exe."
                }
            }
        ]
    }
}