{
    "id": "F-PROC-026-Rundll32InlineScriptExecution",
    "name": "Feature: Rundll32 Executing Inline Script",
    "description": "Identifies rundll32.exe being used to execute inline JavaScript or VBScript. This is a highly suspicious and uncommon behavior, often associated with fileless malware.",
    "severity": "high",
    "mitre_attack": [
        {
            "tactic": "TA0002",
            "technique_id": "T1218",
            "subtechnique_id": "T1218.011"
        }
    ],
    "platform": ["windows"],
    "detection": {
        "inclusion": [
            {
                "id": "rundll32_javascript_pattern",
                "selections": {
                    "selection_rundll32_script": {
                        "event_type": "process",
                        "condition_method": "and",
                        "conditions": [
                            {"field": "body.process.exe_path", "operator": "endswith", "value": "rundll32.exe"},
                            {
                                "field": "body.process.commandline",
                                "operator": "regex",
                                "value": "(javascript:|vbscript:)"
                            }
                        ]
                    }
                },
                "action": {
                    "type": "notice",
                    "description": "Feature Captured: Rundll32 executing inline JavaScript/VBScript."
                }
            }
        ]
    }
}