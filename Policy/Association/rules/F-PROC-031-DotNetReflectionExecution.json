{
    "id": "F-PROC-031-DotNetReflectionExecution",
    "name": "Feature: In-Memory .NET Assembly Execution via Reflection",
    "description": "Identifies PowerShell using .NET Reflection to load an assembly from memory. This is a sophisticated fileless technique to execute binaries without writing them to disk.",
    "severity": "low",
    "mitre_attack": [
        {
            "tactic": "TA0002",
            "technique_id": "T1059",
            "subtechnique_id": "T1059.001"
        },
        {
            "tactic": "TA0005",
            "technique_id": "T1620"
        }
    ],
    "platform": ["windows"],
    "detection": {
        "inclusion": [
            {
                "id": "dotnet_reflection_pattern",
                "selections": {
                    "selection_dotnet_reflection": {
                        "event_type": "process",
                        "condition_method": "and",
                        "conditions": [
                            {"field": "body.process.exe_path", "operator": "endswith", "value": "powershell.exe"},
                            {
                                "field": "body.process.commandline",
                                "operator": "regex",
                                "value": "(Reflection\\.Assembly|Load\\(byte)"
                            }
                        ]
                    }
                },
                "action": {
                    "type": "notice",
                    "description": "Feature Captured: PowerShell execution with .NET Reflection for in-memory assembly loading."
                }
            }
        ]
    }
}