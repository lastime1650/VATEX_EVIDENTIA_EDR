{
    "id": "F-PROC-037-PythonInterpreterExecution",
    "name": "Feature: Python Interpreter Execution",
    "description": "Identifies the execution of the Python interpreter (python.exe). While used for legitimate development and scripting, its execution can be noteworthy in non-developer environments.",
    "severity": "info",
    "mitre_attack": [
        {
            "tactic": "TA0002",
            "technique_id": "T1059",
            "subtechnique_id": "T1059.006"
        }
    ],
    "platform": ["windows"],
    "detection": {
        "inclusion": [
            {
                "id": "python_execution",
                "selections": {
                    "selection_python": {
                        "event_type": "process",
                        "condition_method": "and",
                        "conditions": [
                            {"field": "body.process.exe_path", "operator": "endswith", "value": "python.exe"}
                        ]
                    }
                },
                "action": {
                    "type": "notice",
                    "description": "Feature Captured: Python interpreter (python.exe) was executed."
                }
            }
        ]
    }
}