{
    "id": "F-PS-001-ExecutionPolicyBypass",
    "name": "Feature: PowerShell Execution Policy Bypass",
    "description": "Identifies PowerShell being launched with the '-ExecutionPolicy Bypass' flag, which allows any script to run regardless of system settings. This is a common administrative and adversarial practice.",
    "severity": "critical",
    "mitre_attack": [
        {
            "tactic": "TA0005",
            "technique_id": "T1059",
            "subtechnique_id": "T1059.001"
        }
    ],
    "platform": ["windows"],
    "detection": {
        "inclusion": [
            {
                "id": "ps_bypass_flag",
                "selections": {
                    "selection_ps_bypass": {
                        "event_type": "process",
                        "condition_method": "and",
                        "conditions": [
                            {"field": "body.process.exe_path", "operator": "endswith", "value": "powershell.exe"},
                            {
                                "field": "body.process.commandline",
                                "operator": "regex",
                                "value": "-(ep|exec|executionpolicy)\\s+bypass"
                            }
                        ]
                    }
                },
                "action": {
                    "type": "notice",
                    "description": "Feature Captured: PowerShell was launched with an execution policy bypass."
                }
            }
        ]
    }
}