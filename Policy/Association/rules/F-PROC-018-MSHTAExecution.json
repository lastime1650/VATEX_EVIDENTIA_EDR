{
    "id": "F-PROC-018-MSHTAExecution",
    "name": "Feature: MSHTA (HTML Application) Execution",
    "description": "Identifies the execution of mshta.exe, which can run JavaScript or VBScript from remote URLs within an HTML Application. It is a known technique for bypassing security controls.",
    "severity": "info",
    "mitre_attack": [
        {
            "tactic": "TA0005",
            "technique_id": "T1218",
            "subtechnique_id": "T1218.005"
        }
    ],
    "platform": ["windows"],
    "detection": {
        "inclusion": [
            {
                "id": "mshta_process_started",
                "selections": {
                    "selection_mshta_path": {
                        "event_type": "process",
                        "condition_method": "and",
                        "conditions": [
                            {"field": "body.process.exe_path", "operator": "endswith", "value": "mshta.exe"}
                        ]
                    }
                },
                "action": {
                    "type": "notice",
                    "description": "Feature Captured: Microsoft HTML Application Host (mshta.exe) execution"
                }
            }
        ]
    }
}