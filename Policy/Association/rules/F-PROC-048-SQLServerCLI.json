{
    "id": "F-PROC-048-SQLServerCLI",
    "name": "Feature: SQL Server Command-Line Utility Execution",
    "description": "Identifies the execution of sqlcmd.exe, the command-line utility for interacting with Microsoft SQL Server. This indicates direct database interaction.",
    "severity": "info",
    "mitre_attack": [
        {
            "tactic": "TA0002",
            "technique_id": "T1059"
        }
    ],
    "platform": ["windows"],
    "detection": {
        "inclusion": [
            {
                "id": "sqlcmd_execution",
                "selections": {
                    "selection_sqlcmd": {
                        "event_type": "process",
                        "condition_method": "and",
                        "conditions": [
                            {"field": "body.process.exe_path", "operator": "endswith", "value": "sqlcmd.exe"}
                        ]
                    }
                },
                "action": {
                    "type": "notice",
                    "description": "Feature Captured: SQL Server command-line utility (sqlcmd.exe) was executed."
                }
            }
        ]
    }
}