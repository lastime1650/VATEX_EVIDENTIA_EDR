{
    "id": "F-PROC-002-WMIExecution",
    "name": "Feature: WMI Command-line Utility Execution",
    "description": "Identifies the execution of the WMI command-line utility (wmic.exe). WMI is frequently used for system reconnaissance and lateral movement.",
    "severity": "info",
    "mitre_attack": [
        {
            "tactic": "TA0002",
            "technique_id": "T1047"
        }
    ],
    "platform": ["windows"],
    "detection": {
        "inclusion": [
            {
                "id": "wmic_process_started",
                "selections": {
                    "selection_wmic_path": {
                        "event_type": "process",
                        "condition_method": "and",
                        "conditions": [
                            {"field": "body.process.exe_path", "operator": "endswith", "value": "wmic.exe"}
                        ]
                    }
                },
                "action": {
                    "type": "notice",
                    "description": "Feature Captured: WMI Command-line (wmic.exe) Execution"
                }
            }
        ]
    }
}