{
    "id": "F-PROC-006-Rundll32Execution",
    "name": "Feature: RunDLL32 Execution",
    "description": "Identifies the execution of rundll32.exe, which is used to run code from DLL files. This is a very common technique for malware execution and living-off-the-land attacks.",
    "severity": "info",
    "mitre_attack": [
        {
            "tactic": "TA0002",
            "technique_id": "T1218",
            "subtechnique_id": "T1218.011"
        }
    ],
    "platform": ["windows"],
    "detection": {
        "inclusion": [
            {
                "id": "rundll32_process_started",
                "selections": {
                    "selection_rundll32_path": {
                        "event_type": "process",
                        "condition_method": "and",
                        "conditions": [
                            {"field": "body.process.exe_path", "operator": "endswith", "value": "\\rundll32.exe"}
                        ]
                    }
                },
                "action": {
                    "type": "notice",
                    "description": "Feature Captured: RunDLL32 Execution"
                }
            }
        ]
    }
}